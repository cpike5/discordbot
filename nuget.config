<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources. cpike.Agent.* comes from the owner's private GitHub Packages feed; everything
  else from nuget.org. Source mapping keeps every other package off the private feed, so a restore
  that needs no cpike.Agent package never asks it for anything.

  No credentials live here. Reading the feed needs a classic token with read:packages; where each
  kind of build gets one is in docs/articles/private-package-feed.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="cpike5" value="https://nuget.pkg.github.com/cpike5/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="cpike5">
      <package pattern="cpike.Agent.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

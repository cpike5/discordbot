# Discord Bot — Production Environment Configuration
#
# Usage:
#   1. Copy to .env:  cp .env.production.example .env
#   2. Replace ALL placeholder values with real secrets
#   3. Start with:  docker compose --profile postgres up -d
#
# IMPORTANT: Never commit .env with real secrets to version control!

# =============================================================================
# REQUIRED — Discord
# =============================================================================

Discord__Token=YOUR_BOT_TOKEN_HERE
Discord__OAuth__ClientId=YOUR_CLIENT_ID_HERE
Discord__OAuth__ClientSecret=YOUR_CLIENT_SECRET_HERE

# =============================================================================
# DATABASE — PostgreSQL
# =============================================================================

DATABASE_PROVIDER=PostgreSql
CONNECTION_STRING=Host=postgres;Database=discordbot;Username=discordbot;Password=CHANGE_THIS_PASSWORD

# PostgreSQL container settings (must match CONNECTION_STRING above)
POSTGRES_DB=discordbot
POSTGRES_USER=discordbot
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# =============================================================================
# PATHS — Match bind mount layout in docker-compose.yml
# =============================================================================

Soundboard__BasePath=/app/sounds
Vox__BasePath=/app/sounds
Assistant__AgentPromptPath=/app/assistant/system-prompt.md
Assistant__DocumentationBasePath=/app/assistant/docs
AudioCache__CachePath=/app/cache/audio

# =============================================================================
# OBSERVABILITY — Host services via host.docker.internal
# =============================================================================

# Elastic APM (if running on host)
# ElasticApm__ServerUrl=http://host.docker.internal:8200

# Serilog → Loki (if running on host)
# Serilog__WriteTo__2__Name=GrafanaLoki
# Serilog__WriteTo__2__Args__uri=http://host.docker.internal:3100
# Serilog__WriteTo__2__Args__labels__0__key=app
# Serilog__WriteTo__2__Args__labels__0__value=discordbot

# OpenTelemetry → Jaeger (if running on host)
# OpenTelemetry__Tracing__OtlpEndpoint=http://host.docker.internal:4317

# =============================================================================
# OPTIONAL
# =============================================================================

# Instant command registration (global commands take up to 1 hour without this)
# Discord__TestGuildId=123456789012345678

# AI Assistant (OpenRouter - get a key at https://openrouter.ai/keys)
# OpenRouter__ApiKey=YOUR_OPENROUTER_API_KEY

# Azure TTS
# AzureSpeech__SubscriptionKey=YOUR_AZURE_KEY
# AzureSpeech__Region=eastus

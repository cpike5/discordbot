          "expr": "max by (service_instance_id) (discordbot_process_cpu_usage_percent{service_name=\"discordbot\", deployment_environment=~\"$env\", service_instance_id=~\"$instance\"})",
          "legendFormat": "{{service_instance_id}}",
          "range": true,
          "instant": false,
          "refId": "A"

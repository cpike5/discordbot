{
  "uid": "discordbot-business",
  "title": "Discord Bot \u2014 Business & SLOs",
  "description": "Service levels computed from raw counters, the app's own SLO gauges, and growth.",
  "tags": [
    "discordbot",
    "business",
    "slo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(discordbot_process_uptime_seconds{service_name=\"discordbot\"}, deployment_environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(discordbot_process_uptime_seconds{service_name=\"discordbot\"}, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(discordbot_process_uptime_seconds{service_name=\"discordbot\", deployment_environment=~\"$env\"}, service_instance_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(discordbot_process_uptime_seconds{service_name=\"discordbot\", deployment_environment=~\"$env\"}, service_instance_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Gateway disconnects",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(discordbot_gateway_connection_events_total{service_name=\"discordbot\", deployment_environment=~\"$env\", service_instance_id=~\"$instance\", event=\"disconnected\"}[1m]) > 0",
        "step": "60s",
        "titleFormat": "Gateway disconnected",
        "textFormat": "{{reason}}"
      },
      {
        "name": "Restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "discordbot_process_uptime_seconds{service_name=\"discordbot\", deployment_environment=~\"$env\", service_instance_id=~\"$instance\"} < 90",
        "step": "60s",
        "titleFormat": "Process started",
        "textFormat": "{{service_instance_id}}"
      }
    ]
  },
  "links": [
    {
      "title": "Discord Bot",
      "type": "dashboards",
      "tags": [
        "discordbot"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Service levels (computed from raw counters over the selected range)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "gauge",
      "title": "Command success",
      "description": "Target 99%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(discordbot_command_count_total{service_name=\"discordbot\", deployment_environment=~\"$env\", service_instance_id=~\"$instance\", status=\"success\"}[$__range])) / sum(increase(discordbot_command_count_total{service_name=\"discordbot\", deployment_environment=~\"$env\", service_instance_id=~\"$instance\"}[$__range])) * 100",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "\u2013",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "gauge",
      "title": "Gateway availability",
      "description": "Target 99.9%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(avg_over_time(discordbot_gateway_connected{service_name=\"discordbot\", deployment_environment=~\"$env\", service_instance_id=~\"$instance\"}[$__range])) * 100",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "\u2013",

<!DOCTYPE html>
<html lang="en" class="portal-page" theme-root>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <partial name="_ThemeHead" />
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" />
    <partial name="_PwaHead" />
    <title>@ViewData["Title"] - Discord Bot Portal</title>
    <!-- Typefaces: Bricolage Grotesque (display), DM Sans (body), JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Compiled Tailwind CSS (built from site.css via npm run build:css) -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="portal-page bg-bg-primary text-text-primary font-sans antialiased">
    @RenderBody()
    <!-- Toast container, with any toasts queued through TempData -->
    <partial name="_ToastContainer" />
    <!-- Shared fetch wrapper (anti-forgery token, JSON/blob handling, error parsing) -->
    <script src="~/js/safe-html.js" asp-append-version="true"></script>
    <script src="~/js/api-client.js" asp-append-version="true"></script>
    <!-- Unified User Preferences (localStorage + server sync) -->
    <script src="~/js/user-preferences.js" asp-append-version="true"></script>
    <!-- Shared Toast Notification Manager -->
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <!-- Theme: header toggle, saved choice, OS preference -->
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <!-- Button pending states and the data-submit-guard double-submit guard -->
    <script src="~/js/loading-manager.js" asp-append-version="true"></script>
    <!-- Interaction primitives: empty/loading states from script, unsaved-changes warning -->
    <script src="~/js/empty-state.js" asp-append-version="true"></script>
    <script src="~/js/skeleton.js" asp-append-version="true"></script>
    <script src="~/js/unsaved-changes.js" asp-append-version="true"></script>
    <!-- Shared Keyboard Shortcut Manager -->
    <script src="~/js/shared/keyboard-shortcuts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

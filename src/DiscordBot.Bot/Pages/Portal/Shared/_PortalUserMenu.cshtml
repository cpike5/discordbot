@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@*
    Account menu for the member portal header: the signed-in user's name, a way back to the admin
    portal (only for a user the admin portal lets in), the theme switch and Sign out.
    Same data and markup language as the admin navbar's user menu (_Navbar.cshtml), but with its own
    ids, because the navbar script is not loaded here; wwwroot/js/portal-user-menu.js drives it.
*@
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var displayName = user?.DisplayName ?? user?.Email ?? "User";
    var initials = TextDisplay.WordInitials(displayName, 2, "U");
    var avatarUrl = user?.DiscordAvatarUrl;
    // The lowest admin-portal policy: Viewer and up. Portal members hold no role.
    var canOpenAdmin = (await AuthorizationService.AuthorizeAsync(User, "RequireViewer")).Succeeded;

    <div class="relative" data-portal-user-menu>
        <button id="portalUserMenuButton"
                type="button"
                class="topbar-user"
                aria-label="@displayName, account menu"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-controls="portalUserMenu">
            @if (!string.IsNullOrEmpty(avatarUrl))
            {
                <img src="@avatarUrl" alt="" class="topbar-avatar" />
            }
            else
            {
                <span class="topbar-avatar" aria-hidden="true">@initials</span>
            }
            <span class="topbar-user-name">@displayName</span>
            <svg class="topbar-user-caret" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>

        <div id="portalUserMenu" class="user-menu-dropdown" role="menu" aria-labelledby="portalUserMenuButton">
            <div class="user-menu-header">
                <p class="user-menu-name">@displayName</p>
                @if (!string.IsNullOrEmpty(user?.Email))
                {
                    <p class="user-menu-email">@user.Email</p>
                }
            </div>
            @if (canOpenAdmin)
            {
                <a asp-page="/Index" class="user-menu-item" role="menuitem" data-portal-admin-link>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10-3a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z" />
                    </svg>
                    Admin portal
                </a>
            }
            @* theme.js names it for the theme it switches to; the icon follows data-theme in CSS *@
            <button type="button"
                    class="user-menu-item theme-toggle"
                    role="menuitem"
                    data-theme-toggle
                    data-theme-persist="true"
                    aria-label="Switch theme">
                <svg class="theme-toggle-icon-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <svg class="theme-toggle-icon-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                </svg>
                Theme
            </button>
            <form asp-page="/Account/Logout" asp-page-handler="Post" method="post" class="block">
                <button type="submit" class="user-menu-item danger" role="menuitem">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    Sign out
                </button>
            </form>
        </div>
    </div>
}

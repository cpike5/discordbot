@using DiscordBot.Bot.ViewModels.Components
@model string?

@* Audio disabled warning for portal pages. The model is the message: pass nothing for the bot-wide
   switch, or a server-specific sentence when only this server has audio off. *@
<div class="portal-audio-warning">
    @await Html.PartialAsync("../../Shared/Components/_Alert", new AlertViewModel
    {
        Variant = AlertVariant.Warning,
        Title = "Audio Features Disabled",
        Message = Model ?? "Audio features have been temporarily disabled. Audio cannot be played at this time.",
        ShowIcon = true,
        IsDismissible = false
    })
</div>

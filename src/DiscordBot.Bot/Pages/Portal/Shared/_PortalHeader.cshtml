@model DiscordBot.Bot.ViewModels.Portal.PortalHeaderViewModel

@using DiscordBot.Bot.ViewModels.Components

@{
    // Build TabPanel ViewModel inline
    Model.TabsViewModel = new TabPanelViewModel
    {
        Id = "portalTabs",
        StyleVariant = TabStyleVariant.Portal,
        NavigationMode = TabNavigationMode.PageNavigation,
        PersistenceMode = TabPersistenceMode.None,
        Tabs = new List<TabItemViewModel>
        {
            new()
            {
                Id = "soundboard",
                Label = "Soundboard",
                Subtitle = "Play uploaded sounds",
                Href = $"/Portal/Soundboard/{Model.GuildId}",
                IconPathOutline = "M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
            },
            new()
            {
                Id = "tts",
                Label = "Text-to-Speech",
                Subtitle = "Text-to-speech with voices",
                Href = $"/Portal/TTS/{Model.GuildId}",
                IconPathOutline = "M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
            },
            new()
            {
                Id = "vox",
                Label = "VOX",
                Subtitle = "Half-Life style announcements",
                Href = $"/Portal/VOX/{Model.GuildId}",
                IconPathOutline = "M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
            }
        },
        ActiveTabId = Model.ActiveTab,
        AriaLabel = "Portal sections"
    };
}

<!-- Portal Header -->
<header class="portal-header">
    <div class="header-content">
        <!-- Top Section: Icon, Title, Status -->
        <div class="header-top">
            <div class="header-left">
                <div class="guild-icon">
                    @if (!string.IsNullOrEmpty(Model.GuildIconUrl))
                    {
                        <img src="@Model.GuildIconUrl" alt="@Model.GuildName icon" />
                    }
                    else
                    {
                        <div class="guild-icon-fallback">
                            @(Model.GuildName.Length > 0 ? Model.GuildName[0].ToString().ToUpper() : "?")
                        </div>
                    }
                </div>
                <div class="header-text">
                    <h1>@Model.GuildName Portal</h1>
                    <p>Member access for @Model.GuildName</p>
                </div>
            </div>
            <div class="status-badge @(Model.IsOnline ? "online" : "offline")">
                <span class="status-dot"></span>
                @(Model.IsOnline ? "Online" : "Offline")
            </div>
        </div>

        <!-- Navigation Tabs -->
        @if (Model.TabsViewModel != null)
        {
            @await Html.PartialAsync("Components/_TabPanel", Model.TabsViewModel)
        }
    </div>
</header>

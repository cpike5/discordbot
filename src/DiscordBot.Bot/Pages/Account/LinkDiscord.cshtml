@page
@model LinkDiscordModel
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = "Discord account";

    // Discord logo, used as the avatar fallback and on the link button
    const string discordLogo = "M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z";
    const string copyIcon = "M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z";
}

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-text-primary mb-2">Discord account</h1>
    <p class="text-text-secondary">Link your Discord account to sign in with it and to manage your servers from here.</p>
</div>

<!-- Discord Link Card -->
<div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6 shadow-lg">

    @if (!Model.IsDiscordOAuthConfigured)
    {
        <!-- OAuth Not Configured -->
        <div class="text-center py-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-warning-bg border-2 border-warning-border rounded-full mb-4">
                <svg class="w-8 h-8 text-warning" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <h2 class="text-xl font-semibold text-text-primary mb-2">Discord sign-in isn't set up</h2>
            <p class="text-text-secondary text-sm max-w-md mx-auto">
                Linking a Discord account isn't available on this server yet. Ask an administrator to turn it on.
            </p>
        </div>
    }
    else if (Model.IsDiscordLinked)
    {
        <!-- Discord Account Linked -->
        <div>
            <div class="flex items-start gap-4 mb-6 pb-6 border-b border-border-primary">
                <!-- Discord Avatar -->
                @if (!string.IsNullOrEmpty(Model.DiscordAvatarUrl))
                {
                    <img src="@Model.DiscordAvatarUrl" alt="" class="w-16 h-16 rounded-full border-2 border-accent-blue flex-shrink-0" />
                }
                else
                {
                    <!-- Default Avatar -->
                    <div class="w-16 h-16 rounded-full bg-bg-tertiary border-2 border-border-primary flex items-center justify-center flex-shrink-0" aria-hidden="true">
                        <svg class="w-8 h-8 text-text-tertiary" fill="currentColor" viewBox="0 0 24 24">
                            <path d="@discordLogo" />
                        </svg>
                    </div>
                }

                <!-- Discord Info -->
                <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2 mb-1">
                        <h2 class="text-xl font-semibold text-text-primary break-words">@(Model.DiscordUsername ?? "Discord user")</h2>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success-bg text-success border border-success-border">
                            Linked
                        </span>
                    </div>
                    @if (Model.DiscordUserId.HasValue)
                    {
                        <button type="button" class="btn btn-ghost btn-sm -ml-2" data-copy-text="@Model.DiscordUserId.Value" data-copy-label="Discord ID">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="@copyIcon" />
                            </svg>
                            Copy Discord ID
                        </button>
                    }
                    @if (Model.HasValidToken)
                    {
                        <p class="text-xs text-success mt-1 flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            Discord access is active
                        </p>
                    }
                    else
                    {
                        <p class="text-xs text-warning mt-1 flex items-start gap-1">
                            <svg class="w-3.5 h-3.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            Discord access has expired. Unlink and link again to refresh your servers.
                        </p>
                    }
                </div>
            </div>

            <!-- Server List -->
            @if (Model.HasValidToken && Model.UserGuilds.Any())
            {
                <div class="mb-6">
                    <h3 class="text-sm font-semibold text-text-primary mb-3">Servers you manage (@Model.UserGuilds.Count)</h3>
                    <ul class="space-y-2">
                        @foreach (var guild in Model.UserGuilds)
                        {
                            <li class="flex items-center gap-3 p-3 bg-bg-primary rounded-md border border-border-secondary">
                                @if (!string.IsNullOrEmpty(guild.IconUrl))
                                {
                                    <img src="@guild.IconUrl" alt="" class="w-10 h-10 rounded-full flex-shrink-0" />
                                }
                                else
                                {
                                    <!-- Default server icon -->
                                    <div class="w-10 h-10 rounded-full bg-bg-tertiary flex items-center justify-center flex-shrink-0" aria-hidden="true">
                                        <span class="text-text-secondary text-sm font-semibold">@Initials(guild.Name)</span>
                                    </div>
                                }
                                <p class="flex-1 min-w-0 text-sm font-medium text-text-primary truncate">@guild.Name</p>
                                @if (guild.Owner)
                                {
                                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-accent-orange-muted text-accent-orange border border-accent-orange/30 flex-shrink-0">
                                        Owner
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-accent-blue-muted text-accent-blue border border-accent-blue/30 flex-shrink-0">
                                        Admin
                                    </span>
                                }
                                <button type="button" class="btn btn-ghost btn-icon btn-sm flex-shrink-0" data-copy-text="@guild.Id" data-copy-label="Server ID" aria-label="Copy the server ID of @guild.Name" title="Copy server ID">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="@copyIcon" />
                                    </svg>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }
            else if (Model.HasValidToken && !Model.UserGuilds.Any())
            {
                <div class="mb-6 p-4 bg-info-bg border border-info-border rounded-md">
                    <p class="text-sm text-info">
                        You don't manage any Discord servers. You need the Administrator or Manage Server permission to manage a server from this portal.
                    </p>
                </div>
            }

            <!-- Refresh Discord Data -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 py-4 @(Model.HasValidToken && Model.UserGuilds.Any() ? "border-t" : "") border-border-primary border-b">
                <div>
                    <p class="text-sm font-medium text-text-primary">Refresh Discord data</p>
                    <p class="text-xs text-text-secondary mt-0.5">Fetch your latest servers and permissions from Discord</p>
                </div>
                <form method="post" asp-page-handler="RefreshDiscordData" data-submit-guard>
                    <button type="submit" class="btn btn-accent" data-loading-text="Refreshing…">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        Refresh data
                    </button>
                </form>
            </div>

            <!-- Unlink -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-4">
                <div>
                    <p class="text-sm font-medium text-text-primary">Unlink Discord account</p>
                    <p class="text-xs text-text-secondary mt-0.5">This removes the Discord connection and the data stored with it</p>
                </div>
                <button type="button" class="btn btn-danger" onclick="quickActions.showConfirmationModal('unlinkDiscordModal')">
                    Unlink Discord
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Discord Not Linked -->
        <div class="text-center py-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-bg-tertiary rounded-xl mb-4" aria-hidden="true">
                <svg class="w-10 h-10 text-text-secondary" fill="currentColor" viewBox="0 0 24 24">
                    <path d="@discordLogo" />
                </svg>
            </div>
            <h2 class="text-xl font-semibold text-text-primary mb-2">No Discord account linked</h2>
            <p class="text-text-secondary text-sm mb-6 max-w-md mx-auto">
                Link your Discord account to sign in with it and to manage your servers from here.
            </p>

            <!-- Link Discord Button -->
            <form method="post" asp-page-handler="Link" data-submit-guard>
                <button type="submit" class="btn btn-lg bg-discord text-white border-discord hover:bg-discord-hover hover:border-discord-hover" data-loading-text="Opening Discord…">
                    <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="@discordLogo" />
                    </svg>
                    Link Discord account
                </button>
            </form>

            <!-- Info Note -->
            <div class="mt-6 p-4 bg-info-bg border border-info-border rounded-md text-left max-w-md mx-auto">
                <p class="text-xs text-info">
                    <strong>Note:</strong> You'll be sent to Discord to approve this. We only ask for what we need to sign you in and list the servers you manage.
                </p>
            </div>

            <!-- "Or" Divider -->
            <div class="relative my-8 max-w-md mx-auto" role="separator" aria-label="or">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-border-primary"></div>
                </div>
                <div class="relative flex justify-center text-xs">
                    <span class="px-3 bg-bg-secondary text-text-secondary">or</span>
                </div>
            </div>

            @if (!Model.HasPendingVerification)
            {
                <!-- Bot Verification - Initial State -->
                <div class="max-w-md mx-auto text-left">
                    <div class="flex items-start gap-3 mb-4">
                        <div class="flex-shrink-0 w-10 h-10 bg-bg-tertiary rounded-lg flex items-center justify-center" aria-hidden="true">
                            <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-base font-semibold text-text-primary">Link with the Discord bot</h3>
                            <p class="text-sm text-text-secondary mt-1">
                                Already on a server with the bot? Run a command in Discord, then enter the code it gives you here.
                            </p>
                        </div>
                    </div>

                    <!-- Start Verification Button -->
                    <form method="post" asp-page-handler="InitiateBotVerification" data-submit-guard>
                        <button type="submit" class="btn btn-secondary btn-block" data-loading-text="Starting…">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                            Start verification
                        </button>
                    </form>
                </div>
            }
            else
            {
                <!-- Bot Verification - Pending State -->
                <div class="max-w-md mx-auto text-left" data-verification data-expires-at="@Model.PendingVerification!.ExpiresAtUtcIso">
                    <!-- Info Box with Instructions -->
                    <div class="p-4 bg-info-bg border border-info-border rounded-lg mb-6">
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-info flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                            <div class="text-sm text-info">
                                <p class="font-semibold mb-1">Finish in Discord</p>
                                <ol class="list-decimal list-inside space-y-1 text-info/90">
                                    <li>Open Discord and go to a server with the bot</li>
                                    <li>Run the command <code class="px-1.5 py-0.5 bg-info/20 rounded font-mono text-xs whitespace-nowrap">/verify-account</code></li>
                                    <li>Enter the code you receive below</li>
                                </ol>
                            </div>
                        </div>
                    </div>

                    <!-- Expiry countdown: ticks while the code is valid, then locks the form -->
                    <div class="flex items-center justify-between gap-3 mb-4">
                        <span class="text-sm text-text-secondary">Waiting for your code</span>
                        <span class="text-xs text-warning flex items-center gap-1.5" data-verification-timer>
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                            </svg>
                            <span>Expires <span data-utc="@Model.PendingVerification!.ExpiresAtUtcIso" data-format="time">…</span></span>
                            <span aria-hidden="true" data-verification-remaining></span>
                        </span>
                    </div>
                    <p class="sr-only" role="status" data-verification-status></p>

                    <!-- Expired state (shown by link-discord.js) -->
                    <div class="mb-4 p-4 bg-warning-bg border border-warning-border rounded-md" data-verification-expired hidden>
                        <p class="text-sm text-warning font-semibold">This code has expired</p>
                        <p class="text-sm text-text-secondary mt-1">Start again to get a new one.</p>
                        <button type="button" class="btn btn-secondary btn-sm mt-3" data-verification-restart>Start again</button>
                    </div>

                    <!-- Verification Code Input Form -->
                    <form method="post" asp-page-handler="VerifyCode" data-submit-guard data-verification-form>
                        <div class="mb-4">
                            <label asp-for="VerificationCode" class="block text-sm font-semibold text-text-primary mb-2">
                                Verification code
                            </label>
                            <input
                                asp-for="VerificationCode"
                                type="text"
                                maxlength="@(Model.VerificationCodeLength * 2)"
                                placeholder="@Model.CodePlaceholder"
                                autocomplete="off"
                                autocapitalize="characters"
                                spellcheck="false"
                                class="w-full px-4 py-3 text-2xl font-mono uppercase text-center tracking-widest text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors hover:border-border-focus focus:outline-none focus:border-border-focus focus:ring-2 focus:ring-border-focus/20"
                                aria-describedby="code-hint"
                            />
                            <p id="code-hint" class="mt-2 text-xs text-text-secondary">
                                Enter the @Model.VerificationCodeLength-character code from the Discord bot. Dashes and spaces are ignored.
                            </p>
                        </div>

                        <!-- Action Buttons -->
                        <button type="submit" class="btn btn-primary btn-block" data-loading-text="Verifying…" data-verification-submit>
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Verify
                        </button>
                    </form>

                    <!-- Cancel Button -->
                    <form method="post" asp-page-handler="CancelVerification" class="mt-3" data-submit-guard>
                        <button type="submit" class="btn btn-ghost btn-block" data-loading-text="Cancelling…">
                            Cancel
                        </button>
                    </form>
                </div>
            }
        </div>
    }

</div>

@if (Model.IsDiscordLinked)
{
    <partial name="Shared/Components/_ConfirmationModal" model='new ConfirmationModalViewModel
    {
        Id = "unlinkDiscordModal",
        Title = "Unlink Discord account",
        Message = "Unlink your Discord account? You will lose access to server management until you link it again.",
        ConfirmText = "Unlink Discord",
        Variant = ConfirmationVariant.Danger,
        FormAction = Url.Page("/Account/LinkDiscord"),
        FormHandler = "Unlink"
    }' />
}

@section Scripts {
    <script src="~/js/link-discord.js" asp-append-version="true"></script>
}

@functions {
    /// <summary>The first two characters a person would see (emoji and accents stay whole).</summary>
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var elements = System.Globalization.StringInfo.GetTextElementEnumerator(name.Trim());
        var result = new System.Text.StringBuilder();
        for (var i = 0; i < 2 && elements.MoveNext(); i++)
        {
            result.Append(elements.GetTextElement());
        }
        return result.ToString().ToUpperInvariant();
    }
}

@page
@model LockoutModel
@{
    ViewData["Title"] = "Account locked";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" theme-root>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <partial name="_ThemeHead" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] - Discord Bot Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" />
    <!-- Typefaces: Bricolage Grotesque (display), DM Sans (body), JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-bg-primary text-text-primary flex items-center justify-center px-4 py-8 font-sans">

    <main class="w-full max-w-md">
        <!-- Icon and heading -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-error rounded-xl mb-4">
                <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-text-primary">Account locked</h1>
            <p class="text-text-secondary mt-2">Too many failed sign-in attempts</p>
        </div>

        <!-- Message Card -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 shadow-lg">
            <div class="mb-6 p-4 bg-warning-bg border border-warning-border rounded-lg">
                <p class="text-sm text-warning">
                    For your security, this account is locked for a short time.
                </p>
            </div>

            <p class="text-sm text-text-primary mb-4">
                You can try again in @Model.LockoutDuration. If you need access sooner, ask an administrator to help.
            </p>

            <a asp-page="/Account/Login" class="btn btn-primary w-full">
                Return to sign in
            </a>
        </div>
    </main>

</body>
</html>

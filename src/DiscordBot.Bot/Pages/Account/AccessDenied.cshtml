@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" theme-root>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <partial name="_ThemeHead" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] - Discord Bot Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" />
    <!-- Typefaces: Bricolage Grotesque (display), DM Sans (body), JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-bg-primary text-text-primary flex items-center justify-center px-4 py-8 font-sans">

    <main class="w-full max-w-md">
        <!-- Icon and heading -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-error rounded-xl mb-4">
                <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-text-primary">You don't have access to this page</h1>
            <p class="text-text-secondary mt-2">Your account isn't allowed to open it.</p>
        </div>

        <!-- Message Card -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 shadow-lg">
            <p class="text-sm text-text-primary mb-4">
                This page is limited to people with a different role. If you think you should be able to use it, ask an administrator to check your access.
            </p>

            @if (!string.IsNullOrEmpty(Model.ReturnUrl))
            {
                <p class="text-xs text-text-secondary mb-6">
                    Page you tried to open: <span class="font-mono break-all">@Model.ReturnUrl</span>
                </p>
            }

            <div class="flex flex-col sm:flex-row gap-3">
                <a asp-page="/Index" class="btn btn-primary flex-1">
                    Go to dashboard
                </a>
                <form method="post" asp-page="/Account/Logout" class="flex-1 flex" data-submit-guard>
                    <button type="submit" class="btn btn-secondary flex-1" data-loading-text="Signing out…">
                        Sign out
                    </button>
                </form>
            </div>
        </div>
    </main>

    <script src="~/js/loading-manager.js" asp-append-version="true"></script>
</body>
</html>

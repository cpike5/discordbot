@inject DiscordBot.Core.Interfaces.IVersionService VersionService
@inject Microsoft.Extensions.Options.IOptions<DiscordBot.Core.Configuration.ObservabilityOptions> ObservabilityOptions
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    bool IsPage(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
    bool StartsWith(string prefix) => currentPage.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    var dashboardActive = IsPage("/Index");
    var guildsActive = StartsWith("/Guilds");
    var commandsActive = StartsWith("/Commands") || StartsWith("/CommandLogs");
    var ratWatchAnalyticsActive = IsPage("/Admin/RatWatchAnalytics");
    var performanceActive = StartsWith("/Admin/Performance");
    var settingsActive = IsPage("/Admin/Settings");
    var usersActive = StartsWith("/Admin/Users");
    var logsActive = StartsWith("/Admin/Logs") || StartsWith("/Admin/MessageLogs") || StartsWith("/Admin/AuditLogs");
    var notificationsActive = StartsWith("/Admin/Notifications");
    var bulkPurgeActive = IsPage("/Admin/BulkPurge");
    var userPurgeActive = IsPage("/Admin/UserPurge");
    var componentsActive = IsPage("/Components");
}
<!-- Sidebar Rail -->
<aside
  id="sidebar"
  class="sidebar-redesign transform -translate-x-full lg:translate-x-0"
  aria-label="Main navigation"
>
  <!-- Brand -->
  <div class="sidebar-brand">
    <a href="/" class="sidebar-brand-link" aria-label="Bot Admin home">
      <img src="~/images/logo.svg" alt="" class="sidebar-brand-mark" />
      <span class="sidebar-logo-text">
        <span class="sidebar-logo-title">Bot Admin</span>
        <span class="sidebar-logo-sub">Control Console</span>
      </span>
    </a>
    <button type="button" class="sidebar-close lg:hidden" onclick="toggleMobileSidebar()" aria-label="Close menu">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="Primary">
    <!-- Main Navigation -->
    <div class="sidebar-group" role="group" aria-labelledby="main-nav-heading">
      <h2 id="main-nav-heading" class="sidebar-section-header">Overview</h2>

      <!-- Dashboard - visible to all authenticated users -->
      <a href="/" class="sidebar-link-redesign @(dashboardActive ? "active" : "")" title="Dashboard" @(dashboardActive ? "aria-current=page" : "")>
        <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 5.5A1.5 1.5 0 015.5 4h4A1.5 1.5 0 0111 5.5v4A1.5 1.5 0 019.5 11h-4A1.5 1.5 0 014 9.5v-4zM13 5.5A1.5 1.5 0 0114.5 4h4A1.5 1.5 0 0120 5.5v2A1.5 1.5 0 0118.5 9h-4A1.5 1.5 0 0113 7.5v-2zM4 14.5A1.5 1.5 0 015.5 13h4a1.5 1.5 0 011.5 1.5v4A1.5 1.5 0 019.5 20h-4A1.5 1.5 0 014 18.5v-4zM13 12.5a1.5 1.5 0 011.5-1.5h4a1.5 1.5 0 011.5 1.5v6a1.5 1.5 0 01-1.5 1.5h-4a1.5 1.5 0 01-1.5-1.5v-6z" />
        </svg>
        <span class="sidebar-link-text">Dashboard</span>
      </a>

      <!-- Servers - visible to Moderator+ -->
      <authorize policy="RequireModerator">
        <a href="/Guilds" class="sidebar-link-redesign @(guildsActive ? "active" : "")" title="Servers" @(guildsActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
          <span class="sidebar-link-text">Servers</span>
        </a>
      </authorize>

      <!-- Commands - visible to Viewer+ -->
      <authorize policy="RequireViewer">
        <a href="/Commands" class="sidebar-link-redesign @(commandsActive ? "active" : "")" title="Commands" @(commandsActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="sidebar-link-text">Commands</span>
        </a>
      </authorize>

      <!-- Bot Performance - visible to Viewer+ -->
      <authorize policy="RequireViewer">
        <a href="/Admin/Performance" class="sidebar-link-redesign @(performanceActive ? "active" : "")" title="Bot Performance" @(performanceActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 17l5-6 4 3 4-6 5 4M3 21h18" />
          </svg>
          <span class="sidebar-link-text">Bot Performance</span>
        </a>
      </authorize>

      <!-- Rat Watch Analytics - visible to Admin+ -->
      <authorize policy="RequireAdmin">
        <a href="/Admin/RatWatchAnalytics" class="sidebar-link-redesign @(ratWatchAnalyticsActive ? "active" : "")" title="Rat Watch Analytics" @(ratWatchAnalyticsActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span class="sidebar-link-text">Rat Watch Analytics</span>
        </a>
      </authorize>

      <!-- Settings - visible to Admin+ -->
      <authorize policy="RequireAdmin">
        <a href="/Admin/Settings" class="sidebar-link-redesign @(settingsActive ? "active" : "")" title="Settings" @(settingsActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="sidebar-link-text">Settings</span>
        </a>
      </authorize>
    </div>

    <!-- Admin Section - visible to Admin+ -->
    <authorize policy="RequireAdmin">
      <div class="sidebar-group" role="group" aria-labelledby="admin-nav-heading">
        <h2 id="admin-nav-heading" class="sidebar-section-header">Administration</h2>
        <a href="/Admin/Users" class="sidebar-link-redesign @(usersActive ? "active" : "")" title="Users" @(usersActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span class="sidebar-link-text">Users</span>
        </a>
        <a href="/Admin/Logs" class="sidebar-link-redesign @(logsActive ? "active" : "")" title="Logs" @(logsActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="sidebar-link-text">Logs</span>
        </a>
        <a href="/Admin/Notifications" class="sidebar-link-redesign @(notificationsActive ? "active" : "")" title="Notifications" @(notificationsActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span class="sidebar-link-text">Notifications</span>
        </a>
        <authorize policy="RequireSuperAdmin">
          <a href="/Admin/BulkPurge" class="sidebar-link-redesign @(bulkPurgeActive ? "active" : "")" title="Bulk Purge" @(bulkPurgeActive ? "aria-current=page" : "")>
            <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span class="sidebar-link-text">Bulk Purge</span>
          </a>
          <a href="/Admin/UserPurge" class="sidebar-link-redesign @(userPurgeActive ? "active" : "")" title="User Purge" @(userPurgeActive ? "aria-current=page" : "")>
            <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="sidebar-link-text">User Purge</span>
          </a>
        </authorize>
      </div>
    </authorize>

    <!-- Developer Tools - visible to Admin+ -->
    <authorize policy="RequireAdmin">
      <div class="sidebar-group" role="group" aria-labelledby="dev-nav-heading">
        <h2 id="dev-nav-heading" class="sidebar-section-header">Developer</h2>
        <a href="/Components" class="sidebar-link-redesign @(componentsActive ? "active" : "")" title="Components" @(componentsActive ? "aria-current=page" : "")>
          <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span class="sidebar-link-text">Components</span>
        </a>
        @if (!string.IsNullOrEmpty(ObservabilityOptions.Value.KibanaUrl))
        {
          <a href="@ObservabilityOptions.Value.KibanaUrl" target="_blank" rel="noopener noreferrer" class="sidebar-link-redesign" title="Kibana">
            <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span class="sidebar-link-text">Kibana</span>
            <svg class="sidebar-link-ext" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        }
        @if (!string.IsNullOrEmpty(ObservabilityOptions.Value.SeqUrl))
        {
          <a href="@ObservabilityOptions.Value.SeqUrl" target="_blank" rel="noopener noreferrer" class="sidebar-link-redesign" title="Seq">
            <svg class="sidebar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="sidebar-link-text">Seq</span>
            <svg class="sidebar-link-ext" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        }
      </div>
    </authorize>
  </nav>

  <!-- Bot Status Footer -->
  <div class="sidebar-footer bot-status-footer" role="status" aria-label="Bot status">
    <div class="bot-status-container">
      <div class="bot-status-led-wrap" aria-hidden="true">
        <span class="bot-status-led"></span>
      </div>
      <div class="bot-status-text">
        <p class="bot-status-name">Bot Online</p>
        <p class="bot-status-version">@VersionService.GetVersion()</p>
      </div>
    </div>
  </div>
</aside>

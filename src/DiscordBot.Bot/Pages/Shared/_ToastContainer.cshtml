@using DiscordBot.Bot.Extensions
@*
    Toast container, rendered once by every layout. toast.js owns it.

    From JavaScript:   toast.success('Saved.');  toast.error('Could not save.', { action: { label: 'Retry', onClick: retry } });
    From a page model: TempData.SetSuccessToast("Saved.");  (shown on the next render, after a redirect or on Page())
*@
<div id="toastContainer" class="toast-container" role="region" aria-label="Notifications">
    <div id="toastLiveRegion" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    <div id="toastAlertRegion" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
</div>

@{
    var serverToasts = TempData.TakeToasts();
}
@if (serverToasts.Count > 0)
{
    @* JSON in a data block, not executable script: toast.js reads it on load *@
    <script type="application/json" id="serverToasts">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        serverToasts.Select(t => new { type = t.Type, message = t.Message, title = t.Title }),
        new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }))</script>
}

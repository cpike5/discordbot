<!-- Top Bar -->
<header class="topbar navbar-redesign" id="topbar">
  <!-- Left: menu toggles + mobile brand -->
  <div class="topbar-left">
    <!-- Mobile Menu Toggle -->
    <button
      id="sidebarToggle"
      type="button"
      onclick="toggleMobileSidebar()"
      class="topbar-icon-btn lg:hidden"
      aria-label="Toggle sidebar menu"
      aria-expanded="false"
      aria-controls="sidebar"
    >
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Desktop Sidebar Collapse Toggle -->
    <button
      id="sidebarCollapseToggle"
      type="button"
      onclick="toggleSidebarCollapse()"
      class="topbar-icon-btn hidden lg:inline-flex"
      aria-label="Toggle sidebar"
      title="Collapse sidebar"
    >
      <svg class="transition-transform" id="sidebarCollapseIcon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
      </svg>
    </button>

    <!-- Brand (mobile only — the sidebar carries it on desktop) -->
    <a href="/" class="topbar-brand lg:hidden">
      <img src="~/images/logo.svg" alt="" />
      <span class="hidden sm:block">Bot Admin</span>
    </a>
  </div>

  <!-- Center: Search -->
  <form class="topbar-search hidden md:block" role="search" asp-page="/Search" method="get">
    <div class="search-container relative w-full">
      <svg class="topbar-search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <label for="navbar-search" class="sr-only">Search servers, commands, logs</label>
      <input
        type="search"
        id="navbar-search"
        name="q"
        placeholder="Search servers, commands, logs…"
        class="topbar-search-input"
        autocomplete="off"
      />
      <!-- Keyboard Shortcut Hint (desktop only) -->
      <div class="topbar-search-kbd">
        <kbd class="search-kbd">
          <span id="kbd-mac" class="hidden">⌘</span>
          <span id="kbd-other">Ctrl</span>
        </kbd>
        <kbd class="search-kbd">K</kbd>
      </div>
    </div>
  </form>

  <!-- Right: Actions & User Menu -->
  <div class="topbar-right">
    <!-- Mobile Search Toggle -->
    <button type="button" onclick="toggleMobileSearch()" class="topbar-icon-btn md:hidden" aria-label="Search">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </button>

    <!-- Connection status is shown via toast notifications (see dashboard-realtime.js) -->

    <!-- Notification Bell -->
    <div class="relative">
      <button
        id="notificationBellButton"
        type="button"
        onclick="NotificationBell.toggle()"
        class="topbar-icon-btn"
        aria-label="Notifications"
        aria-expanded="false"
        aria-haspopup="menu"
        aria-controls="notificationDropdown"
      >
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <span id="notificationBadge" class="notification-badge hidden" aria-label="0 unread notifications">0</span>
      </button>

      <!-- Notification Dropdown -->
      <div id="notificationDropdown" class="notification-dropdown" role="menu" aria-label="Notifications menu">
        <!-- Header -->
        <div class="notification-dropdown-header">
          <h3 class="text-sm font-semibold text-text-primary">Notifications</h3>
          <button
            type="button"
            onclick="NotificationBell.markAllAsRead()"
            class="notification-mark-all-read"
            aria-label="Mark all as read"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Mark all read</span>
          </button>
        </div>

        <!-- Notification List -->
        <div id="notificationList" class="notification-list" role="list">
          <!-- Notifications will be rendered here by JavaScript -->
        </div>
      </div>

      <!-- Screen reader announcements -->
      <div id="notificationAnnouncer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    </div>

    <!-- Authentication Section -->
    @if (SignInManager.IsSignedIn(User))
    {
      var user = await UserManager.GetUserAsync(User);
      var displayName = user?.DisplayName ?? user?.Email ?? "User";
      var initials = string.Join("", displayName.Split(' ').Take(2).Select(w => w.FirstOrDefault())).ToUpper();
      var avatarUrl = user?.DiscordAvatarUrl;

      <div class="topbar-divider hidden sm:block"></div>

      <!-- User Menu Dropdown -->
      <div class="relative">
        <button
          id="userMenuButton"
          type="button"
          onclick="toggleUserMenu()"
          class="topbar-user"
          aria-label="User menu"
          aria-expanded="false"
          aria-haspopup="menu"
          aria-controls="userMenu"
        >
          @if (!string.IsNullOrEmpty(avatarUrl))
          {
            <img src="@avatarUrl" alt="" class="topbar-avatar" />
          }
          else
          {
            <span class="topbar-avatar" aria-hidden="true">@initials</span>
          }
          <span class="topbar-user-name">@displayName</span>
          <svg class="topbar-user-caret" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div id="userMenu" class="user-menu-dropdown" role="menu" aria-label="User menu options">
          <div class="user-menu-header">
            <p class="user-menu-name">@displayName</p>
            <p class="user-menu-email">@user?.Email</p>
          </div>
          <a asp-page="/Account/Profile" role="menuitem" class="user-menu-item">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Profile
          </a>
          <a asp-page="/Account/Privacy" role="menuitem" class="user-menu-item">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Privacy &amp; Consent
          </a>
          <form asp-page="/Account/Logout" asp-page-handler="Post" method="post" class="block">
            <button type="submit" role="menuitem" class="user-menu-item danger">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Sign out
            </button>
          </form>
        </div>
      </div>
    }
    else
    {
      <!-- Login Button -->
      <a asp-page="/Account/Login" class="btn btn-primary btn-sm ml-2">Sign In</a>
    }
  </div>
</header>

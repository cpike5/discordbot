@model string?
@*
    Header button that switches between the dark and the light theme (UX decision D5).
    wwwroot/js/theme.js wires it up and names it for the theme it switches to; the icon follows
    data-theme in CSS (.theme-toggle). A signed-in user's choice is also saved to their account.
    Model: extra classes for the button, so it can match the header it sits in.
*@
<button type="button"
        class="theme-toggle @Model"
        data-theme-toggle
        data-theme-persist="@(User.Identity?.IsAuthenticated == true ? "true" : "false")"
        aria-label="Switch theme"
        title="Switch theme">
    @* Shown in the dark theme: switch to light *@
    <svg class="theme-toggle-icon-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    @* Shown in the light theme: switch to dark *@
    <svg class="theme-toggle-icon-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
</button>

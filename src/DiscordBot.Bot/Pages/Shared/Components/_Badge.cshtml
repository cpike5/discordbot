@model DiscordBot.Bot.ViewModels.Components.BadgeViewModel
@using DiscordBot.Bot.ViewModels.Components
@{
    // Badges are soft tints by default (see .badge-* in site.css). Outline drops
    // the fill; Subtle drops the hairline. Add "badge-solid" via markup when a
    // filled badge is genuinely needed.
    var sizeClass = Model.Size switch
    {
        BadgeSize.Small => "badge-sm",
        BadgeSize.Large => "badge-lg",
        _ => ""
    };

    var variantClass = Model.Variant switch
    {
        BadgeVariant.Orange => "badge-orange",
        BadgeVariant.Blue => "badge-blue",
        BadgeVariant.Success => "badge-success",
        BadgeVariant.Warning => "badge-warning",
        BadgeVariant.Error => "badge-error",
        BadgeVariant.Info => "badge-info",
        _ => "badge-gray"
    };

    var styleClass = Model.Style switch
    {
        BadgeStyle.Outline => "badge-outline",
        BadgeStyle.Subtle => "badge-subtle",
        _ => ""
    };

    var classes = string.Join(" ", new[] { "badge", variantClass, styleClass, sizeClass }.Where(c => !string.IsNullOrEmpty(c)));
}

<span class="@classes">
    @if (!string.IsNullOrEmpty(Model.IconLeft))
    {
        <svg fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="@Model.IconLeft" clip-rule="evenodd" />
        </svg>
    }
    @Model.Text
    @if (Model.IsRemovable)
    {
        <button
            type="button"
            class="badge-remove"
            aria-label="Remove"
            @if (!string.IsNullOrEmpty(Model.OnRemove))
            {
                @:onclick="@Model.OnRemove"
            }
        >
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    }
</span>

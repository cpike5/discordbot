@model DiscordBot.Bot.ViewModels.Components.CurrencyWalletPanelViewModel

<div id="currency-wallet-panel" class="grid grid-cols-1 xl:grid-cols-5 gap-4"
     data-currency-id="@(Model.CurrencyId?.ToString() ?? string.Empty)"
     data-currency-symbol="@Model.CurrencySymbol"
     data-can-mint="@Model.CanMint.ToString().ToLowerInvariant()"
     data-can-fine="@Model.CanFine.ToString().ToLowerInvariant()"
     data-can-administer="@Model.CanAdminister.ToString().ToLowerInvariant()">

    <!-- Holders -->
    <section class="xl:col-span-2 bg-bg-secondary border border-border-primary rounded-lg" aria-labelledby="wallet-list-heading">
        <div class="px-4 py-3 border-b border-border-primary">
            <div class="flex items-center justify-between gap-3 mb-3">
                <h2 id="wallet-list-heading" class="text-base font-semibold text-text-primary">Holders</h2>
                <div class="flex items-center gap-2">
                    @if (Model.CanMint)
                    {
                        <button type="button" data-wallet-action="mint"
                                class="px-3 py-1.5 text-xs font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
                            Mint
                        </button>
                    }
                    <button type="button" data-wallet-action="refresh"
                            class="px-3 py-1.5 text-xs font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                        Refresh
                    </button>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <label class="sr-only" for="wallet-search">Search holders</label>
                <input type="search" id="wallet-search" placeholder="Search holders…"
                       class="flex-1 min-w-0 px-3 py-2 text-sm bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                <label class="flex items-center gap-2 text-xs text-text-secondary whitespace-nowrap cursor-pointer">
                    <input type="checkbox" id="wallet-debtors-only"
                           class="w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange" />
                    In debt only
                </label>
            </div>
        </div>

        <div id="wallet-list" class="divide-y divide-border-primary max-h-[32rem] overflow-y-auto">
            <p class="px-4 py-6 text-sm text-text-secondary">Loading holders…</p>
        </div>
    </section>

    <!-- Ledger -->
    <section class="xl:col-span-3 bg-bg-secondary border border-border-primary rounded-lg" aria-labelledby="ledger-heading">
        <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-b border-border-primary">
            <div class="min-w-0">
                <h2 id="ledger-heading" class="text-base font-semibold text-text-primary">Ledger</h2>
                <p id="ledger-subject" class="text-xs text-text-tertiary">Select a holder to read their history.</p>
            </div>
            <div class="flex items-center gap-2">
                @if (Model.CanFine)
                {
                    <button type="button" data-wallet-action="fine" disabled
                            class="px-3 py-1.5 text-xs font-medium text-error border border-error/40 rounded-md hover:bg-error/10 transition-colors disabled:opacity-40 disabled:hover:bg-transparent">
                        Fine
                    </button>
                }
            </div>
        </div>

        <div id="ledger-rows" class="divide-y divide-border-primary max-h-[32rem] overflow-y-auto">
            <p class="px-4 py-6 text-sm text-text-secondary">No holder selected.</p>
        </div>

        <div id="ledger-pager" class="hidden flex items-center justify-between gap-3 px-4 py-3 border-t border-border-primary">
            <button type="button" data-wallet-action="ledger-prev"
                    class="px-3 py-1.5 text-xs font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors disabled:opacity-40">
                Previous
            </button>
            <span id="ledger-page-label" class="text-xs text-text-tertiary"></span>
            <button type="button" data-wallet-action="ledger-next"
                    class="px-3 py-1.5 text-xs font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors disabled:opacity-40">
                Next
            </button>
        </div>
    </section>
</div>

<!-- Balance action modal: mint, fine and adjust share one form -->
<div id="wallet-action-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="wallet-action-title">
    <div class="bg-bg-secondary border border-border-primary rounded-lg w-full max-w-md max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border-primary">
            <h3 id="wallet-action-title" class="text-base font-semibold text-text-primary">Mint</h3>
            <button type="button" data-wallet-action="close-modal" class="text-text-tertiary hover:text-text-primary" aria-label="Close">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form id="wallet-action-form" class="px-5 py-4 space-y-4" novalidate>
            <p id="wallet-action-help" class="text-sm text-text-secondary"></p>
            <div id="wallet-action-error" class="hidden text-sm text-error bg-error/10 border border-error/40 rounded-md px-3 py-2"></div>

            <div id="wallet-action-user-row">
                <label for="wallet-action-user" class="block text-sm font-medium text-text-secondary mb-1">Discord user ID</label>
                <input type="text" id="wallet-action-user" inputmode="numeric"
                       class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
            </div>

            <div>
                <label for="wallet-action-amount" class="block text-sm font-medium text-text-secondary mb-1">Amount</label>
                <input type="number" id="wallet-action-amount" step="1"
                       class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                <p id="wallet-action-amount-help" class="text-xs text-text-tertiary mt-1"></p>
            </div>

            <div>
                <label for="wallet-action-reason" class="block text-sm font-medium text-text-secondary mb-1">Reason</label>
                <input type="text" id="wallet-action-reason" maxlength="512"
                       class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
            </div>

            <label id="wallet-action-case-row" class="hidden items-start gap-2 cursor-pointer">
                <input type="checkbox" id="wallet-action-case"
                       class="mt-1 w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange" />
                <span>
                    <span class="block text-sm text-text-primary">Also open a mod case</span>
                    <span class="block text-xs text-text-tertiary">Creates a Note case carrying the fine reason, so the ledger and the case history agree.</span>
                </span>
            </label>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" data-wallet-action="close-modal"
                        class="px-4 py-2 text-sm font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                    Cancel
                </button>
                <button type="submit" id="wallet-action-submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
                    Confirm
                </button>
            </div>
        </form>
    </div>
</div>

@model DiscordBot.Bot.ViewModels.Components.CurrencyWalletPanelViewModel
@using DiscordBot.Bot.ViewModels.Components
@{
    // Mint and fine name a member: search for them rather than typing a Discord ID
    var holderPicker = new AutocompleteInputViewModel
    {
        Id = "wallet-action-user",
        Name = "wallet-action-user",
        Label = "Member",
        Placeholder = "Search by username...",
        Endpoint = "/api/autocomplete/users",
        GuildIdSourceElement = Model.GuildId.HasValue ? "wallet-guild-source" : null,
        NoResultsMessage = "No members found",
        HelpText = "Only people the bot has seen in a logged message can be found by name."
    };
}

<div id="currency-wallet-panel" class="grid grid-cols-1 xl:grid-cols-5 gap-4"
     data-currency-id="@(Model.CurrencyId?.ToString() ?? string.Empty)"
     data-currency-symbol="@Model.CurrencySymbol"
     data-can-mint="@Model.CanMint.ToString().ToLowerInvariant()"
     data-can-fine="@Model.CanFine.ToString().ToLowerInvariant()"
     data-can-administer="@Model.CanAdminister.ToString().ToLowerInvariant()">

    <!-- Holders -->
    <section class="xl:col-span-2 bg-bg-secondary border border-border-primary rounded-lg" aria-labelledby="wallet-list-heading">
        <div class="px-4 py-3 border-b border-border-primary">
            <div class="flex items-center justify-between gap-3 mb-3">
                <h2 id="wallet-list-heading" class="text-base font-semibold text-text-primary">Holders</h2>
                <div class="flex items-center gap-2">
                    @if (Model.CanMint)
                    {
                        <button type="button" data-wallet-action="mint" class="btn btn-primary btn-sm"
                                @(Model.CurrencyId.HasValue ? null : "disabled")
                                title="@(Model.CurrencyId.HasValue ? "Mint units" : "Pick a currency first")">
                            Mint
                        </button>
                    }
                    <button type="button" data-wallet-action="refresh" class="btn btn-secondary btn-sm">Refresh</button>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <label class="sr-only" for="wallet-search">Search holders</label>
                <input type="search" id="wallet-search" placeholder="Search holders…" autocomplete="off" class="form-input flex-1 min-w-0" />
                <label class="flex items-center gap-2 text-xs text-text-secondary whitespace-nowrap cursor-pointer">
                    <input type="checkbox" id="wallet-debtors-only"
                           class="w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange" />
                    In debt only
                </label>
            </div>
        </div>

        <div id="wallet-list" class="divide-y divide-border-primary max-h-[32rem] overflow-y-auto">
            <p class="px-4 py-6 text-sm text-text-secondary">Select a currency to see its holders.</p>
        </div>
    </section>

    <!-- Ledger -->
    <section class="xl:col-span-3 bg-bg-secondary border border-border-primary rounded-lg" aria-labelledby="ledger-heading">
        <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-b border-border-primary">
            <div class="min-w-0">
                <h2 id="ledger-heading" tabindex="-1" class="text-base font-semibold text-text-primary">Ledger</h2>
                <p id="ledger-subject" class="text-xs text-text-tertiary">Select a holder to read their history.</p>
            </div>
            <div class="flex items-center gap-2">
                @if (Model.CanFine)
                {
                    <button type="button" data-wallet-action="fine" disabled class="btn btn-danger btn-sm" title="Select a holder first">Fine</button>
                }
            </div>
        </div>

        <div id="ledger-rows" class="divide-y divide-border-primary max-h-[32rem] overflow-y-auto">
            <p class="px-4 py-6 text-sm text-text-secondary">No holder selected.</p>
        </div>

        <div id="ledger-pager" class="hidden flex items-center justify-between gap-3 px-4 py-3 border-t border-border-primary">
            <button type="button" data-wallet-action="ledger-prev" class="btn btn-secondary btn-sm">Previous</button>
            <span id="ledger-page-label" class="text-xs text-text-tertiary" role="status"></span>
            <button type="button" data-wallet-action="ledger-next" class="btn btn-secondary btn-sm">Next</button>
        </div>
    </section>
</div>

<!-- Balance action dialog: mint, fine and adjust share one form. A quickActions dialog. -->
<div id="wallet-action-modal" class="hidden fixed inset-0 z-[var(--z-modal)]" role="dialog" aria-modal="true" aria-labelledby="wallet-action-title">
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm qa-modal-backdrop" data-modal-dismiss aria-hidden="true"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="bg-bg-tertiary border border-border-primary rounded-lg shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto qa-modal-panel pointer-events-auto" role="document">
            <div class="flex items-center justify-between px-5 py-4 border-b border-border-primary">
                <h2 id="wallet-action-title" class="text-base font-semibold text-text-primary">Mint</h2>
                <button type="button" data-modal-dismiss class="btn btn-ghost btn-icon" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <form id="wallet-action-form" class="px-5 py-4 space-y-4" novalidate>
                <p id="wallet-action-help" class="text-sm text-text-secondary"></p>
                <div id="wallet-action-error" class="hidden text-sm text-error bg-error/10 border border-error/40 rounded-md px-3 py-2" role="alert"></div>

                @if (Model.GuildId.HasValue)
                {
                    <input type="hidden" id="wallet-guild-source" value="@Model.GuildId" />
                }

                <div id="wallet-action-user-row">
                    <partial name="Shared/Components/_AutocompleteInput" model="holderPicker" />
                </div>

                <div>
                    <label for="wallet-action-amount" class="block text-sm font-medium text-text-secondary mb-1">Amount</label>
                    <input type="number" id="wallet-action-amount" step="1" inputmode="numeric" class="form-input w-full" />
                    <p id="wallet-action-amount-help" class="text-xs text-text-tertiary mt-1"></p>
                </div>

                <div>
                    <label for="wallet-action-reason" class="block text-sm font-medium text-text-secondary mb-1">Reason</label>
                    <input type="text" id="wallet-action-reason" maxlength="512" autocomplete="off" class="form-input w-full" />
                </div>

                <label id="wallet-action-case-row" class="hidden items-start gap-2 cursor-pointer">
                    <input type="checkbox" id="wallet-action-case" class="mt-1 w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange" />
                    <span>
                        <span class="block text-sm text-text-primary">Also open a mod case</span>
                        <span class="block text-xs text-text-tertiary">Creates a Note case carrying the fine reason, so the ledger and the case history agree.</span>
                    </span>
                </label>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" data-modal-dismiss class="btn btn-secondary">Cancel</button>
                    <button type="submit" id="wallet-action-submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

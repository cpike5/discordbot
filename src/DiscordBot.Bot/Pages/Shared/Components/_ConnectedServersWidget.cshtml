@model DiscordBot.Bot.ViewModels.Components.ConnectedServersWidgetViewModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Components.Enums
@*
    One row layout for every width: a grid at md and up (with a header row), a stacked card below
    it. The rows are also drawn from script after "Sync All" (wwwroot/js/dashboard-actions.js
    clones #connected-server-template), so a change to the row markup belongs in both. The caller
    decides who sees the card; there is no role check in here.
*@
@functions {
    private static (string Badge, string Title) StatusStyle(ServerConnectionStatus status) => status switch
    {
        ServerConnectionStatus.Online => ("badge-success", "Ran commands today"),
        ServerConnectionStatus.Idle => ("badge-warning", "Active, no commands today"),
        _ => ("badge-gray", "The bot is no longer in this server")
    };
}

<template id="connected-server-template">
    <li class="connected-server" data-row>
        <div class="connected-server-main">
            <span class="connected-server-avatar" data-field="avatar" aria-hidden="true"></span>
            <a class="connected-server-link" data-field="link" href="#"><span data-field="name"></span></a>
        </div>
        <div class="connected-server-meta">
            <span class="connected-server-cell"><span class="connected-server-label">Members</span><span data-field="members"></span></span>
            <span class="connected-server-cell"><span class="connected-server-label">Status</span><span class="badge" data-field="status"></span></span>
            <span class="connected-server-cell"><span class="connected-server-label">Commands today</span><span data-field="commands"></span></span>
        </div>
        <div class="connected-server-actions row-actions">
            <button type="button" class="btn btn-ghost btn-icon btn-sm" data-copy-server-id data-field="copy">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
            </button>
        </div>
    </li>
</template>

<section class="card connected-servers h-full flex flex-col overflow-hidden" id="connected-servers" aria-labelledby="connected-servers-title">
    <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-4 border-b border-border-primary">
        <h2 id="connected-servers-title" class="text-lg font-semibold text-text-primary">@Model.Title</h2>
        <a href="@Model.ViewAllUrl" class="text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors" id="connected-servers-view-all">
            @(Model.ShowViewAll ? $"View all {DisplayFormat.Number(Model.TotalServerCount)}" : "View all")
        </a>
    </div>

    <div class="connected-servers-head" id="connected-servers-head" aria-hidden="true" @(Model.Servers.Any() ? "" : "hidden")>
        <span>Server</span>
        <span>Members</span>
        <span>Status</span>
        <span>Commands today</span>
        <span></span>
    </div>

    <ul class="connected-servers-list flex-grow" id="connected-servers-list" role="list" @(Model.Servers.Any() ? "" : "hidden")>
        @foreach (var server in Model.Servers)
        {
            var (badge, statusTitle) = StatusStyle(server.Status);
            <li class="connected-server" data-row data-server-id="@server.Id">
                <div class="connected-server-main">
                    @if (!string.IsNullOrEmpty(server.IconUrl))
                    {
                        <span class="connected-server-avatar" data-field="avatar" aria-hidden="true"><img src="@server.IconUrl" alt="" loading="lazy" /></span>
                    }
                    else
                    {
                        <span class="connected-server-avatar text-white @server.AvatarClass" data-field="avatar" aria-hidden="true">@server.Initials</span>
                    }
                    <a class="connected-server-link" data-field="link" href="@server.DetailUrl"><span data-field="name">@server.Name</span></a>
                </div>
                <div class="connected-server-meta">
                    <span class="connected-server-cell"><span class="connected-server-label">Members</span><span data-field="members">@DisplayFormat.Number(server.MemberCount)</span></span>
                    <span class="connected-server-cell"><span class="connected-server-label">Status</span><span class="badge @badge" data-field="status" title="@statusTitle">@server.Status</span></span>
                    <span class="connected-server-cell"><span class="connected-server-label">Commands today</span><span data-field="commands">@DisplayFormat.Number(server.CommandsToday)</span></span>
                </div>
                <div class="connected-server-actions row-actions">
                    <button type="button" class="btn btn-ghost btn-icon btn-sm" data-copy-server-id="@server.Id" data-field="copy" aria-label="Copy server ID for @server.Name" title="Copy server ID">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                    </button>
                </div>
            </li>
        }
    </ul>

    <div id="connected-servers-empty" class="flex-grow flex items-center" @(Model.Servers.Any() ? "hidden" : "")>
        <partial name="Shared/Components/_EmptyState" model="@(new EmptyStateViewModel
        {
            Type = EmptyStateType.NoData,
            Title = "No servers yet",
            Description = "Servers appear here once the bot joins them.",
            IconSvgPath = "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
            Size = EmptyStateSize.Compact,
            HeadingLevel = 3
        })" />
    </div>
</section>

@model bool
@* "Restart required" notice for the Settings page. The model says whether a restart is already
   pending when the page is drawn; when it is not, the banner is rendered hidden so settings.js
   can show it the moment a save reports that a restart is needed, without reloading the page.
   The link goes to the Bot Control tab; settings.js switches tabs in place when it is already
   on that page. *@
<authorize policy="RequireAdmin">
    <div id="restartBanner" class="mb-6 bg-warning/10 border-2 border-warning rounded-lg p-4 @(Model ? "" : "hidden")" role="status" data-restart-banner>
        <div class="flex items-start gap-3">
            <svg class="w-6 h-6 flex-shrink-0 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div class="flex-1 min-w-0">
                <h2 class="text-base font-semibold text-warning mb-1">Restart needed</h2>
                <p class="text-sm text-text-primary mb-3">
                    Some saved settings only take effect after the bot restarts. Restart it from the Bot Control tab when you are ready.
                </p>
                <a asp-page="/Admin/Settings" asp-route-category="BotControl" data-settings-tab-link="BotControl"
                   class="btn bg-warning hover:bg-warning-hover active:bg-warning-active text-on-warning">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Go to Bot Control
                </a>
            </div>
        </div>
    </div>
</authorize>

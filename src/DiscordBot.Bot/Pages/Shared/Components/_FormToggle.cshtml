@model DiscordBot.Bot.ViewModels.Components.FormToggleViewModel
@{
    var descriptionId = $"{Model.Id}-desc";
    var hasDescription = !string.IsNullOrEmpty(Model.Description);
}

<div class="flex items-start gap-4">
    <label class="toggle @(Model.IsDisabled ? "toggle-disabled" : "")">
        <input type="checkbox"
               id="@Model.Id"
               name="@Model.Name"
               class="toggle-input"
               role="switch"
               value="true"
               @if (Model.IsChecked)
               {
                   @:checked
               }
               @if (Model.IsDisabled)
               {
                   @:disabled
               }
               @if (hasDescription)
               {
                   @:aria-describedby="@descriptionId"
               }
               @if (Model.AdditionalAttributes != null)
               {
                   foreach (var attr in Model.AdditionalAttributes)
                   {
                       @Html.Raw($" {attr.Key}=\"{System.Net.WebUtility.HtmlEncode(attr.Value)}\"")
                   }
               } />
        <span class="toggle-slider" aria-hidden="true"></span>
    </label>
    @if (Model.PostsFalseWhenOff && !Model.IsDisabled && !string.IsNullOrEmpty(Model.Name))
    {
        @* After the checkbox on purpose: the binder takes the first value, so checked posts true. *@
        <input type="hidden" name="@Model.Name" value="false" />
    }

    @if (!string.IsNullOrEmpty(Model.Label) || hasDescription)
    {
        <div class="flex-1 min-w-0">
            @if (!string.IsNullOrEmpty(Model.Label))
            {
                <label for="@Model.Id" class="block text-sm font-semibold text-text-primary @(Model.IsDisabled ? "cursor-not-allowed opacity-60" : "cursor-pointer")">
                    @Model.Label
                </label>
            }
            @if (hasDescription)
            {
                <p id="@descriptionId" class="text-xs text-text-secondary mt-1">@Model.Description</p>
            }
        </div>
    }
</div>

@model DiscordBot.Bot.ViewModels.Components.ChartDataTableViewModel
@*
    The figures behind a chart, as a table that is visually hidden (sr-only wrapper) but read by screen
    readers. The chart's canvas names it with aria-describedby="@Model.Id". Rendered on the server
    from the same model the chart's JSON island comes from; cell text is encoded by Razor.
*@
@* The wrapper is what is visually hidden: a table ignores sr-only's 1px width and would widen the page *@
<div class="sr-only">
<table id="@Model.Id">
    <caption>@Model.Caption</caption>
    <thead>
        <tr>
            @foreach (var column in Model.Columns)
            {
                <th scope="col">@column</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                @for (var i = 0; i < row.Count; i++)
                {
                    if (i == 0)
                    {
                        <th scope="row">@row[i]</th>
                    }
                    else
                    {
                        <td>@row[i]</td>
                    }
                }
            </tr>
        }
    </tbody>
</table>
</div>

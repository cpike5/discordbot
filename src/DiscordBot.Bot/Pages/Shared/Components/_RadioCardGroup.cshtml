@model DiscordBot.Bot.ViewModels.Components.RadioCardGroupViewModel
@using DiscordBot.Bot.ViewModels.Components
@{
    var id = Model.ResolvedId;
    var columns = Math.Clamp(Model.Columns, 1, 4);
    var gridClass = columns switch
    {
        1 => "grid-cols-1",
        2 => "grid-cols-1 sm:grid-cols-2",
        3 => "grid-cols-1 sm:grid-cols-3",
        _ => "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
    };
    var invalid = !string.IsNullOrEmpty(Model.ValidationMessage);
    var describedBy = new List<string>();
    if (!string.IsNullOrEmpty(Model.HelpText)) describedBy.Add($"{id}-help");
    if (invalid) describedBy.Add($"{id}-error");
}

<fieldset class="space-y-2 min-w-0 @(invalid ? "radio-card-group-invalid" : "")"
          @if (describedBy.Count > 0)
          {
              @:aria-describedby="@string.Join(" ", describedBy)"
          }>
    <legend class="form-label">
        @Model.Legend
        @if (Model.IsRequired)
        {
            <span class="text-error" aria-hidden="true">*</span>
        }
    </legend>

    @if (!string.IsNullOrEmpty(Model.HelpText))
    {
        <p id="@(id)-help" class="form-help">@Model.HelpText</p>
    }

    <div class="grid gap-3 @gridClass">
        @foreach (var option in Model.Options)
        {
            var card = option with { Name = Model.Name, IsChecked = Model.SelectedValue != null && option.Value == Model.SelectedValue };
            <partial name="Components/_RadioCard" model="card" />
        }
    </div>

    @if (invalid)
    {
        <p id="@(id)-error" class="form-error" role="alert">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @Model.ValidationMessage
        </p>
    }
</fieldset>

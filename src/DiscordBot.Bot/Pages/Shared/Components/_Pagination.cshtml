@model DiscordBot.Bot.ViewModels.Components.PaginationViewModel
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.WebUtilities
@using DiscordBot.Bot.ViewModels.Components
@{
    // Every state rule (empty, single page, page past the end, unknown total) lives on the
    // view model; this file only draws what it says.
    var currentPage = Model.EffectivePage;
    var showSummary = Model.Style == PaginationStyle.Full && Model.ShowItemCount;
    var showSelector = Model.Style == PaginationStyle.Full && Model.ShowsPageSizeSelector;
    var showNav = Model.HasMultiplePages;
    var uid = Guid.NewGuid().ToString("N")[..8];
}

@functions {
    private const string ChevronLeft = "M15 19l-7-7 7-7";
    private const string ChevronRight = "M9 5l7 7-7 7";
    private const string DoubleLeft = "M11 19l-7-7 7-7m8 14l-7-7 7-7";
    private const string DoubleRight = "M13 5l7 7-7 7M5 5l7 7-7 7";

    private static IHtmlContent Icon(string path) => new HtmlString(
        "<svg fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" aria-hidden=\"true\">" +
        $"<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"{path}\" /></svg>");

    private string StripQueryParam(string url, string paramName)
    {
        var queryIndex = url.IndexOf('?');
        if (queryIndex < 0) return url;
        var basePath = url.Substring(0, queryIndex);
        var pairs = url.Substring(queryIndex + 1).Split('&')
            .Where(p => !p.StartsWith(paramName + "=", StringComparison.OrdinalIgnoreCase))
            .ToArray();
        return pairs.Length == 0 ? basePath : basePath + "?" + string.Join("&", pairs);
    }

    private string BuildUrl(int pageNumber)
    {
        if (string.IsNullOrEmpty(Model.BaseUrl)) return "#";
        var baseUrl = StripQueryParam(Model.BaseUrl, Model.PageParameterName);
        var separator = baseUrl.Contains('?') ? "&" : "?";
        return $"{baseUrl}{separator}{Model.PageParameterName}={pageNumber}";
    }

    /// <summary>A Previous/Next/First/Last control: a link, or a disabled span at either end.</summary>
    private IHtmlContent Step(string css, string label, string? text, string iconPath, int target, bool disabled, string? rel, bool iconAfter = false)
    {
        var tag = new TagBuilder(disabled ? "span" : "a");
        tag.AddCssClass(css);
        tag.Attributes["aria-label"] = label;
        if (disabled)
        {
            tag.Attributes["aria-disabled"] = "true";
        }
        else
        {
            tag.Attributes["href"] = BuildUrl(target);
            if (rel != null) tag.Attributes["rel"] = rel;
        }

        if (!iconAfter) tag.InnerHtml.AppendHtml(Icon(iconPath));
        if (text != null) tag.InnerHtml.Append(text);
        if (iconAfter) tag.InnerHtml.AppendHtml(Icon(iconPath));
        return tag;
    }

    /// <summary>A numbered page: a link, or the current page marked with aria-current.</summary>
    private IHtmlContent PageItem(int number, string extraCss)
    {
        var current = number == Model.EffectivePage;
        var tag = new TagBuilder(current ? "span" : "a");
        // On a phone only the current page shows between Previous and Next; the rest would wrap
        tag.AddCssClass($"pagination-link {(current ? "" : "hidden sm:inline-flex")} {extraCss}".Replace("  ", " ").Trim());
        tag.Attributes["aria-label"] = $"Page {number}";
        if (current)
        {
            tag.Attributes["aria-current"] = "page";
        }
        else
        {
            tag.Attributes["href"] = BuildUrl(number);
        }

        tag.InnerHtml.Append(number.ToString());
        return tag;
    }

    private IHtmlContent Ellipsis()
    {
        var tag = new TagBuilder("span");
        tag.AddCssClass("pagination-ellipsis hidden sm:inline-flex");
        tag.Attributes["aria-hidden"] = "true";
        tag.InnerHtml.Append("…");
        return tag;
    }
}

@if (Model.Style == PaginationStyle.Simple)
{
    if (showNav)
    {
        <nav aria-label="@Model.AriaLabel" class="flex items-center gap-3">
            @Step("pagination-link pagination-link-boxed px-4", "Previous page", "Previous", ChevronLeft, currentPage - 1, Model.IsFirstPage, "prev")
            @Step("pagination-link pagination-link-boxed px-4", "Next page", "Next", ChevronRight, currentPage + 1, Model.IsLastPage, "next", iconAfter: true)
        </nav>
    }
}
else if (Model.Style == PaginationStyle.Compact)
{
    if (showNav)
    {
        <nav aria-label="@Model.AriaLabel" class="flex items-center justify-between gap-4">
            @Step("pagination-link pagination-link-boxed", "Previous page", null, ChevronLeft, currentPage - 1, Model.IsFirstPage, "prev")
            <span class="pagination-summary">
                Page <strong>@currentPage</strong> of <strong>@Model.TotalPages</strong>
            </span>
            @Step("pagination-link pagination-link-boxed", "Next page", null, ChevronRight, currentPage + 1, Model.IsLastPage, "next")
        </nav>
    }
}
else if (Model.Style == PaginationStyle.Bordered)
{
    if (showNav)
    {
        <nav aria-label="@Model.AriaLabel" class="pagination-group">
            @Step("pagination-link", "Previous page", null, ChevronLeft, currentPage - 1, Model.IsFirstPage, "prev")
            @foreach (var number in Model.VisiblePages())
            {
                if (number == null)
                {
                    @Ellipsis()
                }
                else
                {
                    @PageItem(number.Value, "")
                }
            }
            @Step("pagination-link", "Next page", null, ChevronRight, currentPage + 1, Model.IsLastPage, "next")
        </nav>
    }
}
else if (showSummary || showSelector || showNav)
{
    @* Full: [page size] [summary] ........ [first prev 1 2 3 next last] *@
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            @if (showSelector)
            {
                // A GET form, not an inline handler: the base URL carries filter values, which
                // must never be written into script text. Existing query values ride along as
                // hidden inputs and the page resets to the first.
                var baseUrl = Model.BaseUrl ?? string.Empty;
                var queryStart = baseUrl.IndexOf('?');
                var formPath = queryStart < 0 ? baseUrl : baseUrl[..queryStart];
                var carried = queryStart < 0
                    ? new Dictionary<string, Microsoft.Extensions.Primitives.StringValues>()
                    : QueryHelpers.ParseQuery(baseUrl[(queryStart + 1)..]);
                var sizes = Model.PageSizeOptions.Append(Model.PageSize).Distinct().OrderBy(s => s).ToList();

                <form method="get" action="@formPath" class="flex items-center gap-2">
                    @foreach (var pair in carried)
                    {
                        if (string.Equals(pair.Key, Model.PageParameterName, StringComparison.OrdinalIgnoreCase)
                            || string.Equals(pair.Key, Model.PageSizeParameterName, StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }

                        foreach (var value in pair.Value)
                        {
                            <input type="hidden" name="@pair.Key" value="@value" />
                        }
                    }
                    <label for="pagination-size-@uid" class="text-sm text-text-secondary">Show</label>
                    <select id="pagination-size-@uid" name="@Model.PageSizeParameterName" class="form-select form-input-sm w-auto min-w-[4.5rem]" onchange="this.form.requestSubmit()">
                        @foreach (var size in sizes)
                        {
                            <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                        }
                    </select>
                    <noscript><button type="submit" class="btn btn-secondary btn-sm">Apply</button></noscript>
                </form>
            }
            @if (showSummary)
            {
                if (Model.IsEmpty)
                {
                    <span class="pagination-summary">No results</span>
                }
                else if (Model.HasKnownTotal)
                {
                    <span class="pagination-summary">
                        Showing <strong>@Model.FirstItem-@Model.LastItem</strong> of <strong>@Model.TotalItems</strong>
                    </span>
                }
                else
                {
                    <span class="pagination-summary">Page <strong>@currentPage</strong> of <strong>@Model.TotalPages</strong></span>
                }
            }
        </div>

        @if (showNav)
        {
            <nav aria-label="@Model.AriaLabel" class="pagination">
                @if (Model.ShowFirstLast)
                {
                    @Step("pagination-link hidden sm:inline-flex", "First page", null, DoubleLeft, 1, Model.IsFirstPage, null)
                }
                @Step("pagination-link", "Previous page", null, ChevronLeft, currentPage - 1, Model.IsFirstPage, "prev")
                @foreach (var number in Model.VisiblePages())
                {
                    if (number == null)
                    {
                        @Ellipsis()
                    }
                    else
                    {
                        @PageItem(number.Value, "")
                    }
                }
                @Step("pagination-link", "Next page", null, ChevronRight, currentPage + 1, Model.IsLastPage, "next")
                @if (Model.ShowFirstLast)
                {
                    @Step("pagination-link hidden sm:inline-flex", "Last page", null, DoubleRight, Model.TotalPages, Model.IsLastPage, null)
                }
            </nav>
        }
    </div>
}

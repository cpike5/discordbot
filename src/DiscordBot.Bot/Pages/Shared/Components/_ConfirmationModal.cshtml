@model DiscordBot.Bot.ViewModels.Components.ConfirmationModalViewModel
@using DiscordBot.Bot.ViewModels.Components
@{
    // quick-actions.js owns open/close, motion, focus, scroll lock and the form submit.
    // The handler goes in the URL because Razor Pages reads it from the query string.
    var formAction = ConfirmationVariantExtensions.ResolveFormAction(
        Model.FormAction, Model.FormHandler, Context.Request.Path + Context.Request.QueryString.Value);
    var color = Model.Variant.ColorToken();
}

<!-- Confirmation Modal: open with quickActions.showConfirmationModal('@Model.Id') -->
<div id="@Model.Id" class="hidden fixed inset-0 z-[var(--z-modal)]" role="alertdialog" aria-modal="true" aria-labelledby="@(Model.Id)Title" aria-describedby="@(Model.Id)Desc" data-confirm-modal>
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm qa-modal-backdrop" data-modal-dismiss aria-hidden="true"></div>

    <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="bg-bg-tertiary border border-border-primary rounded-lg shadow-xl max-w-md w-full qa-modal-panel pointer-events-auto" role="document">
            <div class="p-6">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-full bg-@color/20 flex items-center justify-center">
                        <svg class="w-5 h-5 text-@color" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(string.IsNullOrEmpty(Model.CustomIconPath) ? Model.Variant.DefaultIconPath() : Model.CustomIconPath)" />
                        </svg>
                    </div>

                    <div class="flex-1 min-w-0">
                        <h3 id="@(Model.Id)Title" class="text-lg font-semibold text-text-primary">@Model.Title</h3>
                        <p id="@(Model.Id)Desc" class="mt-2 text-sm text-text-secondary">@Model.Message</p>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 px-6 py-4 bg-bg-secondary border-t border-border-primary rounded-b-lg">
                <button type="button" class="btn btn-secondary" data-modal-dismiss>@Model.CancelText</button>

                <form method="post" action="@formAction" class="inline-block">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="handler" value="@Model.FormHandler" />
                    <button type="submit" class="@Model.Variant.ConfirmButtonClass() min-w-[100px]">
                        <span class="confirm-btn-text">@Model.ConfirmText</span>
                        <svg class="hidden w-4 h-4 animate-spin confirm-btn-spinner" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

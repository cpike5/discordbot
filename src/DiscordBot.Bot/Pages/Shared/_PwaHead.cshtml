@* PWA head tags: web app manifest, install icons, and service worker registration.
   Included in every layout that should make the portal installable. See wwwroot/sw.js. *@
<link rel="manifest" href="~/manifest.webmanifest" />
<link rel="apple-touch-icon" href="~/images/icons/apple-touch-icon.png" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Bot Admin" />
<script src="~/js/pwa.js" asp-append-version="true" defer></script>

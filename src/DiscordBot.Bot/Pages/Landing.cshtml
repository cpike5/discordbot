                View on GitHub
            </a>
        </div>
    </div>
    <!-- Decorative background -->
    <div class="hero-bg absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute inset-0 dot-pattern"></div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="py-16 sm:py-20 lg:py-24" aria-labelledby="features-heading">

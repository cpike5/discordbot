@page
@model DiscordBot.Bot.Pages.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = "Dashboard";

    // What this user can actually use (D8): a card or action they cannot use is left out, and the
    // grid below closes up around what remains.
    var isAdmin = Model.QuickActions.UserIsAdmin;
    var showQuickActions = Model.QuickActions.Actions.Any(a => !a.IsAdminOnly || isAdmin);
}

@{
    Func<object?, IHtmlContent> headerActions =
        @<span class="badge badge-warning" data-stale-badge hidden title="Live updates are paused. The numbers and activity below may be out of date.">Stale</span>;
    var pageHeader = new PageHeaderViewModel
    {
        Eyebrow = "Overview",
        Title = "Dashboard",
        Subtitle = "Bot health, connected servers and the latest activity at a glance.",
        ActionsContent = headerActions(null)
    };
}
<partial name="Shared/Components/_PageHeader" model="pageHeader" />

<!-- Bot Status Banner -->
<div class="mb-8">
    <partial name="Shared/Components/_BotStatusBanner" model="Model.BotStatusBanner" />
</div>

<!-- Hero Metrics Grid (4 columns) -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6 mb-8">
    @foreach (var metric in Model.HeroMetrics)
    {
        <partial name="Shared/Components/_HeroMetricCard" model="metric" />
    }
</div>

<!-- Connected Servers (moderators and up) and Activity Timeline. Without the servers card the
     timeline takes the full row instead of leaving a hole beside it. -->
<div class="grid grid-cols-1 @(Model.ShowConnectedServers ? "xl:grid-cols-2" : "") gap-4 lg:gap-6 mb-8">
    @if (Model.ShowConnectedServers)
    {
        <partial name="Shared/Components/_ConnectedServersWidget" model="Model.ConnectedServers" />
    }

    <div class="flex flex-col">
        <partial name="Shared/Components/_ActivityFeedTimeline" model="Model.ActivityTimeline" />
    </div>
</div>

<!-- Audit Log - Full Width (Admin only) -->
@if (Model.AuditLog != null && Model.ShowAuditLog)
{
    <div class="mb-8">
        <partial name="Shared/Components/_AuditLogCard" model="Model.AuditLog" />
    </div>
}

<!-- Quick Actions Panel at Bottom (only when there is something this user can do) -->
@if (showQuickActions)
{
    <div class="mb-8">
        <partial name="Shared/Components/_QuickActionsCard" model="Model.QuickActions" />
    </div>
}

@if (isAdmin)
{
    <!-- Confirmation Modals (hidden by default). dashboard-actions.js follows up on each. -->
    var restartBotModal = new ConfirmationModalViewModel
    {
        Id = "restartBotModal",
        Title = "Restart the bot?",
        Message = "The bot disconnects from Discord and reconnects, which takes a few seconds. Commands and voice playback stop until it is back.",
        ConfirmText = "Restart bot",
        CancelText = "Cancel",
        Variant = ConfirmationVariant.Warning,
        FormAction = "",
        FormHandler = "RestartBot"
    };
    var syncGuildsModal = new ConfirmationModalViewModel
    {
        Id = "syncGuildsModal",
        Title = "Sync all servers?",
        Message = "Server names and records are refreshed from Discord for every server the bot is in. Nothing is removed.",
        ConfirmText = "Sync servers",
        CancelText = "Cancel",
        Variant = ConfirmationVariant.Info,
        FormAction = "",
        FormHandler = "SyncAllGuilds"
    };
    <partial name="Shared/Components/_ConfirmationModal" model="restartBotModal" />
    <partial name="Shared/Components/_ConfirmationModal" model="syncGuildsModal" />
}


@section Scripts {
    <script src="~/js/dashboard-stats.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-realtime.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-actions.js" asp-append-version="true"></script>
}

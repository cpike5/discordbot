@page "/Admin/Performance"
@model DiscordBot.Bot.Pages.Admin.Performance.IndexModel
@{
    ViewData["Title"] = "Bot Performance";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Dashboard", "/"),
        ("Bot Performance", null)
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/performance-pages.css" />
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
    <div class="flex items-center gap-3">
        <div>
            <h1 class="page-title">Bot Performance</h1>
            <p class="page-subtitle">Health, command, API and system metrics for the bot</p>
        </div>
    </div>

    <!-- Overall Health Status -->
    <div class="health-status @Model.ViewModel.OverallStatusClass">
        @{
            var statusIcon = Model.ViewModel.OverallStatus.ToLowerInvariant() switch
            {
                "healthy" => @"<svg class=""w-4 h-4"" fill=""none"" viewBox=""0 0 24 24"" stroke=""currentColor""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"" /></svg>",
                "warning" => @"<svg class=""w-4 h-4"" fill=""none"" viewBox=""0 0 24 24"" stroke=""currentColor""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"" /></svg>",
                "critical" => @"<svg class=""w-4 h-4"" fill=""none"" viewBox=""0 0 24 24"" stroke=""currentColor""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"" /></svg>",
                _ => @"<svg class=""w-4 h-4"" fill=""none"" viewBox=""0 0 24 24"" stroke=""currentColor""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"" /></svg>"
            };
        }
        @Html.Raw(statusIcon)
        <span>@Model.ViewModel.OverallStatusText</span>
    </div>
</div>

<!-- Navigation tabs -->
<div class="mb-4">
    @{
        var performanceTabs = new DiscordBot.Bot.ViewModels.Components.TabPanelViewModel
        {
            Id = "performanceTabs",
            StyleVariant = DiscordBot.Bot.ViewModels.Components.TabStyleVariant.Underline,
            // tab-panel.js owns the tablist (arrow keys, focus, announcements) and raises `tabchange`;
            // dashboard.js loads the content, because it needs the time range, a cache and the hub
            // subscription. The tab and range live in the query string (?tab=…&hours=…), which
            // dashboard.js writes, so tab-panel.js persists nothing itself.
            NavigationMode = DiscordBot.Bot.ViewModels.Components.TabNavigationMode.InPage,
            PersistenceMode = DiscordBot.Bot.ViewModels.Components.TabPersistenceMode.None,
            AriaLabel = "Performance sections",
            ActiveTabId = Model.ActiveTabId,
            Tabs = new List<DiscordBot.Bot.ViewModels.Components.TabItemViewModel>
            {
                new() { Id = "overview", Label = "Overview",
                    IconPathOutline = "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" },
                new() { Id = "health", Label = "Health Metrics", ShortLabel = "Health",
                    IconPathOutline = "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" },
                new() { Id = "commands", Label = "Commands",
                    IconPathOutline = "M13 10V3L4 14h7v7l9-11h-7z" },
                new() { Id = "api", Label = "API & Rate Limits", ShortLabel = "API",
                    IconPathOutline = "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" },
                new() { Id = "system", Label = "System Health", ShortLabel = "System",
                    IconPathOutline = "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" },
                new() { Id = "alerts", Label = "Alerts",
                    IconPathOutline = "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9",
                    BadgeCount = Model.ViewModel.ActiveAlertCount,
                    BadgeVariant = DiscordBot.Bot.ViewModels.Components.TabBadgeVariant.Warning }
            }
        };
    }
    @await Html.PartialAsync("Components/_TabPanel", performanceTabs)

</div>

<!-- Time range (hidden on tabs that do not use it) and the freshness of the tab on screen -->
<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 mb-6">
    <div class="flex items-center gap-2 flex-shrink-0" id="timeRangeGroup" role="group" aria-label="Time range">
        <span class="text-sm text-text-secondary mr-2 whitespace-nowrap" id="timeRangeLabel">Time range</span>
        <button type="button" class="time-range-btn active" data-hours="24" aria-pressed="true">24h</button>
        <button type="button" class="time-range-btn" data-hours="168" aria-pressed="false">7d</button>
        <button type="button" class="time-range-btn" data-hours="720" aria-pressed="false">30d</button>
    </div>

    <!--
        "Live" appears only while the tab is subscribed to a hub group and the connection is up;
        every other tab says when it was last loaded. The stale badge is toggled by
        connection-banner.js. Not a live region: the relative time repaints every 30s.
    -->
    <div class="perf-status ml-auto" id="perfStatus">
        <span class="live-indicator hidden" id="perfLive" data-perf-live>
            <span class="live-dot" aria-hidden="true"></span>
            <span class="live-text" data-perf-live-text>Live</span>
        </span>
        <span class="badge badge-warning" data-stale-badge hidden title="Live updates are paused. The numbers below may be out of date.">Stale</span>
        <span class="perf-updated" id="perfUpdated" hidden>
            Updated <time id="perfUpdatedTime" data-relative-time="">just now</time>
        </span>
        <button type="button" class="btn btn-secondary btn-sm" id="perfRefresh" aria-label="Refresh this tab">
            <svg class="btn-svg-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Refresh
        </button>
    </div>
</div>

<!-- The one live region for this screen: loading, loaded and failure messages -->
<p class="sr-only" id="perfStatusLine" role="status" aria-live="polite" aria-atomic="true"></p>

<!-- Tab content, loaded by dashboard.js. Not a live region: announcing a whole tab is noise. -->
<div class="tab-panel"
     id="tabContent"
     role="tabpanel"
     aria-labelledby="performanceTabs-tab-@Model.ActiveTabId"
     data-performance-tabs
     data-initial-tab="@Model.ActiveTabId"
     data-initial-hours="@(Model.RequestedHours?.ToString() ?? "")">
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/realtime-ui.js"></script>
    <script src="~/js/tab-panel.js" asp-append-version="true"></script>

    <!-- Performance Dashboard shared utilities -->
    <script src="~/js/performance/time-range.js" asp-append-version="true"></script>
    <script src="~/js/performance/components/chart-utils.js" asp-append-version="true"></script>
    <script src="~/js/performance/live.js" asp-append-version="true"></script>

    <!-- Tab modules -->
    <script src="~/js/performance/tabs/overview.js" asp-append-version="true"></script>
    <script src="~/js/performance/tabs/health.js" asp-append-version="true"></script>
    <script src="~/js/performance/tabs/commands.js" asp-append-version="true"></script>
    <script src="~/js/performance/tabs/api.js" asp-append-version="true"></script>
    <script src="~/js/performance/tabs/system.js" asp-append-version="true"></script>
    <script src="~/js/performance/tabs/alerts.js" asp-append-version="true"></script>

    <!-- Main orchestrator (loads last) -->
    <script src="~/js/performance/dashboard.js" asp-append-version="true"></script>
}

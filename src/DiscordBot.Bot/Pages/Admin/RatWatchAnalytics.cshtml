@page
@model DiscordBot.Bot.Pages.Admin.RatWatchAnalyticsModel
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = "Global Rat Watch Analytics";

    var hasDateFilter = Model.Request.Query.ContainsKey("StartDate") || Model.Request.Query.ContainsKey("EndDate");
    var hasFilters = hasDateFilter || Model.GuildId.HasValue;
    var dateFilter = new DateRangeFilterViewModel
    {
        StartDate = Model.StartDate,
        EndDate = Model.EndDate,
        Presets = DateRangePreset.Long,
        ClearUrl = Url.Page("RatWatchAnalytics"),
        HasActiveFilters = hasFilters
    };
    var loadFailed = !string.IsNullOrEmpty(Model.ErrorMessage);

    // The figures behind each chart, as text (see _ChartDataTable)
    var summary = Model.ViewModel.Summary;
    var otherWatches = Math.Max(0, summary.TotalWatches - summary.GuiltyCount - summary.ClearedEarlyCount - summary.ActiveWatches);
    var timeSeriesTable = new ChartDataTableViewModel
    {
        Id = "watchesOverTimeData",
        Caption = "Watches per day: total, guilty and cleared early",
        Columns = new[] { "Day", "Total", "Guilty", "Cleared early" },
        Rows = Model.ViewModel.TimeSeries.Select(t => (IReadOnlyList<string>)new[]
        {
            ChartDataTableViewModel.Day(t.Date), ChartDataTableViewModel.Count(t.TotalCount),
            ChartDataTableViewModel.Count(t.GuiltyCount), ChartDataTableViewModel.Count(t.ClearedCount)
        }).ToList()
    };
    var outcomeTable = new ChartDataTableViewModel
    {
        Id = "outcomeDistributionData",
        Caption = "Watches by outcome",
        Columns = new[] { "Outcome", "Watches" },
        Rows = new IReadOnlyList<string>[]
        {
            new[] { "Guilty", ChartDataTableViewModel.Count(summary.GuiltyCount) },
            new[] { "Cleared early", ChartDataTableViewModel.Count(summary.ClearedEarlyCount) },
            new[] { "Active", ChartDataTableViewModel.Count(summary.ActiveWatches) },
            new[] { "Other", ChartDataTableViewModel.Count(otherWatches) }
        }
    };
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm flex-wrap">
            <li>
                <a asp-page="/Index" class="text-text-secondary hover:text-accent-blue transition-colors">Home</a>
            </li>
            <li class="text-text-tertiary" aria-hidden="true">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </li>
            <li>
                <span class="text-text-primary font-medium" aria-current="page">Rat Watch Analytics</span>
            </li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-text-primary">Global Rat Watch Analytics</h1>
            <p class="mt-1 text-sm text-text-secondary">
                @if (Model.GuildId.HasValue)
                {
                    <span>Analytics for @Model.ViewModel.GuildName</span>
                }
                else if (loadFailed)
                {
                    <span>Cross-server metrics and trends</span>
                }
                else
                {
                    <span>Cross-server metrics and trends (@DisplayFormat.Plural(Model.EnabledGuilds.Count, "server") with Rat Watch enabled)</span>
                }
            </p>
        </div>
    </div>

    <filter-panel title="Filters"
                  is-collapsible="true"
                  active-filter-count="@(hasFilters ? 1 : 0)"
                  default-expanded="true">
        <form method="get" id="filterForm">
            <div class="mb-4">
                <label for="GuildId" class="block text-sm font-medium text-text-primary mb-2">Server</label>
                <select id="GuildId"
                        name="GuildId"
                        class="w-full px-3 py-2 text-sm bg-bg-primary border border-border-primary rounded-lg text-text-primary focus:border-border-focus focus:ring-1 focus:ring-border-focus transition-colors">
                    <option value="">All servers</option>
                    @foreach (var guild in Model.EnabledGuilds.OrderBy(g => g.Name))
                    {
                        <option value="@guild.GuildId" selected="@(Model.GuildId == guild.GuildId)">@guild.Name</option>
                    }
                </select>
            </div>
            <partial name="Shared/Components/_DateRangeFilter" model="dateFilter" />
        </form>
    </filter-panel>

    @if (loadFailed)
    {
        <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
            Type = EmptyStateType.Error,
            Title = "Analytics could not be loaded",
            Description = Model.ErrorMessage!,
            Size = EmptyStateSize.Default,
            HeadingLevel = 2,
            Announce = true,
            PrimaryActionText = "Try again",
            PrimaryActionUrl = Model.Request.Path + Model.Request.QueryString,
            PrimaryActionIconPath = ""
        }' />
    }
    else
    {
    <!-- Summary Stats Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6 mb-8">
        <!-- Total Guilds with Rat Watch Enabled -->
        @if (!Model.GuildId.HasValue)
        {
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-text-secondary">Servers using Rat Watch</p>
                        <p class="mt-2 text-3xl font-bold text-text-primary">@Model.EnabledGuilds.Count.ToString("N0")</p>
                        <p class="mt-1 text-xs text-text-tertiary">Servers with feature enabled</p>
                    </div>
                    <div class="p-3 bg-accent-blue/10 rounded-lg">
                        <svg class="w-6 h-6 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                        </svg>
                    </div>
                </div>
            </div>
        }

        <!-- Total Watches -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Total Watches</p>
                    <p class="mt-2 text-3xl font-bold text-text-primary">@Model.ViewModel.Summary.TotalWatches.ToString("N0")</p>
                    <p class="mt-1 text-xs text-text-tertiary">@Model.ViewModel.Summary.ActiveWatches active</p>
                </div>
                <div class="p-3 bg-accent-orange/10 rounded-lg">
                    <svg class="w-6 h-6 text-accent-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Guilty Rate -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Guilty Rate</p>
                    <p class="mt-2 text-3xl font-bold @(Model.ViewModel.Summary.GuiltyRate >= 70 ? "text-error" : Model.ViewModel.Summary.GuiltyRate >= 50 ? "text-warning" : "text-success")">
                        @Model.ViewModel.Summary.GuiltyRate.ToString("F0")%
                    </p>
                    <p class="mt-1 text-xs text-text-tertiary">@Model.ViewModel.Summary.GuiltyCount guilty verdicts</p>
                </div>
                <div class="p-3 @(Model.ViewModel.Summary.GuiltyRate >= 70 ? "bg-error/10" : Model.ViewModel.Summary.GuiltyRate >= 50 ? "bg-warning/10" : "bg-success/10") rounded-lg">
                    <svg class="w-6 h-6 @(Model.ViewModel.Summary.GuiltyRate >= 70 ? "text-error" : Model.ViewModel.Summary.GuiltyRate >= 50 ? "text-warning" : "text-success")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Check-in Rate -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Check-in Rate</p>
                    <p class="mt-2 text-3xl font-bold text-success">@Model.ViewModel.Summary.EarlyCheckInRate.ToString("F0")%</p>
                    <p class="mt-1 text-xs text-text-tertiary">@Model.ViewModel.Summary.ClearedEarlyCount cleared early</p>
                </div>
                <div class="p-3 bg-success/10 rounded-lg">
                    <svg class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6 mb-8">
        <!-- Watches Over Time Chart -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
            <div class="px-5 py-4 border-b border-border-primary">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-accent-orange/10 rounded-lg">
                        <svg class="w-5 h-5 text-accent-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                        </svg>
                    </div>
                    <h2 class="text-lg font-semibold text-text-primary">
                        @(Model.GuildId.HasValue ? "Watches Over Time" : "Trends across all servers")
                    </h2>
                </div>
            </div>
            <div class="p-5">
                @if (Model.ViewModel.TimeSeries.Any())
                {
                    <div style="position: relative; min-height: 300px; max-height: 400px;">
                        <canvas id="watchesOverTimeChart" role="img" aria-label="Line chart of Rat Watches per day: total, guilty and cleared early" aria-describedby="watchesOverTimeData"></canvas>
                    </div>
                    <partial name="Shared/Components/_ChartDataTable" model="timeSeriesTable" />
                }
                else
                {
                    <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                        Type = EmptyStateType.NoData,
                        Title = "No watch data available",
                        Description = "Data will appear here once watches are created",
                        Size = EmptyStateSize.Compact,
                        IconSvgPath = "M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"
                    }' />
                }
            </div>
        </div>

        <!-- Outcome Distribution Chart -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
            <div class="px-5 py-4 border-b border-border-primary">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-accent-blue/10 rounded-lg">
                        <svg class="w-5 h-5 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <h2 class="text-lg font-semibold text-text-primary">Outcome Distribution</h2>
                </div>
            </div>
            <div class="p-5">
                @if (Model.ViewModel.Summary.TotalWatches > 0)
                {
                    <div style="position: relative; min-height: 300px; max-height: 400px;">
                        <canvas id="outcomeDistributionChart" role="img" aria-label="Doughnut chart of Rat Watches by outcome" aria-describedby="outcomeDistributionData"></canvas>
                    </div>
                    <partial name="Shared/Components/_ChartDataTable" model="outcomeTable" />
                }
                else
                {
                    <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                        Type = EmptyStateType.NoData,
                        Title = "No data available",
                        Description = "Outcomes will appear here once watches complete",
                        Size = EmptyStateSize.Compact,
                        IconSvgPath = "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                    }' />
                }
            </div>
        </div>
    </div>

    <!-- Per-Guild Summary Table (Only show for global view) -->
    @if (!Model.GuildId.HasValue && Model.EnabledGuilds.Any())
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-8">
            <div class="px-5 py-4 border-b border-border-primary">
                <h2 class="text-lg font-semibold text-text-primary">Per-server summary</h2>
                <p class="text-sm text-text-secondary mt-1">View individual server analytics</p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-bg-primary/50">
                        <tr>
                            <th scope="col" class="px-5 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Server</th>
                            <th scope="col" class="px-5 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var guild in Model.EnabledGuilds.OrderBy(g => g.Name))
                        {
                            <tr class="hover:bg-bg-hover transition-colors">
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(guild.IconUrl))
                                        {
                                            <img src="@guild.IconUrl" alt="" class="w-10 h-10 rounded-lg" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-lg bg-accent-blue/10 flex items-center justify-center">
                                                <span class="text-accent-blue font-bold text-sm">@guild.Name.Substring(0, Math.Min(2, guild.Name.Length)).ToUpper()</span>
                                            </div>
                                        }
                                        <div>
                                            <p class="font-medium text-text-primary">@guild.Name</p>
                                            <p class="text-xs text-text-tertiary font-mono">ID: @guild.GuildId</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <a asp-page="/Guilds/RatWatch/Analytics" asp-route-guildId="@guild.GuildId" class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors">
                                        View Analytics
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    }
</div>

@section Scripts {
    <!-- Chart.js Library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Embed Chart Data -->
    @{
        var chartData = new {
            timeSeries = Model.ViewModel.TimeSeries.Select(t => new {
                date = t.Date.ToString("yyyy-MM-dd"),
                totalCount = t.TotalCount,
                guiltyCount = t.GuiltyCount,
                clearedCount = t.ClearedCount
            }),
            outcomeDistribution = new {
                guiltyCount = Model.ViewModel.Summary.GuiltyCount,
                clearedEarlyCount = Model.ViewModel.Summary.ClearedEarlyCount,
                activeCount = Model.ViewModel.Summary.ActiveWatches,
                otherCount = Math.Max(0, Model.ViewModel.Summary.TotalWatches - Model.ViewModel.Summary.GuiltyCount - Model.ViewModel.Summary.ClearedEarlyCount - Model.ViewModel.Summary.ActiveWatches)
            },
            heatmap = Model.ViewModel.Heatmap.Select(h => new {
                dayOfWeek = h.DayOfWeek,
                hour = h.Hour,
                count = h.Count
            }),
            topUsers = Model.ViewModel.MostWatched.Take(5).Select(u => new {
                userId = u.UserId.ToString(), // Pass as string to preserve Discord ID precision
                username = u.Username,
                watchesAgainst = u.WatchesAgainst,
                guiltyCount = u.GuiltyCount
            })
        };
        var chartDataJson = System.Text.Json.JsonSerializer.Serialize(chartData);
    }

    <script type="application/json" id="ratWatchChartData">
@Html.Raw(chartDataJson)
    </script>

    <script src="~/js/date-range-filter.js" asp-append-version="true"></script>
    <script src="~/js/shared/filter-panel.js" asp-append-version="true"></script>
    <script src="~/js/analytics-charts.js" asp-append-version="true"></script>
    <script src="~/js/rat-watch-analytics.js" asp-append-version="true"></script>
}

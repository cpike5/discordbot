@page
@model DiscordBot.Bot.Pages.Admin.Users.CreateModel
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = "Create User";

    string? FieldError(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
    ValidationState FieldState(string key) => FieldError(key) != null ? ValidationState.Error : ValidationState.None;

    // Errors that belong to no single field (the service failed for another reason)
    var formErrors = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList()
        ?? new List<string>();
    var hasErrors = !ViewData.ModelState.IsValid;

    var emailModel = new FormInputViewModel
    {
        Id = "Input_Email",
        Name = "Input.Email",
        Label = "Email address",
        Type = "email",
        Value = Model.Input.Email,
        Placeholder = "user@example.com",
        IsRequired = true,
        Autocomplete = "off",
        InputMode = "email",
        HelpText = "This will be the user's sign-in email",
        ValidationState = FieldState("Input.Email"),
        ValidationMessage = FieldError("Input.Email")
    };

    var displayNameModel = new FormInputViewModel
    {
        Id = "Input_DisplayName",
        Name = "Input.DisplayName",
        Label = "Display name",
        Type = "text",
        Value = Model.Input.DisplayName,
        Placeholder = "Jordan Lee",
        Autocomplete = "off",
        HelpText = "Optional. A friendly name shown in the portal."
    };

    // new-password: this form sets someone else's password, so the browser must not offer
    // (or save) the signed-in admin's own.
    var passwordModel = new FormInputViewModel
    {
        Id = "Input_Password",
        Name = "Input.Password",
        Label = "Password",
        Type = "password",
        IsRequired = true,
        Autocomplete = "new-password",
        HelpText = "At least 8 characters, with upper and lower case letters, a number and a symbol",
        ValidationState = FieldState("Input.Password"),
        ValidationMessage = FieldError("Input.Password")
    };

    var confirmModel = new FormInputViewModel
    {
        Id = "Input_ConfirmPassword",
        Name = "Input.ConfirmPassword",
        Label = "Confirm password",
        Type = "password",
        IsRequired = true,
        Autocomplete = "new-password",
        ValidationState = FieldState("Input.ConfirmPassword"),
        ValidationMessage = FieldError("Input.ConfirmPassword")
    };

    var roleModel = new FormSelectViewModel
    {
        Id = "Input_Role",
        Name = "Input.Role",
        Label = "Role",
        Options = Model.ViewModel.AvailableRoles.Select(r => new SelectOption { Value = r.Value, Text = r.Text }).ToList(),
        SelectedValue = Model.Input.Role,
        IsRequired = true,
        HelpText = "The role decides what the user is allowed to do",
        ValidationState = FieldState("Input.Role"),
        ValidationMessage = FieldError("Input.Role")
    };
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-6">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-text-secondary mb-2">
            <a asp-page="Index" class="hover:text-text-primary">Users</a>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-text-primary" aria-current="page">Create</span>
        </nav>
        <h1 class="text-2xl font-bold text-text-primary">Create user</h1>
        <p class="mt-1 text-sm text-text-secondary">Add a new user to the portal</p>
    </div>

    <!-- Form -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg">
        <form method="post" class="p-6 space-y-6"
              data-submit-guard data-focus-first-error data-unsaved-changes
              data-unsaved-dirty-on-load="@(hasErrors ? "true" : null)">
            @foreach (var message in formErrors)
            {
                <partial name="Shared/Components/_Alert" model="new AlertViewModel { Variant = AlertVariant.Error, Message = message }" />
            }

            <partial name="Shared/Components/_FormInput" model="emailModel" />
            <partial name="Shared/Components/_FormInput" model="displayNameModel" />
            <partial name="Shared/Components/_FormInput" model="passwordModel" />
            <partial name="Shared/Components/_FormInput" model="confirmModel" />
            <partial name="Shared/Components/_FormSelect" model="roleModel" />

            <!-- Send Welcome Email -->
            <div>
                <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                    Id = "Input_SendWelcomeEmail",
                    Name = "Input.SendWelcomeEmail",
                    Label = "Send a welcome email",
                    Description = "Tells the new user their account is ready.",
                    IsChecked = Model.Input.SendWelcomeEmail
                }' />
            </div>

            <!-- Action Buttons -->
            <div class="border-t border-border-primary pt-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
                <a asp-page="Index" class="btn btn-secondary justify-center">Cancel</a>
                <button type="submit" class="btn btn-primary justify-center" data-loading-text="Creating...">
                    <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Create user
                </button>
            </div>
        </form>
    </div>

    <!-- Info Box -->
    <div class="mt-6">
        <div class="bg-info/10 border border-info/20 rounded-lg p-4">
            <div class="flex">
                <svg class="w-5 h-5 text-info flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="ml-3">
                    <h2 class="text-sm font-medium text-info">About new users</h2>
                    <ul class="mt-2 text-sm text-text-secondary space-y-1 list-disc list-inside">
                        <li>The email is confirmed automatically</li>
                        <li>The user can sign in straight away</li>
                        <li>You can only assign roles at or below your own</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-focus.js" asp-append-version="true"></script>
}

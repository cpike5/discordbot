@page
@model DiscordBot.Bot.Pages.Admin.LlmUsageModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = "LLM Usage";
    var hasFilters = Model.GuildId.HasValue || Model.Mode.HasValue;
    var noUsage = new EmptyStateViewModel
    {
        Type = hasFilters ? EmptyStateType.NoResults : EmptyStateType.NoData,
        Title = hasFilters ? "No usage matches these filters" : "No usage in this date range",
        Description = hasFilters
            ? "Try a different guild or mode, or clear the filters to see all usage."
            : "Usage appears here once the assistant has answered someone. Widen the dates to look further back.",
        PrimaryActionText = hasFilters ? "Clear filters" : null,
        PrimaryActionUrl = hasFilters ? Url.Page("LlmUsage") : null,
        Size = EmptyStateSize.Compact
    };
}

<div class="page-header">
    <div class="page-header-text">
        <h1 class="page-title">LLM Usage</h1>
        <p class="page-subtitle">
            Token usage and cost across every assistant mode, @Model.StartDate?.ToString("MMM d") &ndash; @Model.EndDate?.ToString("MMM d, yyyy")
        </p>
    </div>
</div>

<!-- Filters -->
<div class="bg-bg-secondary border border-border-primary rounded-lg mb-6" data-llm-filter-panel>
    <button type="button" id="llmUsageFilterToggle" class="w-full flex items-center justify-between px-4 sm:px-5 py-4 text-left" aria-expanded="true" aria-controls="llmUsageFilterContent" data-llm-filter-toggle>
        <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span class="text-lg font-semibold text-text-primary">Filters</span>
            @if (hasFilters)
            {
                <span class="badge badge-orange">Active</span>
            }
        </div>
        <svg id="llmUsageFilterChevron" class="w-5 h-5 text-text-secondary transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
    </button>

    <div id="llmUsageFilterContent">
        <div class="border-t border-border-primary p-4 sm:p-5">
            <form method="get" id="llmUsageFilterForm" data-submit-guard>
                <input type="hidden" name="UserTimezone" id="UserTimezone" value="@Model.UserTimezone" />

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label for="GuildId" class="block text-sm font-medium text-text-primary mb-2">Server</label>
                        <select id="GuildId" name="GuildId" class="form-select w-full">
                            <option value="">All servers (portal-wide)</option>
                            @foreach (var guild in Model.Guilds.OrderBy(g => g.Name))
                            {
                                <option value="@guild.Id" selected="@(Model.GuildId == guild.Id)">@guild.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="Mode" class="block text-sm font-medium text-text-primary mb-2">Mode</label>
                        <select id="Mode" name="Mode" class="form-select w-full">
                            <option value="">All modes</option>
                            @foreach (var mode in Enum.GetValues<LlmMode>())
                            {
                                <option value="@mode" selected="@(Model.Mode == mode)">@mode</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-4" role="group" aria-labelledby="llmUsagePresetLabel">
                    <span id="llmUsagePresetLabel" class="block text-sm font-medium text-text-primary mb-2">Quick date range</span>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" data-date-preset="7days" aria-pressed="false" class="btn btn-secondary btn-sm">Last 7 days</button>
                        <button type="button" data-date-preset="30days" aria-pressed="false" class="btn btn-secondary btn-sm">Last 30 days</button>
                        <button type="button" data-date-preset="90days" aria-pressed="false" class="btn btn-secondary btn-sm">Last 90 days</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="StartDate" class="block text-sm font-medium text-text-primary mb-1">Start date</label>
                        <input type="date" id="StartDate" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-input w-full" />
                    </div>
                    <div>
                        <label for="EndDate" class="block text-sm font-medium text-text-primary mb-1">End date</label>
                        <input type="date" id="EndDate" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-input w-full" />
                    </div>
                </div>
                <p class="mt-2 text-xs text-text-tertiary">Days are your own calendar days. The daily breakdown below groups by UTC day.</p>

                <div class="flex flex-wrap items-center gap-3 mt-6 pt-4 border-t border-border-secondary">
                    <button type="submit" class="btn btn-primary">Apply filters</button>
                    <a asp-page="LlmUsage" class="btn btn-secondary">Clear filters</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hero Stats -->
<div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-8">
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs font-medium text-text-tertiary">Messages</p>
        <p class="mt-1 text-2xl font-bold text-text-primary">@Model.Totals.MessageCount.ToString("N0")</p>
    </div>
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs font-medium text-text-tertiary">Total tokens</p>
        <p class="mt-1 text-2xl font-bold text-text-primary">@((Model.Totals.InputTokens + Model.Totals.OutputTokens).ToString("N0"))</p>
        <p class="mt-1 text-xs text-text-tertiary">@Model.Totals.CachedTokens.ToString("N0") cached</p>
    </div>
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs font-medium text-text-tertiary">Cost (USD)</p>
        <p class="mt-1 text-2xl font-bold text-accent-orange">$@Model.Totals.CostUsd.ToString("F4")</p>
    </div>
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs font-medium text-text-tertiary">Billed share</p>
        <p class="mt-1 text-2xl font-bold text-text-primary">@(Model.Totals.BilledCostShare.HasValue ? (Model.Totals.BilledCostShare.Value * 100).ToString("F0") + "%" : "—")</p>
        <p class="mt-1 text-xs text-text-tertiary">Rest estimated</p>
    </div>
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs font-medium text-text-tertiary">Failed</p>
        <p class="mt-1 text-2xl font-bold text-text-primary">@Model.Totals.FailedCount.ToString("N0")</p>
    </div>
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs font-medium text-text-tertiary">Avg latency</p>
        <p class="mt-1 text-2xl font-bold text-text-primary">@Model.Totals.AverageLatencyMs.ToString("F0")<span class="text-sm font-normal text-text-tertiary">ms</span></p>
    </div>
</div>

<!-- By User -->
<div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-6">
    <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
        <h2 class="text-lg font-semibold text-text-primary">Cost by user</h2>
        <p class="text-sm text-text-secondary mt-1">Top @Model.ByUser.Count by cost. Select a user to read their messages.</p>
    </div>
    @if (Model.ByUser.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-border-primary">
                <thead class="bg-bg-tertiary">
                    <tr>
                        <th scope="col" class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">User</th>
                        <th scope="col" class="px-4 sm:px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Messages</th>
                        <th scope="col" class="px-4 sm:px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Tokens</th>
                        <th scope="col" class="px-4 sm:px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                        <th scope="col" class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Share</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var user in Model.ByUser)
                    {
                        <tr class="hover:bg-bg-tertiary/50 transition-colors cursor-pointer llm-usage-user-row" data-user-id="@user.UserId" data-display-name="@user.DisplayName">
                            <td class="px-4 sm:px-6 py-4 whitespace-nowrap">
                                @* A real button, so the row can be opened from the keyboard; a click anywhere else on the row opens it too *@
                                <button type="button" class="llm-usage-user-button text-left rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
                                        aria-expanded="false" aria-controls="llmUsageDrilldown"
                                        aria-label="Show messages from @user.DisplayName">
                                    <span class="block text-sm font-medium text-text-primary">@user.DisplayName</span>
                                    <span class="block text-xs text-text-tertiary font-mono">@user.UserId</span>
                                </button>
                            </td>
                            <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-right text-sm text-text-primary">@user.MessageCount.ToString("N0")</td>
                            <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-right text-sm text-text-secondary">@((user.InputTokens + user.OutputTokens).ToString("N0"))</td>
                            <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-right text-sm font-medium text-text-primary">$@user.CostUsd.ToString("F4")</td>
                            <td class="px-4 sm:px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-2 w-32">
                                    <div class="flex-1 h-2 bg-bg-tertiary rounded-full overflow-hidden" aria-hidden="true">
                                        <div class="h-full bg-accent-orange" style="width: @((user.CostShare * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                    </div>
                                    <span class="text-xs text-text-tertiary w-10 text-right">@((user.CostShare * 100).ToString("F0"))%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Drill-down panel: filled by llm-usage.js when a user is chosen above -->
        <div id="llmUsageDrilldown" class="hidden border-t border-border-primary" role="region" aria-labelledby="llmUsageDrilldownTitle">
            <div class="px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0">
                    <h3 class="text-sm font-semibold text-text-primary break-words" id="llmUsageDrilldownTitle" tabindex="-1">Messages</h3>
                    <p class="text-xs text-text-tertiary mt-0.5 break-all" id="llmUsageDrilldownSubtitle"></p>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" id="llmUsageDrilldownClose">Close</button>
            </div>

            <!-- Loading, empty and error states land here; the table is shown only with rows -->
            <div id="llmUsageDrilldownState" aria-live="polite"></div>

            <div id="llmUsageDrilldownTableWrap" class="hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-border-primary">
                        <thead class="bg-bg-tertiary">
                            <tr>
                                <th scope="col" class="px-4 sm:px-6 py-2 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Time</th>
                                <th scope="col" class="px-4 sm:px-6 py-2 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Mode</th>
                                <th scope="col" class="px-4 sm:px-6 py-2 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Model</th>
                                <th scope="col" class="px-4 sm:px-6 py-2 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Tokens</th>
                                <th scope="col" class="px-4 sm:px-6 py-2 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                                <th scope="col" class="px-4 sm:px-6 py-2 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Latency</th>
                                <th scope="col" class="px-4 sm:px-6 py-2 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Status</th>
                            </tr>
                        </thead>
                        <tbody id="llmUsageDrilldownBody" class="divide-y divide-border-primary"></tbody>
                    </table>
                </div>
                <div class="px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-2 text-sm">
                    <span id="llmUsageDrilldownPageInfo" class="text-text-tertiary" role="status"></span>
                    <div class="flex gap-2">
                        <button type="button" id="llmUsageDrilldownPrev" class="btn btn-secondary btn-sm">Previous</button>
                        <button type="button" id="llmUsageDrilldownNext" class="btn btn-secondary btn-sm">Next</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <partial name="Shared/Components/_EmptyState" model="noUsage" />
    }
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- By Model -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">Cost by model</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-border-primary">
                <thead class="bg-bg-tertiary">
                    <tr>
                        <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Model</th>
                        <th scope="col" class="px-4 py-2 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Messages</th>
                        <th scope="col" class="px-4 py-2 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var modelRow in Model.ByModel)
                    {
                        <tr>
                            <td class="px-4 py-2 text-sm text-text-primary font-mono break-all">@modelRow.Model</td>
                            <td class="px-4 py-2 whitespace-nowrap text-right text-sm text-text-secondary">@modelRow.MessageCount.ToString("N0")</td>
                            <td class="px-4 py-2 whitespace-nowrap text-right text-sm font-medium text-text-primary">$@modelRow.CostUsd.ToString("F4")</td>
                        </tr>
                    }
                    @if (!Model.ByModel.Any())
                    {
                        <tr><td colspan="3" class="px-4 py-6 text-center text-sm text-text-tertiary">No usage in this range</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- By Mode -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">Cost by mode</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-border-primary">
                <thead class="bg-bg-tertiary">
                    <tr>
                        <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Mode</th>
                        <th scope="col" class="px-4 py-2 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Messages</th>
                        <th scope="col" class="px-4 py-2 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var mode in Model.ByMode)
                    {
                        <tr>
                            <td class="px-4 py-2 whitespace-nowrap text-sm text-text-primary">@mode.Mode</td>
                            <td class="px-4 py-2 whitespace-nowrap text-right text-sm text-text-secondary">@mode.MessageCount.ToString("N0")</td>
                            <td class="px-4 py-2 whitespace-nowrap text-right text-sm font-medium text-text-primary">$@mode.CostUsd.ToString("F4")</td>
                        </tr>
                    }
                    @if (!Model.ByMode.Any())
                    {
                        <tr><td colspan="3" class="px-4 py-6 text-center text-sm text-text-tertiary">No usage in this range</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- By Day: the buckets are UTC days, shown as the calendar dates they are -->
<div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
    <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
        <h2 class="text-lg font-semibold text-text-primary">Daily breakdown</h2>
        <p class="text-sm text-text-secondary mt-1">Grouped by UTC day.</p>
    </div>
    @if (Model.ByDay.Any())
    {
        <div class="overflow-x-auto hidden md:block">
            <table class="min-w-full divide-y divide-border-primary">
                <thead class="bg-bg-tertiary">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Date (UTC)</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Messages</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Tokens</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var day in Model.ByDay.OrderByDescending(d => d.Day))
                    {
                        <tr>
                            <td class="px-6 py-3 whitespace-nowrap text-sm text-text-primary" data-utc-day="@day.Day.ToString("yyyy-MM-dd")">@day.Day.ToString("MMM d, yyyy")</td>
                            <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-secondary">@day.MessageCount.ToString("N0")</td>
                            <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-secondary">@((day.InputTokens + day.OutputTokens).ToString("N0"))</td>
                            <td class="px-6 py-3 whitespace-nowrap text-right text-sm font-medium text-text-primary">$@day.CostUsd.ToString("F4")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="md:hidden divide-y divide-border-primary">
            @foreach (var day in Model.ByDay.OrderByDescending(d => d.Day))
            {
                <div class="p-4">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-medium text-text-primary" data-utc-day="@day.Day.ToString("yyyy-MM-dd")">@day.Day.ToString("MMM d, yyyy")</span>
                        <span class="text-sm font-semibold text-accent-orange">$@day.CostUsd.ToString("F4")</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <div><span class="text-text-tertiary block">Messages</span><span class="text-text-primary font-medium">@day.MessageCount.ToString("N0")</span></div>
                        <div><span class="text-text-tertiary block">Tokens</span><span class="text-text-primary font-medium">@((day.InputTokens + day.OutputTokens).ToString("N0"))</span></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <partial name="Shared/Components/_EmptyState" model="noUsage" />
    }
</div>

@section Scripts {
    <script>
        // Strings throughout: the guild is a Discord ID, too large for a JavaScript number
        window.llmUsageConfig = {
            fromUtc: '@Model.RangeFromUtc.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'")',
            toUtc: '@Model.RangeToUtc.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'")',
            guildId: @Html.Raw(Model.GuildId.HasValue ? $"'{Model.GuildId.Value}'" : "null"),
            mode: @Html.Raw(Model.Mode.HasValue ? $"'{Model.Mode}'" : "null")
        };
    </script>
    <script src="~/js/date-range-filter.js" asp-append-version="true"></script>
    <script src="~/js/llm-usage.js" asp-append-version="true"></script>
}

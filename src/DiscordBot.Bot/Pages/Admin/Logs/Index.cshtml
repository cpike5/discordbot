@page "/Admin/Logs"
@model DiscordBot.Bot.Pages.Admin.Logs.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = "Logs";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Dashboard", "/"),
        ("Logs", null)
    };

    // Each tab is its own page load (?tab=), so only the active tab's data is read and the tab,
    // its filters and the page number all live in the address: Back and reload keep them.
    var tabModel = new TabPanelViewModel
    {
        Id = "logs-tabs",
        AriaLabel = "Log types",
        NavigationMode = TabNavigationMode.PageNavigation,
        PersistenceMode = TabPersistenceMode.None,
        ActiveTabId = Model.ActiveTab,
        Tabs = new List<TabItemViewModel>
        {
            new TabItemViewModel
            {
                Id = "messages",
                Label = "Messages",
                Href = Url.Page("/Admin/Logs/Index", new { tab = "messages" }),
                IconPathOutline = "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z",
            },
            new TabItemViewModel
            {
                Id = "audit",
                Label = "Audit",
                Href = Url.Page("/Admin/Logs/Index", new { tab = "audit" }),
                IconPathOutline = "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
            }
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Logs</h1>
        <p class="page-subtitle">Messages the bot has logged and administrative actions taken in the portal</p>
    </div>
</div>

<!-- Tab Navigation -->
<div class="mb-6">
    @await Html.PartialAsync("Shared/Components/_TabPanel", tabModel)
</div>

<!-- Active tab -->
<div id="logs-tabs-panel-@Model.ActiveTab" role="tabpanel" aria-labelledby="logs-tabs-tab-@Model.ActiveTab">
    @if (Model.ActiveTab == "audit")
    {
        @await Html.PartialAsync("Tabs/_AuditTab", Model)
    }
    else
    {
        @await Html.PartialAsync("Tabs/_MessagesTab", Model)
    }
</div>

@section Scripts {
    <script src="~/js/tab-panel.js" asp-append-version="true"></script>
    <script src="~/js/autocomplete.js" asp-append-version="true"></script>
    @if (Model.ActiveTab == "messages")
    {
        <script src="~/js/message-logs.js" asp-append-version="true"></script>
    }
    <script src="~/js/logs-page.js" asp-append-version="true"></script>
}

@page
@model DiscordBot.Bot.Pages.Admin.SettingsModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Pages
@{
    ViewData["Title"] = "Settings";

    var active = Model.ViewModel.ActiveCategory;
    const string tabsId = "settingsTabs";

    // Heroicons-style outline paths, one per tab
    var tabs = new List<TabItemViewModel>
    {
        new() { Id = "General", Label = "General", IconPathOutline = "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" },
        new() { Id = "Features", Label = "Features", IconPathOutline = "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" },
        new() { Id = "Commands", Label = "Commands", IconPathOutline = "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" },
        new() { Id = "Advanced", Label = "Advanced", IconPathOutline = "M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" },
        new() { Id = "BotControl", Label = "Bot Control", IconPathOutline = "M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" },
        new() { Id = "AiModels", Label = "AI Models", IconPathOutline = "M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 20.25a48.25 48.25 0 01-8.135-.693c-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" }
    };
    if (Model.IsSuperAdmin)
    {
        tabs.Add(new() { Id = "Appearance", Label = "Appearance", IconPathOutline = "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" });
    }

    var tabPanel = new TabPanelViewModel
    {
        Id = tabsId,
        Tabs = tabs,
        ActiveTabId = active,
        StyleVariant = TabStyleVariant.Pills,
        // The address (?category=) is the tab's persistence; settings.js keeps it current
        PersistenceMode = TabPersistenceMode.None,
        AriaLabel = "Settings sections"
    };

    string PanelId(string tab) => $"{tabsId}-panel-{tab}";
    string PanelState(string tab) => active == tab ? "active" : "";

    var resetLabels = new Dictionary<string, string>
    {
        ["General"] = "General",
        ["Features"] = "Features",
        ["Advanced"] = "Advanced",
        ["AiModels"] = "AI Models",
        ["Appearance"] = "Appearance"
    };
    var activeQuery = new { category = active };
}

<!-- Restart needed (hidden until a save says so) -->
<partial name="Components/_RestartBanner" model="Model.ViewModel.IsRestartPending" />

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Manage your bot configuration and preferences</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn btn-secondary" data-modal-open="reset-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Reset all
        </button>
        <button type="button" class="btn btn-primary" data-settings-save-all>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Save all changes
        </button>
    </div>
</div>

<!-- Tabs -->
<div class="mb-6">
    <partial name="Shared/Components/_TabPanel" model="tabPanel" />
</div>

<!-- General -->
<section id="@PanelId("General")" data-tab-panel-for="@tabsId" data-tab-id="General" role="tabpanel"
         aria-labelledby="@(tabsId)-tab-General" tabindex="0" class="@PanelState("General")" hidden="@(active == "General" ? null : "hidden")">
    <form method="post" class="bg-bg-secondary border border-border-primary rounded-lg mb-6"
          data-settings-form="General" data-settings-handler="SaveCategory" data-unsaved-changes>
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">General settings</h2>
            <p class="text-sm text-text-secondary mt-1">The bot's basic settings and behavior</p>
        </div>
        <div class="p-4 sm:p-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                @foreach (var setting in Model.ViewModel.GeneralSettings)
                {
                    @await Html.PartialAsync("_SettingField", setting)
                }
            </div>
        </div>
        <partial name="_SettingsTabFooter" model='new SettingsTabFooterViewModel { Category = "General", ResetModalId = "reset-General" }' />
    </form>
</section>

<!-- Features -->
<section id="@PanelId("Features")" data-tab-panel-for="@tabsId" data-tab-id="Features" role="tabpanel"
         aria-labelledby="@(tabsId)-tab-Features" tabindex="0" class="@PanelState("Features")" hidden="@(active == "Features" ? null : "hidden")">
    <form method="post" class="bg-bg-secondary border border-border-primary rounded-lg mb-6"
          data-settings-form="Features" data-settings-handler="SaveCategory" data-unsaved-changes>
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">Feature settings</h2>
            <p class="text-sm text-text-secondary mt-1">Turn bot features on or off for every server</p>
        </div>
        <div class="p-4 sm:p-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                @foreach (var setting in Model.ViewModel.FeaturesSettings)
                {
                    @await Html.PartialAsync("_SettingField", setting)
                }
            </div>
        </div>
        <partial name="_SettingsTabFooter" model='new SettingsTabFooterViewModel { Category = "Features", ResetModalId = "reset-Features" }' />
    </form>
</section>

<!-- Commands -->
<section id="@PanelId("Commands")" data-tab-panel-for="@tabsId" data-tab-id="Commands" role="tabpanel"
         aria-labelledby="@(tabsId)-tab-Commands" tabindex="0" class="@PanelState("Commands")" hidden="@(active == "Commands" ? null : "hidden")">
    <form method="post" class="bg-bg-secondary border border-border-primary rounded-lg mb-6"
          data-settings-form="Commands" data-settings-handler="SaveCommandModules" data-unsaved-changes>
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">Command modules</h2>
            <p class="text-sm text-text-secondary mt-1">Turn Discord slash command modules on or off. Changes take effect after the bot restarts.</p>
        </div>
        <div class="p-4 sm:p-6 space-y-8">
            @{
                var categoryOrder = new[] { "Admin", "Moderation", "Features", "Audio", "Utility", "Core" };
                var categoryDescriptions = new Dictionary<string, string>
                {
                    ["Admin"] = "Server administration and configuration commands",
                    ["Moderation"] = "Moderation and enforcement commands",
                    ["Features"] = "Optional feature commands",
                    ["Audio"] = "Voice channel and audio playback commands",
                    ["Utility"] = "Information and utility commands",
                    ["Core"] = "Essential bot commands (always on)"
                };
            }

            @foreach (var category in categoryOrder)
            {
                if (Model.ViewModel.CommandModulesByCategory.TryGetValue(category, out var modules) && modules.Any())
                {
                    var isCoreCategory = category == "Core";
                    <div class="command-module-category">
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                            <h3 class="text-base font-semibold text-text-primary">@category commands</h3>
                            @if (isCoreCategory)
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-info/10 border border-info text-info text-xs font-medium rounded">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                    Always on
                                </span>
                            }
                        </div>
                        @if (categoryDescriptions.TryGetValue(category, out var categoryDesc))
                        {
                            <p class="text-sm text-text-secondary mb-4">@categoryDesc</p>
                        }
                        <div class="space-y-3">
                            @foreach (var module in modules)
                            {
                                var toggleModel = new FormToggleViewModel
                                {
                                    Id = $"module_{module.ModuleName}",
                                    Name = $"CommandModules[{module.ModuleName}]",
                                    Label = module.DisplayName,
                                    Description = string.IsNullOrEmpty(module.Description) ? null : module.Description,
                                    IsChecked = module.IsEnabled,
                                    IsDisabled = isCoreCategory,
                                    // settings.js reads each toggle's checked state itself
                                    PostsFalseWhenOff = false,
                                    AdditionalAttributes = new Dictionary<string, string> { ["data-command-module-toggle"] = "true" }
                                };
                                <div class="flex flex-wrap sm:flex-nowrap items-start gap-3 p-4 bg-bg-primary rounded-lg border border-border-primary @(isCoreCategory ? "opacity-75" : "")">
                                    <div class="flex-1 min-w-0">
                                        <partial name="Components/_FormToggle" model="toggleModel" />
                                    </div>
                                    @if (module.RequiresRestart && !isCoreCategory)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-1 bg-warning/10 border border-warning text-warning text-xs font-medium rounded flex-shrink-0">
                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                            </svg>
                                            Needs restart
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        <partial name="_SettingsTabFooter" model='new SettingsTabFooterViewModel { Category = "Commands" }' />
    </form>
</section>

<!-- Advanced -->
<section id="@PanelId("Advanced")" data-tab-panel-for="@tabsId" data-tab-id="Advanced" role="tabpanel"
         aria-labelledby="@(tabsId)-tab-Advanced" tabindex="0" class="@PanelState("Advanced")" hidden="@(active == "Advanced" ? null : "hidden")">
    <form method="post" class="bg-bg-secondary border border-border-primary rounded-lg mb-6"
          data-settings-form="Advanced" data-settings-handler="SaveCategory" data-unsaved-changes>
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">Advanced settings</h2>
            <p class="text-sm text-text-secondary mt-1">Data retention</p>
        </div>
        <div class="p-4 sm:p-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                @foreach (var setting in Model.ViewModel.AdvancedSettings)
                {
                    @await Html.PartialAsync("_SettingField", setting)
                }
            </div>
        </div>
        <partial name="_SettingsTabFooter" model='new SettingsTabFooterViewModel { Category = "Advanced", ResetModalId = "reset-Advanced" }' />
    </form>
</section>

<!-- Bot Control -->
<section id="@PanelId("BotControl")" data-tab-panel-for="@tabsId" data-tab-id="BotControl" role="tabpanel"
         aria-labelledby="@(tabsId)-tab-BotControl" tabindex="0" class="@PanelState("BotControl")" hidden="@(active == "BotControl" ? null : "hidden")">
    <!-- Status poll failure (settings.js shows it; the last known values stay on screen) -->
    <div id="botStatusError" class="hidden mb-6" role="status">
        <partial name="Shared/Components/_Alert" model='new AlertViewModel { Variant = AlertVariant.Warning, Title = "Bot status unavailable", Message = "The status could not be loaded. The values below may be out of date. Trying again every 5 seconds." }' />
        <button type="button" class="btn btn-secondary mt-3" data-status-retry>Try now</button>
    </div>

    <div id="botShutdownNotice" class="hidden mb-6" role="status">
        <partial name="Shared/Components/_Alert" model='new AlertViewModel { Variant = AlertVariant.Warning, Title = "Shutdown requested", Message = "The bot is stopping and will not restart by itself. Start it again on the server when you need it." }' />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6" data-bot-control-status>
        <!-- Bot Status Card -->
        <div class="lg:col-span-2 min-w-0">
            <div class="bg-bg-secondary border border-border-primary rounded-lg">
                <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
                    <h2 class="text-lg font-semibold text-text-primary">Bot status</h2>
                    <p class="text-sm text-text-secondary mt-1">Live connection status</p>
                </div>
                <div class="p-4 sm:p-6">
                    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
                        <div class="min-w-0">
                            <dt class="text-sm font-medium text-text-secondary mb-1">Status</dt>
                            <dd class="flex items-center gap-2 min-w-0">
                                <span class="w-2.5 h-2.5 flex-shrink-0 rounded-full @(Model.BotControlViewModel.Status.ConnectionState == "Connected" ? "bg-success animate-pulse" : "bg-error")" data-status-indicator aria-hidden="true"></span>
                                <span class="text-base sm:text-lg font-semibold text-text-primary break-words min-w-0" data-connection-state>@Model.BotControlViewModel.Status.ConnectionState</span>
                            </dd>
                        </div>
                        <div class="min-w-0">
                            <dt class="text-sm font-medium text-text-secondary mb-1">Uptime</dt>
                            <dd class="text-base sm:text-lg font-semibold text-text-primary" data-uptime>@Model.BotControlViewModel.Status.UptimeFormatted</dd>
                        </div>
                        <div class="min-w-0">
                            <dt class="text-sm font-medium text-text-secondary mb-1">Latency</dt>
                            <dd class="text-base sm:text-lg font-semibold text-text-primary" data-latency>@Model.BotControlViewModel.Status.LatencyMs ms</dd>
                        </div>
                        <div class="min-w-0">
                            <dt class="text-sm font-medium text-text-secondary mb-1">Servers</dt>
                            <dd class="text-base sm:text-lg font-semibold text-text-primary" data-guild-count>@Model.BotControlViewModel.Status.GuildCount</dd>
                        </div>
                    </dl>

                    <div class="mt-4 pt-4 border-t border-border-primary">
                        <p class="text-xs text-text-secondary">
                            Updates every 5 seconds. Last updated: <span data-last-updated>when the page loaded</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions Card -->
        <div class="min-w-0">
            <div class="bg-bg-secondary border border-border-primary rounded-lg">
                <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
                    <h2 class="text-lg font-semibold text-text-primary">Actions</h2>
                    <p class="text-sm text-text-secondary mt-1">Restart or stop the bot</p>
                </div>
                <div class="p-4 sm:p-6 space-y-4">
                    <button type="button" class="btn w-full justify-center bg-warning hover:bg-warning-hover active:bg-warning-active text-on-warning" data-modal-open="restartModal" data-restart-button>
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        Restart bot
                    </button>
                    <p class="text-xs text-text-secondary text-center">
                        Reconnects to Discord without stopping the application.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Configuration Card -->
    <div class="mb-6">
        <div class="bg-bg-secondary border border-border-primary rounded-lg">
            <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
                <h2 class="text-lg font-semibold text-text-primary">Configuration</h2>
                <p class="text-sm text-text-secondary mt-1">How the bot is set up right now (read-only)</p>
            </div>
            <div class="p-4 sm:p-6">
                <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                    <div class="space-y-1 min-w-0">
                        <dt class="text-sm font-medium text-text-secondary">Bot token</dt>
                        <dd class="text-sm font-mono text-text-primary bg-bg-primary px-3 py-2 rounded-md border border-border-primary break-all">@Model.BotControlViewModel.Configuration.TokenMasked</dd>
                    </div>
                    <div class="space-y-1 min-w-0">
                        <dt class="text-sm font-medium text-text-secondary">Test server ID</dt>
                        <dd class="text-sm font-mono text-text-primary bg-bg-primary px-3 py-2 rounded-md border border-border-primary break-all">@(Model.BotControlViewModel.Configuration.HasTestGuild ? Model.BotControlViewModel.Configuration.TestGuildId.ToString() : "Not configured")</dd>
                    </div>
                    <div class="space-y-1 min-w-0">
                        <dt class="text-sm font-medium text-text-secondary">Database</dt>
                        <dd class="text-sm text-text-primary bg-bg-primary px-3 py-2 rounded-md border border-border-primary">@Model.BotControlViewModel.Configuration.DatabaseProvider</dd>
                    </div>
                    <div class="space-y-1 min-w-0">
                        <dt class="text-sm font-medium text-text-secondary">Default rate limit</dt>
                        <dd class="text-sm text-text-primary bg-bg-primary px-3 py-2 rounded-md border border-border-primary">@Model.BotControlViewModel.Configuration.DefaultRateLimitInvokes @(Model.BotControlViewModel.Configuration.DefaultRateLimitInvokes == 1 ? "use" : "uses") per @Model.BotControlViewModel.Configuration.DefaultRateLimitPeriodSeconds seconds</dd>
                    </div>
                    <div class="space-y-1 min-w-0">
                        <dt class="text-sm font-medium text-text-secondary">Discord.NET version</dt>
                        <dd class="text-sm text-text-primary bg-bg-primary px-3 py-2 rounded-md border border-border-primary break-words">@Model.BotControlViewModel.Configuration.DiscordNetVersion</dd>
                    </div>
                    <div class="space-y-1 min-w-0">
                        <dt class="text-sm font-medium text-text-secondary">Application version</dt>
                        <dd class="text-sm text-text-primary bg-bg-primary px-3 py-2 rounded-md border border-border-primary break-words">@Model.BotControlViewModel.Configuration.AppVersion</dd>
                    </div>
                    <div class="space-y-1 min-w-0">
                        <dt class="text-sm font-medium text-text-secondary">.NET runtime</dt>
                        <dd class="text-sm text-text-primary bg-bg-primary px-3 py-2 rounded-md border border-border-primary break-words">@Model.BotControlViewModel.Configuration.RuntimeVersion</dd>
                    </div>
                    <div class="space-y-1 min-w-0">
                        <dt class="text-sm font-medium text-text-secondary">Started</dt>
                        <dd class="text-sm text-text-primary bg-bg-primary px-3 py-2 rounded-md border border-border-primary">
                            <time datetime="@DisplayFormat.Iso(Model.BotControlViewModel.Status.StartTime)" data-utc="@DisplayFormat.Iso(Model.BotControlViewModel.Status.StartTime)" data-format="datetime">@DisplayFormat.Date(Model.BotControlViewModel.Status.StartTime)</time>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>

    <!-- Bot Shutdown -->
    <div class="border-2 border-error rounded-lg p-4 sm:p-6 bg-error/5 mb-6">
        <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-error/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <h3 class="text-lg font-semibold text-error">Shut down the bot</h3>
                <p class="text-sm text-text-secondary mt-1">
                    This stops every bot feature. The bot stays off until someone starts it again on the server.
                    You will be asked to type SHUTDOWN first.
                </p>
                <div class="mt-4">
                    <button type="button" class="btn btn-danger" data-modal-open="shutdownModal" data-shutdown-button>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                        Shut down bot
                    </button>
                </div>
            </div>
        </div>
    </div>

    <partial name="Components/_ConfirmationModal" model="Model.RestartModal" />
    <partial name="Components/_TypedConfirmationModal" model="Model.ShutdownModal" />
</section>

<!-- AI Models -->
<section id="@PanelId("AiModels")" data-tab-panel-for="@tabsId" data-tab-id="AiModels" role="tabpanel"
         aria-labelledby="@(tabsId)-tab-AiModels" tabindex="0" class="@PanelState("AiModels")" hidden="@(active == "AiModels" ? null : "hidden")">
    <!-- Per-mode defaults: saved through the same handler as every other tab (SaveCategory, category AiModels) -->
    <form id="aiModelsDefaultsForm" method="post" class="bg-bg-secondary border border-border-primary rounded-lg mb-6"
          data-settings-form="AiModels" data-settings-handler="SaveCategory" data-unsaved-changes>
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">Default model for each mode</h2>
            <p class="text-sm text-text-secondary mt-1">
                The model each mode uses by default. It applies from the next message; no restart is needed.
            </p>
        </div>
        <div class="p-4 sm:p-6">
            <div id="aiModelsDefaultsError" class="hidden mb-4" role="status">
                <partial name="Shared/Components/_Alert" model='new AlertViewModel { Variant = AlertVariant.Error, Title = "Current defaults unavailable", Message = "" }' />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                @foreach (var setting in Model.ViewModel.AiModelsSettings)
                {
                    var fieldId = setting.Key.Replace(":", "-").Replace(".", "-");
                    var noEnabledModels = Model.ViewModel.AiModelsEnabledSlugCount == 0;
                    var configuredSlug = Model.ViewModel.AiModelsConfiguredSlugs.GetValueOrDefault(setting.Key);
                    var emptyOptionLabel = string.IsNullOrEmpty(configuredSlug)
                        ? "Use configured value"
                        : $"Use configured value ({configuredSlug})";
                    <div class="p-4 bg-bg-primary border border-border-primary rounded-lg min-w-0" data-setting-key="@setting.Key">
                        @{
                            var selectViewModel = new FormSelectViewModel
                            {
                                Id = $"setting_{fieldId}",
                                Name = $"FormSettings[{setting.Key}]",
                                Label = setting.DisplayName,
                                SelectedValue = setting.Value,
                                Options = (setting.AllowedValues ?? new List<string>())
                                    .Select(v => new SelectOption { Value = v, Text = v == "" ? emptyOptionLabel : v })
                                    .ToList(),
                                IsRequired = false,
                                AdditionalAttributes = new Dictionary<string, string>
                                {
                                    { "data-mode-select", "true" },
                                    { "data-field-id", fieldId }
                                }
                            };
                        }
                        <partial name="Components/_FormSelect" model="selectViewModel" />
                        <p id="aiModelDefaultDetail-@fieldId" class="text-xs font-mono text-text-secondary mt-2 break-words"></p>
                        <div id="aiModelDefaultBadges-@fieldId" class="flex flex-wrap gap-1.5 mt-2">
                            <span class="badge badge-gray">Loading…</span>
                        </div>
                        <p id="aiModelDefaultHint-@fieldId" class="text-xs text-text-secondary mt-2 @(noEnabledModels ? "" : "hidden")">
                            No models are enabled yet. Enable one in the catalog below to pick it here.
                        </p>
                        <p id="aiModelDefaultFieldError-@fieldId" class="hidden text-xs text-error mt-1"></p>
                    </div>
                }
            </div>
        </div>
        <partial name="_SettingsTabFooter" model='new SettingsTabFooterViewModel { Category = "AiModels", SaveText = "Save defaults", ResetModalId = "reset-AiModels" }' />
    </form>

    <!-- Catalog (each toggle saves at once; there is nothing to "Save" here) -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg mb-6">
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">Model catalog</h2>
            <p class="text-sm text-text-secondary mt-1">Choose which OpenRouter models the bot may use. Nothing is on by default. Each switch saves as soon as you flip it.</p>
        </div>

        <!-- Toolbar -->
        <div class="p-4 sm:p-6 border-b border-border-primary">
            <div class="flex flex-col lg:flex-row lg:items-end gap-4">
                <div class="flex-1 min-w-0">
                    <label for="aiModelsSearch" class="block text-xs font-medium text-text-secondary mb-1.5">Search</label>
                    <input type="search" id="aiModelsSearch" placeholder="Search name or slug…" autocomplete="off" class="form-input w-full" />
                </div>
                <div class="w-full lg:w-56">
                    <label for="aiModelsVendor" class="block text-xs font-medium text-text-secondary mb-1.5">Vendor</label>
                    <select id="aiModelsVendor" class="form-select w-full">
                        <option value="">All vendors</option>
                    </select>
                </div>
                <div class="flex flex-wrap items-center gap-4">
                    <label class="flex items-center gap-2 text-sm text-text-secondary cursor-pointer">
                        <input type="checkbox" id="aiModelsEnabledOnly" class="rounded border-border-primary" />
                        Enabled only
                    </label>
                    <label class="flex items-center gap-2 text-sm text-text-secondary cursor-pointer">
                        <input type="checkbox" id="aiModelsAvailableOnly" class="rounded border-border-primary" />
                        Available only
                    </label>
                    <label class="flex items-center gap-2 text-sm text-text-secondary cursor-pointer">
                        <input type="checkbox" id="aiModelsToolsOnly" class="rounded border-border-primary" />
                        Tool-capable only
                    </label>
                </div>
                <div class="flex flex-wrap items-center gap-3 lg:ml-auto">
                    <span id="aiModelsLastRefresh" class="text-xs text-text-secondary">Never refreshed</span>
                    <button type="button" id="aiModelsRefreshBtn" class="btn btn-secondary whitespace-nowrap">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        Refresh from OpenRouter
                    </button>
                </div>
            </div>
        </div>

        <!-- Empty state (catalog never refreshed / no API key) -->
        <div id="aiModelsEmptyState" class="hidden p-6">
            <partial name="Components/_EmptyState" model='new EmptyStateViewModel
            {
                Type = EmptyStateType.NoData,
                Title = "No models in the catalog yet",
                Description = "Refresh from OpenRouter to load the current model list, then choose which ones the bot may use."
            }' />
        </div>

        <!-- No-matches state (catalog has rows, but the current filters exclude all of them) -->
        <div id="aiModelsNoMatchesState" class="hidden p-6">
            <partial name="Components/_EmptyState" model='new EmptyStateViewModel
            {
                Type = EmptyStateType.NoResults,
                Title = "No models match",
                Description = "No model fits the search and filters you chose.",
                PrimaryActionText = "Clear filters",
                PrimaryActionIconPath = "",
                PrimaryActionAttributes = new Dictionary<string, string> { ["id"] = "aiModelsClearFiltersBtn" }
            }' />
        </div>

        <!-- Inline error (catalog fetch failed) -->
        <div id="aiModelsErrorState" class="hidden p-6">
            <partial name="Shared/Components/_Alert" model='new AlertViewModel { Variant = AlertVariant.Error, Title = "The catalog could not be loaded", Message = "" }' />
            <button type="button" class="btn btn-secondary mt-3" id="aiModelsRetryBtn">Try again</button>
        </div>

        <!-- Table -->
        <div id="aiModelsTableWrapper" class="table-container overflow-x-auto">
            <table class="w-full min-w-[820px]">
                <caption class="sr-only">OpenRouter model catalog</caption>
                <thead class="bg-bg-tertiary border-b border-border-primary">
                    <tr>
                        <th scope="col" class="table-cell-header text-left cursor-pointer select-none" data-sort-key="Name" tabindex="0" aria-sort="none">Model</th>
                        <th scope="col" class="table-cell-header text-left cursor-pointer select-none" data-sort-key="Vendor" tabindex="0" aria-sort="none">Vendor</th>
                        <th scope="col" class="table-cell-header text-right cursor-pointer select-none" data-sort-key="PromptPrice" tabindex="0" aria-sort="none">Prompt $/M</th>
                        <th scope="col" class="table-cell-header text-right cursor-pointer select-none" data-sort-key="CompletionPrice" tabindex="0" aria-sort="none">Completion $/M</th>
                        <th scope="col" class="table-cell-header text-right cursor-pointer select-none" data-sort-key="ContextLength" tabindex="0" aria-sort="none">Context</th>
                        <th scope="col" class="table-cell-header text-left cursor-pointer select-none" data-sort-key="ReleasedAt" tabindex="0" aria-sort="none">Released</th>
                        <th scope="col" class="table-cell-header text-center">Tools</th>
                        <th scope="col" class="table-cell-header text-center">Enabled</th>
                    </tr>
                </thead>
                <tbody id="aiModelsTableBody" class="table-body">
                    <tr><td colspan="8" class="table-cell text-sm text-text-secondary">Loading…</td></tr>
                </tbody>
            </table>
        </div>
        <div class="px-4 sm:px-6 py-3 border-t border-border-primary">
            <p id="aiModelsCount" class="text-xs text-text-secondary" aria-live="polite"></p>
        </div>
    </div>
</section>

<!-- Appearance (SuperAdmin only) -->
@if (Model.IsSuperAdmin)
{
    <section id="@PanelId("Appearance")" data-tab-panel-for="@tabsId" data-tab-id="Appearance" role="tabpanel"
             aria-labelledby="@(tabsId)-tab-Appearance" tabindex="0" class="@PanelState("Appearance")" hidden="@(active == "Appearance" ? null : "hidden")">
        <form method="post" class="bg-bg-secondary border border-border-primary rounded-lg mb-6"
              data-settings-form="Appearance" data-settings-handler="SaveAppearance" data-unsaved-changes>
            <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
                <h2 class="text-lg font-semibold text-text-primary">Appearance settings</h2>
                <p class="text-sm text-text-secondary mt-1">The default theme for the portal</p>
            </div>
            <div class="p-4 sm:p-6">
                <div class="max-w-md">
                    @{
                        var themeSelect = new FormSelectViewModel
                        {
                            Id = "SelectedThemeId",
                            Name = "SelectedThemeId",
                            Label = "Default theme",
                            Placeholder = null,
                            Options = Model.AvailableThemes.Select(t => new SelectOption { Value = t.Value, Text = t.Text }).ToList(),
                            SelectedValue = Model.AvailableThemes.FirstOrDefault(t => t.Selected)?.Value,
                            HelpText = "Used for everyone who has not chosen a theme of their own."
                        };
                    }
                    <partial name="Components/_FormSelect" model="themeSelect" />
                </div>
            </div>
            <partial name="_SettingsTabFooter" model='new SettingsTabFooterViewModel { Category = "Appearance", ResetModalId = "reset-Appearance" }' />
        </form>
    </section>
}

<!-- Danger zone -->
<div class="border-2 border-error rounded-lg p-4 sm:p-6 bg-error/5">
    <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-10 h-10 rounded-full bg-error/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <div class="flex-1 min-w-0">
            <h2 class="text-lg font-semibold text-error">Danger zone</h2>
            <p class="text-sm text-text-secondary mt-1">
                Resetting all settings puts every tab back to its default values. This cannot be undone.
            </p>
            <div class="mt-4">
                <button type="button" class="btn btn-danger" data-modal-open="reset-all">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Reset all settings
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reset confirmations. They post to the page, which redirects, so the page reloads once with the outcome as a toast. -->
@foreach (var reset in resetLabels)
{
    if (reset.Key == "Appearance" && !Model.IsSuperAdmin)
    {
        continue;
    }
    var resetHandler = reset.Key == "Appearance" ? "ResetAppearance" : "ResetCategory";
    <partial name="Components/_ConfirmationModal" model='new ConfirmationModalViewModel
    {
        Id = $"reset-{reset.Key}",
        Title = $"Reset {reset.Value} settings?",
        Message = $"Every {reset.Value} setting goes back to its default. Unsaved changes on this page are discarded. This cannot be undone.",
        ConfirmText = "Reset settings",
        Variant = ConfirmationVariant.Warning,
        FormAction = Url.Page("/Admin/Settings", new { category = reset.Key }),
        FormHandler = resetHandler
    }' />
}
<partial name="Components/_ConfirmationModal" model='new ConfirmationModalViewModel
{
    Id = "reset-all",
    Title = "Reset all settings?",
    Message = "Every setting on every tab goes back to its default. Unsaved changes on this page are discarded. This cannot be undone.",
    ConfirmText = "Reset all settings",
    Variant = ConfirmationVariant.Danger,
    FormAction = Url.Page("/Admin/Settings", activeQuery),
    FormHandler = "ResetAll"
}' />

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/tab-panel.js" asp-append-version="true"></script>
    <script src="~/js/settings.js" asp-append-version="true"></script>
    <script src="~/js/llm-models.js" asp-append-version="true"></script>
}

@page
@model DiscordBot.Bot.Pages.Admin.UserPurgeModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = "User Data Purge";

    var idError = ViewData.ModelState[nameof(Model.DiscordUserId)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var userLabel = string.IsNullOrEmpty(Model.DiscordUsername)
        ? $"user {Model.DiscordUserId}"
        : $"{Model.DiscordUsername} (ID {Model.DiscordUserId})";

    var userIdInput = new FormInputViewModel
    {
        Id = "discord-user-id",
        Name = "DiscordUserId",
        Label = "Discord user ID",
        Type = "text",
        Value = Model.DiscordUserId,
        Placeholder = "123456789012345678",
        Autocomplete = "off",
        InputMode = "numeric",
        Pattern = "[0-9]*",
        IsRequired = true,
        HelpText = "In Discord, turn on Developer Mode, then right-click the user and choose Copy User ID.",
        ValidationState = idError != null ? ValidationState.Error : ValidationState.None,
        ValidationMessage = idError
    };
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="page-title">User Data Purge</h1>
        <p class="mt-1 text-sm text-text-secondary">Permanently delete everything stored about one Discord user (GDPR right to erasure)</p>
    </div>

    <!-- Warning Notice -->
    <div class="mb-6 p-4 bg-error-bg border border-error-border rounded-lg">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-error flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <div>
                <p class="text-sm font-semibold text-error">Warning: this cannot be undone</p>
                <p class="text-sm text-error/90 mt-1">
                    A purge permanently deletes the user's data from the system. Use it with care.
                </p>
            </div>
        </div>
    </div>

    <!-- Purge Result (shown once, after the redirect) -->
    @if (Model.Outcome is { } outcome)
    {
        <div class="bg-success-bg border border-success-border rounded-lg p-6 mb-6">
            <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-success flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <div class="flex-1 min-w-0">
                    <h2 class="text-lg font-semibold text-success mb-2">Purge complete</h2>
                    <p class="text-sm text-success/90 mb-4 break-words">
                        Deleted all data for @(string.IsNullOrEmpty(outcome.Username) ? "the user" : outcome.Username)
                        (ID <span class="font-mono">@outcome.DiscordUserId</span>).
                    </p>

                    <div class="bg-bg-secondary rounded-lg p-4 border border-success-border">
                        <p class="text-xs font-semibold text-text-primary uppercase tracking-wider mb-2">Records removed</p>
                        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
                            @foreach (var kvp in outcome.DeletedCounts.Where(x => x.Value > 0))
                            {
                                <li class="text-xs">
                                    <span class="text-text-secondary">@PurgeDisplay.CountLabel(kvp.Key):</span>
                                    <span class="text-text-primary font-mono ml-1">@kvp.Value.ToString("N0")</span>
                                </li>
                            }
                        </ul>
                        <div class="mt-3 pt-3 border-t border-border-primary">
                            <span class="text-sm font-semibold text-text-primary">Total: </span>
                            <span class="text-sm font-mono text-text-primary">@outcome.DeletedCounts.Values.Sum().ToString("N0")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(outcome.CorrelationId))
                    {
                        <p class="text-xs text-success/80 mt-4 break-all">
                            Audit reference: <span class="font-mono">@outcome.CorrelationId</span>
                        </p>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Preview Load Error -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6">
            <partial name="Shared/Components/_Alert" model="new AlertViewModel { Variant = AlertVariant.Error, Message = Model.ErrorMessage, IsDismissible = false }" />
        </div>
    }

    <!-- Input Form -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 mb-6">
        <h2 class="text-lg font-semibold text-text-primary mb-4">Find a user</h2>
        <form method="get" class="space-y-4" data-focus-first-error>
            <partial name="Shared/Components/_FormInput" model="userIdInput" />
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    Preview data
                </button>
                @if (!string.IsNullOrEmpty(Model.DiscordUserId))
                {
                    <a asp-page="UserPurge" class="btn btn-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    <!-- Cannot Purge Warning -->
    @if (!string.IsNullOrEmpty(Model.CannotPurgeReason))
    {
        <div class="mb-6">
            <partial name="Shared/Components/_Alert" model='new AlertViewModel { Variant = AlertVariant.Warning, Title = "This user cannot be purged", Message = Model.CannotPurgeReason }' />
        </div>
    }

    <!-- Preview Results -->
    @if (Model.ShowPreview && Model.PreviewResult != null)
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-6">
            <div class="px-6 py-4 border-b border-border-primary bg-bg-tertiary">
                <h2 class="text-lg font-semibold text-text-primary">Preview: data that would be deleted</h2>
                <p class="text-sm text-text-secondary mt-1 break-words">
                    These records will be deleted permanently for
                    @if (!string.IsNullOrEmpty(Model.DiscordUsername))
                    {
                        <span class="font-semibold text-text-primary">@Model.DiscordUsername</span>
                        @:(ID <span class="font-mono text-text-primary">@Model.DiscordUserId</span>).
                    }
                    else
                    {
                        @:the user with ID <span class="font-mono text-text-primary">@Model.DiscordUserId</span>.
                    }
                </p>
            </div>

            <div class="p-6">
                @if (Model.PreviewResult.DeletedCounts.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-border-primary">
                            <thead>
                                <tr>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                                        Data
                                    </th>
                                    <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">
                                        Records
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border-primary">
                                @foreach (var kvp in Model.PreviewResult.DeletedCounts.OrderByDescending(x => x.Value))
                                {
                                    <tr class="hover:bg-bg-tertiary/50 transition-colors">
                                        <td class="px-4 py-3 text-sm text-text-primary">
                                            @if (PurgeDisplay.IsAnonymized(kvp.Key))
                                            {
                                                <span class="inline-flex flex-wrap items-center gap-2">
                                                    @PurgeDisplay.CountLabel(kvp.Key[..^"_Anonymized".Length])
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info-bg text-info border border-info-border">
                                                        Anonymized, not deleted
                                                    </span>
                                                </span>
                                            }
                                            else
                                            {
                                                @PurgeDisplay.CountLabel(kvp.Key)
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-sm text-text-primary text-right font-mono">
                                            @kvp.Value.ToString("N0")
                                        </td>
                                    </tr>
                                }
                                <tr class="bg-bg-tertiary font-semibold">
                                    <td class="px-4 py-3 text-sm text-text-primary">Total records</td>
                                    <td class="px-4 py-3 text-sm text-text-primary text-right font-mono">
                                        @Model.PreviewResult.DeletedCounts.Values.Sum().ToString("N0")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Info Notice -->
                    <div class="mt-6 p-4 bg-info-bg border border-info-border rounded-md">
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-info flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                            <div class="text-sm text-info">
                                <p class="font-semibold mb-1">About anonymized records</p>
                                <p class="text-info/90">
                                    Rat Watch records and watches are anonymized instead of deleted, so the history stays complete. The user's ID in them is replaced with 0.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Purge Confirmation Form: posts, then redirects, so a refresh never repeats the purge -->
                    <div class="mt-6 pt-6 border-t border-border-primary">
                        <form method="post" id="purge-form" data-submit-guard data-purge-form>
                            <input type="hidden" name="DiscordUserId" value="@Model.DiscordUserId" />
                            <button type="submit" class="btn btn-error"
                                    data-purge-confirm
                                    data-confirm-title="Permanently delete user data"
                                    data-confirm-message="You are about to permanently delete all data for @userLabel. This cannot be undone."
                                    data-confirm-required="@Model.DiscordUserId"
                                    data-confirm-label="Type the user ID @Model.DiscordUserId to confirm"
                                    data-confirm-action="Purge user data"
                                    data-loading-text="Purging...">
                                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                                Purge data for @(string.IsNullOrEmpty(Model.DiscordUsername) ? "this user" : Model.DiscordUsername)
                            </button>
                            <p class="mt-2 text-xs text-text-secondary">
                                You will be asked to type the user ID before anything is deleted.
                            </p>
                        </form>
                    </div>
                }
                else
                {
                    <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                        Type = EmptyStateType.NoResults,
                        Title = "No data found",
                        Description = "Nothing is stored for this Discord user ID. Check the ID, or the user may never have used the bot.",
                        HeadingLevel = 3
                    }' />
                }
            </div>
        </div>
    }

    <!-- Additional Information -->
    <div class="mt-6 p-4 bg-info-bg border border-info-border rounded-md">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-info flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <div class="text-sm text-info">
                <p class="font-semibold mb-1">GDPR compliance</p>
                <p class="text-info/90">
                    This tool covers the "right to be forgotten". All of the user's data is deleted or anonymized, and the purge is recorded in the audit log.
                    Users can also ask for deletion themselves with the <code class="px-1.5 py-0.5 bg-info/20 rounded font-mono text-xs">/privacy</code> command in Discord.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/form-focus.js" asp-append-version="true"></script>
    <script src="~/js/purge.js" asp-append-version="true"></script>
}

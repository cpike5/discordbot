@page "/Admin/Currency"
@model DiscordBot.Bot.Pages.Admin.Currency.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = "Currency";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-text-primary">Bot-wide Currency</h1>
    <p class="text-sm text-text-secondary mt-1">
        Currencies that exist across every server, including the credit that will back paid features.
        Guild administrators can price their own features in these; only you can create or change them.
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model="new AlertViewModel { Variant = AlertVariant.Success, Message = Model.SuccessMessage, IsDismissible = true }" />
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model="new AlertViewModel { Variant = AlertVariant.Error, Message = Model.ErrorMessage, IsDismissible = true }" />
    </div>
}

<div class="grid grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Currencies</p>
        <p class="text-xl font-semibold text-text-primary">@Model.ViewModel.Currencies.Count</p>
    </div>
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Wallets</p>
        <p class="text-xl font-semibold text-text-primary">@Model.ViewModel.TotalHolders.ToString("N0")</p>
    </div>
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
        <p class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Units in circulation</p>
        <p class="text-xl font-semibold text-text-primary">@Model.ViewModel.TotalCirculation.ToString("N0")</p>
    </div>
</div>

<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <h2 class="text-lg font-semibold text-text-primary">Currencies</h2>
    <button type="button" data-currency-action="create"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        New Currency
    </button>
</div>

@if (Model.ViewModel.Currencies.Count == 0)
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg mb-8">
        <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
            Title = "No bot-wide currencies",
            Description = "Create one to hold credit that gates paid features. Turn transfers and debt off so it cannot be resold or overdrawn."
        }' />
    </div>
}
else
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-x-auto mb-8">
        <table class="min-w-full text-sm">
            <thead>
                <tr class="border-b border-border-primary">
                    <th scope="col" class="text-left px-4 py-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">Currency</th>
                    <th scope="col" class="text-left px-4 py-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">Holders</th>
                    <th scope="col" class="text-left px-4 py-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">In circulation</th>
                    <th scope="col" class="text-left px-4 py-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">Rules</th>
                    <th scope="col" class="text-right px-4 py-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ViewModel.Currencies)
                {
                    var currency = item.Currency;
                    <tr class="border-b border-border-primary last:border-0 @(currency.IsActive ? "" : "opacity-70")">
                        <td class="px-4 py-3">
                            <span class="text-text-primary"><span class="mr-2" aria-hidden="true">@currency.Symbol</span>@currency.Name</span>
                            @if (!currency.IsActive)
                            {
                                <span class="ml-2 px-2 py-0.5 text-xs font-medium rounded-full bg-bg-tertiary text-text-tertiary border border-border-primary">Deactivated</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-text-secondary">@item.HolderCount.ToString("N0")</td>
                        <td class="px-4 py-3 text-text-secondary">@item.Circulation.ToString("N0") @currency.Symbol</td>
                        <td class="px-4 py-3 text-text-secondary">
                            @(currency.IsTransferable ? "Transferable" : "Not transferable")@(currency.AllowNegative ? $" • debt to {currency.DebtFloor}" : "")
                        </td>
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                            <button type="button" data-admin-currency-select="@currency.Id" data-currency-symbol="@currency.Symbol"
                                    class="px-3 py-1.5 text-xs font-medium text-white bg-accent-blue border border-accent-blue rounded-md hover:bg-accent-blue/80 transition-colors">
                                Wallets
                            </button>
                            <button type="button" data-currency-action="authorities" data-currency-id="@currency.Id" data-currency-name="@currency.Name"
                                    class="px-3 py-1.5 text-xs font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors ml-1">
                                Mint authorities
                            </button>
                            @if (currency.IsActive)
                            {
                                <button type="button" data-currency-action="edit" data-currency-id="@currency.Id"
                                        class="px-3 py-1.5 text-xs font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors ml-1">
                                    Edit
                                </button>
                                <button type="button" data-currency-action="deactivate" data-currency-id="@currency.Id" data-currency-name="@currency.Name"
                                        class="px-3 py-1.5 text-xs font-medium text-error border border-error/40 rounded-md hover:bg-error/10 transition-colors ml-1">
                                    Deactivate
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mb-4">
        <h2 class="text-lg font-semibold text-text-primary">Wallets &amp; Ledger</h2>
        <p id="admin-wallet-subject" class="text-sm text-text-secondary">Pick a currency above to read its holders across every server.</p>
    </div>

    <partial name="Shared/Components/_CurrencyWalletPanel" model="Model.WalletPanel" />
}

<!-- Currency editor modal -->
<div id="currency-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="currency-modal-title">
    <div class="bg-bg-secondary border border-border-primary rounded-lg w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border-primary">
            <h3 id="currency-modal-title" class="text-base font-semibold text-text-primary">New Currency</h3>
            <button type="button" data-currency-action="close-modal" class="text-text-tertiary hover:text-text-primary" aria-label="Close">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form id="currency-form" class="px-5 py-4 space-y-4" novalidate>
            <div id="currency-form-error" class="hidden text-sm text-error bg-error/10 border border-error/40 rounded-md px-3 py-2"></div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="sm:col-span-2">
                    <label for="currency-name" class="block text-sm font-medium text-text-secondary mb-1">Name</label>
                    <input type="text" id="currency-name" maxlength="64" required
                           class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                </div>
                <div>
                    <label for="currency-symbol" class="block text-sm font-medium text-text-secondary mb-1">Symbol</label>
                    <input type="text" id="currency-symbol" maxlength="16" required placeholder="💳"
                           class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                </div>
            </div>

            <label class="flex items-start gap-2 cursor-pointer">
                <input type="checkbox" id="currency-transferable"
                       class="mt-1 w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange" />
                <span>
                    <span class="block text-sm text-text-primary">Members can pay each other</span>
                    <span class="block text-xs text-text-tertiary">Leave off for credit: transfers are how a mint mistake spreads.</span>
                </span>
            </label>

            <label class="flex items-start gap-2 cursor-pointer">
                <input type="checkbox" id="currency-allow-negative"
                       class="mt-1 w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange" />
                <span>
                    <span class="block text-sm text-text-primary">Fines can push a balance into debt</span>
                    <span class="block text-xs text-text-tertiary">Fines are a guild action and never apply to a bot-wide currency, so this normally stays off.</span>
                </span>
            </label>

            <div id="currency-debt-floor-row" class="hidden">
                <label for="currency-debt-floor" class="block text-sm font-medium text-text-secondary mb-1">Debt floor</label>
                <input type="number" id="currency-debt-floor" max="-1" step="1"
                       class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                <p class="text-xs text-text-tertiary mt-1">The most negative balance a fine may reach. Stored negative, e.g. -100.</p>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" data-currency-action="close-modal"
                        class="px-4 py-2 text-sm font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                    Cancel
                </button>
                <button type="submit" id="currency-save"
                        class="px-4 py-2 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Mint authorities modal -->
<div id="authorities-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="authorities-modal-title">
    <div class="bg-bg-secondary border border-border-primary rounded-lg w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border-primary">
            <h3 id="authorities-modal-title" class="text-base font-semibold text-text-primary">Mint Authorities</h3>
            <button type="button" data-currency-action="close-authorities" class="text-text-tertiary hover:text-text-primary" aria-label="Close">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="px-5 py-4 space-y-4">
            <p class="text-sm text-text-secondary">
                Minting is the only way units are created. A bot-wide currency has no roles, so grants here are users, or the
                system principal a background job mints as.
            </p>
            <div id="authorities-error" class="hidden text-sm text-error bg-error/10 border border-error/40 rounded-md px-3 py-2"></div>
            <div id="authorities-list" class="space-y-2 text-sm text-text-secondary">Loading…</div>

            <form id="authority-form" class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-3 border-t border-border-primary" novalidate>
                <select id="authority-type" class="px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue">
                    <option value="@((int)MintPrincipalType.User)">User</option>
                    <option value="@((int)MintPrincipalType.System)">System</option>
                </select>
                <input type="text" id="authority-id" inputmode="numeric" placeholder="Discord user ID"
                       class="px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                <button type="submit" class="px-3 py-2 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
                    Grant
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.currencyPage = {
            scope: 'global',
            listUrl: '/api/admin/currencies',
            createUrl: '/api/admin/currencies'
        };
    </script>
    <script src="~/js/currency/currency-manage.js" asp-append-version="true"></script>
    <script src="~/js/currency/currency-wallets.js" asp-append-version="true"></script>
    <script>
        // The bot-wide page starts with no currency selected; picking one points the shared wallet
        // panel at it.
        document.addEventListener('click', function (event) {
            const target = event.target.closest('[data-admin-currency-select]');
            if (!target || !window.CurrencyWallets) return;

            const symbol = target.getAttribute('data-currency-symbol') || '';
            const row = target.closest('tr');
            const name = row ? row.querySelector('td')?.textContent?.trim() : '';

            document.getElementById('admin-wallet-subject').textContent =
                name ? `Holders of ${name} across every server.` : 'Holders across every server.';

            window.CurrencyWallets.setCurrency(target.getAttribute('data-admin-currency-select'), symbol);
        });
    </script>
}

@page
@model DiscordBot.Bot.Pages.Admin.BulkPurgeModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = "Bulk Data Purge";

    string? FieldError(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
    ValidationState FieldState(string key) => FieldError(key) != null ? ValidationState.Error : ValidationState.None;

    var entityCards = Enum.GetValues<BulkPurgeEntityType>().Select(t => new RadioCardViewModel
    {
        Value = t.ToString(),
        Title = t.DisplayName(),
        Description = t.Description()
    }).ToList();

    var preview = Model.PreviewResult;
    var hasRecords = preview is { Success: true, EstimatedCount: > 0 };
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="page-title">Bulk Data Purge</h1>
        <p class="mt-1 text-sm text-text-secondary">Permanently delete historical data by record type, date range and server</p>
    </div>

    <!-- Warning Notice -->
    <div class="mb-6 p-4 bg-error-bg border border-error-border rounded-lg">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-error flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <div>
                <p class="text-sm font-semibold text-error">Warning: this cannot be undone</p>
                <p class="text-sm text-error/90 mt-1">
                    A purge permanently deletes data from the database. Always preview before you run it.
                </p>
            </div>
        </div>
    </div>

    @if (Model.Outcome is { } outcome)
    {
        <div class="mb-6">
            <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                Variant = AlertVariant.Success,
                Title = "Purge complete",
                Message = $"Deleted {DisplayFormat.Plural(outcome.DeletedCount, "record")} from {outcome.EntityType.DisplayNameLower()}.{(string.IsNullOrEmpty(outcome.CorrelationId) ? "" : $" Audit reference: {outcome.CorrelationId}")}",
                IsDismissible = true
            }' />
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6">
            <partial name="Shared/Components/_Alert" model="new AlertViewModel { Variant = AlertVariant.Error, Message = Model.ErrorMessage }" />
        </div>
    }

    <!-- Criteria form: a GET, so the preview has its own address and a refresh only previews again -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 mb-6">
        <h2 class="text-lg font-semibold text-text-primary mb-4">Choose what to purge</h2>
        <form method="get" class="space-y-6" data-focus-first-error>
            <input type="hidden" name="Preview" value="true" />

            <partial name="Shared/Components/_RadioCardGroup" model='new RadioCardGroupViewModel {
                Name = "EntityType",
                Id = "purge-entity-type",
                Legend = "Record type",
                IsRequired = true,
                Columns = 4,
                Options = entityCards,
                SelectedValue = Enum.IsDefined(typeof(BulkPurgeEntityType), Model.EntityType) ? Model.EntityType.ToString() : null,
                ValidationMessage = FieldError("EntityType")
            }' />

            <!-- Date Range -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                    Id = "start-date",
                    Name = "StartDate",
                    Label = "Start date (included)",
                    Type = "date",
                    Value = Model.StartDate?.ToString("yyyy-MM-dd"),
                    HelpText = "Leave empty for no lower limit",
                    ValidationState = FieldState("StartDate"),
                    ValidationMessage = FieldError("StartDate")
                }' />
                <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                    Id = "end-date",
                    Name = "EndDate",
                    Label = "End date (not included)",
                    Type = "date",
                    Value = Model.EndDate?.ToString("yyyy-MM-dd"),
                    HelpText = "Leave empty for no upper limit",
                    ValidationState = FieldState("EndDate"),
                    ValidationMessage = FieldError("EndDate")
                }' />
            </div>

            <!-- Server ID filter -->
            <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                Id = "guild-id",
                Name = "GuildIdInput",
                Label = "Server ID (optional)",
                Type = "text",
                Value = Model.GuildIdInput,
                Placeholder = "123456789012345678",
                Autocomplete = "off",
                InputMode = "numeric",
                Pattern = "[0-9]*",
                HelpText = "Leave empty to purge across all servers. In Discord, right-click the server and choose Copy Server ID.",
                ValidationState = FieldState("GuildIdInput"),
                ValidationMessage = FieldError("GuildIdInput")
            }' />

            <!-- Actions -->
            <div class="flex gap-3 pt-4 border-t border-border-primary">
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    Preview records
                </button>
                <a asp-page="BulkPurge" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>

    <!-- Preview Results -->
    @if (preview is { Success: true })
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-6">
            <div class="px-6 py-4 border-b border-border-primary bg-bg-tertiary">
                <h2 class="text-lg font-semibold text-text-primary">Preview: records that would be deleted</h2>
                <p class="text-sm text-text-secondary mt-1">
                    These records match your choices and will be deleted permanently.
                </p>
            </div>

            <div class="p-6">
                @if (hasRecords)
                {
                    <dl class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                        <div class="bg-bg-tertiary rounded-lg p-4">
                            <dt class="text-xs font-medium text-text-secondary uppercase tracking-wider mb-1">Record type</dt>
                            <dd class="text-lg font-semibold text-text-primary">@preview.EntityType.DisplayName()</dd>
                        </div>
                        <div class="bg-bg-tertiary rounded-lg p-4">
                            <dt class="text-xs font-medium text-text-secondary uppercase tracking-wider mb-1">Date range</dt>
                            <dd class="text-lg font-semibold text-text-primary">@preview.DateRange</dd>
                        </div>
                        <div class="bg-bg-tertiary rounded-lg p-4">
                            <dt class="text-xs font-medium text-text-secondary uppercase tracking-wider mb-1">Records</dt>
                            <dd class="text-lg font-semibold text-error">@preview.EstimatedCount.ToString("N0")</dd>
                        </div>
                    </dl>

                    @if (preview.GuildId.HasValue)
                    {
                        <div class="mb-6 p-3 bg-info-bg border border-info-border rounded-md">
                            <p class="text-sm text-info">
                                <span class="font-semibold">Server filter:</span>
                                @if (!string.IsNullOrEmpty(Model.GuildFilterName))
                                {
                                    <span>@Model.GuildFilterName</span>
                                }
                                else
                                {
                                    <span>Unknown server</span>
                                }
                                <span class="font-mono text-xs text-text-secondary">(ID @preview.GuildId)</span>
                            </p>
                        </div>
                    }

                    <!-- Execute form: posts, then redirects, so a refresh never repeats the purge -->
                    <div class="pt-6 border-t border-border-primary">
                        <form method="post" asp-page-handler="Execute" id="purge-form" data-submit-guard data-purge-form>
                            <input type="hidden" name="EntityType" value="@Model.EntityType" />
                            <input type="hidden" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="GuildIdInput" value="@Model.GuildIdInput" />

                            <button type="submit" class="btn btn-error"
                                    data-purge-confirm
                                    data-confirm-title="Permanently delete records"
                                    data-confirm-message="You are about to permanently delete @DisplayFormat.Plural(preview.EstimatedCount, "record") from @preview.EntityType.DisplayNameLower() (date range: @preview.DateRange). This cannot be undone."
                                    data-confirm-required="CONFIRM"
                                    data-confirm-label="Type CONFIRM to continue"
                                    data-confirm-action="Purge records"
                                    data-loading-text="Purging...">
                                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                                Purge @DisplayFormat.Plural(preview.EstimatedCount, "record")
                            </button>
                            <p class="mt-2 text-xs text-text-secondary">
                                You will be asked to type CONFIRM before anything is deleted.
                            </p>
                        </form>
                    </div>
                }
                else
                {
                    <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                        Type = EmptyStateType.NoResults,
                        Title = "No records match",
                        Description = $"There are no records in {preview.EntityType.DisplayNameLower()} for this date range and server. Try a wider range, or clear the server ID.",
                        HeadingLevel = 3
                    }' />
                }
            </div>
        </div>
    }

    <!-- Progress (filled from the hub while the purge runs) -->
    <div id="progress-container" class="hidden mb-6" role="status" aria-live="polite">
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
            <div class="flex items-center gap-4 mb-4">
                <svg class="w-6 h-6 animate-spin text-accent-orange" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <div>
                    <p class="text-sm font-medium text-text-primary" id="progress-message">Purging records. Keep this page open.</p>
                    <p class="text-xs text-text-secondary" id="progress-detail">Large purges can take a minute.</p>
                </div>
            </div>
            <div class="w-full bg-bg-tertiary rounded-full h-2" role="progressbar" aria-label="Purge progress" aria-valuemin="0" aria-valuemax="100" id="progress-track">
                <div id="progress-bar" class="bg-accent-orange h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
            <p class="mt-2 text-xs text-text-secondary text-right" id="progress-percent"></p>
        </div>
    </div>

    <!-- Additional Information -->
    <div class="p-4 bg-info-bg border border-info-border rounded-md">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-info flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <div class="text-sm text-info">
                <p class="font-semibold mb-1">Data retention</p>
                <p class="text-info/90">
                    Use this for one-off cleanups. For automatic retention, set the retention options in
                    <a asp-page="/Admin/Settings" asp-route-category="Advanced" class="underline hover:no-underline">Settings</a>.
                    Every purge is recorded in the audit log.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/form-focus.js" asp-append-version="true"></script>
    <script src="~/js/purge.js" asp-append-version="true"></script>
}

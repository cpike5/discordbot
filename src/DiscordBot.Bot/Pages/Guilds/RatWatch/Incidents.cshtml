@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.RatWatch.IncidentsModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Pages
@using DiscordBot.Core.Enums
@using Microsoft.AspNetCore.WebUtilities
@{
    ViewData["Title"] = $"Rat Watch Incidents - {Model.ViewModel.GuildName}";
    Layout = "_GuildLayout";

    var vm = Model.ViewModel;
    var loadFailed = !string.IsNullOrEmpty(Model.ErrorMessage);
    var clearUrl = Url.Page("Incidents", new { guildId = vm.GuildId });

    // The current filters as a query string, without the page and handler, for the export link
    // and the pagination links: both keep every filter the page is showing.
    var filterQuery = Model.Request.Query
        .Where(q => !string.Equals(q.Key, "pageNumber", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(q.Key, "handler", StringComparison.OrdinalIgnoreCase))
        .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v)))
        .ToList();
    var exportUrl = QueryHelpers.AddQueryString(Url.Page("Incidents", "ExportCsv", new { guildId = vm.GuildId })!, filterQuery);
    var pagingBaseUrl = QueryHelpers.AddQueryString(clearUrl!, filterQuery);

    var dateFilter = new DateRangeFilterViewModel
    {
        StartDate = vm.Filters.StartDate,
        EndDate = vm.Filters.EndDate,
        PresetLabel = "Quick date range (scheduled time)",
        ShowActions = false
    };

    var pagination = new PaginationViewModel
    {
        CurrentPage = vm.CurrentPage,
        TotalPages = vm.TotalPages,
        TotalItems = vm.TotalCount,
        PageSize = vm.PageSize,
        BaseUrl = pagingBaseUrl,
        PageParameterName = "pageNumber",
        ShowFirstLast = true,
        ShowPageSizeSelector = true,
        ShowItemCount = true,
        PageSizeOptions = new[] { 10, 25, 50, 100 }
    };
    var accusedInput = new FormInputViewModel
    {
        Id = "AccusedUser", Name = "AccusedUser", Label = "Accused user", Value = vm.Filters.AccusedUser,
        Placeholder = "Username or Discord ID", HelpText = "Partial username match or Discord ID"
    };
    var initiatorInput = new FormInputViewModel
    {
        Id = "InitiatorUser", Name = "InitiatorUser", Label = "Initiator user", Value = vm.Filters.InitiatorUser,
        Placeholder = "Username or Discord ID", HelpText = "Partial username match or Discord ID"
    };
    var minVotesInput = new FormInputViewModel
    {
        Id = "MinVoteCount", Name = "MinVoteCount", Label = "Minimum total votes", Type = "number",
        Value = vm.Filters.MinVoteCount?.ToString(), InputMode = "numeric", Min = "0", Placeholder = "For example 5"
    };
    var keywordInput = new FormInputViewModel
    {
        Id = "Keyword", Name = "Keyword", Label = "Keyword in message", Value = vm.Filters.Keyword,
        Placeholder = "Search custom messages"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
}

<!-- Rat Watch Navigation Tabs -->
<partial name="Shared/Components/_TabPanel" model='new TabPanelViewModel {
    Id = "ratWatchTabs",
    StyleVariant = TabStyleVariant.Underline,
    NavigationMode = TabNavigationMode.PageNavigation,
    Tabs = new List<TabItemViewModel>
    {
        new() {
            Id = "settings",
            Label = "Settings",
            Href = $"/Guilds/RatWatch/{Model.ViewModel.GuildId}"
        },
        new() {
            Id = "analytics",
            Label = "Analytics",
            Href = $"/Guilds/RatWatch/Analytics/{Model.ViewModel.GuildId}"
        },
        new() {
            Id = "incidents",
            Label = "Incidents",
            Href = $"/Guilds/RatWatch/Incidents/{Model.ViewModel.GuildId}"
        }
    },
    ActiveTabId = "incidents",
    AriaLabel = "Rat Watch navigation",
    ContainerClass = "mb-6"
}' />

<div data-incident-page data-guild-id="@vm.GuildId"
     data-detail-url="@Url.Page("Incidents", "IncidentDetail", new { guildId = vm.GuildId, incidentId = "__id__" })">

<!-- Filter Panel -->
<filter-panel title="Filters"
              is-collapsible="true"
              active-filter-count="@vm.ActiveFilterCount"
              default-expanded="true">
    <form method="get" asp-page="Incidents" asp-route-guildId="@vm.GuildId" class="space-y-4">
        <fieldset>
            <legend class="block text-sm font-medium text-text-primary mb-2">Status</legend>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                @foreach (var status in RatWatchIncidentsViewModel.AllStatuses)
                {
                    var isChecked = vm.Filters.Statuses.Count == 0 || vm.Filters.Statuses.Contains(status);
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="Statuses" value="@status" checked="@isChecked" class="w-4 h-4 rounded" />
                        <partial name="Shared/Components/_RatWatchStatusBadge" model="status" />
                    </label>
                }
            </div>
        </fieldset>

        <div>
            <partial name="Shared/Components/_DateRangeFilter" model="dateFilter" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <partial name="Shared/Components/_FormInput" model="accusedInput" />
            <partial name="Shared/Components/_FormInput" model="initiatorInput" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <partial name="Shared/Components/_FormInput" model="minVotesInput" />
            <partial name="Shared/Components/_FormInput" model="keywordInput" />
        </div>

        <!-- Sort and page size stay as they are when the filters change -->
        <input type="hidden" name="SortBy" value="@vm.Filters.SortBy" />
        <input type="hidden" name="SortDesc" value="@(vm.Filters.SortDescending ? "true" : "false")" />
        <input type="hidden" name="PageSize" value="@vm.PageSize" />

        <div class="flex flex-wrap items-center gap-3 mt-6 pt-4 border-t border-border-secondary">
            <button type="submit" class="btn btn-primary">
                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
                Apply filters
            </button>
            @if (vm.ActiveFilterCount > 0)
            {
                <a href="@clearUrl" class="btn btn-secondary">
                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Clear filters
                </a>
            }
        </div>
    </form>
</filter-panel>

@if (loadFailed)
{
    <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
        Type = EmptyStateType.Error,
        Title = "Incidents could not be loaded",
        Description = Model.ErrorMessage!,
        Size = EmptyStateSize.Default,
        HeadingLevel = 2,
        Announce = true,
        PrimaryActionText = "Try again",
        PrimaryActionUrl = Model.Request.Path + Model.Request.QueryString,
        PrimaryActionIconPath = ""
    }' />
}
else
{
    <!-- Results Summary -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <p class="text-sm text-text-secondary">
            @if (vm.TotalCount > 0)
            {
                var startItem = (vm.CurrentPage - 1) * vm.PageSize + 1;
                var endItem = Math.Min(vm.CurrentPage * vm.PageSize, vm.TotalCount);
                <text>Showing <span class="font-medium text-text-primary">@startItem-@endItem</span> of <span class="font-medium text-text-primary">@DisplayFormat.Plural(vm.TotalCount, "incident")</span></text>
            }
            else
            {
                <text>No incidents found</text>
            }
        </p>
        <div class="flex items-center gap-3">
            @if (vm.ActiveFilterCount > 0)
            {
                <span class="text-sm text-text-tertiary">@DisplayFormat.Plural(vm.ActiveFilterCount, "filter") active</span>
            }
            @if (vm.TotalCount > 0)
            {
                <a href="@exportUrl" class="btn btn-secondary btn-sm" download>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    Export all as CSV
                </a>
            }
        </div>
    </div>

    @if (vm.TotalCount > 0)
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-6">
            <!-- Cards under md (D13) -->
            <ul class="md:hidden divide-y divide-border-primary">
                @foreach (var incident in vm.Incidents)
                {
                    <li class="p-4 space-y-2 cursor-pointer" data-incident-id="@incident.Id">
                        <div class="flex items-start justify-between gap-3">
                            <partial name="Shared/Components/_RatWatchStatusBadge" model="incident.Status" />
                            <span class="text-xs text-text-secondary whitespace-nowrap" data-utc="@incident.ScheduledAtUtcIso" data-format="datetime-short"></span>
                        </div>
                        <p class="text-sm text-text-primary break-words">
                            <span class="preview-trigger font-medium" data-preview-type="user" data-user-id="@incident.AccusedUserId" data-context-guild-id="@vm.GuildId">@incident.AccusedUsername</span>
                            <span class="text-text-tertiary">accused by</span>
                            <span class="preview-trigger text-text-secondary" data-preview-type="user" data-user-id="@incident.InitiatorUserId" data-context-guild-id="@vm.GuildId">@incident.InitiatorUsername</span>
                        </p>
                        @if (incident.TotalVotes > 0)
                        {
                            <p class="text-sm">
                                <span class="text-error font-medium">@incident.GuiltyVotes guilty</span>
                                <span class="text-text-tertiary">/</span>
                                <span class="text-success font-medium">@incident.NotGuiltyVotes not guilty</span>
                            </p>
                        }
                        <button type="button" class="btn btn-secondary btn-sm" data-incident-view="@incident.Id">View details</button>
                    </li>
                }
            </ul>

            <div class="hidden md:block overflow-x-auto">
                <table class="min-w-full divide-y divide-border-primary">
                    <thead class="bg-bg-tertiary">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Accused</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Initiator</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Scheduled</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Votes</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var incident in vm.Incidents)
                        {
                            <tr class="hover:bg-bg-hover transition-colors cursor-pointer" data-incident-id="@incident.Id">
                                <td class="px-6 py-4 whitespace-nowrap"><partial name="Shared/Components/_RatWatchStatusBadge" model="incident.Status" /></td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="preview-trigger text-sm text-text-primary" data-preview-type="user" data-user-id="@incident.AccusedUserId" data-context-guild-id="@vm.GuildId">@incident.AccusedUsername</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="preview-trigger text-sm text-text-secondary" data-preview-type="user" data-user-id="@incident.InitiatorUserId" data-context-guild-id="@vm.GuildId">@incident.InitiatorUsername</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-text-primary" data-utc="@incident.ScheduledAtUtcIso" data-format="datetime-short"></span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (incident.TotalVotes > 0)
                                    {
                                        @* Words as well as colours: the tally never relies on red and green *@
                                        <span class="text-sm">
                                            <span class="text-error font-medium">@incident.GuiltyVotes guilty</span>
                                            <span class="text-text-tertiary" aria-hidden="true">/</span>
                                            <span class="text-success font-medium">@incident.NotGuiltyVotes not guilty</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-sm text-text-tertiary">No votes</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    @* Always visible: it is the only keyboard route into the details *@
                                    <button type="button" data-incident-view="@incident.Id"
                                            class="inline-flex items-center gap-1 text-sm text-accent-blue hover:text-accent-blue-hover transition-colors"
                                            aria-label="View details for the incident with @incident.AccusedUsername">
                                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                        <span class="hidden lg:inline">Details</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="px-6 py-4 border-t border-border-primary">
                <partial name="Shared/Components/_Pagination" model="pagination" />
            </div>
        </div>
    }
    else
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
            @if (vm.ActiveFilterCount > 0)
            {
                <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                    Type = EmptyStateType.NoResults,
                    Title = "No incidents match these filters",
                    Description = "Try different filters, or clear them to see every incident.",
                    Size = EmptyStateSize.Default,
                    HeadingLevel = 2,
                    PrimaryActionText = "Clear filters",
                    PrimaryActionUrl = clearUrl,
                    PrimaryActionIconPath = ""
                }' />
            }
            else
            {
                <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                    Type = EmptyStateType.NoData,
                    Title = "No incidents yet",
                    Description = "No Rat Watch incidents have been created in this server in the last 30 days.",
                    Size = EmptyStateSize.Default,
                    HeadingLevel = 2
                }' />
            }
        </div>
    }
}

</div>

<!-- Incident details dialog (opened by rat-watch-incidents.js through quickActions.openDialog) -->
<div id="incidentModal" class="hidden fixed inset-0 z-[var(--z-modal)]" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm qa-modal-backdrop" data-modal-dismiss aria-hidden="true"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="bg-bg-secondary border border-border-primary rounded-lg shadow-xl w-full max-w-3xl max-h-full flex flex-col qa-modal-panel pointer-events-auto" role="document">
            <div class="px-6 py-4 border-b border-border-primary flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                    <span id="modalStatusBadge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold"></span>
                    <h2 id="modalTitle" class="text-lg font-semibold text-text-primary">Incident details</h2>
                </div>
                <button type="button" data-modal-dismiss class="btn btn-icon btn-secondary" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div id="modalBody" class="px-6 py-4 overflow-y-auto" aria-live="polite">
                <p class="text-text-secondary">Loading incident...</p>
            </div>
            <div class="px-6 py-4 bg-bg-primary border-t border-border-primary flex justify-end">
                <button type="button" data-modal-dismiss data-modal-initial-focus class="btn btn-secondary">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/date-range-filter.js" asp-append-version="true"></script>
    <script src="~/js/shared/filter-panel.js" asp-append-version="true"></script>
    <script src="~/js/rat-watch-incidents.js" asp-append-version="true"></script>
}

@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.RatWatch.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = $"Rat Watch - {Model.ViewModel.GuildName}";
    Layout = "_GuildLayout";

    var timezoneSelect = new FormSelectViewModel
    {
        Id = "timezone",
        Name = "timezone",
        Label = "Timezone",
        Placeholder = null,
        SelectedValue = Model.ViewModel.Timezone,
        Options = Model.ViewModel.TimezoneOptions.ToList()
    };
    var maxAdvanceInput = new FormInputViewModel
    {
        Id = "maxAdvanceHours",
        Name = "maxAdvanceHours",
        Label = "Max advance hours",
        Type = "number",
        Value = Model.ViewModel.MaxAdvanceHours.ToString(),
        InputMode = "numeric",
        Min = "1",
        Max = "168",
        HelpText = "How far ahead a watch can be scheduled (1 to 168 hours)."
    };
    var votingDurationInput = new FormInputViewModel
    {
        Id = "votingDurationMinutes",
        Name = "votingDurationMinutes",
        Label = "Voting duration (minutes)",
        Type = "number",
        Value = Model.ViewModel.VotingDurationMinutes.ToString(),
        InputMode = "numeric",
        Min = "1",
        Max = "60"
    };
    var enabledToggle = new FormToggleViewModel
    {
        Id = "isEnabled",
        Name = "isEnabled",
        Label = "Enable Rat Watch for this server",
        IsChecked = Model.ViewModel.IsEnabled
    };
    var pagination = new PaginationViewModel
    {
        CurrentPage = Model.ViewModel.CurrentPage,
        TotalPages = Model.ViewModel.TotalPages,
        TotalItems = Model.ViewModel.TotalWatches,
        PageSize = Model.ViewModel.PageSize,
        BaseUrl = Url.Page("Index", new { guildId = Model.ViewModel.GuildId, pageSize = Model.ViewModel.PageSize }),
        PageParameterName = "pageNumber",
        ShowItemCount = true
    };
    var leaderboardToggle = new FormToggleViewModel
    {
        Id = "publicLeaderboardEnabled",
        Name = "publicLeaderboardEnabled",
        Label = "Enable the public leaderboard page",
        Description = "Anyone with the link can see it, without signing in.",
        IsChecked = Model.ViewModel.PublicLeaderboardEnabled
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
}

<!-- Rat Watch Navigation Tabs -->
<partial name="Shared/Components/_TabPanel" model='new TabPanelViewModel {
    Id = "ratWatchTabs",
    StyleVariant = TabStyleVariant.Underline,
    NavigationMode = TabNavigationMode.PageNavigation,
    Tabs = new List<TabItemViewModel>
    {
        new() {
            Id = "settings",
            Label = "Settings",
            Href = $"/Guilds/RatWatch/{Model.ViewModel.GuildId}"
        },
        new() {
            Id = "analytics",
            Label = "Analytics",
            Href = $"/Guilds/RatWatch/Analytics/{Model.ViewModel.GuildId}"
        },
        new() {
            Id = "incidents",
            Label = "Incidents",
            Href = $"/Guilds/RatWatch/Incidents/{Model.ViewModel.GuildId}"
        }
    },
    ActiveTabId = "settings",
    AriaLabel = "Rat Watch navigation",
    ContainerClass = "mb-6"
}' />

<!-- Settings Card -->
<div class="bg-bg-secondary border border-border-primary rounded-lg p-6 mb-6">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-text-primary">Settings</h2>
        <button type="button" id="settings-toggle" data-settings-toggle aria-expanded="false" aria-controls="settings-form"
                class="btn btn-secondary btn-sm">
            Edit settings
        </button>
    </div>

    <!-- Settings Display -->
    <dl id="settings-display" class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div>
            <dt class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Timezone</dt>
            <dd class="text-sm text-text-primary break-words">@Model.ViewModel.Timezone</dd>
        </div>
        <div>
            <dt class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Max advance</dt>
            <dd class="text-sm text-text-primary">@DisplayFormat.Plural(Model.ViewModel.MaxAdvanceHours, "hour")</dd>
        </div>
        <div>
            <dt class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Voting duration</dt>
            <dd class="text-sm text-text-primary">@DisplayFormat.Plural(Model.ViewModel.VotingDurationMinutes, "minute")</dd>
        </div>
        <div>
            <dt class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Status</dt>
            <dd class="text-sm @(Model.ViewModel.IsEnabled ? "text-success" : "text-error")">
                @(Model.ViewModel.IsEnabled ? "Enabled" : "Disabled")
            </dd>
        </div>
        <div>
            <dt class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Public leaderboard</dt>
            <dd>
                @if (Model.ViewModel.PublicLeaderboardEnabled)
                {
                    <a asp-page="/Guilds/PublicLeaderboard" asp-route-guildId="@Model.ViewModel.GuildId"
                       class="inline-flex items-center gap-1 text-sm text-accent-blue hover:text-accent-blue-hover transition-colors"
                       target="_blank" rel="noopener">
                        Enabled
                        <span class="sr-only">(opens in a new tab)</span>
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                }
                else
                {
                    <span class="text-sm text-text-secondary">Disabled</span>
                }
            </dd>
        </div>
    </dl>

    <!-- Settings Form (hidden until Edit settings) -->
    <form id="settings-form" method="post" asp-page-handler="UpdateSettings" asp-route-guildId="@Model.ViewModel.GuildId"
          asp-route-pageNumber="@Model.ViewModel.CurrentPage" asp-route-pageSize="@Model.ViewModel.PageSize"
          class="hidden mt-4 pt-4 border-t border-border-primary" data-submit-guard data-unsaved-changes>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <partial name="Shared/Components/_FormSelect" model="timezoneSelect" />
            <partial name="Shared/Components/_FormInput" model="maxAdvanceInput" />
            <partial name="Shared/Components/_FormInput" model="votingDurationInput" />
            <div class="space-y-4">
                <partial name="Shared/Components/_FormToggle" model="enabledToggle" />
                <partial name="Shared/Components/_FormToggle" model="leaderboardToggle" />
            </div>
        </div>
        <div class="flex justify-end gap-2">
            <button type="button" data-settings-toggle class="btn btn-secondary">Cancel</button>
            <button type="submit" class="btn btn-primary" data-loading-text="Saving...">Save settings</button>
        </div>
    </form>
</div>

<!-- Summary Stats Cards -->
@if (Model.ViewModel.AnalyticsSummary != null)
{
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6 mb-6">
        <!-- Total Watches -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Total Watches</p>
                    <p class="mt-2 text-3xl font-bold text-text-primary">@Model.ViewModel.AnalyticsSummary.TotalWatches.ToString("N0")</p>
                    <p class="mt-1 text-xs text-text-tertiary">All-time</p>
                </div>
                <div class="p-3 bg-accent-blue/10 rounded-lg">
                    <svg class="w-6 h-6 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Active Watches -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Active Watches</p>
                    <p class="mt-2 text-3xl font-bold text-warning">@Model.ViewModel.AnalyticsSummary.ActiveWatches.ToString("N0")</p>
                    <p class="mt-1 text-xs text-text-tertiary">Pending + Voting</p>
                </div>
                <div class="p-3 bg-warning/10 rounded-lg">
                    <svg class="w-6 h-6 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Guilty Rate -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Guilty Rate</p>
                    @{
                        var guiltyRate = Model.ViewModel.AnalyticsSummary.GuiltyRate;
                        var guiltyRateColor = guiltyRate < 50 ? "text-success" : guiltyRate <= 80 ? "text-warning" : "text-error";
                        var guiltyRateIconBg = guiltyRate < 50 ? "bg-success/10" : guiltyRate <= 80 ? "bg-warning/10" : "bg-error/10";
                    }
                    <p class="mt-2 text-3xl font-bold @guiltyRateColor">@guiltyRate.ToString("F0")%</p>
                    <p class="mt-1 text-xs text-text-tertiary">@Model.ViewModel.AnalyticsSummary.GuiltyCount guilty verdicts</p>
                </div>
                <div class="p-3 @guiltyRateIconBg rounded-lg">
                    <svg class="w-6 h-6 @guiltyRateColor" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Early Check-in Rate -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Early Check-in Rate</p>
                    @{
                        var checkInRate = Model.ViewModel.AnalyticsSummary.EarlyCheckInRate;
                        var checkInRateColor = checkInRate > 80 ? "text-success" : checkInRate >= 50 ? "text-warning" : "text-error";
                        var checkInRateIconBg = checkInRate > 80 ? "bg-success/10" : checkInRate >= 50 ? "bg-warning/10" : "bg-error/10";
                    }
                    <p class="mt-2 text-3xl font-bold @checkInRateColor">@checkInRate.ToString("F0")%</p>
                    <p class="mt-1 text-xs text-text-tertiary">@Model.ViewModel.AnalyticsSummary.ClearedEarlyCount cleared early</p>
                </div>
                <div class="p-3 @checkInRateIconBg rounded-lg">
                    <svg class="w-6 h-6 @checkInRateColor" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>
}

<!-- Stats and Leaderboard Row -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <!-- Stats Card -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
        <h2 class="text-lg font-semibold text-text-primary mb-4">Watch Stats</h2>
        <div class="grid grid-cols-3 gap-4">
            <div class="text-center">
                <p class="text-2xl font-bold text-warning">@Model.ViewModel.PendingCount</p>
                <p class="text-xs text-text-tertiary">Pending</p>
            </div>
            <div class="text-center">
                <p class="text-2xl font-bold text-accent-blue">@Model.ViewModel.VotingCount</p>
                <p class="text-xs text-text-tertiary">Voting</p>
            </div>
            <div class="text-center">
                <p class="text-2xl font-bold text-success">@Model.ViewModel.CompletedCount</p>
                <p class="text-xs text-text-tertiary">Completed</p>
            </div>
        </div>
        <div class="mt-4 pt-4 border-t border-border-primary text-center">
            <p class="text-3xl font-bold text-text-primary">@Model.ViewModel.TotalWatches</p>
            <p class="text-sm text-text-tertiary">Total Watches</p>
        </div>
    </div>

    <!-- Leaderboard Card -->
    <div class="lg:col-span-2 bg-bg-secondary border border-border-primary rounded-lg p-6">
        <h2 class="text-lg font-semibold text-text-primary mb-4">Hall of Shame</h2>
        @if (Model.ViewModel.Leaderboard.Any())
        {
            <ol class="space-y-2">
                @foreach (var entry in Model.ViewModel.Leaderboard)
                {
                    <li class="flex items-center justify-between p-2 rounded-lg @(entry.Rank <= 3 ? "bg-bg-tertiary" : "")">
                        <div class="flex items-center gap-3 min-w-0">
                            <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full text-sm font-bold @(entry.Rank == 1 ? "bg-warning/20 text-warning" : entry.Rank == 2 ? "bg-text-secondary/20 text-text-secondary" : entry.Rank == 3 ? "bg-accent-orange/20 text-accent-orange" : "bg-bg-tertiary text-text-tertiary")">
                                <span class="sr-only">Rank </span>@entry.Rank
                            </span>
                            <span class="preview-trigger text-sm text-text-primary truncate" data-preview-type="user" data-user-id="@entry.UserId" data-context-guild-id="@Model.ViewModel.GuildId">@entry.Username</span>
                        </div>
                        <span class="text-sm font-semibold text-error whitespace-nowrap">@entry.GuiltyCount guilty</span>
                    </li>
                }
            </ol>
        }
        else
        {
            <p class="text-sm text-text-tertiary text-center py-8">No guilty verdicts yet. Everyone's been honest!</p>
        }
    </div>
</div>

<!-- Watches -->
@if (Model.ViewModel.TotalWatches > 0)
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-border-primary">
            <h2 class="text-lg font-semibold text-text-primary">Recent Watches</h2>
        </div>

        <!-- Cards under md (D13) -->
        <ul class="md:hidden divide-y divide-border-primary">
            @foreach (var watch in Model.ViewModel.Watches)
            {
                <li class="p-4 space-y-2">
                    <div class="flex items-start justify-between gap-3">
                        <partial name="Shared/Components/_RatWatchStatusBadge" model="watch.Status" />
                        <span class="text-xs text-text-secondary whitespace-nowrap" data-utc="@watch.ScheduledAtUtcIso" data-format="datetime-short"></span>
                    </div>
                    <p class="text-sm text-text-primary break-words">
                        <span class="preview-trigger font-medium" data-preview-type="user" data-user-id="@watch.AccusedUserId" data-context-guild-id="@Model.ViewModel.GuildId">@watch.AccusedUsername</span>
                        <span class="text-text-tertiary">accused by</span>
                        <span class="preview-trigger text-text-secondary" data-preview-type="user" data-user-id="@watch.InitiatorUserId" data-context-guild-id="@Model.ViewModel.GuildId">@watch.InitiatorUsername</span>
                    </p>
                    @if (!string.IsNullOrWhiteSpace(watch.CustomMessage))
                    {
                        <p class="text-sm text-text-secondary break-words">@watch.CustomMessage</p>
                    }
                    @if (watch.TotalVotes > 0)
                    {
                        <p class="text-sm">
                            <span class="text-error font-medium">@watch.GuiltyVotes guilty</span>
                            <span class="text-text-tertiary">/</span>
                            <span class="text-success font-medium">@watch.NotGuiltyVotes not guilty</span>
                        </p>
                    }
                    @if (watch.CanEndVote || watch.CanCancel)
                    {
                        <div class="flex gap-2 pt-1">
                            @if (watch.CanEndVote)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" data-watch-action="end-vote"
                                        data-watch-id="@watch.Id" data-accused="@watch.AccusedUsername"
                                        data-guilty="@watch.GuiltyVotes" data-not-guilty="@watch.NotGuiltyVotes"
                                        data-action-url="@Url.Page("Index", "EndVote", new { guildId = Model.ViewModel.GuildId, pageNumber = Model.ViewModel.CurrentPage, pageSize = Model.ViewModel.PageSize })">
                                    End vote
                                </button>
                            }
                            @if (watch.CanCancel)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" data-watch-action="cancel"
                                        data-watch-id="@watch.Id" data-accused="@watch.AccusedUsername"
                                        data-action-url="@Url.Page("Index", "Cancel", new { guildId = Model.ViewModel.GuildId, pageNumber = Model.ViewModel.CurrentPage, pageSize = Model.ViewModel.PageSize })">
                                    Cancel watch
                                </button>
                            }
                        </div>
                    }
                </li>
            }
        </ul>

        <div class="hidden md:block overflow-x-auto">
            <table class="w-full">
                <thead class="bg-bg-tertiary border-b border-border-primary">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Accused</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Initiator</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Message</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Scheduled</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Vote ends</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Votes</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var watch in Model.ViewModel.Watches)
                    {
                        <tr class="hover:bg-bg-hover transition-colors">
                            <td class="px-6 py-4"><partial name="Shared/Components/_RatWatchStatusBadge" model="watch.Status" /></td>
                            <td class="px-6 py-4">
                                <span class="preview-trigger text-sm text-text-primary" data-preview-type="user" data-user-id="@watch.AccusedUserId" data-context-guild-id="@Model.ViewModel.GuildId">@watch.AccusedUsername</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="preview-trigger text-sm text-text-secondary" data-preview-type="user" data-user-id="@watch.InitiatorUserId" data-context-guild-id="@Model.ViewModel.GuildId">@watch.InitiatorUsername</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm text-text-secondary max-w-[200px] truncate block" title="@watch.CustomMessage">
                                    @(watch.CustomMessage ?? "No message")
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm text-text-primary" data-utc="@watch.ScheduledAtUtcIso" data-format="datetime-short"></span>
                            </td>
                            <td class="px-6 py-4">
                                @if (watch.VoteEndsAtUtcIso != null)
                                {
                                    <span class="text-sm text-text-primary" data-utc="@watch.VoteEndsAtUtcIso" data-format="datetime-short"></span>
                                }
                                else
                                {
                                    <span class="text-sm text-text-tertiary">--</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (watch.TotalVotes > 0)
                                {
                                    @* Words as well as colours: the tally never relies on red and green *@
                                    <div class="flex flex-wrap items-center gap-x-2 text-sm">
                                        <span class="text-error font-medium">@watch.GuiltyVotes guilty</span>
                                        <span class="text-text-tertiary" aria-hidden="true">/</span>
                                        <span class="text-success font-medium">@watch.NotGuiltyVotes not guilty</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm text-text-tertiary">--</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-1 row-actions">
                                    @if (watch.CanEndVote)
                                    {
                                        <button type="button" data-watch-action="end-vote"
                                                data-watch-id="@watch.Id" data-accused="@watch.AccusedUsername"
                                                data-guilty="@watch.GuiltyVotes" data-not-guilty="@watch.NotGuiltyVotes"
                                                data-action-url="@Url.Page("Index", "EndVote", new { guildId = Model.ViewModel.GuildId, pageNumber = Model.ViewModel.CurrentPage, pageSize = Model.ViewModel.PageSize })"
                                                class="p-2 text-text-secondary hover:text-accent-blue hover:bg-accent-blue/10 rounded-md transition-colors"
                                                title="End vote" aria-label="End vote for @watch.AccusedUsername">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                            </svg>
                                        </button>
                                    }
                                    @if (watch.CanCancel)
                                    {
                                        <button type="button" data-watch-action="cancel"
                                                data-watch-id="@watch.Id" data-accused="@watch.AccusedUsername"
                                                data-action-url="@Url.Page("Index", "Cancel", new { guildId = Model.ViewModel.GuildId, pageNumber = Model.ViewModel.CurrentPage, pageSize = Model.ViewModel.PageSize })"
                                                class="p-2 text-text-secondary hover:text-error hover:bg-error/10 rounded-md transition-colors"
                                                title="Cancel watch" aria-label="Cancel watch for @watch.AccusedUsername">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-border-primary">
            <partial name="Shared/Components/_Pagination" model="pagination" />
        </div>
    </div>

    @* One hidden form carries every row action; rat-watch-manage.js points it at the row's handler *@
    <form id="watch-action-form" method="post" class="hidden" data-submit-guard>
        <input type="hidden" name="watchId" value="" />
    </form>
}
else
{
    <!-- Empty State -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
        <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
            Type = EmptyStateType.FirstTime,
            Title = "No Rat Watches Yet",
            Description = "No accountability watches have been created in this server. Use the \"Rat Watch\" context menu on a message in Discord to start one.",
            Size = EmptyStateSize.Default,
            IconSvgPath = "M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
        }' />
    </div>
}

@section Scripts {
    <script src="~/js/rat-watch-manage.js" asp-append-version="true"></script>
}

@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.Soundboard.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = $"Soundboard - {Model.ViewModel.GuildName}";
    Layout = "_GuildLayout";
}

<!-- Audio Tabs Navigation -->
    <partial name="Shared/Components/_TabPanel" model='new TabPanelViewModel {
        Id = "audioTabs",
        StyleVariant = TabStyleVariant.Pills,
        NavigationMode = TabNavigationMode.PageNavigation,
        Tabs = new List<TabItemViewModel>
        {
            new() {
                Id = "soundboard",
                Label = "Soundboard",
                Href = $"/Guilds/Soundboard/{Model.ViewModel.GuildId}",
                BadgeCount = Model.ViewModel.Stats.TotalSounds,
                BadgeVariant = TabBadgeVariant.Info,
                IconPathOutline = "M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
            },
            new() {
                Id = "tts",
                Label = "Text-to-Speech",
                Href = $"/Guilds/TextToSpeech/{Model.ViewModel.GuildId}",
                IconPathOutline = "M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
            },
            new() {
                Id = "vox",
                Label = "VOX",
                Href = $"/Guilds/VOX/{Model.ViewModel.GuildId}",
                IconPathOutline = "M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 1 1 0-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 0 1-1.44-4.282m3.102.069a18.03 18.03 0 0 1-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 0 1 8.835 2.535M10.34 6.66a23.847 23.847 0 0 0 8.835-2.535m0 0A23.74 23.74 0 0 0 18.795 3m.38 1.125a23.91 23.91 0 0 1 1.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 0 0 1.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 0 1 0 3.46"
            },
            new() {
                Id = "settings",
                Label = "Settings",
                Href = $"/Guilds/AudioSettings/{Model.ViewModel.GuildId}",
                IconPathOutline = "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"
            },
            new() {
                Id = "audiolog",
                Label = "Audio Log",
                Href = $"/Guilds/AudioModerationLog/{Model.ViewModel.GuildId}",
                IconPathOutline = "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
            }
        },
        ActiveTabId = "soundboard",
        AriaLabel = "Audio sections"
    }' />

    <!-- Audio Globally Disabled Warning -->
    @if (Model.IsAudioGloballyDisabled)
    {
        <div class="mb-6">
            <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                Variant = AlertVariant.Warning,
                Title = "Audio Features Disabled",
                Message = "Audio features have been disabled globally by an administrator. Soundboard commands will not work until audio is re-enabled in Settings.",
                IsDismissible = false
            }' />
        </div>
    }

    <!-- Load failure: page state, with a way out -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6">
            <partial name="Shared/Components/_Alert" model="new AlertViewModel {
                Variant = AlertVariant.Error,
                Message = Model.ErrorMessage,
                IsDismissible = false
            }" />
            <a href="@(Model.Request.Path + Model.Request.QueryString)" class="btn btn-secondary mt-3">Try again</a>
        </div>
    }
    else
    {
    <!-- Stats Cards Section -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <!-- Total Sounds Card -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5 hover:border-border-focus transition-colors">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <p class="text-text-secondary text-sm mb-1">Total Sounds</p>
                    <p id="stat-total-sounds" class="text-3xl font-bold text-text-primary">@Model.ViewModel.Stats.TotalSounds</p>
                </div>
                <div class="w-10 h-10 bg-accent-blue/20 rounded-lg flex items-center justify-center text-accent-blue">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                </div>
            </div>
            <p class="text-xs text-text-tertiary">of @Model.ViewModel.MaxSoundsPerGuild allowed</p>
        </div>

        <!-- Plays Today Card -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5 hover:border-border-focus transition-colors">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <p class="text-text-secondary text-sm mb-1">Plays Today</p>
                    <p class="text-3xl font-bold text-text-primary">@Model.ViewModel.Stats.PlaysToday</p>
                </div>
                <div class="w-10 h-10 bg-accent-blue/20 rounded-lg flex items-center justify-center text-accent-blue">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8 5v14l11-7z"/>
                    </svg>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.ViewModel.Stats.ComparisonText))
            {
                <p class="text-xs @Model.ViewModel.Stats.ComparisonCssClass">@Model.ViewModel.Stats.ComparisonText</p>
            }
            else
            {
                <p class="text-xs text-text-tertiary">No comparison data</p>
            }
        </div>

        <!-- Storage Used Card -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5 hover:border-border-focus transition-colors">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <p class="text-text-secondary text-sm mb-1">Storage Used</p>
                    <p id="stat-storage-used" class="text-3xl font-bold text-text-primary">@Model.ViewModel.Stats.StorageUsedFormatted</p>
                </div>
                <div class="w-10 h-10 bg-accent-blue/20 rounded-lg flex items-center justify-center text-accent-blue">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                    </svg>
                </div>
            </div>
            <p id="stat-storage-limit" class="text-xs text-text-tertiary">of @Model.ViewModel.Stats.StorageLimitFormatted limit (@Model.ViewModel.Stats.StoragePercentage%)</p>
        </div>

        <!-- Top Sound Card -->
        <div class="bg-bg-secondary border border-accent-orange rounded-lg p-5 gradient-card-orange">
            <div class="flex items-start justify-between mb-4">
                <div class="min-w-0">
                    <p class="text-text-secondary text-sm mb-1">Top Sound</p>
                    <p id="stat-top-sound" class="text-3xl font-bold truncate max-w-[150px] @(string.IsNullOrEmpty(Model.ViewModel.Stats.TopSoundName) ? "text-text-tertiary" : "text-text-primary")" title="@Model.ViewModel.Stats.TopSoundName">@(string.IsNullOrEmpty(Model.ViewModel.Stats.TopSoundName) ? "--" : Model.ViewModel.Stats.TopSoundName)</p>
                </div>
                <div class="w-10 h-10 bg-accent-orange/30 rounded-lg flex items-center justify-center text-accent-orange">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                </div>
            </div>
            <p id="stat-top-sound-plays" class="text-xs text-text-tertiary">@(Model.ViewModel.Stats.TopSoundPlays > 0 ? $"{Model.ViewModel.Stats.TopSoundPlays} {(Model.ViewModel.Stats.TopSoundPlays == 1 ? "play" : "plays")}" : "No plays yet")</p>
        </div>
    </div>

    <!-- Main Content Layout: Sound List + Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-7 gap-6">

        <!-- Left Panel: Sound List -->
        <div class="lg:col-span-4 min-w-0">
            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <!-- Table Header -->
                <div class="px-4 sm:px-6 py-4 border-b border-border-primary flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-4">
                        <h2 class="text-lg font-semibold text-text-primary">Sounds</h2>
                        <!-- Sort Dropdown with AJAX -->
                        <partial name="Shared/_SortDropdown" model='new SortDropdownViewModel {
                            Id = "sortDropdown",
                            SortOptions = new List<SortOption>
                            {
                                new SortOption { Value = "name-asc", Label = "Name (A-Z)" },
                                new SortOption { Value = "name-desc", Label = "Name (Z-A)" },
                                new SortOption { Value = "newest", Label = "Newest First" },
                                new SortOption { Value = "oldest", Label = "Oldest First" }
                            },
                            CurrentSort = Model.ViewModel.CurrentSort,
                            ParameterName = "sort",
                            UseAjax = true,
                            TargetSelector = "#soundsList",
                            PartialUrl = $"/Guilds/Soundboard/{Model.ViewModel.GuildId}?handler=Partial"
                        }' />
                    </div>
                    <div class="flex items-center gap-3">
                        @if (Model.ViewModel.Stats.TotalSounds == 0)
                        {
                            <button type="button" id="exportAllBtn" class="btn btn-secondary btn-sm" disabled title="Upload a sound first">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                                Export All
                            </button>
                        }
                        else
                        {
                            <a id="exportAllBtn" href="/api/guilds/@Model.ViewModel.GuildId/sounds/export" class="btn btn-secondary btn-sm" download>
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                                Export All
                            </a>
                        }
                        <span id="sound-count-chip" class="inline-flex items-center justify-center px-2.5 py-1 text-xs font-semibold text-accent-blue bg-accent-blue/20 rounded-full">
                            @Model.ViewModel.Stats.TotalSounds @(Model.ViewModel.Stats.TotalSounds == 1 ? "sound" : "sounds")
                        </span>
                    </div>
                </div>

                <!-- Sounds List Container (AJAX target) -->
                <div id="soundsList">
                    <partial name="_SoundsList" model="Model" />
                </div>
            </div>
        </div>

        <!-- Right Sidebar -->
        <div class="lg:col-span-3 space-y-6 min-w-0">

            <!-- Voice Channel Control Panel -->
            <partial name="Shared/Components/_VoiceChannelPanel" model="Model.VoiceChannelPanel" />

            <!-- Manage Categories Section -->
            <div id="categoryManagerPanel" class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <button type="button" id="categoryToggleBtn"
                        aria-expanded="false" aria-controls="categoryContent"
                        class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-bg-hover transition-colors">
                    <span class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-accent-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                        </svg>
                        <span class="text-sm font-semibold text-text-primary">Manage Categories</span>
                        <span id="categoryCountBadge" class="@(Model.ViewModel.Categories.Count == 0 ? "hidden " : "")inline-flex items-center justify-center px-2 py-0.5 text-xs font-semibold text-accent-blue bg-accent-blue/20 rounded-full">@Model.ViewModel.Categories.Count</span>
                    </span>
                    <svg id="categoryChevron" class="w-4 h-4 text-text-secondary transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div id="categoryContent" class="hidden border-t border-border-primary">
                    <div class="p-4 space-y-3">
                        <!-- Create Category -->
                        <form id="addCategoryForm" class="space-y-1" novalidate>
                            <label for="newCategoryInput" class="block text-xs font-medium text-text-secondary">New category</label>
                            <div class="flex gap-2">
                                <input type="text" id="newCategoryInput" name="name"
                                       placeholder="Category name" maxlength="50" autocomplete="off"
                                       aria-describedby="categoryError"
                                       class="flex-1 min-w-0 bg-bg-tertiary border border-border-primary rounded-lg px-3 py-2 text-sm text-text-primary placeholder:text-text-secondary focus:outline-none focus:border-accent-orange focus:ring-1 focus:ring-accent-orange" />
                                <button type="submit" id="addCategoryBtn" class="btn btn-primary btn-sm shrink-0">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                    </svg>
                                    <span data-label>Add</span>
                                </button>
                            </div>
                            <p id="categoryError" class="text-xs text-error hidden" role="alert"></p>
                        </form>

                        <!-- Category List -->
                        <ul id="categoryList" class="space-y-1" aria-label="Categories"></ul>

                        <!-- Empty State -->
                        <p id="categoryEmptyState" class="hidden text-center text-xs text-text-secondary py-3">No categories yet. Create one to organize sounds.</p>
                    </div>
                </div>
            </div>

            <!-- Upload Sounds Section -->
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                <h3 class="text-sm font-semibold text-text-primary mb-1">Upload Sounds</h3>
                <p id="uploadLimits" class="text-xs text-text-tertiary mb-4">@Model.ViewModel.SupportedFormats, up to @(Model.ViewModel.MaxFileSizeBytes / (1024 * 1024)) MB and @Model.ViewModel.MaxDurationSeconds seconds each. You can add several files at once.</p>

                <!-- Upload Form: the script sends one request per file; the form posts to the same handler -->
                <form method="post" id="uploadForm" asp-page-handler="Upload" asp-route-guildId="@Model.ViewModel.GuildId" enctype="multipart/form-data">
                    <input type="file"
                           id="file-input"
                           name="file"
                           accept=".mp3,.wav,.ogg,.m4a,audio/*"
                           multiple
                           class="sr-only"
                           aria-describedby="uploadLimits"
                           tabindex="-1" />
                    <button type="button" id="dropzone"
                            class="w-full border-2 border-dashed border-border-primary rounded-lg p-6 bg-bg-tertiary text-center cursor-pointer hover:border-accent-blue hover:bg-bg-hover transition-colors"
                            aria-describedby="uploadLimits">
                        <span class="flex flex-col items-center justify-center">
                            <svg class="w-12 h-12 text-text-tertiary mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                            </svg>
                            <span class="text-sm font-medium text-text-primary">Drag and drop audio files here</span>
                            <span class="text-xs text-text-secondary">or choose files from your computer</span>
                        </span>
                    </button>

                    <!-- Selected files: one row each with its own progress and result -->
                    <ul id="uploadQueue" class="hidden mt-3 space-y-2" aria-label="Files to upload"></ul>
                    <p id="uploadStatus" class="sr-only" role="status" aria-live="polite"></p>

                    <div id="uploadActions" class="hidden mt-3 flex gap-2">
                        <button type="submit" id="upload-btn" class="btn btn-primary flex-1">
                            <span data-label>Upload sound</span>
                        </button>
                        <button type="button" id="uploadClearBtn" class="btn btn-secondary">Clear</button>
                    </div>
                </form>

                <!-- Discover Button -->
                <form method="post" asp-page-handler="Discover" asp-route-guildId="@Model.ViewModel.GuildId" class="mt-4" data-submit-guard>
                    <button type="submit" class="btn btn-secondary w-full" data-loading-text="Scanning folder…">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7M3 7V5a2 2 0 012-2h6l2 2h6a2 2 0 012 2v2" />
                        </svg>
                        Discover sounds from folder
                    </button>
                </form>
            </div>

            <!-- Format Info -->
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Limits</h3>
                <ul class="space-y-2 text-sm text-text-secondary">
                    <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-success shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <span>@Model.ViewModel.SupportedFormats audio files</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-success shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <span>Max file size: @(Model.ViewModel.MaxFileSizeBytes / (1024 * 1024)) MB</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-success shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <span>Max duration: @Model.ViewModel.MaxDurationSeconds seconds</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-success shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <span>Max @Model.ViewModel.MaxSoundsPerGuild sounds per server</span>
                    </li>
                </ul>
                <p class="mt-3 text-xs text-text-tertiary">Change these in <a class="text-accent-blue hover:underline" href="@Url.Page("/Guilds/AudioSettings/Index", new { guildId = Model.ViewModel.GuildId })">Audio Settings</a>.</p>
            </div>
        </div>
    </div>
    }

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
}

@section Scripts {
    <!-- Voice Channel Panel script (SignalR and DashboardHub are loaded in _Layout.cshtml) -->
    <script src="~/js/voice-channel-panel.js"></script>

    <!-- AJAX Sort Module -->
    <script src="~/js/ajax-sort.js"></script>

    @if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
    <script type="application/json" id="soundboardCategories">@Json.Serialize(Model.ViewModel.Categories)</script>
    <script>
        // Snowflakes go in as strings: a number loses its last digits
        window.guildId = '@Model.ViewModel.GuildId';
        window.soundboardAdminConfig = {
            guildId: '@Model.ViewModel.GuildId',
            maxFileBytes: @Model.ViewModel.MaxFileSizeBytes,
            maxSounds: @Model.ViewModel.MaxSoundsPerGuild,
            memberPortalEnabled: @(Model.IsMemberPortalEnabled ? "true" : "false")
        };
    </script>
    <script src="~/js/soundboard-admin.js" asp-append-version="true"></script>
    }
}

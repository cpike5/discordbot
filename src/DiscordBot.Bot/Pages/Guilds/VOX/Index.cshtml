@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.VOX.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = $"VOX - {Model.GuildName}";
    Layout = "_GuildLayout";

    var groupDescriptions = new Dictionary<VoxClipGroup, string>
    {
        { VoxClipGroup.Vox, "Standard VOX clips (scientist voice)" },
        { VoxClipGroup.Fvox, "Female VOX clips (female scientist voice)" },
        { VoxClipGroup.Hgrunt, "Human Grunt clips (military voice)" }
    };
}

<!-- Audio Tabs Navigation -->
<partial name="Shared/Components/_TabPanel" model='new TabPanelViewModel {
    Id = "audioTabs",
    StyleVariant = TabStyleVariant.Pills,
    NavigationMode = TabNavigationMode.PageNavigation,
    Tabs = new List<TabItemViewModel>
    {
        new() {
            Id = "soundboard",
            Label = "Soundboard",
            Href = $"/Guilds/Soundboard/{Model.GuildId}",
            IconPathOutline = "M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
        },
        new() {
            Id = "tts",
            Label = "Text-to-Speech",
            Href = $"/Guilds/TextToSpeech/{Model.GuildId}",
            IconPathOutline = "M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
        },
        new() {
            Id = "vox",
            Label = "VOX",
            Href = $"/Guilds/VOX/{Model.GuildId}",
            BadgeCount = Model.TotalClipCount,
            BadgeVariant = TabBadgeVariant.Info,
            IconPathOutline = "M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 1 1 0-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 0 1-1.44-4.282m3.102.069a18.03 18.03 0 0 1-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 0 1 8.835 2.535M10.34 6.66a23.847 23.847 0 0 0 8.835-2.535m0 0A23.74 23.74 0 0 0 18.795 3m.38 1.125a23.91 23.91 0 0 1 1.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 0 0 1.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 0 1 0 3.46"
        },
        new() {
            Id = "settings",
            Label = "Settings",
            Href = $"/Guilds/AudioSettings/{Model.GuildId}",
            IconPathOutline = "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"
        },
        new() {
            Id = "audiolog",
            Label = "Audio Log",
            Href = $"/Guilds/AudioModerationLog/{Model.GuildId}",
            IconPathOutline = "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
        }
    },
    ActiveTabId = "vox",
    AriaLabel = "Audio sections"
}' />

<!-- Load failure -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model="new AlertViewModel {
            Variant = AlertVariant.Error,
            Message = Model.ErrorMessage,
            IsDismissible = false
        }" />
        <a href="@(Model.Request.Path + Model.Request.QueryString)" class="btn btn-secondary mt-3">Try again</a>
    </div>
}
else
{
    var filtersActive = !string.IsNullOrWhiteSpace(Model.SearchQuery)
        || (!Model.GroupFilter.Equals("all", StringComparison.OrdinalIgnoreCase)
            && Enum.TryParse<VoxClipGroup>(Model.GroupFilter, true, out _));
    string PageUrl(string groupFilter, int pageNumber) =>
        Url.Page("/Guilds/VOX/Index", new { guildId = Model.GuildId, groupFilter, searchQuery = Model.SearchQuery, pageNumber }) ?? string.Empty;
    var clearFiltersUrl = Url.Page("/Guilds/VOX/Index", new { guildId = Model.GuildId }) ?? string.Empty;

<!-- VOX Page Content -->
<div class="space-y-6">
    <!-- VOX Configuration Card -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6">
        <h2 class="text-lg font-semibold text-text-primary mb-1">VOX settings</h2>
        <p class="text-sm text-text-secondary mb-4">
            These apply to every server. They are set in the bot's configuration (<code>Vox</code> section of <code>appsettings.json</code>) and cannot be changed here; per-server settings may come later.
        </p>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-bg-tertiary rounded-lg p-4">
                <dt class="text-xs font-medium uppercase tracking-wider text-text-secondary">Default word gap</dt>
                <dd class="mt-1 text-lg font-semibold text-text-primary">@Model.Settings.DefaultWordGapMs ms</dd>
                <dd class="text-xs text-text-tertiary">Silence between clips</dd>
            </div>
            <div class="bg-bg-tertiary rounded-lg p-4">
                <dt class="text-xs font-medium uppercase tracking-wider text-text-secondary">Max words</dt>
                <dd class="mt-1 text-lg font-semibold text-text-primary">@Model.Settings.MaxMessageWords</dd>
                <dd class="text-xs text-text-tertiary">Per VOX message</dd>
            </div>
            <div class="bg-bg-tertiary rounded-lg p-4">
                <dt class="text-xs font-medium uppercase tracking-wider text-text-secondary">Max length</dt>
                <dd class="mt-1 text-lg font-semibold text-text-primary">@Model.Settings.MaxMessageLength characters</dd>
                <dd class="text-xs text-text-tertiary">Per VOX message</dd>
            </div>
        </dl>
    </div>

    <!-- Info Banner -->
    <partial name="Shared/Components/_Alert" model='new AlertViewModel {
        Variant = AlertVariant.Info,
        Title = "Static clip library",
        Message = "VOX clips are audio files that ship with the bot. They cannot be edited or deleted here. Use the search and group filters to explore them, and Rescan after adding files to the folder.",
        IsDismissible = false
    }' />

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        @foreach (VoxClipGroup group in Enum.GetValues<VoxClipGroup>())
        {
            var count = Model.ClipCountsByGroup.ContainsKey(group) ? Model.ClipCountsByGroup[group] : 0;
            var groupName = group.ToString().ToUpperInvariant();
            var (bgClass, textClass) = group switch
            {
                VoxClipGroup.Vox => ("bg-accent-blue/20", "text-accent-blue"),
                VoxClipGroup.Fvox => ("bg-accent-orange/20", "text-accent-orange"),
                VoxClipGroup.Hgrunt => ("bg-success/20", "text-success"),
                _ => ("bg-accent-blue/20", "text-accent-blue")
            };

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-5 hover:border-border-focus transition-colors">
                <div class="flex items-start justify-between mb-4">
                    <div>
                        <p class="text-text-secondary text-sm mb-1">@groupName</p>
                        <p class="text-3xl font-bold text-text-primary">@count</p>
                        <p class="text-xs text-text-tertiary mt-1">@groupDescriptions[group]</p>
                    </div>
                    <div class="w-10 h-10 @bgClass rounded-lg flex items-center justify-center @textClass">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-text-tertiary">@(count == 1 ? "clip" : "clips")</p>
            </div>
        }
    </div>

    <!-- Clip Browser Card -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
        <!-- Group Filter -->
        <nav class="px-4 sm:px-6 pt-4 pb-3 border-b border-border-primary" aria-label="Clip group">
            <div class="flex items-center gap-2 flex-wrap">
                @{
                    // An unknown group in the address shows every group, so "All groups" is the active tab then
                    var allActive = Model.GroupFilter.Equals("all", StringComparison.OrdinalIgnoreCase)
                        || !Enum.TryParse<VoxClipGroup>(Model.GroupFilter, true, out _);
                }
                <a href="@PageUrl("all", 1)"
                   @(allActive ? "aria-current=page" : "")
                   class="px-4 py-2 rounded-full text-sm font-medium transition-colors @(allActive ? "bg-accent-blue text-white" : "bg-bg-tertiary text-text-secondary hover:bg-bg-hover")">
                    All groups
                </a>
                @foreach (VoxClipGroup group in Enum.GetValues<VoxClipGroup>())
                {
                    var groupName = group.ToString().ToUpperInvariant();
                    var isActive = Model.GroupFilter.Equals(group.ToString(), StringComparison.OrdinalIgnoreCase);
                    <a href="@PageUrl(group.ToString(), 1)"
                       title="@groupDescriptions[group]"
                       @(isActive ? "aria-current=page" : "")
                       class="px-4 py-2 rounded-full text-sm font-medium transition-colors @(isActive ? "bg-accent-blue text-white" : "bg-bg-tertiary text-text-secondary hover:bg-bg-hover")">
                        @groupName
                    </a>
                }
            </div>
        </nav>

        <!-- Toolbar -->
        <div class="px-4 sm:px-6 py-4 border-b border-border-primary flex flex-wrap items-center justify-between gap-3">
            <!-- Search: GET, so the filter, the page and Back all live in the address -->
            <form method="get" class="flex flex-1 min-w-[12rem] max-w-md gap-2" role="search">
                <input type="hidden" name="groupFilter" value="@Model.GroupFilter" />
                <div class="relative flex-1 min-w-0">
                    <input type="search" name="searchQuery" value="@Model.SearchQuery" placeholder="Search clips…"
                           aria-label="Search clips" autocomplete="off" enterkeyhint="search"
                           class="form-input w-full pl-10">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-tertiary pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <button type="submit" class="btn btn-secondary btn-sm shrink-0">Search</button>
            </form>

            <!-- Rescan Button -->
            <form method="post" asp-page-handler="Rescan" asp-route-guildId="@Model.GuildId" asp-route-groupFilter="@Model.GroupFilter" asp-route-searchQuery="@Model.SearchQuery" asp-route-pageNumber="@Model.PageNumber" data-submit-guard>
                <button type="submit" class="btn btn-secondary btn-sm" data-loading-text="Rescanning…">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Rescan clips
                </button>
            </form>
        </div>

        <!-- Clips Table -->
        @if (Model.FilteredClips.Count > 0)
        {
            <div class="overflow-x-auto">
                <table class="w-full">
                    <caption class="sr-only">VOX clip library</caption>
                    <thead class="bg-bg-tertiary border-b border-border-primary">
                        <tr>
                            <th scope="col" class="px-4 sm:px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Clip name</th>
                            <th scope="col" class="px-4 sm:px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Group</th>
                            <th scope="col" class="px-4 sm:px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Duration</th>
                            <th scope="col" class="px-4 sm:px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">File size</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var clip in Model.FilteredClips)
                        {
                            var groupBadgeColor = clip.Group switch
                            {
                                VoxClipGroup.Vox => "bg-accent-blue/20 text-accent-blue",
                                VoxClipGroup.Fvox => "bg-accent-orange/20 text-accent-orange",
                                VoxClipGroup.Hgrunt => "bg-success/20 text-success",
                                _ => "bg-accent-blue/20 text-accent-blue"
                            };

                            <tr class="hover:bg-bg-hover transition-colors">
                                <td class="px-4 sm:px-6 py-3 text-sm font-medium text-text-primary break-all">@clip.Name</td>
                                <td class="px-4 sm:px-6 py-3">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @groupBadgeColor">
                                        @clip.Group.ToString().ToUpperInvariant()
                                    </span>
                                </td>
                                <td class="px-4 sm:px-6 py-3 text-sm text-text-secondary whitespace-nowrap">@clip.DurationSeconds.ToString("F2")s</td>
                                <td class="px-4 sm:px-6 py-3 text-sm text-text-secondary whitespace-nowrap">@FormatFileSize(clip.FileSizeBytes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="px-4 sm:px-6 py-4 border-t border-border-primary">
                    <partial name="Shared/Components/_Pagination" model='new PaginationViewModel {
                        CurrentPage = Model.PageNumber,
                        TotalPages = Model.TotalPages,
                        TotalItems = Model.TotalClipCount,
                        PageSize = IndexModel.PageSize,
                        BaseUrl = PageUrl(Model.GroupFilter, 1),
                        PageParameterName = "pageNumber",
                        Style = PaginationStyle.Full,
                        ShowItemCount = true,
                        AriaLabel = "VOX clips pages"
                    }' />
                </div>
            }
        }
        else if (filtersActive)
        {
            <div class="px-6 py-8">
                <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                    Type = EmptyStateType.NoResults,
                    Title = "No clips match your filters",
                    Description = "Try a different search or group, or clear the filters to see every clip.",
                    PrimaryActionText = "Clear filters",
                    PrimaryActionUrl = clearFiltersUrl,
                    Size = EmptyStateSize.Default
                }' />
            </div>
        }
        else
        {
            <div class="px-6 py-8">
                <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                    Type = EmptyStateType.NoData,
                    Title = "No VOX clips found",
                    Description = "The clip folders are empty or could not be read. Add clips to the VOX folder on the bot, then use Rescan clips.",
                    Size = EmptyStateSize.Default
                }' />
            </div>
        }
    </div>
</div><!-- End VOX Page Content -->
}

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
}

@functions {
    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        int order = 0;
        double size = bytes;

        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }

        return $"{size:F2} {sizes[order]}";
    }
}

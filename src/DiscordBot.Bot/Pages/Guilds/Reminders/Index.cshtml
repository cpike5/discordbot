@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.Reminders.IndexModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = $"Reminders - {Model.ViewModel.GuildName}";
    Layout = "_GuildLayout";

    var guildId = Model.ViewModel.GuildId;
    var stats = Model.ViewModel.Stats;

    static BadgeVariant StatusVariant(ReminderStatus status) => status switch
    {
        ReminderStatus.Pending => BadgeVariant.Blue,
        ReminderStatus.Delivered => BadgeVariant.Success,
        ReminderStatus.Failed => BadgeVariant.Error,
        _ => BadgeVariant.Default
    };

    const string cancelIcon = "M6 18L18 6M6 6l12 12";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
        <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
            Type = EmptyStateType.Error,
            Title = "Reminders unavailable",
            Description = Model.ErrorMessage,
            PrimaryActionText = "Try again",
            PrimaryActionUrl = Url.Page("Index", new { guildId, status = (int?)Model.Status })
        }' />
    </div>
}
else
{
    <!-- Statistics -->
    <dl class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4 lg:gap-6 mb-6">
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-5">
            <dt class="text-sm font-medium text-text-secondary">Total</dt>
            <dd class="mt-2 text-2xl sm:text-3xl font-bold text-text-primary">@DisplayFormat.Number(stats.TotalCount)</dd>
            <dd class="mt-1 text-xs text-text-secondary">All time</dd>
        </div>
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-5">
            <dt class="text-sm font-medium text-text-secondary">Pending</dt>
            <dd class="mt-2 text-2xl sm:text-3xl font-bold text-accent-blue">@DisplayFormat.Number(stats.PendingCount)</dd>
            <dd class="mt-1 text-xs text-text-secondary">Waiting to be sent</dd>
        </div>
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-5">
            <dt class="text-sm font-medium text-text-secondary">Delivered today</dt>
            <dd class="mt-2 text-2xl sm:text-3xl font-bold text-success">@DisplayFormat.Number(stats.DeliveredTodayCount)</dd>
            <dd class="mt-1 text-xs text-text-secondary">Sent successfully</dd>
        </div>
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-5">
            <dt class="text-sm font-medium text-text-secondary">Failed</dt>
            <dd class="mt-2 text-2xl sm:text-3xl font-bold @(stats.FailedCount > 0 ? "text-error" : "text-text-primary")">@DisplayFormat.Number(stats.FailedCount)</dd>
            <dd class="mt-1 text-xs text-text-secondary">@(stats.FailedCount > 0 ? "Could not be delivered" : "Nothing failed")</dd>
        </div>
    </dl>

    <!-- Filters -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
        <form method="get" class="flex flex-col sm:flex-row sm:items-end gap-4">
            <div class="flex-1 sm:max-w-xs">
                <label for="status" class="form-label block mb-1.5">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    <option value="@((int)ReminderStatus.Pending)" selected="@(Model.Status == ReminderStatus.Pending)">Pending</option>
                    <option value="@((int)ReminderStatus.Delivered)" selected="@(Model.Status == ReminderStatus.Delivered)">Delivered</option>
                    <option value="@((int)ReminderStatus.Failed)" selected="@(Model.Status == ReminderStatus.Failed)">Failed</option>
                    <option value="@((int)ReminderStatus.Cancelled)" selected="@(Model.Status == ReminderStatus.Cancelled)">Cancelled</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                @if (Model.Status.HasValue)
                {
                    <a asp-page="Index" asp-route-guildId="@guildId" class="btn btn-secondary">Clear filters</a>
                }
            </div>
        </form>
    </div>

    @if (Model.ViewModel.TotalCount > 0)
    {
        <!-- Desktop table -->
        <div class="hidden md:block bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <caption class="sr-only">Reminders for @Model.ViewModel.GuildName</caption>
                    <thead class="bg-bg-tertiary border-b border-border-primary">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">User</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Message</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Due</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Created</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var reminder in Model.ViewModel.Reminders)
                        {
                            <tr class="table-row hover:bg-bg-hover transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(reminder.AvatarUrl))
                                        {
                                            <img src="@reminder.AvatarUrl" alt="" class="w-8 h-8 rounded-full" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="w-8 h-8 rounded-full bg-bg-tertiary flex items-center justify-center" aria-hidden="true">
                                                <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                            </div>
                                        }
                                        <span class="preview-trigger text-sm text-text-primary" data-preview-type="user" data-user-id="@reminder.UserId" data-context-guild-id="@guildId">@reminder.Username</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-text-secondary max-w-[250px] truncate block" title="@reminder.Message">@reminder.MessagePreview</span>
                                    @if (reminder.Status == ReminderStatus.Failed && !string.IsNullOrEmpty(reminder.LastError))
                                    {
                                        <span class="text-xs text-error block mt-1 max-w-[250px] break-words">Last error: @reminder.LastError</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-sm text-text-primary whitespace-nowrap">@DisplayFormat.Time(reminder.TriggerAt, "datetime-short")</td>
                                <td class="px-6 py-4 text-sm text-text-secondary whitespace-nowrap">@DisplayFormat.Time(reminder.CreatedAt, "datetime-short")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <partial name="Shared/Components/_Badge" model="new BadgeViewModel { Text = reminder.StatusText, Variant = StatusVariant(reminder.Status), Style = BadgeStyle.Subtle, Size = BadgeSize.Small, IsPill = true }" />
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-end gap-1 row-actions">
                                        @if (reminder.CanCancel)
                                        {
                                            <form method="post" asp-page-handler="Cancel" asp-route-guildId="@guildId"
                                                  asp-route-reminderId="@reminder.Id" asp-route-pageNumber="@Model.ViewModel.CurrentPage"
                                                  asp-route-pageSize="@Model.ViewModel.PageSize" asp-route-status="@((int?)Model.Status)"
                                                  data-submit-guard
                                                  data-confirm-title="Cancel this reminder?"
                                                  data-confirm-message="@($"The reminder for {reminder.Username} will not be sent.")"
                                                  data-confirm-text="Cancel reminder"
                                                  data-confirm-cancel="Keep reminder"
                                                  data-confirm-variant="danger" class="inline">
                                                <button type="submit" class="row-action-btn row-action-btn-danger"
                                                        aria-label="Cancel the reminder for @reminder.Username" title="Cancel reminder">
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@cancelIcon" /></svg>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile cards -->
        <ul class="md:hidden space-y-4" role="list">
            @foreach (var reminder in Model.ViewModel.Reminders)
            {
                <li class="bg-bg-secondary border border-border-primary rounded-lg p-4" data-row>
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <div class="flex items-center gap-3 min-w-0">
                            @if (!string.IsNullOrEmpty(reminder.AvatarUrl))
                            {
                                <img src="@reminder.AvatarUrl" alt="" class="w-9 h-9 rounded-full flex-shrink-0" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-9 h-9 rounded-full bg-bg-tertiary flex items-center justify-center flex-shrink-0" aria-hidden="true">
                                    <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                </div>
                            }
                            <span class="preview-trigger font-medium text-text-primary break-words min-w-0" data-preview-type="user" data-user-id="@reminder.UserId" data-context-guild-id="@guildId">@reminder.Username</span>
                        </div>
                        <partial name="Shared/Components/_Badge" model="new BadgeViewModel { Text = reminder.StatusText, Variant = StatusVariant(reminder.Status), Style = BadgeStyle.Subtle, Size = BadgeSize.Small, IsPill = true }" />
                    </div>

                    <p class="text-sm text-text-secondary break-words mb-1">@reminder.Message</p>
                    @if (reminder.Status == ReminderStatus.Failed && !string.IsNullOrEmpty(reminder.LastError))
                    {
                        <p class="text-xs text-error break-words mb-1">Last error: @reminder.LastError</p>
                    }

                    <dl class="grid grid-cols-2 gap-3 text-sm mt-3">
                        <div>
                            <dt class="text-text-secondary">Due</dt>
                            <dd class="text-text-primary">@DisplayFormat.Time(reminder.TriggerAt, "datetime-short")</dd>
                        </div>
                        <div>
                            <dt class="text-text-secondary">Created</dt>
                            <dd class="text-text-primary">@DisplayFormat.Time(reminder.CreatedAt, "datetime-short")</dd>
                        </div>
                    </dl>

                    @if (reminder.CanCancel)
                    {
                        <div class="mt-4 pt-3 border-t border-border-secondary">
                            <form method="post" asp-page-handler="Cancel" asp-route-guildId="@guildId"
                                  asp-route-reminderId="@reminder.Id" asp-route-pageNumber="@Model.ViewModel.CurrentPage"
                                  asp-route-pageSize="@Model.ViewModel.PageSize" asp-route-status="@((int?)Model.Status)"
                                  data-submit-guard
                                  data-confirm-title="Cancel this reminder?"
                                  data-confirm-message="@($"The reminder for {reminder.Username} will not be sent.")"
                                  data-confirm-text="Cancel reminder"
                                  data-confirm-cancel="Keep reminder"
                                  data-confirm-variant="danger" class="flex">
                                <button type="submit" class="btn btn-error btn-sm flex-1 justify-center min-h-[44px]">Cancel reminder</button>
                            </form>
                        </div>
                    }
                </li>
            }
        </ul>

        @if (Model.ViewModel.TotalPages > 1)
        {
            <div class="mt-6">
                <partial name="Shared/Components/_Pagination" model='new PaginationViewModel {
                    CurrentPage = Model.ViewModel.CurrentPage,
                    TotalPages = Model.ViewModel.TotalPages,
                    TotalItems = Model.ViewModel.TotalCount,
                    PageSize = Model.ViewModel.PageSize,
                    BaseUrl = Url.Page(null, new { guildId, status = (int?)Model.Status, pageSize = Model.ViewModel.PageSize }) ?? string.Empty,
                    Style = PaginationStyle.Full,
                    ShowItemCount = true,
                    PageParameterName = "pageNumber"
                }' />
            </div>
        }
    }
    else
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
            <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                Type = Model.Status.HasValue ? EmptyStateType.NoResults : EmptyStateType.FirstTime,
                Title = Model.Status.HasValue ? "No reminders match this filter" : "No reminders yet",
                Description = Model.Status.HasValue
                    ? "No reminders have this status. Clear the filter to see all of them."
                    : "Nobody has set a reminder in this server. Members create them with the /remind command in Discord.",
                PrimaryActionText = Model.Status.HasValue ? "Clear filters" : null,
                PrimaryActionUrl = Model.Status.HasValue ? Url.Page("Index", new { guildId }) : null,
                IconSvgPath = "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
            }' />
        </div>
    }
}

@section Scripts {
    <script src="~/js/confirm-forms.js" asp-append-version="true"></script>
}

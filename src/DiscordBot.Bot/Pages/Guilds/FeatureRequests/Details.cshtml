@page "{guildId:long}/{id:guid}"
@model DiscordBot.Bot.Pages.Guilds.FeatureRequests.DetailsModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@using System.Text.Json
@{
    ViewData["Title"] = $"Feature Request Details - {Model.GuildName}";
    Layout = "_GuildLayout";

    string badgeColor = "bg-text-tertiary/10 text-text-tertiary";
    string badgeLabel = "Unknown";

    if (Model.Item != null)
    {
        (badgeColor, badgeLabel) = Model.Item.Status switch
        {
            FeatureRequestStatus.Submitted => ("bg-accent-blue/10 text-accent-blue", "Submitted"),
            FeatureRequestStatus.GeneratingDocs => ("bg-yellow-500/10 text-yellow-500", "Generating Docs"),
            FeatureRequestStatus.DocsGenerated => ("bg-green-500/10 text-green-500", "Docs Generated"),
            FeatureRequestStatus.DocGenFailed => ("bg-red-500/10 text-red-500", "Doc Gen Failed"),
            FeatureRequestStatus.Approved => ("bg-green-600/10 text-green-600", "Approved"),
            FeatureRequestStatus.Rejected => ("bg-text-tertiary/10 text-text-tertiary", "Rejected"),
            _ => ("bg-text-tertiary/10 text-text-tertiary", Model.Item.Status.ToString())
        };
    }
}

<!-- Success Message -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model="new AlertViewModel {
            Variant = AlertVariant.Success,
            Message = Model.SuccessMessage,
            IsDismissible = true
        }" />
    </div>
}

<!-- Error Message -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model="new AlertViewModel {
            Variant = AlertVariant.Error,
            Message = Model.ErrorMessage,
            IsDismissible = true
        }" />
    </div>
}

@if (Model.Item == null)
{
    <p class="text-text-secondary">Feature request not found.</p>
}
else
{
    var shortId = Model.Item.Id.ToString("N")[..8].ToUpperInvariant();

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content Column -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Summary Card -->
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-mono text-text-tertiary">#@shortId</span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @badgeColor">
                            @badgeLabel
                        </span>
                    </div>
                    <div class="text-sm text-text-tertiary">
                        <span data-utc="@Model.Item.CreatedAt.ToString("o")" data-format="datetime"></span>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Description</h3>
                        <p class="text-text-primary whitespace-pre-wrap">@Model.Item.Description</p>
                    </div>

                    <div>
                        <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Submitter</h3>
                        <p class="text-text-primary text-sm">User ID: <span class="font-mono">@Model.Item.SubmittedByUserId</span></p>
                    </div>
                </div>
            </div>

            <!-- Gathered Requirements Card -->
            @if (!string.IsNullOrEmpty(Model.Item.GatheredRequirements))
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                    <h2 class="text-lg font-semibold text-text-primary mb-4">Gathered Requirements</h2>
                    @{
                        Core.Models.FeatureRequests.GatheredRequirements? gathered = null;
                        try
                        {
                            gathered = JsonSerializer.Deserialize<Core.Models.FeatureRequests.GatheredRequirements>(Model.Item.GatheredRequirements);
                        }
                        catch { }
                    }
                    @if (gathered != null)
                    {
                        <div class="space-y-4">
                            @if (!string.IsNullOrEmpty(gathered.ProblemStatement))
                            {
                                <div>
                                    <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Problem Statement</h3>
                                    <p class="text-text-primary">@gathered.ProblemStatement</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(gathered.SuccessCriteria))
                            {
                                <div>
                                    <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Success Criteria</h3>
                                    <p class="text-text-primary">@gathered.SuccessCriteria</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(gathered.Priority))
                            {
                                <div>
                                    <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Priority</h3>
                                    <p class="text-text-primary">@gathered.Priority</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <pre class="bg-bg-primary border border-border-primary rounded-md p-4 text-sm text-text-primary overflow-x-auto">@Model.Item.GatheredRequirements</pre>
                    }
                </div>
            }

            <!-- Doc Generation Card -->
            @if (!string.IsNullOrEmpty(Model.Item.DocBranchName) || !string.IsNullOrEmpty(Model.Item.DocGenError))
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                    <h2 class="text-lg font-semibold text-text-primary mb-4">Documentation Generation</h2>

                    @if (!string.IsNullOrEmpty(Model.Item.DocBranchName))
                    {
                        <div class="space-y-3">
                            <div>
                                <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Branch</h3>
                                <p class="text-accent-blue font-mono text-sm">@Model.Item.DocBranchName</p>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Item.DocPath))
                            {
                                <div>
                                    <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Doc Path</h3>
                                    <p class="text-text-primary font-mono text-sm">@Model.Item.DocPath</p>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Item.DocGenError))
                    {
                        <div class="mt-4">
                            <h3 class="text-sm font-semibold text-red-500 uppercase tracking-wider mb-1">Error</h3>
                            <pre class="bg-bg-primary border border-red-500/30 rounded-md p-3 text-sm text-red-400 overflow-x-auto">@Model.Item.DocGenError</pre>
                        </div>
                    }
                </div>
            }

            <!-- Review Information Card -->
            @if (Model.Item.ReviewedAt.HasValue)
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                    <h2 class="text-lg font-semibold text-text-primary mb-4">Review Information</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <span class="text-sm text-text-secondary">Reviewed by:</span>
                            <p class="text-text-primary text-sm font-mono">@(Model.Item.ReviewedByUserId?.ToString() ?? "Unknown")</p>
                        </div>
                        <div>
                            <span class="text-sm text-text-secondary">Reviewed at:</span>
                            <p class="text-text-primary"><span data-utc="@Model.Item.ReviewedAt.Value.ToString("o")" data-format="datetime"></span></p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Item.ReviewNotes))
                    {
                        <div class="mt-4">
                            <span class="text-sm text-text-secondary">Notes:</span>
                            <p class="text-text-primary mt-1">@Model.Item.ReviewNotes</p>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Action Panel Column -->
        <div class="lg:col-span-1">
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 sticky top-6">
                <h2 class="text-lg font-semibold text-text-primary mb-4">Actions</h2>

                @if (Model.Item.Status == FeatureRequestStatus.Submitted
                    || Model.Item.Status == FeatureRequestStatus.DocsGenerated
                    || Model.Item.Status == FeatureRequestStatus.GeneratingDocs)
                {
                    <!-- Review Notes -->
                    <div class="mb-4">
                        <label for="reviewNotes" class="block text-sm font-medium text-text-secondary mb-1">Review Notes (optional)</label>
                        <textarea id="reviewNotes" rows="3" class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary text-sm focus:ring-2 focus:ring-accent-blue focus:border-accent-blue" placeholder="Add notes for the record..."></textarea>
                    </div>

                    <div class="space-y-3">
                        <!-- Approve -->
                        <form method="post" asp-page-handler="Approve" asp-route-guildId="@Model.GuildId" asp-route-id="@Model.Item.Id">
                            <input type="hidden" name="ReviewNotes" id="reviewNotesApprove" />
                            <button type="submit"
                                onclick="document.getElementById('reviewNotesApprove').value=document.getElementById('reviewNotes').value"
                                class="w-full px-4 py-2 bg-green-600 text-white font-medium rounded-md hover:bg-green-700 transition-colors">
                                Approve
                            </button>
                        </form>

                        <!-- Reject -->
                        <form method="post" asp-page-handler="Reject" asp-route-guildId="@Model.GuildId" asp-route-id="@Model.Item.Id">
                            <input type="hidden" name="ReviewNotes" id="reviewNotesReject" />
                            <button type="submit"
                                onclick="document.getElementById('reviewNotesReject').value=document.getElementById('reviewNotes').value"
                                class="w-full px-4 py-2 bg-text-tertiary/20 text-text-primary font-medium rounded-md hover:bg-text-tertiary/30 transition-colors">
                                Reject
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Item.Status == FeatureRequestStatus.DocGenFailed)
                {
                    <!-- Approve / Reject available after DocGenFailed -->
                    <div class="mb-4">
                        <label for="reviewNotesFailed" class="block text-sm font-medium text-text-secondary mb-1">Review Notes (optional)</label>
                        <textarea id="reviewNotesFailed" rows="3" class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary text-sm focus:ring-2 focus:ring-accent-blue focus:border-accent-blue" placeholder="Add notes for the record..."></textarea>
                    </div>

                    <div class="space-y-3">
                        <form method="post" asp-page-handler="Approve" asp-route-guildId="@Model.GuildId" asp-route-id="@Model.Item.Id">
                            <input type="hidden" name="ReviewNotes" id="reviewNotesApprove2" />
                            <button type="submit"
                                onclick="document.getElementById('reviewNotesApprove2').value=document.getElementById('reviewNotesFailed').value"
                                class="w-full px-4 py-2 bg-green-600 text-white font-medium rounded-md hover:bg-green-700 transition-colors">
                                Approve Anyway
                            </button>
                        </form>

                        <form method="post" asp-page-handler="Reject" asp-route-guildId="@Model.GuildId" asp-route-id="@Model.Item.Id">
                            <input type="hidden" name="ReviewNotes" id="reviewNotesReject2" />
                            <button type="submit"
                                onclick="document.getElementById('reviewNotesReject2').value=document.getElementById('reviewNotesFailed').value"
                                class="w-full px-4 py-2 bg-text-tertiary/20 text-text-primary font-medium rounded-md hover:bg-text-tertiary/30 transition-colors">
                                Reject
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="text-center text-sm text-text-secondary">
                        This request has been <span class="font-medium">@badgeLabel.ToLower()</span>.
                    </div>
                }

                <div class="mt-6 pt-4 border-t border-border-primary">
                    <a href="/Guilds/@Model.GuildId/FeatureRequests" class="text-sm text-accent-blue hover:text-accent-blue/80 transition-colors">
                        &larr; Back to Feature Requests
                    </a>
                </div>
            </div>
        </div>
    </div>
}

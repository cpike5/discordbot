@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.FeatureRequests.IndexModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = $"Feature Requests - {Model.GuildName}";
    Layout = "_GuildLayout";

    var guildId = Model.GuildId;
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
        <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
            Type = EmptyStateType.Error,
            Title = "Feature requests unavailable",
            Description = Model.ErrorMessage,
            PrimaryActionText = "Try again",
            PrimaryActionUrl = Url.Page("Index", new { guildId, statusFilter = (int?)Model.StatusFilter, pageNumber = Model.PageNumber })
        }' />
    </div>
}
else
{
    <!-- Filter -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
        <form method="get" class="flex flex-col sm:flex-row sm:items-end gap-4">
            <div class="flex-1 sm:max-w-xs">
                <label for="statusFilter" class="form-label block mb-1.5">Status</label>
                <select id="statusFilter" name="StatusFilter" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<FeatureRequestStatus>())
                    {
                        <option value="@((int)status)" selected="@(Model.StatusFilter == status)">@FeatureRequestDisplay.Label(status)</option>
                    }
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                @if (Model.StatusFilter.HasValue)
                {
                    <a asp-page="Index" asp-route-guildId="@guildId" class="btn btn-secondary">Clear filters</a>
                }
            </div>
        </form>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
            <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                Type = Model.StatusFilter.HasValue ? EmptyStateType.NoResults : EmptyStateType.FirstTime,
                Title = Model.StatusFilter.HasValue ? "No feature requests match this filter" : "No feature requests yet",
                Description = Model.StatusFilter.HasValue
                    ? "No request has this status. Clear the filter to see all of them."
                    : "Members submit them with the /feature-request command in Discord.",
                PrimaryActionText = Model.StatusFilter.HasValue ? "Clear filters" : null,
                PrimaryActionUrl = Model.StatusFilter.HasValue ? Url.Page("Index", new { guildId }) : null,
                IconSvgPath = "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
            }' />
        </div>
    }
    else
    {
        <!-- Desktop table -->
        <div class="hidden md:block bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-6">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-border-primary">
                    <caption class="sr-only">Feature requests for @Model.GuildName</caption>
                    <thead class="bg-bg-tertiary">
                        <tr>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Ref</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Submitted by</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Description</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Date</th>
                            <th scope="col" class="px-4 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var item in Model.Items)
                        {
                            // GUID hex digits (ASCII), safe to slice
                            var shortId = item.Id.ToString("N")[..8].ToUpperInvariant();
                            <tr class="hover:bg-bg-hover transition-colors">
                                <td class="px-4 py-4 whitespace-nowrap"><span class="text-xs font-mono text-text-secondary">#@shortId</span></td>
                                <td class="px-4 py-4 whitespace-nowrap text-sm text-text-secondary">@Model.SubmitterName(item.SubmittedByUserId)</td>
                                <td class="px-4 py-4 text-sm text-text-primary max-w-md break-words">@FeatureRequestDisplay.Excerpt(item.Description)</td>
                                <td class="px-4 py-4 whitespace-nowrap"><partial name="Shared/Components/_Badge" model="FeatureRequestDisplay.Badge(item.Status)" /></td>
                                <td class="px-4 py-4 whitespace-nowrap text-sm text-text-secondary">@DisplayFormat.Time(item.CreatedAt, "date")</td>
                                <td class="px-4 py-4 whitespace-nowrap text-right">
                                    <a asp-page="Details" asp-route-guildId="@guildId" asp-route-id="@item.Id"
                                       class="row-action-btn row-action-btn-accent"
                                       aria-label="View feature request #@shortId" title="View details">
                                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile cards -->
        <ul class="md:hidden space-y-4 mb-6" role="list">
            @foreach (var item in Model.Items)
            {
                // GUID hex digits (ASCII), safe to slice
                var shortId = item.Id.ToString("N")[..8].ToUpperInvariant();
                <li class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <span class="text-xs font-mono text-text-secondary">#@shortId</span>
                        <partial name="Shared/Components/_Badge" model="FeatureRequestDisplay.Badge(item.Status)" />
                    </div>
                    <p class="text-sm text-text-primary break-words mb-2">@FeatureRequestDisplay.Excerpt(item.Description, 160)</p>
                    <div class="flex items-center justify-between gap-3 text-xs text-text-secondary mt-3 pt-3 border-t border-border-primary">
                        <span class="min-w-0 break-words">@Model.SubmitterName(item.SubmittedByUserId)</span>
                        <span class="flex-shrink-0">@DisplayFormat.Time(item.CreatedAt, "date")</span>
                    </div>
                    <div class="mt-3">
                        <a asp-page="Details" asp-route-guildId="@guildId" asp-route-id="@item.Id" class="btn btn-secondary btn-sm w-full justify-center min-h-[44px]">View details</a>
                    </div>
                </li>
            }
        </ul>

        @if (Model.TotalPages > 1)
        {
            <partial name="Shared/Components/_Pagination" model='new PaginationViewModel {
                CurrentPage = Model.PageNumber,
                TotalPages = Model.TotalPages,
                TotalItems = Model.Total,
                PageSize = Model.PageSize,
                BaseUrl = Url.Page(null, new { guildId, statusFilter = (int?)Model.StatusFilter }) ?? string.Empty,
                Style = PaginationStyle.Full,
                ShowItemCount = true,
                PageParameterName = "pageNumber"
            }' />
        }
    }
}

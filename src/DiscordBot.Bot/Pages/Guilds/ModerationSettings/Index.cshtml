@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.ModerationSettings.IndexModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.DTOs
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = $"Moderation Settings - {Model.GuildName}";
    Layout = "_GuildLayout";

    var vm = Model.ViewModel;
    var spam = vm.SpamConfig;
    var content = vm.ContentFilterConfig;
    var raid = vm.RaidProtectionConfig;

    var tabs = new TabPanelViewModel
    {
        Id = "modSettingsTabs",
        AriaLabel = "Moderation settings sections",
        ActiveTabId = "overview",
        NavigationMode = TabNavigationMode.InPage,
        PersistenceMode = TabPersistenceMode.UrlHash,
        StyleVariant = TabStyleVariant.Underline,
        Tabs = new[]
        {
            new TabItemViewModel { Id = "overview", Label = "Overview",
                IconPathOutline = "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" },
            new TabItemViewModel { Id = "spam", Label = "Spam",
                IconPathOutline = "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" },
            new TabItemViewModel { Id = "content", Label = "Content",
                IconPathOutline = "M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01" },
            new TabItemViewModel { Id = "raid", Label = "Raid",
                IconPathOutline = "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" },
            new TabItemViewModel { Id = "tags", Label = "Tags",
                IconPathOutline = "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" }
        }
    };

    var modeGroup = new RadioCardGroupViewModel
    {
        Name = "mode",
        Legend = "Configuration mode",
        HelpText = "Simple uses a ready-made protection level. Advanced lets you tune each rule on its own tab.",
        SelectedValue = ((int)vm.Mode).ToString(),
        Columns = 2,
        Options = new List<RadioCardViewModel>
        {
            new() { Value = ((int)ConfigMode.Simple).ToString(), Title = "Simple", Description = "Pick Relaxed, Moderate or Strict." },
            new() { Value = ((int)ConfigMode.Advanced).ToString(), Title = "Advanced", Description = "Set thresholds and actions yourself." }
        }
    };

    var presetGroup = new RadioCardGroupViewModel
    {
        Name = "preset",
        Legend = "Protection level",
        HelpText = "Choosing a level replaces your Spam, Content and Raid settings, including the blocklist. You are asked first.",
        SelectedValue = vm.SimplePreset,
        Columns = 3,
        Options = new List<RadioCardViewModel>
        {
            new() { Value = "Relaxed", Title = "Relaxed", Description = "Minimal intervention. Only catches obvious spam and severe violations." },
            new() { Value = "Moderate", Title = "Moderate", Description = "Balanced protection. Flags suspicious activity for review." },
            new() { Value = "Strict", Title = "Strict", Description = "Maximum protection. Aggressive detection with auto-actions enabled." }
        }
    };

    var categories = new[] { TagCategory.Positive, TagCategory.Negative, TagCategory.Neutral };

    // Mod-log channel picker: the saved channel stays listed even when the bot cannot see it
    var modLogOptions = new List<SelectOption> { new() { Value = string.Empty, Text = "Off (no channel)" } };
    if (Model.ModLogChannelMissing && vm.ModLogChannelId.HasValue)
    {
        modLogOptions.Add(new SelectOption { Value = vm.ModLogChannelId.Value.ToString(), Text = $"Unknown channel ({vm.ModLogChannelId.Value})" });
    }
    modLogOptions.AddRange(Model.AvailableChannels.Select(c => new SelectOption { Value = c.Id.ToString(), Text = "# " + c.Name }));
    var modLogOn = vm.ModLogChannelId.HasValue;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moderation.css" asp-append-version="true" />
}

<partial name="Shared/Components/_TabPanel" model="tabs" />

<div class="bg-bg-secondary border border-border-primary rounded-lg">
    <!-- Overview -->
    <div data-tab-panel-for="modSettingsTabs" data-tab-id="overview" id="modSettingsTabs-panel-overview" role="tabpanel" aria-labelledby="modSettingsTabs-tab-overview" class="p-4 sm:p-6">
        <form id="overviewForm" method="post" novalidate data-unsaved-changes data-settings-form="overview" class="mb-8">
            <partial name="Shared/Components/_RadioCardGroup" model="modeGroup" />

            <!-- Mod-log channel feed -->
            <section class="mt-6 pt-6 border-t border-border-secondary" aria-labelledby="modLogHeading">
                <h3 id="modLogHeading" class="text-lg font-semibold text-text-primary mb-1">Mod-log channel</h3>
                <p class="text-sm text-text-secondary mb-4">
                    Post an embed to a channel for each moderation case. Pick a channel only moderators can read: the
                    embed names the member and shows the reason. The portal stays the record either way.
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <partial name="Shared/Components/_FormSelect" model='new FormSelectViewModel {
                        Id = "modlog-channel", Name = "modLogChannelId", Label = "Channel", Placeholder = null,
                        SelectedValue = vm.ModLogChannelId?.ToString() ?? string.Empty, Options = modLogOptions,
                        HelpText = "The bot needs Send Messages and Embed Links in this channel.",
                        AdditionalAttributes = new() { ["data-field"] = "modLogChannelId" } }' />
                </div>
                @if (Model.SuggestedModLogChannel is { } suggested)
                {
                    <p class="text-sm text-text-secondary mt-2" id="modlog-suggestion">
                        Looks like this server has <span class="font-mono">#@suggested.Name</span>.
                        <button type="button" class="btn btn-ghost btn-sm" data-suggest-modlog="@suggested.Id">Use it</button>
                    </p>
                }
                @if (Model.ModLogChannelMissing)
                {
                    <p class="text-sm text-warning mt-2" role="status">
                        The saved channel is not one the bot can see right now. It may have been deleted, or the bot is offline. Nothing will be posted until you choose another.
                    </p>
                }
                <fieldset class="mt-4 space-y-3" id="modlog-kinds">
                    <legend class="text-sm font-semibold text-text-primary mb-1">What to post</legend>
                    <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                        Id = "modlog-kind-cases", Name = "modLogCases", Label = "Moderation cases",
                        Description = "Every warn, mute, kick, ban, unban and note, whether from a command, the portal or a fine.",
                        IsChecked = vm.ModLogEvents.HasFlag(ModLogEventKinds.Cases), IsDisabled = !modLogOn, PostsFalseWhenOff = false,
                        AdditionalAttributes = new() { ["data-modlog-kind"] = ((int)ModLogEventKinds.Cases).ToString() } }' />
                    <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                        Id = "modlog-kind-flagged", Name = "modLogFlagged", Label = "Flagged events",
                        Description = "Auto-moderation flagged something for review and took no action.",
                        IsChecked = vm.ModLogEvents.HasFlag(ModLogEventKinds.FlaggedEvents), IsDisabled = !modLogOn, PostsFalseWhenOff = false,
                        AdditionalAttributes = new() { ["data-modlog-kind"] = ((int)ModLogEventKinds.FlaggedEvents).ToString() } }' />
                    <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                        Id = "modlog-kind-auto", Name = "modLogAuto", Label = "Automatic actions",
                        Description = "Auto-moderation deleted a message, or muted, kicked or banned someone on its own.",
                        IsChecked = vm.ModLogEvents.HasFlag(ModLogEventKinds.AutoActions), IsDisabled = !modLogOn, PostsFalseWhenOff = false,
                        AdditionalAttributes = new() { ["data-modlog-kind"] = ((int)ModLogEventKinds.AutoActions).ToString() } }' />
                </fieldset>
            </section>

            <div class="mt-6 pt-6 border-t border-border-secondary flex flex-wrap items-center justify-end gap-3">
                <span class="text-sm text-warning hidden" data-unsaved-indicator>Unsaved changes</span>
                <button type="submit" class="btn btn-primary" data-loading-text="Saving…">Save overview</button>
            </div>
        </form>

        <!-- Simple mode: presets apply on their own, after a confirmation -->
        <div id="simpleMode" class="mb-8 @(vm.Mode == ConfigMode.Advanced ? "hidden" : "")">
            <partial name="Shared/Components/_RadioCardGroup" model="presetGroup" />
            <p id="presetStatus" class="sr-only" role="status"></p>
        </div>

        <!-- Advanced mode: pointer to the rule tabs -->
        <div id="advancedMode" class="mb-8 @(vm.Mode == ConfigMode.Simple ? "hidden" : "")">
            <div class="p-4 bg-bg-tertiary border border-border-primary rounded-lg">
                <div class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-accent-orange flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div>
                        <h3 class="font-semibold text-text-primary mb-1">Advanced configuration</h3>
                        <p class="text-sm text-text-secondary mb-3">
                            Configure each moderation feature on its own tab: thresholds, actions and exclusions.
                        </p>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" data-switch-tab="spam" class="btn btn-secondary btn-sm">Spam detection</button>
                            <button type="button" data-switch-tab="content" class="btn btn-secondary btn-sm">Content filter</button>
                            <button type="button" data-switch-tab="raid" class="btn btn-secondary btn-sm">Raid protection</button>
                            <button type="button" data-switch-tab="tags" class="btn btn-secondary btn-sm">Tags</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Last 24 hours -->
        <section aria-labelledby="activityHeading">
            <h3 id="activityHeading" class="text-lg font-semibold text-text-primary mb-4">Activity summary (last 24 hours)</h3>
            @if (!Model.StatisticsLoaded)
            {
                <div class="mb-4">
                    <partial name="Shared/Components/_Alert" model="new AlertViewModel {
                        Variant = AlertVariant.Warning,
                        Message = statsFailed
                    }" />
                </div>
            }
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="history-stat-card">
                    <span class="history-stat-value">@(Model.StatisticsLoaded ? Model.EventsFlagged.ToString("N0") : "—")</span>
                    <span class="history-stat-label">Events flagged</span>
                </div>
                <div class="history-stat-card">
                    <span class="history-stat-value">@(Model.StatisticsLoaded ? Model.ActionedEvents.ToString("N0") : "—")</span>
                    <span class="history-stat-label">Outcomes recorded</span>
                </div>
                <div class="history-stat-card">
                    <span class="history-stat-value" id="activeRulesCount">@Model.ActiveRules</span>
                    <span class="history-stat-label">Active rules</span>
                </div>
                <div class="history-stat-card">
                    <span class="history-stat-value">@(Model.StatisticsLoaded ? Model.DismissedEvents.ToString("N0") : "—")</span>
                    <span class="history-stat-label">Dismissed</span>
                </div>
            </div>
        </section>
    </div>

    <!-- Spam -->
    <div data-tab-panel-for="modSettingsTabs" data-tab-id="spam" id="modSettingsTabs-panel-spam" role="tabpanel" aria-labelledby="modSettingsTabs-tab-spam" class="p-4 sm:p-6" hidden>
        <form id="spamForm" method="post" novalidate data-unsaved-changes data-settings-form="spam">
            <div class="mb-6 pb-6 border-b border-border-secondary">
                <h3 class="text-lg font-semibold text-text-primary mb-3">Spam detection</h3>
                <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                    Id = "spam-enabled", Name = "enabled", Label = "Detect spam", Description = "Detect and flag spam messages automatically.",
                    IsChecked = spam.Enabled, PostsFalseWhenOff = false,
                    AdditionalAttributes = new() { ["data-field"] = "enabled" } }' />
            </div>

            <div class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                        Id = "spam-max-messages", Name = "maxMessagesPerWindow", Label = "Message rate threshold", Type = "number",
                        Value = spam.MaxMessagesPerWindow.ToString(), Min = "1", Max = "100", Step = "1", InputMode = "numeric", IsRequired = true,
                        HelpText = "Flag when a user sends this many messages...",
                        AdditionalAttributes = new() { ["data-field"] = "maxMessagesPerWindow", ["data-parse"] = "int" } }' />
                    <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                        Id = "spam-window-seconds", Name = "windowSeconds", Label = "Time window (seconds)", Type = "number",
                        Value = spam.WindowSeconds.ToString(), Min = "1", Max = "60", Step = "1", InputMode = "numeric", IsRequired = true,
                        HelpText = "...within this time period.",
                        AdditionalAttributes = new() { ["data-field"] = "windowSeconds", ["data-parse"] = "int" } }' />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                        Id = "spam-max-mentions", Name = "maxMentionsPerMessage", Label = "Max mentions per message", Type = "number",
                        Value = spam.MaxMentionsPerMessage.ToString(), Min = "1", Max = "50", Step = "1", InputMode = "numeric", IsRequired = true,
                        HelpText = "The most mentions one message may contain.",
                        AdditionalAttributes = new() { ["data-field"] = "maxMentionsPerMessage", ["data-parse"] = "int" } }' />
                    <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                        Id = "spam-duplicate-threshold", Name = "duplicateMessageThreshold", Label = "Similarity threshold (%)", Type = "number",
                        Value = ((int)Math.Round(spam.DuplicateMessageThreshold * 100)).ToString(), Min = "50", Max = "100", Step = "1", InputMode = "numeric", IsRequired = true,
                        HelpText = "Messages this similar count as duplicates.",
                        AdditionalAttributes = new() { ["data-field"] = "duplicateMessageThreshold", ["data-parse"] = "percent" } }' />
                </div>

                <div>
                    <label for="spam-auto-action" class="form-label block mb-1">Auto-action on detection</label>
                    <select id="spam-auto-action" name="autoAction" class="form-select md:w-72" data-field="autoAction" data-parse="int" aria-describedby="spam-auto-action-help">
                        <option value="@((int)AutoAction.None)" selected="@(spam.AutoAction == AutoAction.None)">None (flag only)</option>
                        <option value="@((int)AutoAction.Delete)" selected="@(spam.AutoAction == AutoAction.Delete)">Delete message</option>
                        <option value="@((int)AutoAction.Warn)" selected="@(spam.AutoAction == AutoAction.Warn)">Warn user</option>
                        <option value="@((int)AutoAction.Mute)" selected="@(spam.AutoAction == AutoAction.Mute)">Mute user (1 hour)</option>
                        <option value="@((int)AutoAction.Kick)" selected="@(spam.AutoAction == AutoAction.Kick)">Kick user</option>
                        <option value="@((int)AutoAction.Ban)" selected="@(spam.AutoAction == AutoAction.Ban)">Ban user</option>
                    </select>
                    <p id="spam-auto-action-help" class="form-help mt-1">What the bot does by itself when spam is detected.</p>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-border-secondary flex flex-wrap items-center justify-end gap-3">
                <span class="text-sm text-warning hidden" data-unsaved-indicator>Unsaved changes</span>
                <button type="submit" class="btn btn-primary" data-loading-text="Saving…">Save spam settings</button>
            </div>
        </form>
    </div>

    <!-- Content -->
    <div data-tab-panel-for="modSettingsTabs" data-tab-id="content" id="modSettingsTabs-panel-content" role="tabpanel" aria-labelledby="modSettingsTabs-tab-content" class="p-4 sm:p-6" hidden>
        <form id="contentForm" method="post" novalidate data-unsaved-changes data-settings-form="content">
            <div class="mb-6 pb-6 border-b border-border-secondary">
                <h3 class="text-lg font-semibold text-text-primary mb-3">Content filter</h3>
                <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                    Id = "content-enabled", Name = "enabled", Label = "Filter content", Description = "Block harmful, offensive or unwanted content.",
                    IsChecked = content.Enabled, PostsFalseWhenOff = false,
                    AdditionalAttributes = new() { ["data-field"] = "enabled" } }' />
            </div>

            <div class="space-y-6">
                <partial name="Shared/Components/_FormTextarea" model='new FormTextareaViewModel {
                    Id = "content-prohibited-words", Name = "prohibitedWords", Label = "Custom blocklist", Rows = 4, Dir = "auto",
                    Placeholder = "Enter words or phrases...", Value = string.Join(", ", content.ProhibitedWords),
                    HelpText = "Words and phrases to block, separated by commas. Up to 500 entries.",
                    AdditionalAttributes = new() { ["data-field"] = "prohibitedWords", ["data-parse"] = "list" } }' />

                <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                    Id = "content-block-invites", Name = "blockInviteLinks", Label = "Block Discord invite links",
                    Description = "Stop members posting invites to other servers.",
                    IsChecked = content.BlockInviteLinks, PostsFalseWhenOff = false,
                    AdditionalAttributes = new() { ["data-field"] = "blockInviteLinks" } }' />

                <div>
                    <label for="content-auto-action" class="form-label block mb-1">Auto-action on detection</label>
                    <select id="content-auto-action" name="autoAction" class="form-select md:w-72" data-field="autoAction" data-parse="int">
                        <option value="@((int)AutoAction.None)" selected="@(content.AutoAction == AutoAction.None)">None (flag only)</option>
                        <option value="@((int)AutoAction.Delete)" selected="@(content.AutoAction == AutoAction.Delete)">Delete message</option>
                        <option value="@((int)AutoAction.Warn)" selected="@(content.AutoAction == AutoAction.Warn)">Warn user</option>
                        <option value="@((int)AutoAction.Mute)" selected="@(content.AutoAction == AutoAction.Mute)">Delete and mute user</option>
                        <option value="@((int)AutoAction.Ban)" selected="@(content.AutoAction == AutoAction.Ban)">Delete and ban user</option>
                    </select>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-border-secondary flex flex-wrap items-center justify-end gap-3">
                <span class="text-sm text-warning hidden" data-unsaved-indicator>Unsaved changes</span>
                <button type="submit" class="btn btn-primary" data-loading-text="Saving…">Save content settings</button>
            </div>
        </form>
    </div>

    <!-- Raid -->
    <div data-tab-panel-for="modSettingsTabs" data-tab-id="raid" id="modSettingsTabs-panel-raid" role="tabpanel" aria-labelledby="modSettingsTabs-tab-raid" class="p-4 sm:p-6" hidden>
        <form id="raidForm" method="post" novalidate data-unsaved-changes data-settings-form="raid">
            <div class="mb-6 pb-6 border-b border-border-secondary">
                <h3 class="text-lg font-semibold text-text-primary mb-3">Raid protection</h3>
                <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                    Id = "raid-enabled", Name = "enabled", Label = "Detect raids", Description = "Detect and respond to coordinated attacks.",
                    IsChecked = raid.Enabled, PostsFalseWhenOff = false,
                    AdditionalAttributes = new() { ["data-field"] = "enabled" } }' />
            </div>

            <div class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                        Id = "raid-max-joins", Name = "maxJoinsPerWindow", Label = "Mass join threshold", Type = "number",
                        Value = raid.MaxJoinsPerWindow.ToString(), Min = "5", Max = "100", Step = "1", InputMode = "numeric", IsRequired = true,
                        HelpText = "Trigger when this many users join...",
                        AdditionalAttributes = new() { ["data-field"] = "maxJoinsPerWindow", ["data-parse"] = "int" } }' />
                    <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                        Id = "raid-window-seconds", Name = "windowSeconds", Label = "Time window (seconds)", Type = "number",
                        Value = raid.WindowSeconds.ToString(), Min = "10", Max = "300", Step = "1", InputMode = "numeric", IsRequired = true,
                        HelpText = "...within this time period.",
                        AdditionalAttributes = new() { ["data-field"] = "windowSeconds", ["data-parse"] = "int" } }' />
                </div>

                <div class="md:w-1/2">
                    <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                        Id = "raid-min-account-age", Name = "minAccountAgeHours", Label = "Minimum account age (hours)", Type = "number",
                        Value = raid.MinAccountAgeHours.ToString(), Min = "0", Max = "720", Step = "1", InputMode = "numeric", IsRequired = true,
                        HelpText = "Require accounts to be older than this. 0 means no restriction.",
                        AdditionalAttributes = new() { ["data-field"] = "minAccountAgeHours", ["data-parse"] = "int" } }' />
                </div>

                <div>
                    <label for="raid-auto-action" class="form-label block mb-1">Auto-action on raid detection</label>
                    <select id="raid-auto-action" name="autoAction" class="form-select md:w-72" data-field="autoAction" data-parse="int" aria-describedby="raid-auto-action-help">
                        <option value="@((int)RaidAutoAction.None)" selected="@(raid.AutoAction == RaidAutoAction.None)">None</option>
                        <option value="@((int)RaidAutoAction.AlertOnly)" selected="@(raid.AutoAction == RaidAutoAction.AlertOnly)">Alert only</option>
                        <option value="@((int)RaidAutoAction.LockInvites)" selected="@(raid.AutoAction == RaidAutoAction.LockInvites)">Lock invites</option>
                        <option value="@((int)RaidAutoAction.LockServer)" selected="@(raid.AutoAction == RaidAutoAction.LockServer)">Lock server</option>
                    </select>
                    <p id="raid-auto-action-help" class="form-help mt-1">What the bot does by itself when a raid is detected.</p>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-border-secondary flex flex-wrap items-center justify-end gap-3">
                <span class="text-sm text-warning hidden" data-unsaved-indicator>Unsaved changes</span>
                <button type="submit" class="btn btn-primary" data-loading-text="Saving…">Save raid settings</button>
            </div>
        </form>
    </div>

    <!-- Tags -->
    <div data-tab-panel-for="modSettingsTabs" data-tab-id="tags" id="modSettingsTabs-panel-tags" role="tabpanel" aria-labelledby="modSettingsTabs-tab-tags" class="p-4 sm:p-6" hidden>
        <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
            <div>
                <h3 class="text-lg font-semibold text-text-primary">User tags</h3>
                <p class="text-sm text-text-secondary">Define tags that moderators can put on members.</p>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" data-open-import>
                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                Import templates
            </button>
        </div>

        <ul class="space-y-3 mb-6" id="tags-list">
            @foreach (var tag in vm.Tags)
            {
                <li class="flex flex-wrap items-center justify-between gap-3 p-3 bg-bg-tertiary rounded-lg" data-tag-name="@tag.Name">
                    <div class="flex flex-wrap items-center gap-3 min-w-0">
                        <span class="user-tag @ModTagStyle.CssClass(tag.Category) break-all">@tag.Name</span>
                        <span class="text-sm text-text-secondary">@(tag.UserCount == 0 ? "Not used yet" : "Used by " + DisplayFormat.Plural(tag.UserCount, "member"))</span>
                    </div>
                    <button type="button" class="btn btn-ghost btn-icon text-error" data-delete-tag="@tag.Name" aria-label="Delete tag @tag.Name" title="Delete tag">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </li>
            }
        </ul>
        <div id="tags-empty" class="@(vm.Tags.Any() ? "hidden" : "") mb-6">
            <partial name="Shared/Components/_EmptyState" model="new EmptyStateViewModel {
                Type = EmptyStateType.NoData,
                Title = noTagsTitle,
                Description = noTagsText,
                Size = EmptyStateSize.Compact
            }" />
        </div>

        <form id="newTagForm" method="post" novalidate class="p-4 bg-bg-tertiary rounded-lg">
            <h4 class="font-medium text-text-primary mb-4">Add a tag</h4>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                    Id = "new-tag-name", Name = "name", Label = "Tag name", Placeholder = "For example: VIP or Trusted", MaxLength = 50, IsRequired = true,
                    Autocomplete = "off",
                    AdditionalAttributes = new() { ["data-field"] = "name" } }' />
                <div class="space-y-1.5">
                    <label for="new-tag-category" class="form-label block">Colour</label>
                    <select id="new-tag-category" name="category" class="form-select" data-field="category">
                        @foreach (var category in categories)
                        {
                            <option value="@((int)category)">@ModTagStyle.DisplayName(category)</option>
                        }
                    </select>
                </div>
                <div class="flex items-end">
                    <button type="submit" class="btn btn-primary w-full" data-loading-text="Adding…">Add tag</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Import templates dialog -->
<div id="importTemplatesDialog"
     class="hidden fixed inset-0 z-[var(--z-modal)]"
     role="dialog"
     aria-modal="true"
     aria-labelledby="importTemplatesTitle">
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm qa-modal-backdrop" data-modal-dismiss aria-hidden="true"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
        <form id="importTemplatesForm" method="post" novalidate
              class="bg-bg-tertiary border border-border-primary rounded-lg shadow-xl max-w-lg w-full max-h-[90vh] flex flex-col qa-modal-panel pointer-events-auto">
            <div class="p-6 overflow-y-auto min-h-0">
                <h2 id="importTemplatesTitle" class="text-lg font-semibold text-text-primary mb-1">Import template tags</h2>
                <p class="text-sm text-text-secondary mb-4">Add ready-made tags to this server. Tags it already has are skipped.</p>
                <fieldset>
                    <legend class="sr-only">Template tags to import</legend>
                    <div class="space-y-2">
                        @foreach (var (template, alreadyImported) in Model.TemplateOptions())
                        {
                            <label class="flex items-start gap-3 p-3 rounded-lg border border-border-primary bg-bg-secondary @(alreadyImported ? "opacity-60" : "cursor-pointer")">
                                <input type="checkbox" name="templates" value="@template.Name" class="w-4 h-4 mt-1 rounded border-border-primary flex-shrink-0"
                                       @(alreadyImported ? "disabled" : "checked") data-template-option />
                                <span class="min-w-0">
                                    <span class="user-tag @ModTagStyle.CssClass(template.Category) break-all">@template.Name</span>
                                    @if (alreadyImported)
                                    {
                                        <span class="ml-2 text-xs text-text-secondary">Already added</span>
                                    }
                                    <span class="block text-sm text-text-secondary mt-1">@template.Description</span>
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>
                <p id="importTemplatesError" class="form-error mt-3 hidden" role="alert"></p>
            </div>
            <div class="flex justify-end gap-3 px-6 py-4 bg-bg-secondary border-t border-border-primary rounded-b-lg flex-shrink-0">
                <button type="button" class="btn btn-secondary" data-modal-dismiss>Cancel</button>
                <button type="submit" id="importTemplatesSubmit" class="btn btn-primary" data-loading-text="Importing…">Import selected</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Server data for the page script. IDs are strings so snowflakes keep every digit.
        window.moderationData = {
            guildId: '@Model.GuildId',
            mode: @((int)vm.Mode),
            simplePreset: @Json.Serialize(vm.SimplePreset ?? string.Empty),
            modLogChannelId: '@(vm.ModLogChannelId?.ToString() ?? string.Empty)',
            modLogEvents: @((int)vm.ModLogEvents)
        };
    </script>
    <script src="~/js/moderation-settings.js" asp-append-version="true"></script>
}

@functions {
    private const string statsFailed = "The last-24-hours numbers could not be loaded. Reload the page to try again.";
    private const string noTagsTitle = "No tags yet";
    private const string noTagsText = "Add a tag below, or import the ready-made templates.";
}

@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.ModerationSettings.IndexModel
@{
    ViewData["Title"] = "Moderation Settings";
    Layout = "_GuildLayout";
}

<!-- Blazor island: the page keeps its route, layout, breadcrumb, header, auth and
     24h stats; the island owns the interactive settings body. -->
<component type="typeof(DiscordBot.Bot.Blazor.Pages.ModerationSettingsIsland)"
           render-mode="ServerPrerendered"
           param-GuildId="@Model.GuildId.ToString()"
           param-EventsFlagged="@Model.EventsFlagged"
           param-AutoActions="@Model.AutoActions"
           param-FalsePositives="@Model.FalsePositives" />

@section Styles {
    <link rel="stylesheet" href="~/css/moderation.css" asp-append-version="true" />
}

@section Scripts {
    @* The Blazor circuit + interop shim are bootstrapped globally in _Layout,
       so the island needs no per-page script. *@
}

@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.EditModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = $"Edit {Model.ViewModel.Name}";
    Layout = "_GuildLayout";

    var timeoutError = ViewData.ModelState.FieldError("Input.AutoLeaveTimeoutMinutes");
}

<div class="max-w-3xl mx-auto">
    <form method="post" id="guild-edit-form"
          data-submit-guard
          data-focus-first-error
          data-unsaved-changes
          data-unsaved-dirty-on-load="@(Model.DirtyOnLoad ? "true" : "false")"
          novalidate>
        <input type="hidden" name="Input.AudioSettingsLoaded" value="@(Model.AudioSettingsLoaded ? "true" : "false")" />
        <div asp-validation-summary="ModelOnly" class="form-error mb-4"></div>

        <!-- General Settings -->
        <section class="bg-bg-secondary border border-border-primary rounded-lg mb-6" aria-labelledby="general-heading">
            <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
                <h2 id="general-heading" class="text-lg font-semibold text-text-primary">General</h2>
            </div>
            <div class="p-4 sm:p-6">
                <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                    Id = "Input_IsActive",
                    Name = "Input.IsActive",
                    Label = "Bot active",
                    Description = "Turn the bot on or off for this server.",
                    IsChecked = Model.Input.IsActive
                }' />
            </div>
        </section>

        <!-- Audio Settings -->
        <section class="bg-bg-secondary border border-border-primary rounded-lg mb-6" aria-labelledby="audio-heading">
            <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
                <h2 id="audio-heading" class="text-lg font-semibold text-text-primary">Audio</h2>
            </div>
            @if (Model.AudioSettingsLoaded)
            {
                <div class="p-4 sm:p-6 space-y-5">
                    <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                        Id = "Input_AudioEnabled",
                        Name = "Input.AudioEnabled",
                        Label = "Audio enabled",
                        Description = "Turn the soundboard, text-to-speech and voice features on or off.",
                        IsChecked = Model.Input.AudioEnabled
                    }' />

                    <div class="max-w-xs">
                        <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                            Id = "Input_AutoLeaveTimeoutMinutes",
                            Name = "Input.AutoLeaveTimeoutMinutes",
                            Label = "Auto-leave timeout (minutes)",
                            Type = "number",
                            Value = Model.Input.AutoLeaveTimeoutMinutes.ToString(),
                            Min = "0",
                            Max = GuildAudioSettings.MaxAutoLeaveTimeoutMinutes.ToString(),
                            Step = "1",
                            InputMode = "numeric",
                            Autocomplete = "off",
                            HelpText = "Minutes of silence before the bot leaves the voice channel, from 0 to 60. 0 keeps it there.",
                            ValidationState = FormFieldState.StateOf(timeoutError),
                            ValidationMessage = timeoutError
                        }' />
                    </div>

                    <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                        Id = "Input_QueueEnabled",
                        Name = "Input.QueueEnabled",
                        Label = "Queue sounds",
                        Description = "On: sounds play one after another. Off: a new sound replaces the one playing.",
                        IsChecked = Model.Input.QueueEnabled
                    }' />

                    <div class="pt-3 border-t border-border-primary">
                        <a asp-page="/Guilds/AudioSettings" asp-route-guildId="@Model.ViewModel.Id" class="text-sm text-accent-blue hover:text-accent-blue/80 transition-colors">
                            More audio settings
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="p-4 sm:p-6">
                    <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                        Variant = AlertVariant.Warning,
                        Title = "Audio settings could not be loaded",
                        Message = "They are left as they are when you save. Reload the page to try again."
                    }' />
                    <a asp-page="Edit" asp-route-guildId="@Model.ViewModel.Id" class="btn btn-secondary mt-3">Reload audio settings</a>
                </div>
            }
        </section>

        <!-- Form Actions -->
        <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3">
            <span data-unsaved-indicator class="hidden text-sm text-warning sm:mr-auto" role="status">Unsaved changes</span>
            <a asp-page="Details" asp-route-guildId="@Model.ViewModel.Id" class="btn btn-secondary justify-center">Cancel</a>
            <button type="submit" class="btn btn-primary inline-flex items-center justify-center gap-2" data-loading-text="Saving...">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Save settings
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/form-focus.js" asp-append-version="true"></script>
}

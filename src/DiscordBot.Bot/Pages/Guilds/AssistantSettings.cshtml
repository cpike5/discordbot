@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.AssistantSettingsModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = $"Assistant Settings - {Model.Guild.Name}";
    Layout = "_GuildLayout";

    // A form re-rendered after a failed save shows input that is not saved yet.
    var dirtyOnLoad = HttpMethods.IsPost(Model.Request.Method);
    var rateError = ViewData.ModelState.FieldError("Input.RateLimitOverride");
    var selectedChannelCount = Model.AvailableChannels.Count(c => c.IsSelected);
    var toolCount = Model.ToolCategories.Sum(c => c.Tools.Count);
    var selectedToolCount = Model.ToolCategories.Sum(c => c.Tools.Count(t => t.IsSelected));
}

@if (!Model.GloballyEnabled)
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model='new AlertViewModel {
            Variant = AlertVariant.Warning,
            Message = "The AI assistant is switched off for every server. These settings take effect once it is turned on in the portal settings."
        }' />
    </div>
}

<form method="post" id="assistant-form"
      data-submit-guard
      data-focus-first-error
      data-unsaved-changes
      data-unsaved-dirty-on-load="@(dirtyOnLoad ? "true" : "false")"
      novalidate>
    <div asp-validation-summary="ModelOnly" class="form-error mb-4"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Configuration Form Column -->
        <div class="lg:col-span-2 space-y-6 min-w-0">
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6">
                <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                    Id = "Input_IsEnabled",
                    Name = "Input.IsEnabled",
                    Label = "Enable the AI assistant",
                    Description = "Let members ask questions by mentioning the bot.",
                    IsChecked = Model.Input.IsEnabled
                }' />
            </div>

            <div data-section-gate="#Input_IsEnabled" class="space-y-3">
                <p data-section-gate-note hidden class="text-sm text-text-secondary">
                    The assistant is off for this server. Turn it on above to edit these settings; your saved values are kept.
                </p>

                <div data-section-gate-body class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6 space-y-8">
                    <!-- Channel Selection -->
                    <fieldset class="min-w-0" aria-describedby="channels-help">
                        <legend class="form-label">Allowed channels</legend>
                        <p id="channels-help" class="form-help mb-3">Channels where the assistant can answer. Leave every box clear to allow all channels.</p>

                        <div class="max-h-64 overflow-y-auto border border-border-primary rounded-md bg-bg-primary">
                            @if (Model.AvailableChannels.Any())
                            {
                                @foreach (var channel in Model.AvailableChannels)
                                {
                                    <label class="flex items-center gap-3 px-4 py-3 hover:bg-bg-hover cursor-pointer border-b border-border-secondary last:border-b-0 min-h-[44px]">
                                        <input type="checkbox"
                                               name="Input.AllowedChannelIds"
                                               value="@channel.Id"
                                               checked="@channel.IsSelected"
                                               data-count-group="channels"
                                               class="w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange focus:ring-offset-bg-primary" />
                                        <span class="text-sm text-text-primary min-w-0 break-words">@(channel.IsMissing ? "" : "#")@channel.Name</span>
                                        <span class="text-xs @(channel.IsMissing ? "text-warning" : "text-text-secondary") ml-auto flex-shrink-0">@channel.Type</span>
                                    </label>
                                }
                            }
                            else
                            {
                                <div class="px-4 py-6 text-center text-text-secondary text-sm">
                                    No text channels are available. The bot may not be connected to this server right now.
                                </div>
                            }
                        </div>
                        <p class="text-xs text-text-secondary mt-2" id="channels-count" aria-live="polite"
                          
                          >
                            @DisplayFormat.Number(selectedChannelCount) of @DisplayFormat.Plural(Model.AvailableChannels.Count, "channel") selected
                        </p>
                        @if (Model.AvailableChannels.Any(c => c.IsMissing))
                        {
                            <p class="text-xs text-warning mt-1">
                                Some saved channels are not in this server's channel list (deleted, or not visible to the bot). They stay ticked until you clear them.
                            </p>
                        }
                    </fieldset>

                    <!-- Tool Access -->
                    <fieldset class="min-w-0" aria-describedby="tools-help">
                        <legend class="form-label">Tool access</legend>
                        <p id="tools-help" class="form-help mb-3">
                            Choose which tools the assistant may use in this server. Fewer tools means cheaper,
                            faster answers; a tool the assistant cannot see is one it cannot call.
                        </p>

                        @if (Model.UsingDefaultToolSet)
                        {
                            <div class="mb-3">
                                <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                                    Variant = AlertVariant.Info,
                                    Message = "No tools are chosen, so this server uses the default set, shown ticked below. Saving the page as it is keeps that default."
                                }' />
                            </div>
                        }

                        <div class="max-h-80 overflow-y-auto border border-border-primary rounded-md bg-bg-primary">
                            @foreach (var category in Model.ToolCategories)
                            {
                                <div class="border-b border-border-secondary last:border-b-0">
                                    <div class="px-4 py-2 bg-bg-tertiary/40">
                                        <span class="text-xs font-semibold uppercase tracking-wide text-text-secondary">@category.Category</span>
                                    </div>
                                    @foreach (var tool in category.Tools)
                                    {
                                        <label class="flex items-start gap-3 px-4 py-3 hover:bg-bg-hover cursor-pointer min-h-[44px]">
                                            <input type="checkbox"
                                                   name="Input.EnabledTools"
                                                   value="@tool.Name"
                                                   checked="@tool.IsSelected"
                                                   data-count-group="tools"
                                                   class="mt-0.5 w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange focus:ring-offset-bg-primary" />
                                            <span class="min-w-0">
                                                <span class="block text-sm text-text-primary">@tool.DisplayName</span>
                                                <span class="block text-xs text-text-secondary">@tool.Description</span>
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                        <p class="text-xs text-text-secondary mt-2" id="tools-count" aria-live="polite" data-count-total="@toolCount">
                            @DisplayFormat.Number(selectedToolCount) of @DisplayFormat.Plural(toolCount, "tool") selected.
                            Clearing every box restores the default set.
                        </p>
                    </fieldset>

                    <!-- Rate Limit Override -->
                    <div class="max-w-xs">
                        <partial name="Shared/Components/_FormInput" model='new FormInputViewModel {
                            Id = "Input_RateLimitOverride",
                            Name = "Input.RateLimitOverride",
                            Label = "Rate limit override",
                            Type = "number",
                            Value = Model.Input.RateLimitOverride?.ToString(),
                            Placeholder = $"{Model.DefaultRateLimit} (default)",
                            Min = "1",
                            Max = "100",
                            Step = "1",
                            InputMode = "numeric",
                            Autocomplete = "off",
                            HelpText = $"Questions per person in each {Model.RateLimitWindowMinutes}-minute window. Leave empty to use the default of {Model.DefaultRateLimit}.",
                            ValidationState = FormFieldState.StateOf(rateError),
                            ValidationMessage = rateError
                        }' />
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <button type="submit" class="btn btn-primary inline-flex items-center justify-center gap-2" data-loading-text="Saving...">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Save settings
                </button>
                <a asp-page="Details" asp-route-guildId="@Model.Guild.Id" class="btn btn-secondary inline-flex items-center justify-center">Cancel</a>
                <span data-unsaved-indicator class="hidden text-sm text-warning" role="status">Unsaved changes</span>
                <a asp-page="AssistantMetrics" asp-route-guildId="@Model.Guild.Id" class="btn btn-ghost inline-flex items-center justify-center gap-2 sm:ml-auto">
                    View metrics
                </a>
            </div>
        </div>

        <!-- Help Panel Column -->
        <div class="space-y-6 min-w-0">
            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
                    <h2 class="text-sm font-semibold text-text-primary">How it works</h2>
                </div>
                <div class="p-4 sm:p-6 space-y-4 text-sm text-text-secondary">
                    <p>When it is on, members ask questions by mentioning the bot:</p>
                    <div class="bg-bg-primary border border-border-primary rounded-md p-3 font-mono text-xs break-words">
                        <span class="text-accent-blue">@@BotName</span> How do I use the soundboard?
                    </div>
                    <p>The bot uses AI to answer questions about its features and commands.</p>
                </div>
            </div>

            <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                Variant = AlertVariant.Info,
                Title = "Member consent required",
                Message = "Members must agree with /consent before using the assistant. Questions and answers are logged for debugging."
            }' />

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <h2 class="text-sm font-semibold text-text-primary mb-2">Rate limiting</h2>
                <p class="text-xs text-text-secondary">
                    Rate limits keep the API cost in check. By default each person can ask @Model.DefaultRateLimit
                    questions every @Model.RateLimitWindowMinutes minutes. Admins are not limited.
                </p>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/section-gate.js" asp-append-version="true"></script>
    <script src="~/js/form-focus.js" asp-append-version="true"></script>
    <script src="~/js/assistant-settings.js" asp-append-version="true"></script>
}

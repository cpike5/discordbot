@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.DetailsModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.Interfaces
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = Model.ViewModel.Name;
    Layout = "_GuildLayout";
    var guild = Model.ViewModel;

    // Where a failed widget's "Try again" goes: this page, which loads every section again
    var retryUrl = Url.Page("Details", new { guildId = guild.Id });
    const string widgets = "~/Pages/Guilds/Widgets/";

    const string widgetEmptyIcon = "M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4";

    // One widget per section. A section that failed to load gets a retry state; one that loaded
    // but has nothing to show gets an empty state; otherwise its body partial renders.
    var scheduledMessagesWidget = new DashboardWidgetViewModel
    {
        Title = "Scheduled messages",
        DetailUrl = Url.Page("ScheduledMessages/Index", new { guildId = guild.Id }),
        LoadFailed = Model.SectionFailed(GuildDetailsSections.ScheduledMessages),
        RetryUrl = retryUrl,
        BodyPartial = widgets + "_ScheduledMessagesBody.cshtml",
        BodyModel = Model,
        EmptyState = Model.ScheduledMessagesTotal > 0 ? null : new EmptyStateViewModel
        {
            Type = EmptyStateType.NoData,
            Title = "No scheduled messages yet",
            Description = "Send a message to a channel on a schedule.",
            IconSvgPath = "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
            PrimaryActionText = "Create a scheduled message",
            PrimaryActionUrl = Url.Page("ScheduledMessages/Create", new { guildId = guild.Id })
        }
    };

    var ratWatchWidget = new DashboardWidgetViewModel
    {
        Title = "Rat Watch",
        IsEnabled = Model.SectionFailed(GuildDetailsSections.RatWatch) ? null : Model.RatWatchEnabled,
        DetailUrl = Url.Page("RatWatch/Incidents", new { guildId = guild.Id }),
        DetailLinkText = "Incidents →",
        HeaderActions = new List<WidgetHeaderAction>
        {
            new() { Text = "Settings", Url = Url.Page("RatWatch/Index", new { guildId = guild.Id }) ?? string.Empty },
            new() { Text = "Analytics", Url = Url.Page("RatWatch/Analytics", new { guildId = guild.Id }) ?? string.Empty }
        },
        LoadFailed = Model.SectionFailed(GuildDetailsSections.RatWatch),
        RetryUrl = retryUrl,
        BodyPartial = widgets + "_RatWatchBody.cshtml",
        BodyModel = Model,
        EmptyState = Model.RatWatchTotal > 0 ? null : new EmptyStateViewModel
        {
            Type = EmptyStateType.NoData,
            Title = Model.RatWatchEnabled ? "No watches yet" : "Rat Watch is off",
            Description = Model.RatWatchEnabled
                ? "Use the \"Rat Watch\" message command in Discord to start accountability tracking."
                : "Turn Rat Watch on in its settings to start tracking.",
            IconSvgPath = "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
        }
    };

    var remindersWidget = new DashboardWidgetViewModel
    {
        Title = "Reminders",
        DetailUrl = Url.Page("Reminders/Index", new { guildId = guild.Id }),
        LoadFailed = Model.SectionFailed(GuildDetailsSections.Reminders),
        RetryUrl = retryUrl,
        BodyPartial = widgets + "_RemindersBody.cshtml",
        BodyModel = Model,
        EmptyState = Model.RemindersTotal > 0 ? null : new EmptyStateViewModel
        {
            Type = EmptyStateType.NoData,
            Title = "No reminders yet",
            Description = "Members create reminders with the /remind command in Discord.",
            IconSvgPath = "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
        }
    };

    var audioHasData = Model.AudioEnabled && (Model.TotalSoundCount > 0 || Model.TopSounds.Any() || !string.IsNullOrEmpty(Model.MostUsedTtsVoice));
    var audioWidget = new DashboardWidgetViewModel
    {
        Title = "Audio",
        IsEnabled = Model.SectionFailed(GuildDetailsSections.Audio) ? null : Model.AudioEnabled,
        DetailUrl = Url.Page("AudioSettings/Index", new { guildId = guild.Id }),
        LoadFailed = Model.SectionFailed(GuildDetailsSections.Audio),
        RetryUrl = retryUrl,
        BodyPartial = widgets + "_AudioBody.cshtml",
        BodyModel = Model,
        EmptyState = audioHasData ? null : new EmptyStateViewModel
        {
            Type = EmptyStateType.NoData,
            Title = Model.AudioEnabled ? "No audio activity yet" : "Audio is off",
            Description = Model.AudioEnabled ? "Upload sounds and use text-to-speech to see stats here." : "Turn audio on in the audio settings.",
            IconSvgPath = "M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3",
            PrimaryActionText = Model.AudioEnabled ? null : "Open audio settings",
            PrimaryActionUrl = Model.AudioEnabled ? null : Url.Page("AudioSettings/Index", new { guildId = guild.Id })
        }
    };

    var assistantOn = Model.AssistantGloballyEnabled && Model.AssistantLocallyEnabled;
    var assistantWidget = new DashboardWidgetViewModel
    {
        Title = "Assistant",
        IsEnabled = Model.SectionFailed(GuildDetailsSections.Assistant) ? null : Model.AssistantLocallyEnabled,
        DetailUrl = Url.Page("AssistantSettings", new { guildId = guild.Id }),
        LoadFailed = Model.SectionFailed(GuildDetailsSections.Assistant),
        RetryUrl = retryUrl,
        BodyPartial = widgets + "_AssistantBody.cshtml",
        BodyModel = Model,
        EmptyState = assistantOn ? null : !Model.AssistantGloballyEnabled
            ? new EmptyStateViewModel
            {
                Type = EmptyStateType.Error,
                Title = "Assistant unavailable",
                Description = "The AI assistant is switched off for every server. An admin can turn it on in the portal settings.",
                IconSvgPath = "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            }
            : new EmptyStateViewModel
            {
                Type = EmptyStateType.NoData,
                Title = "Assistant is off",
                Description = "Turn it on to let members ask questions about the bot's features.",
                IconSvgPath = "M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
                PrimaryActionText = "Open assistant settings",
                PrimaryActionUrl = Url.Page("AssistantSettings", new { guildId = guild.Id })
            }
    };

    var membersWidget = new DashboardWidgetViewModel
    {
        Title = "Members",
        DetailUrl = Url.Page("Members/Index", new { guildId = guild.Id }),
        LoadFailed = Model.SectionFailed(GuildDetailsSections.Members),
        RetryUrl = retryUrl,
        BodyPartial = widgets + "_MembersBody.cshtml",
        BodyModel = Model,
        EmptyState = Model.MembersTotalCount > 0 ? null : new EmptyStateViewModel
        {
            Type = EmptyStateType.NoData,
            Title = "No members found",
            Description = "Member data appears here once the server has synced.",
            IconSvgPath = widgetEmptyIcon
        }
    };

    var activityWidget = new DashboardWidgetViewModel
    {
        Title = "Activity",
        Subtitle = "Recent command activity",
        IconSvgPath = "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
        DetailUrl = $"/Commands?tab=logs&GuildId={guild.Id}",
        LoadFailed = Model.SectionFailed(GuildDetailsSections.Activity),
        RetryUrl = retryUrl,
        BodyPartial = widgets + "_ActivityBody.cshtml",
        BodyModel = Model,
        EmptyState = guild.RecentCommandLogs.Any() ? null : new EmptyStateViewModel
        {
            Type = EmptyStateType.NoData,
            Title = "No command activity yet",
            Description = "No commands have been run in this server."
        },
        ColSpan = 2
    };

    const string infoIconMembers = "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z";
    const string infoIconCalendar = "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z";
    const string infoIconChat = "M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z";
    const string infoIconBolt = "M13 10V3L4 14h7v7l9-11h-7z";
}

<!-- Server information (always visible, not in tabs) -->
<section class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6 mb-6" aria-labelledby="server-info-heading">
    <h2 id="server-info-heading" class="text-lg font-semibold text-text-primary mb-4">Server information</h2>
    <dl class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
        <div>
            <dt class="flex items-center gap-2 mb-1 text-sm text-text-secondary font-medium">
                <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@infoIconMembers" /></svg>
                Members
            </dt>
            <dd class="text-xl font-bold text-text-primary">@DisplayFormat.Number(guild.MemberCount)</dd>
        </div>
        <div>
            <dt class="flex items-center gap-2 mb-1 text-sm text-text-secondary font-medium">
                <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@infoIconCalendar" /></svg>
                Bot joined
            </dt>
            <dd class="text-xl font-bold text-text-primary">@DisplayFormat.Time(guild.JoinedAt, "date")</dd>
        </div>
        <div>
            <dt class="flex items-center gap-2 mb-1 text-sm text-text-secondary font-medium">
                <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@infoIconChat" /></svg>
                Prefix
            </dt>
            <dd class="text-xl font-bold text-text-primary font-mono">
                @if (!string.IsNullOrEmpty(guild.Prefix))
                {
                    @guild.Prefix
                }
                else
                {
                    <span class="text-text-secondary text-base font-sans">Default (/)</span>
                }
            </dd>
        </div>
        <div>
            <dt class="flex items-center gap-2 mb-1 text-sm text-text-secondary font-medium">
                <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@infoIconBolt" /></svg>
                Status
            </dt>
            <dd class="text-xl font-bold @(guild.IsActive ? "text-success" : "text-text-secondary")">@(guild.IsActive ? "Active" : "Inactive")</dd>
        </div>
        <div>
            <dt class="flex items-center gap-2 mb-1 text-sm text-text-secondary font-medium">
                <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@infoIconChat" /></svg>
                Welcome messages
            </dt>
            <dd class="text-xl font-bold">
                @if (Model.SectionFailed(GuildDetailsSections.Welcome))
                {
                    <span class="text-text-secondary text-base">Unavailable</span>
                }
                else if (Model.WelcomeEnabled)
                {
                    <span class="text-success">On</span>
                }
                else
                {
                    <span class="text-text-secondary">Off</span>
                }
            </dd>
        </div>
    </dl>
</section>

<!-- Widgets -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-6">
    <partial name="Shared/Components/_DashboardWidget" model="scheduledMessagesWidget" />
    <partial name="Shared/Components/_DashboardWidget" model="ratWatchWidget" />
    <partial name="Shared/Components/_DashboardWidget" model="remindersWidget" />
    <partial name="Shared/Components/_DashboardWidget" model="audioWidget" />
    <partial name="Shared/Components/_DashboardWidget" model="assistantWidget" />
    <partial name="Shared/Components/_DashboardWidget" model="membersWidget" />
    <partial name="Shared/Components/_DashboardWidget" model="activityWidget" />
</div>

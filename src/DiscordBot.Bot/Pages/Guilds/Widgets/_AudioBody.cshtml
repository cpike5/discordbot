@model DiscordBot.Bot.Pages.Guilds.DetailsModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@{
    const string stat = "~/Pages/Guilds/Widgets/_WidgetStat.cshtml";
}

<div class="grid grid-cols-2 gap-3 sm:gap-4 mb-4">
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Total sounds", Value = DisplayFormat.Number(Model.TotalSoundCount) }' />
    <partial name="@stat" model='new WidgetStatViewModel {
        Label = "Top TTS voice",
        Compact = true,
        Value = string.IsNullOrEmpty(Model.MostUsedTtsVoice) ? "No TTS use this week" : Model.MostUsedTtsVoice
    }' />
</div>

@if (Model.TopSounds.Any())
{
    <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wide mb-3">Top sounds this week</h3>
    <ul class="space-y-2">
        @foreach (var sound in Model.TopSounds)
        {
            <li class="flex items-center justify-between gap-2 p-2 rounded-lg bg-bg-primary">
                <span class="text-sm font-medium text-text-primary truncate min-w-0" title="@sound.Name">@sound.Name</span>
                <span class="text-sm font-bold text-accent-blue flex-shrink-0">@DisplayFormat.Plural(sound.PlayCount, "play")</span>
            </li>
        }
    </ul>
}

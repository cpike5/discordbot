@model DiscordBot.Bot.Pages.Guilds.DetailsModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@{
    const string stat = "~/Pages/Guilds/Widgets/_WidgetStat.cshtml";
}

<div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Total", Value = DisplayFormat.Number(Model.RemindersTotal), IconPath = "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" }' />
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Pending", Value = DisplayFormat.Number(Model.RemindersPending), Tone = "blue", IconPath = "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" }' />
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Delivered today", Value = DisplayFormat.Number(Model.RemindersDeliveredToday), Tone = "success", IconPath = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" }' />
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Failed", Value = DisplayFormat.Number(Model.RemindersFailed), Tone = Model.RemindersFailed > 0 ? "error" : "default", IconPath = "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" }' />
</div>

@if (Model.UpcomingReminders.Any())
{
    <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wide mt-6 mb-3">Upcoming</h3>
    <ul class="space-y-2">
        @foreach (var reminder in Model.UpcomingReminders)
        {
            <li class="p-2 rounded-lg hover:bg-bg-tertiary transition-colors">
                <p class="text-sm font-medium text-text-primary preview-trigger" data-preview-type="user" data-user-id="@reminder.UserId" data-context-guild-id="@Model.ViewModel.Id">@reminder.Username</p>
                <p class="text-xs text-text-secondary truncate mt-0.5">@reminder.MessagePreview</p>
                <p class="text-xs text-text-secondary mt-1">@DisplayFormat.Time(reminder.TriggerAt, relative: true)</p>
            </li>
        }
    </ul>
}

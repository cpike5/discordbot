@model DiscordBot.Bot.Pages.Guilds.DetailsModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@{
    const string stat = "~/Pages/Guilds/Widgets/_WidgetStat.cshtml";
}

<div class="grid grid-cols-2 gap-3 sm:gap-4 mb-4">
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Members", Value = DisplayFormat.Number(Model.MembersTotalCount) }' />
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Active today", Value = DisplayFormat.Number(Model.MembersActiveToday), Tone = "success" }' />
</div>

@if (Model.NewestMembers.Any())
{
    <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wide mb-4">Newest members</h3>
    <ul class="space-y-2">
        @foreach (var member in Model.NewestMembers)
        {
            var avatarUrl = Model.MemberAvatarUrl(member);
            <li>
                <a asp-page="/Guilds/Members/Index" asp-route-guildId="@Model.ViewModel.Id" asp-route-searchTerm="@member.UserId"
                   class="flex items-center gap-3 p-2 rounded-lg hover:bg-bg-tertiary transition-colors">
                    @if (avatarUrl != null)
                    {
                        <img src="@avatarUrl" alt="" class="w-10 h-10 rounded-full" loading="lazy" />
                    }
                    else
                    {
                        <div class="w-10 h-10 rounded-full bg-bg-tertiary flex items-center justify-center" aria-hidden="true">
                            <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                        </div>
                    }
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-text-primary truncate preview-trigger" data-preview-type="user" data-user-id="@member.UserId" data-context-guild-id="@Model.ViewModel.Id">@member.DisplayName</p>
                        <p class="text-xs text-text-secondary">Joined @DisplayFormat.Time(member.JoinedAt, "date")</p>
                    </div>
                </a>
            </li>
        }
    </ul>
}

@model DiscordBot.Bot.Pages.Guilds.DetailsModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@{
    const string stat = "~/Pages/Guilds/Widgets/_WidgetStat.cshtml";
}

<div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Total watches", Value = DisplayFormat.Number(Model.RatWatchTotal), IconPath = "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" }' />
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Pending or voting", Value = DisplayFormat.Number(Model.RatWatchPending), Tone = "warning", IconPath = "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" }' />
    <partial name="@stat" model='new WidgetStatViewModel { Label = "Completed", Value = DisplayFormat.Number(Model.RatWatchCompleted), Tone = "success", IconPath = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" }' />
</div>

@if (Model.TopRatLeaderboard.Any())
{
    <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wide mt-4 mb-3">Top rats</h3>
    <ol class="space-y-2">
        @foreach (var entry in Model.TopRatLeaderboard)
        {
            <li class="flex items-center justify-between gap-2 p-2 rounded-lg bg-bg-primary">
                <div class="flex items-center gap-2 min-w-0 flex-1">
                    <span class="text-sm font-bold text-text-secondary flex-shrink-0 w-8">@(entry.Rank switch { 1 => "\U0001F947", 2 => "\U0001F948", 3 => "\U0001F949", _ => $"#{entry.Rank}" })</span>
                    <span class="text-sm font-medium text-text-primary truncate" title="@entry.Username">@entry.Username</span>
                </div>
                <span class="text-sm font-bold text-error flex-shrink-0">@entry.GuiltyCount guilty</span>
            </li>
        }
    </ol>
}

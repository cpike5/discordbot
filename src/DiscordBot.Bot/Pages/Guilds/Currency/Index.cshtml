@page "/Guilds/{guildId:long}/Currency"
@model DiscordBot.Bot.Pages.Guilds.Currency.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = $"Currency - {Model.ViewModel.GuildName}";
    Layout = "_GuildLayout";
}

<partial name="Shared/Components/_TabPanel" model='new TabPanelViewModel {
    Id = "currencyTabs",
    StyleVariant = TabStyleVariant.Pills,
    NavigationMode = TabNavigationMode.PageNavigation,
    Tabs = new List<TabItemViewModel>
    {
        new() {
            Id = "currencies",
            Label = "Currencies",
            Href = $"/Guilds/{Model.ViewModel.GuildId}/Currency",
            BadgeCount = Model.ViewModel.GuildCurrencies.Count,
            BadgeVariant = TabBadgeVariant.Info,
            IconPathOutline = "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        },
        new() {
            Id = "prices",
            Label = "Prices",
            Href = $"/Guilds/{Model.ViewModel.GuildId}/Currency/Prices",
            BadgeCount = Model.ViewModel.PricedFeatureCount,
            BadgeVariant = TabBadgeVariant.Warning,
            IconPathOutline = "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 10V5a2 2 0 012-2z"
        }
    },
    ActiveTabId = "currencies",
    AriaLabel = "Currency sections"
}' />

@if (Model.IsCurrencyRuntimeDisabled)
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model='new AlertViewModel {
            Variant = AlertVariant.Warning,
            Title = "Currency Features Disabled",
            Message = "Currency features are switched off globally, so nothing is being charged and the wallet commands are unavailable. Balances and prices are kept and take effect again when an administrator re-enables the feature in Settings."
        }' />
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model="new AlertViewModel { Variant = AlertVariant.Success, Message = Model.SuccessMessage, IsDismissible = true }" />
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model="new AlertViewModel { Variant = AlertVariant.Error, Message = Model.ErrorMessage, IsDismissible = true }" />
    </div>
}

<!-- Guild currencies -->
<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div>
        <h2 class="text-lg font-semibold text-text-primary">Server Currencies</h2>
        <p class="text-sm text-text-secondary">Currencies this server owns. Nothing costs anything until you set a price.</p>
    </div>
    <button type="button" data-currency-action="create"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        New Currency
    </button>
</div>

@if (Model.ViewModel.GuildCurrencies.Count == 0)
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg mb-8">
        <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
            Title = "No currencies yet",
            Description = "Create a currency to give this server a wallet system. You can then price soundboard sounds, mint units, and fine members.",
            IconSvgPath = "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        }' />
    </div>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
        @foreach (var item in Model.ViewModel.GuildCurrencies)
        {
            var currency = item.Currency;
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-5 @(currency.IsActive ? "" : "opacity-70")"
                 data-currency-card="@currency.Id">
                <div class="flex items-start justify-between gap-3 mb-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-2xl leading-none" aria-hidden="true">@currency.Symbol</span>
                            <h3 class="text-base font-semibold text-text-primary truncate">@currency.Name</h3>
                            @if (!currency.IsActive)
                            {
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-bg-tertiary text-text-tertiary border border-border-primary">Deactivated</span>
                            }
                        </div>
                        <div class="flex items-center gap-2 flex-wrap mt-2">
                            <span class="px-2 py-0.5 text-xs rounded-full border @(currency.IsTransferable ? "border-accent-blue/40 text-accent-blue bg-accent-blue/10" : "border-border-primary text-text-tertiary")">
                                @(currency.IsTransferable ? "Transferable" : "Not transferable")
                            </span>
                            @if (currency.AllowNegative)
                            {
                                <span class="px-2 py-0.5 text-xs rounded-full border border-error/40 text-error bg-error/10">
                                    Debt to @currency.DebtFloor
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-3 mb-4">
                    <div>
                        <p class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">Holders</p>
                        <p class="text-sm text-text-primary">@item.HolderCount.ToString("N0")</p>
                    </div>
                    <div>
                        <p class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">In circulation</p>
                        <p class="text-sm text-text-primary">@item.Circulation.ToString("N0") @currency.Symbol</p>
                    </div>
                    <div>
                        <p class="text-xs text-text-tertiary font-medium uppercase tracking-wide mb-1">In debt</p>
                        <p class="text-sm @(item.DebtorCount > 0 ? "text-error" : "text-text-primary")">@item.DebtorCount.ToString("N0")</p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-border-primary">
                    <a href="/Guilds/@Model.ViewModel.GuildId/Currency/@currency.Id"
                       class="px-3 py-1.5 text-xs font-medium text-white bg-accent-blue border border-accent-blue rounded-md hover:bg-accent-blue/80 transition-colors">
                        Wallets &amp; ledger
                    </a>
                    <button type="button" data-currency-action="authorities" data-currency-id="@currency.Id" data-currency-name="@currency.Name"
                            class="px-3 py-1.5 text-xs font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                        Mint authorities
                    </button>
                    @if (currency.IsActive)
                    {
                        <button type="button" data-currency-action="edit" data-currency-id="@currency.Id"
                                class="px-3 py-1.5 text-xs font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                            Edit rules
                        </button>
                        <button type="button" data-currency-action="deactivate" data-currency-id="@currency.Id" data-currency-name="@currency.Name"
                                class="px-3 py-1.5 text-xs font-medium text-error border border-error/40 rounded-md hover:bg-error/10 transition-colors">
                            Deactivate
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- Global currencies -->
<div class="mb-4">
    <h2 class="text-lg font-semibold text-text-primary">Bot-wide Currencies</h2>
    <p class="text-sm text-text-secondary">Owned by the bot operator. You can price this server's features in them, but only the operator can change their rules.</p>
</div>

@if (Model.ViewModel.GlobalCurrencies.Count == 0)
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 text-sm text-text-secondary">
        There are no bot-wide currencies.
    </div>
}
else
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-x-auto">
        <table class="min-w-full text-sm">
            <thead>
                <tr class="border-b border-border-primary">
                    <th scope="col" class="text-left px-4 py-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">Currency</th>
                    <th scope="col" class="text-left px-4 py-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">Transfers</th>
                    <th scope="col" class="text-left px-4 py-3 text-xs font-medium uppercase tracking-wide text-text-tertiary">Debt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var currency in Model.ViewModel.GlobalCurrencies)
                {
                    <tr class="border-b border-border-primary last:border-0">
                        <td class="px-4 py-3 text-text-primary">
                            <span class="mr-2" aria-hidden="true">@currency.Symbol</span>@currency.Name
                        </td>
                        <td class="px-4 py-3 text-text-secondary">@(currency.IsTransferable ? "Allowed" : "Off")</td>
                        <td class="px-4 py-3 text-text-secondary">@(currency.AllowNegative ? $"To {currency.DebtFloor}" : "Off")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Currency editor modal -->
<div id="currency-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="currency-modal-title">
    <div class="bg-bg-secondary border border-border-primary rounded-lg w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border-primary">
            <h3 id="currency-modal-title" class="text-base font-semibold text-text-primary">New Currency</h3>
            <button type="button" data-currency-action="close-modal" class="text-text-tertiary hover:text-text-primary" aria-label="Close">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form id="currency-form" class="px-5 py-4 space-y-4" novalidate>
            <div id="currency-form-error" class="hidden text-sm text-error bg-error/10 border border-error/40 rounded-md px-3 py-2"></div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="sm:col-span-2">
                    <label for="currency-name" class="block text-sm font-medium text-text-secondary mb-1">Name</label>
                    <input type="text" id="currency-name" maxlength="64" required
                           class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                </div>
                <div>
                    <label for="currency-symbol" class="block text-sm font-medium text-text-secondary mb-1">Symbol</label>
                    <input type="text" id="currency-symbol" maxlength="16" required placeholder="🪙"
                           class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                </div>
            </div>

            <label class="flex items-start gap-2 cursor-pointer">
                <input type="checkbox" id="currency-transferable" checked
                       class="mt-1 w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange" />
                <span>
                    <span class="block text-sm text-text-primary">Members can pay each other</span>
                    <span class="block text-xs text-text-tertiary">Turns <code>/wallet pay</code> on for this currency.</span>
                </span>
            </label>

            <label class="flex items-start gap-2 cursor-pointer">
                <input type="checkbox" id="currency-allow-negative"
                       class="mt-1 w-4 h-4 rounded border-border-primary text-accent-orange focus:ring-accent-orange" />
                <span>
                    <span class="block text-sm text-text-primary">Fines can push a balance into debt</span>
                    <span class="block text-xs text-text-tertiary">Only fines can cross zero. Spending never creates debt, and priced features are locked while a balance is below it.</span>
                </span>
            </label>

            <div id="currency-debt-floor-row" class="hidden">
                <label for="currency-debt-floor" class="block text-sm font-medium text-text-secondary mb-1">Debt floor</label>
                <input type="number" id="currency-debt-floor" max="-1" step="1"
                       class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                <p class="text-xs text-text-tertiary mt-1">The most negative balance a fine may reach. Stored negative, e.g. -100.</p>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" data-currency-action="close-modal"
                        class="px-4 py-2 text-sm font-medium text-text-primary bg-bg-tertiary border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                    Cancel
                </button>
                <button type="submit" id="currency-save"
                        class="px-4 py-2 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Mint authorities modal -->
<div id="authorities-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="authorities-modal-title">
    <div class="bg-bg-secondary border border-border-primary rounded-lg w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border-primary">
            <h3 id="authorities-modal-title" class="text-base font-semibold text-text-primary">Mint Authorities</h3>
            <button type="button" data-currency-action="close-authorities" class="text-text-tertiary hover:text-text-primary" aria-label="Close">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="px-5 py-4 space-y-4">
            <p class="text-sm text-text-secondary">
                Minting is the only way units are created, so it is the only action with its own list. Add a member, a role,
                or the system principal that background jobs mint as.
            </p>
            <div id="authorities-error" class="hidden text-sm text-error bg-error/10 border border-error/40 rounded-md px-3 py-2"></div>
            <div id="authorities-list" class="space-y-2 text-sm text-text-secondary">Loading…</div>

            <form id="authority-form" class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-3 border-t border-border-primary" novalidate>
                <select id="authority-type" class="px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue">
                    <option value="@((int)MintPrincipalType.User)">User</option>
                    <option value="@((int)MintPrincipalType.Role)">Role</option>
                    <option value="@((int)MintPrincipalType.System)">System</option>
                </select>
                <input type="text" id="authority-id" inputmode="numeric" placeholder="Discord ID"
                       class="px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue" />
                <button type="submit" class="px-3 py-2 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
                    Grant
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.currencyPage = {
            guildId: '@Model.ViewModel.GuildId',
            scope: 'guild',
            listUrl: '/api/guilds/@Model.ViewModel.GuildId/currencies',
            createUrl: '/api/guilds/@Model.ViewModel.GuildId/currencies'
        };
    </script>
    <script src="~/js/currency/currency-manage.js" asp-append-version="true"></script>
}

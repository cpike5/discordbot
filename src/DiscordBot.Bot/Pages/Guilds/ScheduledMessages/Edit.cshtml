@page "{guildId:long}/{id:guid}"
@model DiscordBot.Bot.Pages.Guilds.ScheduledMessages.EditModel
@{
    ViewData["Title"] = $"Edit Scheduled Message - {Model.Editor.GuildName}";
    Layout = "_GuildLayout";
}

<partial name="_MessageEditor" model="Model.Editor" />

@section Scripts {
    <script src="~/js/discord-markdown.js" asp-append-version="true"></script>
    <script src="~/js/confirm-forms.js" asp-append-version="true"></script>
    <script src="~/js/form-errors.js" asp-append-version="true"></script>
    <script src="~/js/scheduled-message-editor.js" asp-append-version="true"></script>
}

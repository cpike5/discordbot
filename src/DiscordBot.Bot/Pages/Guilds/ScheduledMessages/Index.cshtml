@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.ScheduledMessages.IndexModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Pages
@{
    ViewData["Title"] = $"Scheduled Messages - {Model.ViewModel.GuildName}";
    Layout = "_GuildLayout";

    var guildId = Model.ViewModel.GuildId;

    static BadgeVariant StatusVariant(string status) => status switch
    {
        "Active" => BadgeVariant.Success,
        "Paused" => BadgeVariant.Warning,
        _ => BadgeVariant.Default
    };

    // Icon paths shared by the table and the cards
    const string editIcon = "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z";
    const string pauseIcon = "M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z";
    const string resumeIcon = "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664zM21 12a9 9 0 11-18 0 9 9 0 0118 0z";
    const string deleteIcon = "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
        <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
            Type = EmptyStateType.Error,
            Title = "Scheduled messages unavailable",
            Description = Model.ErrorMessage,
            PrimaryActionText = "Try again",
            PrimaryActionUrl = Url.Page("Index", new { guildId })
        }' />
    </div>
}
else if (Model.ViewModel.TotalCount > 0)
{
    <!-- Desktop table -->
    <div class="hidden md:block bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <caption class="sr-only">Scheduled messages for @Model.ViewModel.GuildName</caption>
                <thead class="bg-bg-tertiary border-b border-border-primary">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Message</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Channel</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Schedule</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Next run</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var message in Model.ViewModel.Messages)
                    {
                        var expired = message.StatusDisplay == "Expired";
                        <tr class="table-row hover:bg-bg-hover transition-colors @(expired ? "opacity-70" : "")">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <partial name="Shared/Components/_Badge" model="new BadgeViewModel { Text = message.StatusDisplay, Variant = StatusVariant(message.StatusDisplay), Style = BadgeStyle.Subtle, Size = BadgeSize.Small, IsPill = true }" />
                            </td>
                            <td class="px-6 py-4">
                                <div class="max-w-xs">
                                    <p class="text-sm text-text-primary truncate" title="@message.MessagePreview">@message.MessagePreview</p>
                                    <p class="text-xs text-text-secondary mt-0.5">Created @DisplayFormat.Time(message.CreatedAt, "date")</p>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-text-primary whitespace-nowrap">@message.ChannelName</td>
                            <td class="px-6 py-4 text-sm text-text-primary whitespace-nowrap">@message.ScheduleDescription</td>
                            <td class="px-6 py-4 text-sm text-text-primary whitespace-nowrap">@DisplayFormat.Time(message.NextExecutionAt, "datetime-short", empty: "Not scheduled")</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-1 row-actions">
                                    <a asp-page="Edit" asp-route-guildId="@guildId" asp-route-id="@message.Id"
                                       class="row-action-btn row-action-btn-accent"
                                       aria-label="Edit @message.MessagePreview" title="Edit">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@editIcon" /></svg>
                                    </a>
                                    @if (!expired)
                                    {
                                        <form method="post" asp-page-handler="Toggle" asp-route-guildId="@guildId" asp-route-messageId="@message.Id"
                                              asp-route-pageNumber="@Model.ViewModel.Page" asp-route-pageSize="@Model.ViewModel.PageSize" data-submit-guard class="inline">
                                            <button type="submit" class="row-action-btn"
                                                    aria-label="@(message.IsEnabled ? "Pause" : "Resume") @message.MessagePreview"
                                                    title="@(message.IsEnabled ? "Pause" : "Resume")">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(message.IsEnabled ? pauseIcon : resumeIcon)" /></svg>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Delete" asp-route-guildId="@guildId" asp-route-messageId="@message.Id"
                                          asp-route-pageNumber="@Model.ViewModel.Page" asp-route-pageSize="@Model.ViewModel.PageSize"
                                          data-submit-guard
                                          data-confirm-title="Delete this scheduled message?"
                                          data-confirm-message="@($"\"{message.MessagePreview}\" will stop being sent and cannot be recovered.")"
                                          data-confirm-text="Delete message"
                                          data-confirm-variant="danger" class="inline">
                                        <button type="submit" class="row-action-btn row-action-btn-danger"
                                                aria-label="Delete @message.MessagePreview" title="Delete">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@deleteIcon" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile cards -->
    <ul class="md:hidden space-y-4" role="list">
        @foreach (var message in Model.ViewModel.Messages)
        {
            var expired = message.StatusDisplay == "Expired";
            <li class="bg-bg-secondary border border-border-primary rounded-lg p-4 @(expired ? "opacity-70" : "")" data-row>
                <div class="flex items-start justify-between gap-3 mb-3">
                    <p class="font-medium text-text-primary break-words min-w-0">@message.MessagePreview</p>
                    <partial name="Shared/Components/_Badge" model="new BadgeViewModel { Text = message.StatusDisplay, Variant = StatusVariant(message.StatusDisplay), Style = BadgeStyle.Subtle, Size = BadgeSize.Small, IsPill = true }" />
                </div>
                <dl class="grid grid-cols-2 gap-3 text-sm mb-4">
                    <div class="min-w-0">
                        <dt class="text-text-secondary">Channel</dt>
                        <dd class="text-text-primary break-words">@message.ChannelName</dd>
                    </div>
                    <div class="min-w-0">
                        <dt class="text-text-secondary">Schedule</dt>
                        <dd class="text-text-primary">@message.ScheduleDescription</dd>
                    </div>
                    <div class="min-w-0 col-span-2">
                        <dt class="text-text-secondary">Next run</dt>
                        <dd class="text-text-primary">@DisplayFormat.Time(message.NextExecutionAt, "datetime-short", empty: "Not scheduled")</dd>
                    </div>
                </dl>
                <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-border-secondary">
                    <a asp-page="Edit" asp-route-guildId="@guildId" asp-route-id="@message.Id" class="btn btn-secondary btn-sm flex-1 justify-center min-h-[44px]">Edit</a>
                    @if (!expired)
                    {
                        <form method="post" asp-page-handler="Toggle" asp-route-guildId="@guildId" asp-route-messageId="@message.Id"
                              asp-route-pageNumber="@Model.ViewModel.Page" asp-route-pageSize="@Model.ViewModel.PageSize" data-submit-guard class="flex-1 flex">
                            <button type="submit" class="btn btn-secondary btn-sm flex-1 justify-center min-h-[44px]">@(message.IsEnabled ? "Pause" : "Resume")</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Delete" asp-route-guildId="@guildId" asp-route-messageId="@message.Id"
                          asp-route-pageNumber="@Model.ViewModel.Page" asp-route-pageSize="@Model.ViewModel.PageSize"
                          data-submit-guard
                          data-confirm-title="Delete this scheduled message?"
                          data-confirm-message="@($"\"{message.MessagePreview}\" will stop being sent and cannot be recovered.")"
                          data-confirm-text="Delete message"
                          data-confirm-variant="danger" class="flex-1 flex">
                        <button type="submit" class="btn btn-error btn-sm flex-1 justify-center min-h-[44px]">Delete</button>
                    </form>
                </div>
            </li>
        }
    </ul>

    @if (Model.ViewModel.TotalPages > 1)
    {
        <div class="mt-6">
            <partial name="Shared/Components/_Pagination" model='new PaginationViewModel {
                CurrentPage = Model.ViewModel.Page,
                TotalPages = Model.ViewModel.TotalPages,
                TotalItems = Model.ViewModel.TotalCount,
                PageSize = Model.ViewModel.PageSize,
                BaseUrl = Url.Page(null, new { guildId, pageSize = Model.ViewModel.PageSize }) ?? string.Empty,
                Style = PaginationStyle.Full,
                ShowItemCount = true,
                PageParameterName = "pageNumber"
            }' />
        </div>
    }
}
else
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
        <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
            Type = EmptyStateType.FirstTime,
            Title = "No scheduled messages yet",
            Description = "Create one to send a message to a channel on a schedule: once, hourly, daily, weekly or monthly.",
            IconSvgPath = "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
            PrimaryActionText = "Create the first message",
            PrimaryActionUrl = Url.Page("Create", new { guildId })
        }' />
    </div>
}

@section Scripts {
    <script src="~/js/confirm-forms.js" asp-append-version="true"></script>
}

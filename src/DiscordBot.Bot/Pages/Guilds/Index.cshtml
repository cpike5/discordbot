@page
@model DiscordBot.Bot.Pages.Guilds.IndexModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Pages
@{
    ViewData["Title"] = "Servers";

    var hasFilters = !string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue;
    var emptyTitle = Model.IsFiltered && !hasFilters ? "No accessible servers" :
                     hasFilters ? "No servers found" : "No servers yet";
    var emptyDesc = Model.IsFiltered && !hasFilters ? "You don't have access to any servers. Ask an admin to grant access, or join a Discord server this bot is in." :
                    hasFilters ? "No server matches your search or filter. Clear them to see every server." : "The bot hasn't joined any servers yet.";

    var emptyState = new EmptyStateViewModel
    {
        Type = hasFilters ? EmptyStateType.NoResults : EmptyStateType.FirstTime,
        Title = emptyTitle,
        Description = emptyDesc,
        PrimaryActionText = hasFilters ? "Clear filters" : null,
        PrimaryActionUrl = hasFilters ? Url.Page("Index") : null
    };

    const string syncIcon = "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- The sync buttons post through ApiClient, which reads the token from the page -->
    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-text">
            <p class="page-eyebrow">Servers</p>
            <div class="flex items-center gap-3">
                <h1 class="page-title">Servers</h1>
                <partial name="Shared/Components/_Badge" model="new BadgeViewModel { Text = DisplayFormat.Number(Model.ViewModel.TotalCount), Variant = BadgeVariant.Blue, Size = BadgeSize.Medium }" />
            </div>
            <p class="page-subtitle">Every Discord server the bot is connected to, with membership and status.</p>
        </div>
        <div class="page-actions">
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <form method="post" asp-page-handler="SyncAll"
                      data-submit-guard
                      data-confirm-title="Sync every server?"
                      data-confirm-message="The bot re-reads the name, icon and member count of every server it is in from Discord. This can take a moment."
                      data-confirm-text="Sync all"
                      data-confirm-variant="info">
                    <button type="submit" class="btn btn-accent inline-flex items-center gap-2" data-loading-text="Syncing all...">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@syncIcon" /></svg>
                        Sync all
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Filtered View Info Banner -->
    @if (Model.IsFiltered)
    {
        <div class="mb-6">
            <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                Variant = AlertVariant.Info,
                Message = $"You are viewing {DisplayFormat.Number(Model.ViewModel.TotalCount)} of {DisplayFormat.Plural(Model.TotalGuilds, "server")}. Only servers where you are a Discord member are shown."
            }' />
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="surface p-4 sm:p-5 mb-6">
        <form method="get" class="flex flex-col md:flex-row md:items-end gap-4">
            <div class="flex-1">
                <label for="SearchTerm" class="form-label block mb-1.5">Search</label>
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-tertiary pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="search" id="SearchTerm" name="SearchTerm" value="@Model.SearchTerm"
                           placeholder="Search servers by name or ID..." autocomplete="off" class="form-input pl-10" />
                </div>
            </div>

            <div class="w-full md:w-40">
                <label for="StatusFilter" class="form-label block mb-1.5">Status</label>
                <select id="StatusFilter" name="StatusFilter" class="form-select">
                    <option value="">All statuses</option>
                    <option value="true" selected="@(Model.StatusFilter == true)">Active</option>
                    <option value="false" selected="@(Model.StatusFilter == false)">Inactive</option>
                </select>
            </div>

            <div class="w-full md:w-40">
                <label for="SortBy" class="form-label block mb-1.5">Sort by</label>
                <select id="SortBy" name="SortBy" class="form-select">
                    @foreach (var (value, display) in GuildListViewModel.SortOptions)
                    {
                        <option value="@value" selected="@(Model.SortBy == value)">@display</option>
                    }
                </select>
            </div>

            <div class="w-full md:w-40">
                <label for="SortDescending" class="form-label block mb-1.5">Order</label>
                <select id="SortDescending" name="SortDescending" class="form-select">
                    <option value="false" selected="@(!Model.SortDescending)">Ascending</option>
                    <option value="true" selected="@(Model.SortDescending)">Descending</option>
                </select>
            </div>

            <div class="flex gap-2">
                <a asp-page="Index" class="btn btn-secondary">Clear</a>
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
            <partial name="Shared/Components/_EmptyState" model='new EmptyStateViewModel {
                Type = EmptyStateType.Error,
                Title = "Servers unavailable",
                Description = Model.ErrorMessage,
                PrimaryActionText = "Try again",
                PrimaryActionUrl = Url.Page("Index", new { SearchTerm = Model.SearchTerm, StatusFilter = Model.StatusFilter, SortBy = Model.SortBy, SortDescending = Model.SortDescending, pageNumber = Model.CurrentPage })
            }' />
        </div>
    }
    else if (!Model.ViewModel.Guilds.Any())
    {
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
            <partial name="Shared/Components/_EmptyState" model="emptyState" />
        </div>
    }
    else
    {
        <!-- Desktop Table -->
        <div class="card hidden md:block">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <caption class="sr-only">Servers the bot is connected to</caption>
                    <thead class="table-header">
                        <tr>
                            <th scope="col" class="table-cell-header px-6">Server</th>
                            <th scope="col" class="table-cell-header px-6">Members</th>
                            <th scope="col" class="table-cell-header px-6">Status</th>
                            <th scope="col" class="table-cell-header px-6 hidden lg:table-cell">Joined</th>
                            <th scope="col" class="table-cell-header px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var guild in Model.ViewModel.Guilds)
                        {
                            var detailsUrl = Url.Page("Details", new { guildId = guild.Id });
                            <tr class="hover:bg-bg-hover transition-colors cursor-pointer group" data-guild-row="@guild.Id" data-row-href="@detailsUrl">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(guild.IconUrl))
                                        {
                                            <img src="@guild.IconUrl" alt="" class="w-10 h-10 rounded-full flex-shrink-0" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-accent-blue to-accent-orange flex items-center justify-center text-white font-bold text-sm flex-shrink-0" aria-hidden="true">
                                                @(guild.Name.Length >= 2 ? guild.Name[..2].ToUpper() : guild.Name.ToUpper())
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <a href="@detailsUrl" class="font-medium text-text-primary group-hover:text-accent-blue transition-colors truncate block" data-guild-name>@guild.Name</a>
                                            <p class="text-xs text-text-secondary font-mono">ID: @guild.Id</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-text-secondary" data-guild-members>@DisplayFormat.Number(guild.MemberCount)</td>
                                <td class="px-6 py-4">
                                    <partial name="Shared/Components/_StatusIndicator" model='new StatusIndicatorViewModel {
                                        Status = guild.IsActive ? StatusType.Online : StatusType.Offline,
                                        Text = guild.IsActive ? "Active" : "Inactive",
                                        DisplayStyle = StatusDisplayStyle.DotWithText,
                                        Size = StatusSize.Medium
                                    }' />
                                </td>
                                <td class="px-6 py-4 text-text-secondary text-sm hidden lg:table-cell">@DisplayFormat.Time(guild.JoinedAt, "date")</td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <button type="button" class="row-action-btn row-action-btn-accent" data-sync-guild="@guild.Id"
                                                aria-label="Sync @guild.Name from Discord" title="Sync from Discord">
                                            <svg class="w-5 h-5 sync-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@syncIcon" /></svg>
                                        </button>
                                        <a asp-page="Edit" asp-route-id="@guild.Id" class="row-action-btn row-action-btn-accent"
                                           aria-label="Configure @guild.Name" title="Configure">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile Card Layout -->
        <ul class="md:hidden space-y-4" role="list">
            @foreach (var guild in Model.ViewModel.Guilds)
            {
                var mobileDetailsUrl = Url.Page("Details", new { guildId = guild.Id });
                <li class="bg-bg-secondary border border-border-primary rounded-lg p-4" data-guild-row="@guild.Id">
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <div class="flex items-center gap-3 min-w-0">
                            @if (!string.IsNullOrEmpty(guild.IconUrl))
                            {
                                <img src="@guild.IconUrl" alt="" class="w-10 h-10 rounded-full flex-shrink-0" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-accent-blue to-accent-orange flex items-center justify-center text-white font-bold text-sm flex-shrink-0" aria-hidden="true">
                                    @(guild.Name.Length >= 2 ? guild.Name[..2].ToUpper() : guild.Name.ToUpper())
                                </div>
                            }
                            <div class="min-w-0">
                                <a href="@mobileDetailsUrl" class="font-medium text-text-primary break-words block" data-guild-name>@guild.Name</a>
                                <p class="text-xs text-text-secondary font-mono break-all">@guild.Id</p>
                            </div>
                        </div>
                        <partial name="Shared/Components/_StatusIndicator" model='new StatusIndicatorViewModel {
                            Status = guild.IsActive ? StatusType.Online : StatusType.Offline,
                            Text = guild.IsActive ? "Active" : "Inactive",
                            DisplayStyle = StatusDisplayStyle.DotWithText,
                            Size = StatusSize.Small
                        }' />
                    </div>

                    <dl class="grid grid-cols-2 gap-3 mb-4 text-sm">
                        <div>
                            <dt class="text-text-secondary">Members</dt>
                            <dd class="text-text-primary" data-guild-members>@DisplayFormat.Number(guild.MemberCount)</dd>
                        </div>
                        <div>
                            <dt class="text-text-secondary">Joined</dt>
                            <dd class="text-text-primary">@DisplayFormat.Time(guild.JoinedAt, "date")</dd>
                        </div>
                    </dl>

                    <div class="flex items-center gap-2 pt-3 border-t border-border-secondary">
                        <button type="button" class="btn btn-secondary btn-sm flex-1 justify-center min-h-[44px]" data-sync-guild="@guild.Id"
                                aria-label="Sync @guild.Name from Discord">Sync</button>
                        <a href="@mobileDetailsUrl" class="btn btn-secondary btn-sm flex-1 justify-center min-h-[44px]">View</a>
                        <a asp-page="Edit" asp-route-id="@guild.Id" class="btn btn-secondary btn-sm flex-1 justify-center min-h-[44px]">Configure</a>
                    </div>
                </li>
            }
        </ul>

        @if (Model.ViewModel.TotalPages > 1)
        {
            <div class="mt-6">
                <partial name="Shared/Components/_Pagination" model='new PaginationViewModel {
                    CurrentPage = Model.ViewModel.CurrentPage,
                    TotalPages = Model.ViewModel.TotalPages,
                    TotalItems = Model.ViewModel.TotalCount,
                    PageSize = Model.ViewModel.PageSize,
                    BaseUrl = Url.Page(null, new { SearchTerm = Model.SearchTerm, StatusFilter = Model.StatusFilter, SortBy = Model.SortBy, SortDescending = Model.SortDescending, PageSize = Model.PageSize }) ?? string.Empty,
                    Style = PaginationStyle.Full,
                    ShowPageSizeSelector = true,
                    ShowItemCount = true,
                    PageParameterName = "pageNumber"
                }' />
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/confirm-forms.js" asp-append-version="true"></script>
    <script src="~/js/guild-sync.js" asp-append-version="true"></script>
}

@page "{guildId:long}/{id:guid}"
@model DiscordBot.Bot.Pages.Guilds.FlaggedEvents.DetailsModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = $"Flagged Event Details - {Model.GuildName}";
    Layout = "_GuildLayout";

    var evt = Model.Event;
    var canAcknowledge = FlaggedEventReviewRules.CanApply(FlaggedEventReviewAction.Acknowledge, evt.Status);
    var canDismiss = FlaggedEventReviewRules.CanApply(FlaggedEventReviewAction.Dismiss, evt.Status);
    var canRecord = FlaggedEventReviewRules.CanRecordOutcome(evt.Status);

    string HandlerUrl(string handler) => Url.Page("/Guilds/FlaggedEvents/Details", handler, new { guildId = Model.GuildId, id = evt.Id }) ?? string.Empty;

    // A reviewer id of 0 means the reviewer had no linked Discord account
    var reviewer = evt.ReviewedByUserId is null or 0
        ? "Not recorded"
        : evt.ReviewedByUsername ?? "Unknown";

    string[] presetOutcomes = { "Warned user", "Muted user for 24 hours", "Kicked user from server", "Banned user from server" };
}

@section Scripts {
    <script src="~/js/flagged-events.js" asp-append-version="true"></script>
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main content -->
    <div class="lg:col-span-2 space-y-6 min-w-0">
        <section class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6" aria-labelledby="eventSummaryHeading">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                <div class="flex flex-wrap items-center gap-3">
                    <h2 id="eventSummaryHeading" class="sr-only">Event summary</h2>
                    <partial name="Shared/Components/_SeverityBadge" model="evt.Severity" />
                    <partial name="Shared/Components/_StatusBadge" model="evt.Status" />
                </div>
                <div class="text-sm text-text-secondary">@DisplayFormat.Time(evt.CreatedAt, "datetime")</div>
            </div>

            <div class="space-y-4">
                <div>
                    <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Description</h3>
                    <p class="text-text-primary break-words">@evt.Description</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Rule type</h3>
                        <div class="flex items-center gap-2">
                            <partial name="Shared/Components/_RuleTypeIcon" model="evt.RuleType" />
                            <span class="text-text-primary">@evt.RuleType</span>
                        </div>
                    </div>

                    @if (evt.ChannelId > 0)
                    {
                        <div>
                            <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Channel</h3>
                            <p class="text-text-primary break-all">#@evt.ChannelName</p>
                        </div>
                    }
                </div>

                @if (evt.ReviewedAt.HasValue)
                {
                    <div class="border-t border-border-primary pt-4">
                        <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-2">Review</h3>
                        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <dt class="text-sm text-text-secondary">Reviewed by</dt>
                                <dd class="text-text-primary break-words">@reviewer</dd>
                            </div>
                            <div>
                                <dt class="text-sm text-text-secondary">Reviewed</dt>
                                <dd class="text-text-primary">@DisplayFormat.Time(evt.ReviewedAt, "datetime")</dd>
                            </div>
                        </dl>
                        @if (!string.IsNullOrEmpty(evt.ActionTaken))
                        {
                            <div class="mt-4">
                                <span class="text-sm text-text-secondary">Outcome recorded</span>
                                <p class="text-text-primary break-words whitespace-pre-wrap" dir="auto">@evt.ActionTaken</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6" aria-labelledby="userInfoHeading">
            <h2 id="userInfoHeading" class="text-lg font-semibold text-text-primary mb-4">User</h2>
            <div class="flex flex-wrap items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-accent-blue flex items-center justify-center text-white font-bold text-lg flex-shrink-0" aria-hidden="true">
                    @TextDisplay.Initials(evt.Username, 1)
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-text-primary font-medium break-all">@evt.Username</div>
                    <div class="text-sm text-text-secondary break-all">User ID <span class="font-mono">@evt.UserId</span></div>
                </div>
                @if (Model.UserIsMember)
                {
                    <a asp-page="/Guilds/Members/Moderation" asp-route-guildId="@Model.GuildId" asp-route-userId="@evt.UserId" class="btn btn-secondary btn-sm">
                        View moderation profile
                    </a>
                }
                else
                {
                    <span class="text-sm text-text-secondary">No longer a member of this server</span>
                }
            </div>
        </section>

        <section class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6" aria-labelledby="evidenceHeading">
            <details open>
                <summary class="flex items-center justify-between cursor-pointer list-none">
                    <h2 id="evidenceHeading" class="text-lg font-semibold text-text-primary">Evidence</h2>
                    <span class="text-sm text-text-secondary">Show or hide</span>
                </summary>
                <pre class="mt-4 bg-bg-primary border border-border-primary rounded-md p-4 text-sm text-text-primary whitespace-pre-wrap break-words">@evt.Evidence</pre>
            </details>
        </section>

        @if (Model.UserHistory.Any())
        {
            <section class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6" aria-labelledby="historyHeading">
                <h2 id="historyHeading" class="text-lg font-semibold text-text-primary mb-4">
                    User history <span class="text-text-secondary font-normal">(@DisplayFormat.Plural(Model.UserHistory.Count(), "other event"))</span>
                </h2>
                <ul class="space-y-3">
                    @foreach (var past in Model.UserHistory)
                    {
                        <li>
                            <a asp-page="/Guilds/FlaggedEvents/Details" asp-route-guildId="@Model.GuildId" asp-route-id="@past.Id"
                               class="flex flex-wrap items-center justify-between gap-3 p-3 bg-bg-primary border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                                <span class="flex flex-wrap items-center gap-3">
                                    <partial name="Shared/Components/_SeverityBadge" model="past.Severity" />
                                    <span class="text-sm text-text-primary">@past.RuleType</span>
                                    <span class="text-xs text-text-secondary">@DisplayFormat.Time(past.CreatedAt, "date")</span>
                                </span>
                                <partial name="Shared/Components/_StatusBadge" model="past.Status" />
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <!-- Review actions -->
    <div class="lg:col-span-1">
        <section class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6 lg:sticky lg:top-6" aria-labelledby="actionsHeading">
            <h2 id="actionsHeading" class="text-lg font-semibold text-text-primary mb-4">Actions</h2>

            @if (canAcknowledge || canDismiss || canRecord)
            {
                <form id="eventActionForm" method="post" data-submit-guard data-event-action-form>
                    <div class="space-y-3">
                        @if (canAcknowledge)
                        {
                            <button type="submit" formaction="@HandlerUrl("Acknowledge")" class="btn btn-accent w-full"
                                    data-loading-text="Acknowledging…"
                                    data-confirm-title="Acknowledge event"
                                    data-confirm-message="Mark this event as seen? It stays open for review."
                                    data-confirm-text="Acknowledge">
                                Acknowledge
                            </button>
                        }
                        @if (canDismiss)
                        {
                            <button type="submit" formaction="@HandlerUrl("Dismiss")" class="btn btn-secondary w-full"
                                    data-loading-text="Dismissing…"
                                    data-confirm-title="Dismiss event"
                                    data-confirm-message="Dismiss this event? It is closed as not needing action."
                                    data-confirm-text="Dismiss">
                                Dismiss
                            </button>
                        }
                    </div>

                    @if (canRecord)
                    {
                        <div class="mt-6 pt-6 border-t border-border-primary">
                            <h3 class="text-sm font-semibold text-text-primary mb-1">Record outcome</h3>
                            <p class="text-xs text-text-secondary mb-3">Keeps a note of what you did in Discord. Nothing is sent to Discord.</p>
                            <div class="space-y-2">
                                @foreach (var preset in presetOutcomes)
                                {
                                    <button type="submit" name="outcome" value="@preset" formaction="@HandlerUrl("RecordOutcome")"
                                            class="btn btn-secondary w-full justify-start"
                                            data-loading-text="Recording…"
                                            data-confirm-title="Record outcome"
                                            data-confirm-message="Record &quot;{value}&quot; as the outcome of this event? This only updates the record. It does not warn, mute, kick or ban anyone in Discord."
                                            data-confirm-text="Record outcome">
                                        @preset
                                    </button>
                                }
                                <button type="button" class="btn btn-secondary w-full justify-start" data-open-dialog="customOutcomeDialog">
                                    Other outcome…
                                </button>
                            </div>
                        </div>
                    }
                </form>
            }
            else
            {
                <p class="text-sm text-text-secondary">
                    This event has been @evt.Status.DisplayNameLower() and is closed.
                </p>
            }

            <div class="mt-6 pt-6 border-t border-border-primary">
                <a asp-page="/Guilds/FlaggedEvents/Index" asp-route-guildId="@Model.GuildId" class="btn btn-ghost w-full">
                    Back to flagged events
                </a>
            </div>
        </section>
    </div>
</div>

@if (canRecord)
{
    <!-- Custom outcome dialog -->
    <div id="customOutcomeDialog"
         class="hidden fixed inset-0 z-[var(--z-modal)]"
         role="dialog"
         aria-modal="true"
         aria-labelledby="customOutcomeTitle">
        <div class="fixed inset-0 bg-black/70 backdrop-blur-sm qa-modal-backdrop" data-modal-dismiss aria-hidden="true"></div>
        <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
            <form method="post" action="@HandlerUrl("RecordOutcome")" asp-antiforgery="true" data-submit-guard
                  class="bg-bg-tertiary border border-border-primary rounded-lg shadow-xl max-w-md w-full qa-modal-panel pointer-events-auto">
                <div class="p-6">
                    <h2 id="customOutcomeTitle" class="text-lg font-semibold text-text-primary mb-1">Record another outcome</h2>
                    <p class="text-sm text-text-secondary mb-4">Describe what you did in Discord. This only updates the record.</p>
                    <label for="customOutcomeText" class="form-label block mb-1">Outcome</label>
                    <textarea id="customOutcomeText" name="outcome" rows="4" required maxlength="@DetailsModel.MaxOutcomeLength" dir="auto"
                              class="form-textarea" placeholder="For example: Timed out for 10 minutes and asked to stop." data-modal-initial-focus></textarea>
                </div>
                <div class="flex justify-end gap-3 px-6 py-4 bg-bg-secondary border-t border-border-primary rounded-b-lg">
                    <button type="button" class="btn btn-secondary" data-modal-dismiss>Cancel</button>
                    <button type="submit" class="btn btn-primary" data-loading-text="Recording…">Record outcome</button>
                </div>
            </form>
        </div>
    </div>
}

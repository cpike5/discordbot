@page "/Guilds/{guildId:long}/Members"
@model DiscordBot.Bot.Pages.Guilds.Members.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Pages
@{
    ViewData["Title"] = $"Members - {Model.Guild?.Name}";
    Layout = "_GuildLayout";
    var members = Model.ViewModel.Members;
    var clearFiltersUrl = Url.Page("Index", new { guildId = Model.GuildId });
    var selectedRoleCount = Model.RoleFilter?.Count ?? 0;
    var canViewProfiles = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var filteredEmpty = new EmptyStateViewModel
    {
        Type = EmptyStateType.NoResults,
        Title = "No members match your filters",
        Description = "Try a different search, or clear the filters to see everyone.",
        PrimaryActionText = "Clear filters",
        PrimaryActionUrl = clearFiltersUrl,
        PrimaryActionIconPath = ""
    };
    var firstTimeEmpty = new EmptyStateViewModel
    {
        Type = EmptyStateType.NoData,
        Title = "No members yet",
        Description = "Members appear here once the bot has synced this server."
    };
}

<!-- Filter Panel -->
<filter-panel title="Filters"
              is-collapsible="true"
              active-filter-count="@Model.ActiveFilterCount"
              default-expanded="@Model.HasActiveFilters"
              use-hidden-toggle="true">
    <form method="get" id="filterForm">
        <input type="hidden" name="GuildId" value="@Model.GuildId" />

        <!-- Row 1: Search and Role Filter -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="SearchTerm" class="form-label block mb-1">Search</label>
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-text-tertiary pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="search"
                           id="SearchTerm"
                           name="SearchTerm"
                           value="@Model.SearchTerm"
                           autocomplete="off"
                           placeholder="Username, display name, or user ID..."
                           class="form-input pl-10" />
                </div>
            </div>

            <!-- Role filter: a disclosure holding a group of checkboxes -->
            <div>
                <span id="roleFilterLabel" class="form-label block mb-1">Roles</span>
                <div class="relative role-multiselect-wrapper">
                    <button type="button"
                            id="roleMultiSelectToggle"
                            class="form-select text-left flex items-center"
                            aria-labelledby="roleFilterLabel roleSelectedText"
                            aria-expanded="false"
                            aria-controls="roleMultiSelectDropdown">
                        <span class="truncate" id="roleSelectedText">@(selectedRoleCount == 0 ? "All roles" : RolesSelectedText(selectedRoleCount))</span>
                    </button>
                    <div id="roleMultiSelectDropdown"
                         class="hidden absolute z-10 mt-1 w-full bg-bg-tertiary border border-border-primary rounded-lg shadow-lg max-h-60 overflow-auto"
                         role="group"
                         aria-labelledby="roleFilterLabel">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            var isSelected = Model.RoleFilter?.Contains(role.Id) ?? false;
                            var colorHex = role.Color > 0 ? $"#{role.Color:X6}" : "#99aab5";
                            <label class="flex items-center gap-2 px-3 py-2 hover:bg-bg-hover cursor-pointer transition-colors">
                                <input type="checkbox"
                                       name="RoleFilter"
                                       value="@role.Id"
                                       checked="@isSelected"
                                       class="w-4 h-4 rounded border-border-primary role-checkbox" />
                                <span class="inline-flex items-center gap-2 min-w-0">
                                    <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: @colorHex" aria-hidden="true"></span>
                                    <span class="text-sm text-text-primary truncate">@role.Name</span>
                                </span>
                            </label>
                        }
                        @if (!Model.AvailableRoles.Any())
                        {
                            <div class="px-3 py-4 text-center text-sm text-text-secondary">
                                No roles available
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Join Date Range -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="JoinedAfter" class="form-label block mb-1">Joined after</label>
                <input type="date"
                       id="JoinedAfter"
                       name="JoinedAfter"
                       value="@Model.JoinedAfter?.ToString("yyyy-MM-dd")"
                       class="form-input" />
            </div>
            <div>
                <label for="JoinedBefore" class="form-label block mb-1">Joined before</label>
                <input type="date"
                       id="JoinedBefore"
                       name="JoinedBefore"
                       value="@Model.JoinedBefore?.ToString("yyyy-MM-dd")"
                       class="form-input" />
            </div>
        </div>

        <!-- Row 3: Activity Filter and Sort -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <div>
                <label for="ActivityFilter" class="form-label block mb-1">Activity</label>
                <select id="ActivityFilter" name="ActivityFilter" class="form-select">
                    @foreach (var option in IndexModel.ActivityOptions)
                    {
                        <option value="@option.Key" selected="@(Model.ActivityFilter == option.Key)">@option.Value</option>
                    }
                </select>
            </div>

            <div>
                <label for="SortBy" class="form-label block mb-1">Sort by</label>
                <select id="SortBy" name="SortBy" class="form-select">
                    @foreach (var option in IndexModel.SortOptions)
                    {
                        <option value="@option.Key" selected="@(Model.SortBy == option.Key)">@option.Value</option>
                    }
                </select>
            </div>

            <div>
                <label for="SortDescending" class="form-label block mb-1">Order</label>
                <select id="SortDescending" name="SortDescending" class="form-select">
                    <option value="false" selected="@(!Model.SortDescending)">Ascending</option>
                    <option value="true" selected="@(Model.SortDescending)">Descending</option>
                </select>
            </div>
        </div>

        <!-- Filter Actions -->
        <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-border-secondary">
            <button type="submit" class="btn btn-primary">
                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
                Apply filters
            </button>
            <a href="@clearFiltersUrl" class="btn btn-secondary">Clear filters</a>
        </div>
    </form>
</filter-panel>

<!-- Selection announcements for screen readers (the count in the toolbar is visual) -->
<p class="sr-only" role="status" data-selection-status></p>

<!-- Bulk Actions Toolbar (hidden until something is selected) -->
<div data-bulk-toolbar hidden class="hidden bg-accent-blue/10 border border-accent-blue/30 rounded-lg px-4 sm:px-5 py-3 mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-accent-blue flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-sm font-medium text-text-primary"><span data-selected-count>0 members</span> selected</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-secondary btn-sm" data-bulk-clear>Clear selection</button>
        <button type="button" class="btn btn-accent btn-sm" data-export-selected data-export-url="@Url.Page(null, "Export", new { guildId = Model.GuildId })">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Export selected
        </button>
    </div>
</div>

@if (!members.Any())
{
    <!-- Empty state: first-time and filtered-empty read differently -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
        @if (Model.HasActiveFilters)
        {
            <partial name="Shared/Components/_EmptyState" model="filteredEmpty" />
        }
        else
        {
            <partial name="Shared/Components/_EmptyState" model="firstTimeEmpty" />
        }
    </div>
}
else
{
    <!-- Desktop table (md and up) -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg hidden md:block">
        <div class="overflow-x-auto">
            <table class="w-full" aria-label="Server members">
                <thead class="bg-bg-tertiary">
                    <tr>
                        <th scope="col" class="px-4 py-4 text-left w-12">
                            <input type="checkbox" data-select-all class="w-4 h-4 rounded border-border-primary cursor-pointer" aria-label="Select all members on this page" />
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Member</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Roles</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider hidden lg:table-cell">Joined</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider hidden xl:table-cell">Last active</th>
                        <th scope="col" class="px-6 py-4 text-right text-xs font-semibold text-text-primary uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var member in members)
                    {
                        <tr class="hover:bg-bg-hover/50 transition-colors">
                            <td class="px-4 py-4">
                                <input type="checkbox" data-select-item="@member.UserId" class="w-4 h-4 rounded border-border-primary cursor-pointer" aria-label="Select @member.DisplayName" />
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(member.AvatarUrl))
                                    {
                                        <img src="@member.AvatarUrl" alt="" class="w-10 h-10 rounded-full flex-shrink-0" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-accent-blue to-accent-orange flex items-center justify-center text-white font-bold text-sm flex-shrink-0" aria-hidden="true">
                                            @TextDisplay.Initials(member.DisplayName)
                                        </div>
                                    }
                                    <div class="min-w-0">
                                        <p class="font-medium text-text-primary truncate preview-trigger" data-preview-type="user" data-user-id="@member.UserId" data-context-guild-id="@Model.GuildId">@member.DisplayName</p>
                                        <p class="text-xs text-text-secondary font-mono truncate">@@@member.Username</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-wrap gap-1">
                                    @{
                                        var visibleRoles = member.Roles.Take(3).ToList();
                                        var remainingCount = member.Roles.Count - 3;
                                    }
                                    @foreach (var role in visibleRoles)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium text-white" style="background-color: @role.ColorHex">
                                            @role.Name
                                        </span>
                                    }
                                    @if (remainingCount > 0)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-bg-tertiary text-text-secondary" title="@string.Join(", ", member.Roles.Skip(3).Select(r => r.Name))">
                                            +@remainingCount
                                        </span>
                                    }
                                    @if (!member.Roles.Any())
                                    {
                                        <span class="text-xs text-text-secondary">No roles</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-text-secondary text-sm hidden lg:table-cell">
                                <span data-utc="@member.JoinedAtUtcIso" data-format="date"></span>
                            </td>
                            <td class="px-6 py-4 text-text-secondary text-sm hidden xl:table-cell">
                                @if (member.LastActiveAt.HasValue)
                                {
                                    <span data-utc="@member.LastActiveAtUtcIso" data-format="relative"></span>
                                }
                                else
                                {
                                    <span class="text-text-secondary">Never</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button type="button"
                                        class="btn btn-ghost btn-sm text-accent-blue"
                                        data-member-view="@member.UserId"
                                        aria-label="View details for @member.DisplayName">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Card layout (below md) -->
    <div class="md:hidden space-y-4">
        <label class="flex items-center gap-3 px-1 text-sm text-text-secondary">
            <input type="checkbox" data-select-all class="w-5 h-5 rounded border-border-primary cursor-pointer" />
            Select all on this page
        </label>
        @foreach (var member in members)
        {
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-start gap-3 mb-3">
                    <input type="checkbox"
                           data-select-item="@member.UserId"
                           class="w-5 h-5 rounded border-border-primary cursor-pointer mt-2 flex-shrink-0"
                           aria-label="Select @member.DisplayName" />
                    @if (!string.IsNullOrEmpty(member.AvatarUrl))
                    {
                        <img src="@member.AvatarUrl" alt="" class="w-10 h-10 rounded-full flex-shrink-0" loading="lazy" />
                    }
                    else
                    {
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-accent-blue to-accent-orange flex items-center justify-center text-white font-bold text-sm flex-shrink-0" aria-hidden="true">
                            @TextDisplay.Initials(member.DisplayName)
                        </div>
                    }
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-text-primary break-words preview-trigger" data-preview-type="user" data-user-id="@member.UserId" data-context-guild-id="@Model.GuildId">@member.DisplayName</p>
                        <p class="text-xs text-text-secondary font-mono break-all">@@@member.Username</p>
                    </div>
                </div>

                @if (member.Roles.Any())
                {
                    <div class="mb-3">
                        <p class="text-xs text-text-secondary mb-1">Roles</p>
                        <div class="flex flex-wrap gap-1">
                            @foreach (var role in member.Roles.Take(5))
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium text-white break-all" style="background-color: @role.ColorHex">
                                    @role.Name
                                </span>
                            }
                            @if (member.Roles.Count > 5)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-bg-tertiary text-text-secondary">
                                    +@(member.Roles.Count - 5)
                                </span>
                            }
                        </div>
                    </div>
                }

                <dl class="grid grid-cols-2 gap-3 mb-4 text-sm">
                    <div>
                        <dt class="text-text-secondary">Joined</dt>
                        <dd class="text-text-primary"><span data-utc="@member.JoinedAtUtcIso" data-format="date"></span></dd>
                    </div>
                    <div>
                        <dt class="text-text-secondary">Last active</dt>
                        <dd class="text-text-primary">
                            @if (member.LastActiveAt.HasValue)
                            {
                                <span data-utc="@member.LastActiveAtUtcIso" data-format="relative"></span>
                            }
                            else
                            {
                                <span>Never</span>
                            }
                        </dd>
                    </div>
                </dl>

                <div class="pt-3 border-t border-border-secondary">
                    <button type="button"
                            class="btn btn-secondary w-full"
                            data-member-view="@member.UserId"
                            aria-label="View details for @member.DisplayName">
                        View details
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Pagination (also carries the "Showing X-Y of Z" count) -->
    <div class="mt-6">
        @{
            var baseUrl = Url.Page(null, new {
                guildId = Model.GuildId,
                SearchTerm = Model.SearchTerm,
                RoleFilter = Model.RoleFilter,
                JoinedAfter = Model.JoinedAfter?.ToString("yyyy-MM-dd"),
                JoinedBefore = Model.JoinedBefore?.ToString("yyyy-MM-dd"),
                ActivityFilter = Model.ActivityFilter,
                SortBy = Model.SortBy,
                SortDescending = Model.SortDescending
            }) ?? string.Empty;
            var paginationModel = new PaginationViewModel {
                CurrentPage = Model.ViewModel.CurrentPage,
                TotalPages = Model.ViewModel.TotalPages,
                TotalItems = Model.ViewModel.TotalCount,
                PageSize = Model.ViewModel.PageSize,
                BaseUrl = baseUrl,
                Style = PaginationStyle.Full,
                ShowPageSizeSelector = true,
                ShowItemCount = true,
                PageParameterName = "pageNumber",
                AriaLabel = "Members pagination"
            };
        }
        <partial name="Shared/Components/_Pagination" model="paginationModel" />
    </div>
}

<!-- Member Detail Modal -->
<partial name="Guilds/Members/_MemberDetailModal" model="canViewProfiles" />

@section Scripts {
    <script src="~/js/bulk-selection.js" asp-append-version="true"></script>
    <script src="~/js/member-directory.js" asp-append-version="true"></script>
    <script>
        // Guild ID as a string to preserve precision
        window.memberDirectoryGuildId = '@Model.GuildId';
    </script>
}

@functions {
    private static string RolesSelectedText(int roleCount) => roleCount == 1 ? "1 role selected" : $"{roleCount} roles selected";
}

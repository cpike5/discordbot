@model bool
@* Member Detail Modal - Partial View. The model says whether the viewer may open moderation profiles (admins only). *@
@* Opened by member-directory.js through quickActions.openDialog, and filled from the members API. *@

<div id="memberDetailModal"
     class="hidden fixed inset-0 z-[var(--z-modal)]"
     role="dialog"
     aria-modal="true"
     aria-labelledby="memberDetailTitle">
    <div class="fixed inset-0 bg-black/75 qa-modal-backdrop" data-modal-dismiss aria-hidden="true"></div>

    <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="relative bg-bg-tertiary border border-border-primary rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] flex flex-col qa-modal-panel pointer-events-auto">
            <div class="flex items-center justify-between px-6 py-4 border-b border-border-primary flex-shrink-0">
                <h2 id="memberDetailTitle" class="text-xl font-semibold text-text-primary">Member details</h2>
                <button type="button"
                        class="btn btn-ghost btn-icon"
                        data-modal-dismiss
                        aria-label="Close">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div id="memberDetailBody" class="overflow-y-auto px-4 sm:px-6 py-6 flex-1 min-h-0">
                <!-- Loading state -->
                <div id="memberDetailLoading" class="flex items-center justify-center py-12" role="status">
                    <svg class="w-8 h-8 animate-spin text-accent-blue" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="ml-3 text-sm text-text-secondary">Loading member details...</span>
                </div>

                <!-- Error state: the message is filled in from the request that failed -->
                <div id="memberDetailError" class="hidden px-2 py-12 text-center" role="status">
                    <svg class="w-12 h-12 mx-auto text-error mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <h3 class="text-lg font-medium text-text-primary mb-2">Could not load this member</h3>
                    <p id="memberDetailErrorText" class="text-sm text-text-secondary mb-4">This member may have left the server.</p>
                    <button type="button" class="btn btn-primary" data-member-retry>Try again</button>
                </div>

                <!-- Content state (filled from script) -->
                <div id="memberDetailContent" class="hidden">
                    <div class="flex items-start gap-4 mb-6 pb-6 border-b border-border-secondary">
                        <img id="modalAvatar" src="" alt="" class="w-20 h-20 rounded-full flex-shrink-0" />
                        <div id="modalAvatarPlaceholder" class="hidden w-20 h-20 rounded-full bg-gradient-to-br from-accent-blue to-accent-orange flex items-center justify-center text-white font-bold text-2xl flex-shrink-0" aria-hidden="true">
                            <span id="modalAvatarInitials"></span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 id="modalDisplayName" class="text-lg font-semibold text-text-primary mb-1 break-words"></h3>
                            <p id="modalUsername" class="text-sm text-text-secondary font-mono mb-2 break-all"></p>
                            <p class="text-xs text-text-secondary flex flex-wrap items-center gap-x-2">
                                <span>User ID</span>
                                <span id="modalUserId" class="font-mono select-all break-all"></span>
                                <button type="button"
                                        class="btn btn-ghost btn-icon text-accent-blue"
                                        data-copy-user-id
                                        aria-label="Copy user ID">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>
                                </button>
                            </p>
                        </div>
                    </div>

                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
                        <div>
                            <dt class="text-xs text-text-secondary uppercase tracking-wider mb-1">Account created</dt>
                            <dd id="modalAccountCreated" class="text-sm text-text-primary"></dd>
                            <dd id="modalAccountAge" class="text-xs text-text-secondary"></dd>
                        </div>
                        <div>
                            <dt class="text-xs text-text-secondary uppercase tracking-wider mb-1">Joined server</dt>
                            <dd id="modalJoinDate" class="text-sm text-text-primary"></dd>
                            <dd id="modalJoinAge" class="text-xs text-text-secondary"></dd>
                        </div>
                        <div>
                            <dt class="text-xs text-text-secondary uppercase tracking-wider mb-1">Last active</dt>
                            <dd id="modalLastActive" class="text-sm text-text-primary"></dd>
                            <dd id="modalLastActiveExact" class="text-xs text-text-secondary"></dd>
                        </div>
                        <div>
                            <dt class="text-xs text-text-secondary uppercase tracking-wider mb-1">Nickname</dt>
                            <dd id="modalNickname" class="text-sm text-text-primary break-words"></dd>
                        </div>
                    </dl>

                    <div class="mb-6">
                        <h4 class="text-sm font-semibold text-text-primary uppercase tracking-wider mb-3">
                            Roles <span id="modalRoleCount" class="text-text-secondary font-normal">(0)</span>
                        </h4>
                        <div id="modalRoleList" class="flex flex-wrap gap-2"></div>
                        <div id="modalNoRoles" class="hidden text-sm text-text-secondary">No roles assigned</div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-bg-secondary rounded-lg p-4 text-center">
                            <p id="modalRoleCountStat" class="text-2xl font-bold text-accent-blue">0</p>
                            <p class="text-xs text-text-secondary">Roles</p>
                        </div>
                        <div class="bg-bg-secondary rounded-lg p-4 text-center">
                            <p id="modalMemberStatus" class="text-2xl font-bold text-success">Active</p>
                            <p class="text-xs text-text-secondary">Status</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-6 py-4 border-t border-border-primary bg-bg-secondary rounded-b-lg flex-shrink-0">
                @if (Model)
                {
                    <a id="modalModerationLink" href="#" class="btn btn-accent">
                        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        View moderation profile
                    </a>
                }
                else
                {
                    <span></span>
                }
                <button type="button" class="btn btn-secondary" data-modal-dismiss>Close</button>
            </div>
        </div>
    </div>
</div>

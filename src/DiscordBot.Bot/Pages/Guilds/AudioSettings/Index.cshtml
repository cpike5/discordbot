@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.AudioSettings.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@{
    ViewData["Title"] = $"Audio Settings - {Model.GuildName}";
    Layout = "_GuildLayout";
}

<!-- Audio Tabs Navigation -->
    <partial name="Shared/Components/_TabPanel" model='new TabPanelViewModel {
        Id = "audioTabs",
        StyleVariant = TabStyleVariant.Pills,
        NavigationMode = TabNavigationMode.PageNavigation,
        Tabs = new List<TabItemViewModel>
        {
            new() {
                Id = "soundboard",
                Label = "Soundboard",
                Href = $"/Guilds/Soundboard/{Model.GuildId}",
                BadgeCount = Model.SoundCount,
                BadgeVariant = TabBadgeVariant.Info,
                IconPathOutline = "M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
            },
            new() {
                Id = "tts",
                Label = "Text-to-Speech",
                Href = $"/Guilds/TextToSpeech/{Model.GuildId}",
                IconPathOutline = "M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
            },
            new() {
                Id = "vox",
                Label = "VOX",
                Href = $"/Guilds/VOX/{Model.GuildId}",
                IconPathOutline = "M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 1 1 0-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 0 1-1.44-4.282m3.102.069a18.03 18.03 0 0 1-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 0 1 8.835 2.535M10.34 6.66a23.847 23.847 0 0 0 8.835-2.535m0 0A23.74 23.74 0 0 0 18.795 3m.38 1.125a23.91 23.91 0 0 1 1.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 0 0 1.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 0 1 0 3.46"
            },
            new() {
                Id = "settings",
                Label = "Settings",
                Href = $"/Guilds/AudioSettings/{Model.GuildId}",
                IconPathOutline = "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"
            },
            new() {
                Id = "audiolog",
                Label = "Audio Log",
                Href = $"/Guilds/AudioModerationLog/{Model.GuildId}",
                IconPathOutline = "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
            }
        },
        ActiveTabId = "settings",
        AriaLabel = "Audio sections"
    }' />

    <!-- Audio Globally Disabled Warning -->
    @if (Model.IsAudioGloballyDisabled)
    {
        <div class="mb-6 max-w-4xl mx-auto">
            <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                Variant = AlertVariant.Warning,
                Title = "Audio Features Disabled",
                Message = "Audio features have been disabled globally by an administrator. Audio commands will not work until audio is re-enabled in Settings.",
                IsDismissible = false
            }' />
        </div>
    }

<form id="audioSettingsForm" method="post" class="max-w-4xl mx-auto" data-unsaved-changes novalidate aria-describedby="saveStatus">
    @Html.AntiForgeryToken()

    <!-- General Settings Section -->
    <section class="settings-section mb-6" aria-labelledby="general-heading">
        <div class="settings-section-header">
            <div class="settings-section-title">
                <div class="settings-section-icon" aria-hidden="true">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <div>
                    <h2 id="general-heading" class="text-lg font-semibold text-text-primary">General Settings</h2>
                    <p class="text-xs text-text-tertiary">Core audio feature configuration</p>
                </div>
            </div>
        </div>
        <div class="settings-section-body">
            <!-- Audio Enabled -->
            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="audioEnabled" id="audioEnabled-label" class="settings-row-title">Audio features enabled</label>
                    <div id="audioEnabled-desc" class="settings-row-description">Turn all audio and soundboard features on or off for this server.</div>
                </div>
                <label class="toggle">
                    <input type="checkbox" id="audioEnabled" name="audioEnabled" class="toggle-input" role="switch" aria-describedby="audioEnabled-desc" @(Model.Settings.AudioEnabled ? "checked" : "") />
                    <span class="toggle-slider" aria-hidden="true"></span>
                </label>
            </div>

            <!-- Auto-leave Timeout -->
            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="autoLeaveTimeout" class="settings-row-title">Auto-leave timeout</label>
                    <div id="autoLeaveTimeout-desc" class="settings-row-description">Minutes of inactivity before the bot leaves the voice channel by itself, from 0 to 60. 0 means it stays until told to leave.</div>
                    <p id="autoLeaveTimeout-error" class="settings-field-error hidden" role="alert"></p>
                </div>
                <div class="input-with-unit">
                    <input type="number" id="autoLeaveTimeout" name="autoLeaveTimeout" value="@Model.Settings.AutoLeaveTimeoutMinutes" min="0" max="60" step="1" inputmode="numeric" autocomplete="off" required
                           data-label="the auto-leave timeout" data-unit="minutes" aria-describedby="autoLeaveTimeout-desc autoLeaveTimeout-error" class="settings-input" />
                    <span class="input-unit" aria-hidden="true">minutes</span>
                </div>
            </div>

            <!-- Queue Enabled -->
            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="queueEnabled" class="settings-row-title">Queue mode</label>
                    <div id="queueEnabled-desc" class="settings-row-description">On: sounds queue up and play in order. Off: a new sound replaces the one that is playing.</div>
                </div>
                <label class="toggle">
                    <input type="checkbox" id="queueEnabled" name="queueEnabled" class="toggle-input" role="switch" aria-describedby="queueEnabled-desc" @(Model.Settings.QueueEnabled ? "checked" : "") />
                    <span class="toggle-slider" aria-hidden="true"></span>
                </label>
            </div>

            <!-- Enable Member Portal -->
            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="enableMemberPortal" class="settings-row-title">Member portal</label>
                    <div id="enableMemberPortal-desc" class="settings-row-description">Lets members of this server open the soundboard, TTS and VOX portal pages. When it is off, nobody can use the portal, administrators included, and its voice controls stop working. It does not depend on the audio switch above.</div>
                </div>
                <label class="toggle">
                    <input type="checkbox" id="enableMemberPortal" name="enableMemberPortal" class="toggle-input" role="switch" aria-describedby="enableMemberPortal-desc" @(Model.Settings.EnableMemberPortal ? "checked" : "") />
                    <span class="toggle-slider" aria-hidden="true"></span>
                </label>
            </div>

            <!-- Silent Playback -->
            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="silentPlayback" class="settings-row-title">Silent playback</label>
                    <div id="silentPlayback-desc" class="settings-row-description">Hide the "Now playing" and "Sound queued" replies to /play. Error replies are always shown.</div>
                </div>
                <label class="toggle">
                    <input type="checkbox" id="silentPlayback" name="silentPlayback" class="toggle-input" role="switch" aria-describedby="silentPlayback-desc" @(Model.Settings.SilentPlayback ? "checked" : "") />
                    <span class="toggle-slider" aria-hidden="true"></span>
                </label>
            </div>

            <!-- Portal Links: shown while the portal is on (as saved) -->
            <div class="settings-row portal-links-row" id="portalLinksRow" @(Model.Settings.EnableMemberPortal ? "" : "hidden")>
                <div class="settings-row-content">
                    <div class="settings-row-title">Portal links</div>
                    <div class="settings-row-description">Open the member portal pages. They open in a new tab and sign in with Discord.</div>
                </div>
                <div class="portal-link-buttons">
                    <a href="/Portal/Soundboard/@Model.GuildId" target="_blank" rel="noopener noreferrer" class="portal-link-btn">
                        Soundboard portal<span class="sr-only"> (opens in a new tab)</span>
                        <svg class="w-3 h-3 external-link-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                    <a href="/Portal/TTS/@Model.GuildId" target="_blank" rel="noopener noreferrer" class="portal-link-btn">
                        TTS portal<span class="sr-only"> (opens in a new tab)</span>
                        <svg class="w-3 h-3 external-link-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                    <a href="/Portal/VOX/@Model.GuildId" target="_blank" rel="noopener noreferrer" class="portal-link-btn">
                        VOX portal<span class="sr-only"> (opens in a new tab)</span>
                        <svg class="w-3 h-3 external-link-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Sound Storage Path (Read-only) -->
            <div class="settings-row">
                <div class="settings-row-content">
                    <div class="settings-row-title">Sound storage folder</div>
                    <div class="settings-row-description">Where this server's audio files are kept on the bot's host. Set in the bot's configuration.</div>
                </div>
                <div class="readonly-field">
                    <svg class="w-4 h-4 text-text-tertiary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                    <code>@Model.SoundFolderPath</code>
                </div>
            </div>
        </div>
    </section>

    <!-- Limits Section -->
    <section class="settings-section mb-6" aria-labelledby="limits-heading">
        <div class="settings-section-header">
            <div class="settings-section-title">
                <div class="settings-section-icon settings-section-icon-warning" aria-hidden="true">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div>
                    <h2 id="limits-heading" class="text-lg font-semibold text-text-primary">Limits</h2>
                    <p class="text-xs text-text-tertiary">Resource limits for audio files and storage</p>
                </div>
            </div>
        </div>
        <div class="settings-section-body">
            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="maxDuration" class="settings-row-title">Maximum sound duration</label>
                    <div id="maxDuration-desc" class="settings-row-description">The longest an uploaded sound may be, from 1 to 300 seconds.</div>
                    <p id="maxDuration-error" class="settings-field-error hidden" role="alert"></p>
                </div>
                <div class="input-with-unit">
                    <input type="number" id="maxDuration" name="maxDuration" value="@Model.Settings.MaxDurationSeconds" min="1" max="300" step="1" inputmode="numeric" autocomplete="off" required
                           data-label="the maximum duration" data-unit="seconds" aria-describedby="maxDuration-desc maxDuration-error" class="settings-input" />
                    <span class="input-unit" aria-hidden="true">seconds</span>
                </div>
            </div>

            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="maxFileSize" class="settings-row-title">Maximum file size</label>
                    <div id="maxFileSize-desc" class="settings-row-description">The largest an uploaded audio file may be, from 1 to 50 MB.</div>
                    <p id="maxFileSize-error" class="settings-field-error hidden" role="alert"></p>
                </div>
                <div class="input-with-unit">
                    <input type="number" id="maxFileSize" name="maxFileSize" value="@(Model.Settings.MaxFileSizeBytes / (1024 * 1024))" min="1" max="50" step="1" inputmode="numeric" autocomplete="off" required
                           data-label="the maximum file size" data-unit="MB" aria-describedby="maxFileSize-desc maxFileSize-error" class="settings-input" />
                    <span class="input-unit" aria-hidden="true">MB</span>
                </div>
            </div>

            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="maxSounds" class="settings-row-title">Maximum sounds</label>
                    <div id="maxSounds-desc" class="settings-row-description">How many sounds this server can store, from 1 to 500.</div>
                    <p id="maxSounds-error" class="settings-field-error hidden" role="alert"></p>
                </div>
                <div class="input-with-unit">
                    <input type="number" id="maxSounds" name="maxSounds" value="@Model.Settings.MaxSoundsPerGuild" min="1" max="500" step="1" inputmode="numeric" autocomplete="off" required
                           data-label="the maximum number of sounds" data-unit="sounds" aria-describedby="maxSounds-desc maxSounds-error" class="settings-input" />
                    <span class="input-unit" aria-hidden="true">sounds</span>
                </div>
            </div>
        </div>
    </section>

    <!-- TTS Settings Section -->
    <section class="settings-section mb-6" aria-labelledby="tts-heading">
        <div class="settings-section-header">
            <div class="settings-section-title">
                <div class="settings-section-icon settings-section-icon-info" aria-hidden="true">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                    </svg>
                </div>
                <div>
                    <h2 id="tts-heading" class="text-lg font-semibold text-text-primary">TTS Settings</h2>
                    <p class="text-xs text-text-tertiary">Configure SSML and advanced TTS features</p>
                </div>
            </div>
        </div>
        <div class="settings-section-body">
            <div class="settings-row">
                <div class="settings-row-content">
                    <label for="ssmlEnabled" class="settings-row-title">Enable SSML mode</label>
                    <div id="ssmlEnabled-desc" class="settings-row-description">Allow SSML (Speech Synthesis Markup Language) for finer voice control: pitch, pauses, emphasis and styles.</div>
                </div>
                <label class="toggle">
                    <input type="checkbox" id="ssmlEnabled" name="ssmlEnabled" class="toggle-input" role="switch" aria-describedby="ssmlEnabled-desc" aria-controls="strictValidationRow maxComplexityRow defaultStyleRow" @(Model.TtsSettings.SsmlEnabled ? "checked" : "") />
                    <span class="toggle-slider" aria-hidden="true"></span>
                </label>
            </div>

            <div class="settings-row ssml-conditional-field" id="strictValidationRow" @(Model.TtsSettings.SsmlEnabled ? "" : "hidden")>
                <div class="settings-row-content">
                    <label for="strictSsmlValidation" class="settings-row-title">Strict SSML validation</label>
                    <div id="strictSsmlValidation-desc" class="settings-row-description">On: invalid SSML is rejected. Off: invalid SSML is spoken as plain text instead.</div>
                </div>
                <label class="toggle">
                    <input type="checkbox" id="strictSsmlValidation" name="strictSsmlValidation" class="toggle-input" role="switch" aria-describedby="strictSsmlValidation-desc" @(Model.TtsSettings.StrictSsmlValidation ? "checked" : "") />
                    <span class="toggle-slider" aria-hidden="true"></span>
                </label>
            </div>

            <div class="settings-row ssml-conditional-field" id="maxComplexityRow" @(Model.TtsSettings.SsmlEnabled ? "" : "hidden")>
                <div class="settings-row-content">
                    <label for="maxSsmlComplexity" class="settings-row-title">Max SSML complexity</label>
                    <div id="maxSsmlComplexity-desc" class="settings-row-description">A cap on how many nested elements and voice changes one message may use, from 10 to 200. Higher allows more.</div>
                    <p id="maxSsmlComplexity-error" class="settings-field-error hidden" role="alert"></p>
                </div>
                <div class="input-with-unit">
                    <input type="number" id="maxSsmlComplexity" name="maxSsmlComplexity" value="@Model.TtsSettings.MaxSsmlComplexity" min="10" max="200" step="1" inputmode="numeric" autocomplete="off" required
                           data-label="the SSML complexity limit" data-unit="" aria-describedby="maxSsmlComplexity-desc maxSsmlComplexity-error" class="settings-input" />
                </div>
            </div>

            <div class="settings-row ssml-conditional-field" id="defaultStyleRow" @(Model.TtsSettings.SsmlEnabled ? "" : "hidden")>
                <div class="settings-row-content">
                    <label for="defaultStyle" class="settings-row-title">Default style</label>
                    <div id="defaultStyle-desc" class="settings-row-description">The speaking style used when a message names none, for voices that support styles.</div>
                    <p id="defaultStyle-error" class="settings-field-error hidden" role="alert"></p>
                </div>
                @{
                    var selectedStyle = Model.TtsSettings.DefaultStyle ?? "";
                }
                <select id="defaultStyle" name="defaultStyle" class="settings-input settings-select" aria-describedby="defaultStyle-desc defaultStyle-error">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedStyle))">(None)</option>
                    @foreach (var style in IndexModel.DefaultStyles)
                    {
                        <option value="@style" selected="@(selectedStyle == style)">@(char.ToUpperInvariant(style[0]) + style[1..])</option>
                    }
                </select>
            </div>
        </div>
    </section>

    <!-- Command Permissions Section -->
    <section class="settings-section mb-6" aria-labelledby="permissions-heading">
        <div class="settings-section-header">
            <div class="settings-section-title">
                <div class="settings-section-icon settings-section-icon-success" aria-hidden="true">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>
                <div>
                    <h2 id="permissions-heading" class="text-lg font-semibold text-text-primary">Command Permissions</h2>
                    <p class="text-xs text-text-tertiary">Limit audio commands to certain roles. Leave a command with no roles to let everyone use it.</p>
                </div>
            </div>
        </div>
        <div class="settings-section-body">
            @if (!Model.RolesAvailable)
            {
                <div class="mb-4">
                    <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                        Variant = AlertVariant.Warning,
                        Title = "Roles are not available",
                        Message = "The bot cannot see this server right now, so its roles cannot be listed. Roles already chosen are kept when you save.",
                        IsDismissible = false
                    }' />
                </div>
            }
            @foreach (var command in IndexModel.SoundboardCommands)
            {
                var restriction = Model.Settings.CommandRoleRestrictions
                    .FirstOrDefault(r => r.CommandName.Equals(command, StringComparison.OrdinalIgnoreCase));
                var allowedRoleIds = restriction?.AllowedRoleIds ?? new List<ulong>();
                var unknownRoleIds = allowedRoleIds.Where(id => Model.AvailableRoles.All(r => r.Id != id)).ToList();
                var chosenNames = allowedRoleIds
                    .Select(id => Model.AvailableRoles.FirstOrDefault(r => r.Id == id)?.Name ?? "Deleted role")
                    .ToList();

                <fieldset class="command-permission-card" data-command="@command">
                    <legend class="command-name">
                        @GetCommandIcon(command)
                        /@command
                    </legend>
                    <p id="@(command)-desc" class="text-xs text-text-tertiary mb-3">@GetCommandDescription(command)</p>
                    <details class="role-picker">
                        <summary class="role-select-trigger" aria-describedby="@(command)-desc">
                            <span class="role-tags" data-role-summary>
                                @if (chosenNames.Count == 0)
                                {
                                    <span class="role-select-placeholder">Everyone can use this command</span>
                                }
                                else
                                {
                                    @foreach (var roleName in chosenNames)
                                    {
                                        <span class="role-tag">@roleName</span>
                                    }
                                }
                            </span>
                            <svg class="w-4 h-4 text-text-tertiary flex-shrink-0 role-picker-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </summary>
                        <div class="role-select-dropdown" role="group" aria-label="Roles allowed to use /@command">
                            @foreach (var role in Model.AvailableRoles)
                            {
                                var isSelected = allowedRoleIds.Contains(role.Id);
                                <label class="role-select-option @(isSelected ? "selected" : "")">
                                    <input type="checkbox" class="role-checkbox" name="roles-@command" data-command="@command" data-role-name="@role.Name" value="@role.Id" @(isSelected ? "checked" : "") />
                                    <span class="role-color" style="background: @RoleColor(role.Color);" aria-hidden="true"></span>
                                    <span class="text-sm text-text-primary break-words min-w-0">@role.Name</span>
                                </label>
                            }
                            @foreach (var roleId in unknownRoleIds)
                            {
                                <label class="role-select-option selected" title="This role no longer exists or the bot cannot see it. Untick it to remove it.">
                                    <input type="checkbox" class="role-checkbox" name="roles-@command" data-command="@command" data-role-name="Deleted role" value="@roleId" checked />
                                    <span class="role-color role-color-unknown" aria-hidden="true"></span>
                                    <span class="text-sm text-text-secondary">Deleted role</span>
                                </label>
                            }
                            @if (Model.AvailableRoles.Count == 0 && unknownRoleIds.Count == 0)
                            {
                                <div class="px-4 py-2 text-sm text-text-tertiary">No roles available</div>
                            }
                            <div class="role-select-footer">
                                <button type="button" class="btn btn-secondary btn-sm" data-clear-roles="@command">Allow everyone</button>
                            </div>
                        </div>
                    </details>
                </fieldset>
            }
        </div>
    </section>

    <!-- Save bar: one Save for the whole page -->
    <div class="settings-savebar" role="region" aria-label="Save settings">
        <button type="button" id="resetDefaultsBtn" class="btn btn-secondary">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span class="settings-savebar-reset-label">Reset to defaults</span>
        </button>
        <p id="saveStatus" class="settings-savebar-status" role="status" aria-live="polite">
            <span data-unsaved-indicator class="hidden inline-block px-2 py-0.5 rounded-full bg-warning text-on-warning font-semibold">Unsaved changes</span>
            <span data-saved-note class="text-text-tertiary">All changes saved</span>
        </p>
        <button type="submit" id="saveSettingsBtn" class="btn btn-primary" data-loading-text="Saving…">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Save changes
        </button>
    </div>
</form>

@functions {
    private static string GetCommandDescription(string command)
    {
        return command.ToLower() switch
        {
            "join" => "Join a voice channel",
            "leave" => "Leave the current voice channel",
            "play" => "Play a sound from the soundboard",
            "sounds" => "List available sounds in the soundboard",
            "stop" => "Stop the currently playing sound and clear the queue",
            _ => "Execute this command"
        };
    }

    /// <summary>A Discord role colour as CSS: only a well-formed hex colour is used, never raw text.</summary>
    private static string RoleColor(string? color)
    {
        var hex = (color ?? string.Empty).TrimStart('#');
        return hex.Length == 6 && hex.All(Uri.IsHexDigit) && hex != "000000"
            ? "#" + hex
            : "var(--color-text-tertiary)";
    }

    private static Microsoft.AspNetCore.Html.IHtmlContent GetCommandIcon(string command)
    {
        var iconPath = command.ToLower() switch
        {
            "join" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\" />",
            "leave" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z\" /><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2\" />",
            "play" => "<path d=\"M8 5v14l11-7z\" fill=\"currentColor\" />",
            "sounds" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 10h16M4 14h16M4 18h16\" />",
            "stop" => "<path d=\"M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z\" fill=\"currentColor\" />",
            _ => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 10V3L4 14h7v7l9-11h-7z\" />"
        };
        return new Microsoft.AspNetCore.Html.HtmlString($"<svg class=\"w-3.5 h-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" aria-hidden=\"true\">{iconPath}</svg>");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
    <style>
        /* Settings Section Styles */
        .settings-section {
            background: var(--color-bg-secondary);
            border: 1px solid var(--color-border-primary);
            border-radius: 0.5rem;
        }

        .settings-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--color-border-primary);
        }

        .settings-section-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .settings-section-icon {
            width: 2rem;
            height: 2rem;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-accent-blue-muted);
            color: var(--color-accent-blue);
            border-radius: 0.5rem;
        }
        .settings-section-icon-warning { background: var(--color-warning-bg); color: var(--color-warning); }
        .settings-section-icon-info { background: var(--color-info-bg); color: var(--color-info); }
        .settings-section-icon-success { background: var(--color-success-bg); color: var(--color-success); }

        .settings-section-body {
            padding: 1.5rem;
        }

        /* Settings Row: label and description on the left, the control on the right; stacked on phones */
        .settings-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            padding: 1rem 0;
            border-bottom: 1px solid var(--color-border-secondary);
        }
        .settings-row[hidden] { display: none; }

        .settings-row:first-child {
            padding-top: 0;
        }

        .settings-row:last-of-type {
            border-bottom: none;
            padding-bottom: 0;
        }

        .settings-row-content {
            flex: 1;
            min-width: 0;
        }

        .settings-row-title {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--color-text-primary);
            margin-bottom: 0.25rem;
        }

        .settings-row-description {
            font-size: 0.75rem;
            color: var(--color-text-tertiary);
        }

        .settings-field-error {
            margin-top: 0.375rem;
            font-size: 0.75rem;
            color: var(--color-error);
        }

        @@media (max-width: 639px) {
            .settings-section-header { padding: 0.875rem 1rem; }
            .settings-section-body { padding: 1rem; }
            .settings-row { flex-direction: column; align-items: stretch; }
            .settings-row > .toggle { align-self: flex-start; }
            .settings-row > .readonly-field { overflow-wrap: anywhere; }
            .settings-input { width: 100%; }
            .settings-select { width: 100% !important; min-width: 0; }
            .input-with-unit { width: 100%; }
        }

        /* Input Styles */
        .settings-input {
            width: 6rem;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            background: var(--color-bg-primary);
            border: 1px solid var(--color-border-primary);
            border-radius: 0.5rem;
            color: var(--color-text-primary);
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .settings-select { width: auto; min-width: 10rem; }

        .settings-input:focus {
            outline: none;
            border-color: var(--color-border-focus);
            box-shadow: 0 0 0 2px var(--color-accent-blue-muted);
        }
        .settings-input.input-validation-error {
            border-color: var(--color-error);
        }

        .input-with-unit {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .input-unit {
            font-size: 0.75rem;
            color: var(--color-text-tertiary);
        }

        /* Read-only field */
        .readonly-field {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.75rem;
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-secondary);
            border-radius: 0.5rem;
            font-size: 0.875rem;
            color: var(--color-text-secondary);
            min-width: 0;
        }

        .readonly-field code {
            font-family: ui-monospace, monospace;
            color: var(--color-text-primary);
            overflow-wrap: anywhere;
        }

        /* Command Permission Card */
        .command-permission-card {
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-secondary);
            border-radius: 0.5rem;
            padding: 1rem;
            margin: 0 0 0.75rem;
            min-width: 0;
        }

        .command-permission-card:last-child {
            margin-bottom: 0;
        }

        .command-name {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.5rem;
            background: var(--color-bg-hover);
            border-radius: 0.375rem;
            font-family: ui-monospace, monospace;
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--color-accent-blue);
            margin-bottom: 0.75rem;
        }

        /* Role picker: a native <details>, so Enter/Space opens it and Tab walks the checkboxes */
        .role-picker { width: 100%; }
        .role-select-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            width: 100%;
            min-height: 2.5rem;
            padding: 0.5rem 0.75rem;
            background: var(--color-bg-primary);
            border: 1px solid var(--color-border-primary);
            border-radius: 0.5rem;
            cursor: pointer;
            list-style: none;
            transition: border-color 0.2s;
        }
        .role-select-trigger::-webkit-details-marker { display: none; }
        .role-select-trigger:hover { border-color: var(--color-border-focus); }
        .role-select-trigger:focus-visible {
            outline: 2px solid var(--color-border-focus);
            outline-offset: 2px;
        }
        .role-picker[open] .role-picker-chevron { transform: rotate(180deg); }

        .role-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.375rem;
            min-width: 0;
        }

        .role-tag {
            display: inline-flex;
            align-items: center;
            padding: 0.125rem 0.5rem;
            background: var(--color-accent-blue-muted);
            color: var(--color-accent-blue);
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 500;
            overflow-wrap: anywhere;
        }

        .role-select-placeholder {
            color: var(--color-text-tertiary);
            font-size: 0.875rem;
        }

        .role-select-dropdown {
            margin-top: 0.25rem;
            background: var(--color-bg-secondary);
            border: 1px solid var(--color-border-primary);
            border-radius: 0.5rem;
            max-height: 14rem;
            overflow-y: auto;
        }

        .role-select-option {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.625rem 0.75rem;
            cursor: pointer;
            transition: background 0.15s;
        }
        .role-select-option:hover { background: var(--color-bg-hover); }
        .role-select-option.selected { background: var(--color-accent-blue-muted); }
        .role-select-option:focus-within { outline: 2px solid var(--color-border-focus); outline-offset: -2px; }
        .role-select-option input { flex-shrink: 0; width: 1rem; height: 1rem; accent-color: var(--color-accent-blue-fill); }

        .role-select-footer {
            position: sticky;
            bottom: 0;
            padding: 0.5rem 0.75rem;
            background: var(--color-bg-secondary);
            border-top: 1px solid var(--color-border-secondary);
        }

        .role-color {
            width: 0.75rem;
            height: 0.75rem;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .role-color-unknown { background: var(--color-text-tertiary); }

        /* Portal Link Buttons */
        .portal-link-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .portal-link-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.5rem 0.75rem;
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-primary);
            border-radius: 0.375rem;
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--color-text-primary);
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .portal-link-btn:hover {
            background: var(--color-bg-hover);
            border-color: var(--color-border-focus);
            color: var(--color-accent-blue);
        }

        .portal-link-btn .external-link-icon {
            opacity: 0.5;
            transition: opacity 0.15s;
        }

        .portal-link-btn:hover .external-link-icon {
            opacity: 1;
        }

        .portal-links-row {
            background: var(--color-bg-tertiary);
            margin: -0.5rem -1.5rem;
            padding: 1rem 1.5rem !important;
            border-top: 1px dashed var(--color-border-secondary);
        }
        @@media (max-width: 639px) {
            .portal-links-row { margin: -0.5rem -1rem; padding: 1rem !important; }
        }

        /* One Save for the page: stays in view at the bottom while editing */
        .settings-savebar {
            position: sticky;
            bottom: 0;
            z-index: 20;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem calc(0.75rem + var(--safe-bottom, 0px));
            background: var(--color-bg-secondary);
            border: 1px solid var(--color-border-primary);
            border-radius: 0.5rem;
            box-shadow: var(--shadow-md);
        }
        .settings-savebar-status {
            flex: 1;
            min-width: 8rem;
            margin: 0;
            font-size: 0.8125rem;
            text-align: right;
        }
        @@media (max-width: 479px) {
            .settings-savebar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; padding: 0.5rem 0.75rem calc(0.5rem + var(--safe-bottom, 0px)); }
            .settings-savebar-status { grid-column: 1 / -1; order: -1; text-align: center; min-width: 0; }
            .settings-savebar .btn { justify-content: center; padding-inline: 0.5rem; min-width: 0; }
            .settings-savebar .btn svg { display: none; }
        }
    </style>
}

@section Scripts {
    <script>
        // Snowflakes go in as strings: a number loses its last digits
        window.guildId = '@Model.GuildId';
        window.audioSettingsConfig = { guildId: '@Model.GuildId' };
    </script>
    <script src="~/js/audio-settings.js" asp-append-version="true"></script>
}

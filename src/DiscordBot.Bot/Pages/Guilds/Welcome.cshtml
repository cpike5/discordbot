@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.WelcomeModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Pages
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = $"Welcome Settings - {Model.ViewModel.GuildName}";
    Layout = "_GuildLayout";

    // A form re-rendered after a failed save shows input that is not saved yet.
    var dirtyOnLoad = HttpMethods.IsPost(Model.Request.Method);

    var channelError = ViewData.ModelState.FieldError("Input.WelcomeChannelId");
    var messageError = ViewData.ModelState.FieldError("Input.WelcomeMessage");
    var colorError = ViewData.ModelState.FieldError("Input.EmbedColor");

    var channelOptions = FormFieldState.ChannelOptions(
        Model.AvailableChannels, Model.Input.WelcomeChannelId, "No channel selected", out var channelIsMissing);

    string[] tokens = { "{user}", "{username}", "{server}", "{memberCount}" };
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-6">
        <partial name="Shared/Components/_Alert" model='new AlertViewModel { Variant = AlertVariant.Error, Message = Model.ErrorMessage }' />
    </div>
}

<form method="post" id="welcome-form"
      data-submit-guard
      data-focus-first-error
      data-unsaved-changes
      data-unsaved-dirty-on-load="@(dirtyOnLoad ? "true" : "false")"
      data-guild-name="@Model.ViewModel.GuildName"
      novalidate>
    <div asp-validation-summary="ModelOnly" class="form-error mb-4"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        <!-- Configuration Form Column -->
        <div class="space-y-6 min-w-0">
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6">
                <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                    Id = "Input_IsEnabled",
                    Name = "Input.IsEnabled",
                    Label = "Enable welcome messages",
                    Description = "Send a message when a new member joins the server.",
                    IsChecked = Model.Input.IsEnabled
                }' />
            </div>

            <div data-section-gate="#Input_IsEnabled" class="space-y-3">
                <p data-section-gate-note hidden class="text-sm text-text-secondary" id="welcome-gate-note">
                    Welcome messages are off. Turn them on above to edit these settings; your saved values are kept.
                </p>

                <div data-section-gate-body class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6 space-y-6">
                    <!-- Welcome Channel -->
                    <div>
                        <partial name="Shared/Components/_FormSelect" model='new FormSelectViewModel {
                            Id = "Input_WelcomeChannelId",
                            Name = "Input.WelcomeChannelId",
                            Label = "Welcome channel",
                            Placeholder = null,
                            SelectedValue = Model.Input.WelcomeChannelId?.ToString() ?? string.Empty,
                            Options = channelOptions,
                            HelpText = "The channel where welcome messages are sent.",
                            ValidationState = FormFieldState.StateOf(channelError),
                            ValidationMessage = channelError
                        }' />
                        @if (channelIsMissing)
                        {
                            <div class="mt-2">
                                <partial name="Shared/Components/_Alert" model='new AlertViewModel {
                                    Variant = AlertVariant.Warning,
                                    Message = "The saved channel is not in the channel list for this server. It may have been deleted, or the bot cannot see it right now. It stays selected until you choose another channel."
                                }' />
                            </div>
                        }
                    </div>

                    <!-- Welcome Message Template -->
                    <div>
                        <div class="flex flex-wrap items-center gap-2 mb-2" role="group" aria-label="Insert a token into the message">
                            <span class="form-label mr-1">Insert</span>
                            @foreach (var token in tokens)
                            {
                                <button type="button"
                                        data-insert-token="@token"
                                        class="btn btn-secondary btn-sm font-mono">
                                    @token
                                </button>
                            }
                        </div>

                        <partial name="Shared/Components/_FormTextarea" model='new FormTextareaViewModel {
                            Id = "Input_WelcomeMessage",
                            Name = "Input.WelcomeMessage",
                            Label = "Welcome message",
                            Placeholder = "Enter your welcome message...",
                            Value = Model.Input.WelcomeMessage,
                            Rows = 4,
                            MaxLength = 2000,
                            HelpText = "Supports Discord markdown. Tokens are replaced when the message is sent.",
                            ValidationState = FormFieldState.StateOf(messageError),
                            ValidationMessage = messageError
                        }' />
                    </div>

                    <!-- Use Embed -->
                    <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                        Id = "Input_UseEmbed",
                        Name = "Input.UseEmbed",
                        Label = "Send as an embed",
                        Description = "A rich embed with a coloured edge instead of plain text.",
                        IsChecked = Model.Input.UseEmbed
                    }' />

                    <!-- Include Avatar (embeds only) -->
                    <partial name="Shared/Components/_FormToggle" model='new FormToggleViewModel {
                        Id = "Input_IncludeAvatar",
                        Name = "Input.IncludeAvatar",
                        Label = "Show the member avatar",
                        Description = "Shown as a thumbnail on the embed. Plain-text messages have no avatar.",
                        IsChecked = Model.Input.IncludeAvatar
                    }' />

                    <!-- Embed Color -->
                    <div id="embed-color-container" class="@(!Model.Input.UseEmbed ? "hidden" : "")">
                        <label for="Input_EmbedColor" class="form-label block mb-1.5">Embed colour</label>
                        <div class="flex items-center gap-3">
                            <input type="color"
                                   id="embed-color-picker"
                                   value="@(System.Text.RegularExpressions.Regex.IsMatch(Model.Input.EmbedColor ?? "", "^#[0-9A-Fa-f]{6}$") ? Model.Input.EmbedColor : "#5865F2")"
                                   aria-label="Pick the embed colour"
                                   data-unsaved-ignore
                                   class="w-12 h-10 rounded border border-border-primary cursor-pointer bg-transparent" />
                            <input type="text"
                                   id="Input_EmbedColor"
                                   name="Input.EmbedColor"
                                   value="@Model.Input.EmbedColor"
                                   autocomplete="off"
                                   spellcheck="false"
                                   maxlength="7"
                                   placeholder="#5865F2"
                                   aria-describedby="Input_EmbedColor-help @(colorError != null ? "Input_EmbedColor-error" : "")"
                                   @(colorError != null ? "aria-invalid=true" : "")
                                   class="form-input flex-1 font-mono @(colorError != null ? "input-validation-error" : "")" />
                        </div>
                        <p id="Input_EmbedColor-help" class="form-help mt-1.5">Six-digit hex colour, for example #5865F2.</p>
                        @if (colorError != null)
                        {
                            <p id="Input_EmbedColor-error" class="form-error mt-1" role="alert">@colorError</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Token Help Panel -->
            <details class="bg-bg-secondary border border-border-primary rounded-lg group" open>
                <summary class="px-4 sm:px-6 py-4 flex items-center justify-between cursor-pointer list-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-border-focus rounded-lg">
                    <span class="text-sm font-semibold text-text-primary">Available tokens</span>
                    <svg class="w-5 h-5 text-text-tertiary transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </summary>
                <ul class="px-4 sm:px-6 pb-4 divide-y divide-border-secondary text-sm">
                    @foreach (var (token, description, example) in new[]
                    {
                        ("{user}", "Mentions the new member", "@NewMember"),
                        ("{username}", "The member's display name", "NewMember"),
                        ("{server}", "The server name", Model.ViewModel.GuildName),
                        ("{memberCount}", "Total member count", "1,234")
                    })
                    {
                        <li class="py-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                            <button type="button" data-insert-token="@token"
                                    class="btn btn-secondary btn-sm font-mono"
                                    aria-label="Insert @token into the message">@token</button>
                            <span class="text-text-secondary flex-1 min-w-[10rem]">@description</span>
                            <span class="text-text-tertiary break-all">e.g. @example</span>
                        </li>
                    }
                </ul>
            </details>

            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <button type="submit" class="btn btn-primary inline-flex items-center justify-center gap-2" data-loading-text="Saving...">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Save settings
                </button>
                <a asp-page="Details" asp-route-guildId="@Model.ViewModel.GuildId"
                   class="btn btn-secondary inline-flex items-center justify-center gap-2">
                    Cancel
                </a>
                <span data-unsaved-indicator class="hidden text-sm text-warning" role="status">Unsaved changes</span>
            </div>
        </div>

        <!-- Live Preview Column -->
        <div class="lg:sticky lg:top-8 lg:self-start min-w-0">
            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <div class="px-4 sm:px-6 py-4 border-b border-border-primary">
                    <h2 class="text-sm font-semibold text-text-primary">Preview</h2>
                    <p class="text-xs text-text-secondary mt-1">How the message will look in Discord, with sample data.</p>
                </div>
                <div class="p-4 sm:p-6">
                    <p id="preview-off-note" class="text-xs text-text-secondary mb-3" hidden>
                        Welcome messages are off, so nothing is sent. This is how the message will look once they are on.
                    </p>
                    <div class="discord-preview">
                        <div class="flex gap-3">
                            <div class="flex-shrink-0" aria-hidden="true">
                                <div class="w-10 h-10 rounded-full bg-discord flex items-center justify-center">
                                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-x-1.5 mb-1">
                                    <span class="discord-preview-name text-sm">Bot</span>
                                    <span class="discord-bot-badge">Bot</span>
                                    <span class="discord-preview-muted text-xs">Today at @DisplayFormat.Time(DateTime.UtcNow, "time")</span>
                                </div>
                                <!-- Plain text message -->
                                <div id="preview-plain" class="text-sm leading-relaxed break-words"></div>
                                <!-- Embed -->
                                <div id="preview-embed" class="discord-embed" hidden>
                                    <div class="flex gap-3">
                                        <div id="preview-embed-text" class="text-sm leading-relaxed break-words flex-1 min-w-0"></div>
                                        <div id="preview-thumb" class="w-16 h-16 rounded-md flex-shrink-0 discord-embed-thumb" aria-hidden="true">Member avatar</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-t border-border-secondary">
                        <p class="text-xs text-text-secondary mb-2">Sample data used in the preview</p>
                        <ul class="text-xs text-text-secondary space-y-1">
                            <li><code class="px-1 bg-bg-tertiary rounded">{user}</code> = @@NewMember</li>
                            <li><code class="px-1 bg-bg-tertiary rounded">{username}</code> = NewMember</li>
                            <li><code class="px-1 bg-bg-tertiary rounded">{server}</code> = @Model.ViewModel.GuildName</li>
                            <li><code class="px-1 bg-bg-tertiary rounded">{memberCount}</code> = 1,234</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/discord-markdown.js" asp-append-version="true"></script>
    <script src="~/js/section-gate.js" asp-append-version="true"></script>
    <script src="~/js/form-focus.js" asp-append-version="true"></script>
    <script src="~/js/welcome-settings.js" asp-append-version="true"></script>
}

@page "{guildId:long}"
@model DiscordBot.Bot.Pages.Guilds.AudioModerationLog.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@{
    ViewData["Title"] = $"Audio Log - {Model.GuildName}";
    Layout = "_GuildLayout";
    var startItem = Model.TotalCount > 0 ? (Model.CurrentPage - 1) * Model.PageSize + 1 : 0;
    var endItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
}

<!-- Audio Tabs Navigation -->

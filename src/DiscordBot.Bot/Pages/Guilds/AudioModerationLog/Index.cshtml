<!-- Filter Bar -->
<div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
    <form method="get" id="filterForm">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Feature Type Filter -->
            <div>
                <label for="FeatureFilter" class="block text-sm font-medium text-text-secondary mb-1">Feature Type</label>
                <select id="FeatureFilter"
                        name="FeatureFilter"
                        class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:ring-2 focus:ring-accent-blue focus:border-accent-blue">
                    <option value="">All Types</option>
                    <option value="@((int)AudioFeatureType.Soundboard)" selected="@(Model.FeatureFilter == AudioFeatureType.Soundboard)">Soundboard</option>
                    <option value="@((int)AudioFeatureType.Tts)" selected="@(Model.FeatureFilter == AudioFeatureType.Tts)">TTS</option>
                    <option value="@((int)AudioFeatureType.Vox)" selected="@(Model.FeatureFilter == AudioFeatureType.Vox)">VOX</option>
                </select>
            </div>

            <!-- User ID Filter -->
            <div>
                <label for="UserFilter" class="block text-sm font-medium text-text-secondary mb-1">User ID</label>
                <input type="text"
                       id="UserFilter"
                       name="UserFilter"
                       value="@Model.UserFilter"
                       placeholder="Discord User ID..."
                       class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary placeholder-text-tertiary focus:ring-2 focus:ring-accent-blue focus:border-accent-blue" />
            </div>

            <!-- Date From Filter -->
            <div>
                <label for="DateFrom" class="block text-sm font-medium text-text-secondary mb-1">From Date</label>
                <input type="date"
                       id="DateFrom"
                       name="DateFrom"
                       value="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                       class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:ring-2 focus:ring-accent-blue focus:border-accent-blue" />
            </div>

            <!-- Date To Filter -->
            <div>
                <label for="DateTo" class="block text-sm font-medium text-text-secondary mb-1">To Date</label>
                <input type="date"
                       id="DateTo"
                       name="DateTo"
                       value="@Model.DateTo?.ToString("yyyy-MM-dd")"
                       class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:ring-2 focus:ring-accent-blue focus:border-accent-blue" />
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 mt-4">
            <a href="@Url.Page("/Guilds/AudioModerationLog/Index", new { guildId = Model.GuildId })" class="px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors">
                Clear Filters
            </a>
            <button type="submit" class="px-4 py-2 bg-accent-blue text-white text-sm font-medium rounded-md hover:bg-accent-blue/90 transition-colors">
                Apply Filters
            </button>
        </div>
    </form>
</div>

@if (!Model.LogEntries.Any())
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-text-secondary mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
        </svg>
        <h3 class="text-sm font-medium text-text-primary mb-1">No audio playback events found</h3>
        <p class="text-sm text-text-tertiary">@(Model.HasActiveFilters ? "Try adjusting your filters." : "No audio has been played in this guild yet.")</p>
    </div>
}
else
{
    <!-- Desktop Table -->
    <div class="hidden md:block bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-6">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-border-primary" role="table" aria-label="Audio playback log">
                <thead class="bg-bg-tertiary">
                    <tr>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Timestamp</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">User</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Feature</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Content</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Channel</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var entry in Model.LogEntries)
                    {
                        <tr class="hover:bg-bg-hover transition-colors">
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span class="text-sm text-text-secondary" data-utc="@entry.PlayedAt.ToString("o")" data-format="datetime"></span>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span class="text-sm font-medium text-text-primary preview-trigger" data-preview-type="user" data-user-id="@entry.UserId" data-context-guild-id="@Model.GuildId">
                                    @Model.ResolveUserName(entry.UserId)
                                </span>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                @{
                                    var (badgeClass, badgeLabel) = entry.FeatureType switch
                                    {
                                        AudioFeatureType.Soundboard => ("bg-accent-blue/20 text-accent-blue", "Soundboard"),
                                        AudioFeatureType.Tts => ("bg-accent-green/20 text-accent-green", "TTS"),
                                        AudioFeatureType.Vox => ("bg-accent-orange/20 text-accent-orange", "VOX"),
                                        _ => ("bg-bg-tertiary text-text-secondary", entry.FeatureType.ToString())
                                    };
                                }
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @badgeClass">
                                    @badgeLabel
                                </span>
                            </td>
                            <td class="px-4 py-4">
                                <span class="text-sm text-text-primary truncate block max-w-xs" title="@entry.ContentName">@entry.ContentName</span>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                @if (entry.ChannelId.HasValue)
                                {
                                    <span class="text-sm text-text-secondary">#@Model.ResolveChannelName(entry.ChannelId.Value)</span>
                                }
                                else
                                {
                                    <span class="text-sm text-text-tertiary">--</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-4 mb-6">
        @foreach (var entry in Model.LogEntries)
        {
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-start justify-between mb-3">
                    <div>
                        @{
                            var (mBadgeClass, mBadgeLabel) = entry.FeatureType switch
                            {
                                AudioFeatureType.Soundboard => ("bg-accent-blue/20 text-accent-blue", "Soundboard"),
                                AudioFeatureType.Tts => ("bg-accent-green/20 text-accent-green", "TTS"),
                                AudioFeatureType.Vox => ("bg-accent-orange/20 text-accent-orange", "VOX"),
                                _ => ("bg-bg-tertiary text-text-secondary", entry.FeatureType.ToString())
                            };
                        }
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @mBadgeClass">
                            @mBadgeLabel
                        </span>
                    </div>
                    <span class="text-xs text-text-tertiary" data-utc="@entry.PlayedAt.ToString("o")" data-format="datetime"></span>
                </div>
                <div class="space-y-2">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-semibold text-text-secondary">User:</span>
                        <span class="text-sm text-text-primary preview-trigger" data-preview-type="user" data-user-id="@entry.UserId" data-context-guild-id="@Model.GuildId">
                            @Model.ResolveUserName(entry.UserId)
                        </span>
                    </div>
                    <div>
                        <span class="text-sm font-semibold text-text-secondary">Content:</span>
                        <span class="text-sm text-text-primary">@entry.ContentName</span>
                    </div>
                    @if (entry.ChannelId.HasValue)
                    {
                        <div class="text-sm text-text-secondary">#@Model.ResolveChannelName(entry.ChannelId.Value)</div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="mt-6">
            @{
                var baseUrl = Url.Page(null, new {
                    guildId = Model.GuildId,
                    FeatureFilter = Model.FeatureFilter.HasValue ? ((int)Model.FeatureFilter.Value).ToString() : null,
                    UserFilter = Model.UserFilter,
                    DateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"),
                    DateTo = Model.DateTo?.ToString("yyyy-MM-dd"),
                    PageSize = Model.PageSize
                }) ?? string.Empty;
                var paginationModel = new PaginationViewModel {
                    CurrentPage = Model.CurrentPage,
                    TotalPages = Model.TotalPages,
                    TotalItems = Model.TotalCount,
                    PageSize = Model.PageSize,
                    BaseUrl = baseUrl,
                    Style = PaginationStyle.Full,
                    ShowPageSizeSelector = true,
                    ShowItemCount = true,
                    PageParameterName = "pageNumber"
                };
            }
            <partial name="Shared/Components/_Pagination" model="paginationModel" />
        </div>
    }

    <!-- Results Summary -->
    @if (Model.TotalCount > 0)
    {
        <div class="mt-4 text-sm text-text-secondary">
            Showing @startItem to @endItem of @Model.TotalCount.ToString("N0") entries
        </div>
    }
}

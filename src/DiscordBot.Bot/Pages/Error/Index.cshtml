@page "/Error/{statusCode:int}"
@model DiscordBot.Bot.Pages.Error.ErrorPageModel
@{
    ViewData["Title"] = Model.Heading;
    Layout = "_ErrorLayout";

    var signedIn = User.Identity?.IsAuthenticated == true;
    var (iconBg, iconPath) = Model.Code switch
    {
        401 or 403 => ("bg-error-bg text-error", "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"),
        404 => ("bg-warning-bg text-warning", "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"),
        400 or 408 or 429 => ("bg-info-bg text-info", "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"),
        _ when Model.Code >= 500 => ("bg-error-bg text-error", "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"),
        _ => ("bg-warning-bg text-warning", "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
    };
    var showSignIn = Model.Code == 401 || (Model.Code == 403 && !signedIn);
    var showReload = Model.Code is 400 or 408 or 429 or >= 500;
}

<div class="w-full max-w-md">
    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-xl mb-4 @iconBg" aria-hidden="true">
            <svg class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@iconPath" />
            </svg>
        </div>
        <p class="text-xs font-mono text-text-secondary mb-1">Error @Model.Code</p>
        <h1 class="text-2xl font-bold text-text-primary">@Model.Heading</h1>
    </div>

    <div class="card p-6">
        <p class="text-sm text-text-primary">@Model.Description</p>

        @if (!string.IsNullOrEmpty(Model.OriginalPath))
        {
            <p class="text-xs text-text-secondary mt-4 font-mono break-all">
                <span class="font-sans">Address:</span> @Model.OriginalPath
            </p>
        }

        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="text-xs text-text-secondary mt-2 font-mono break-all">
                <span class="font-sans">Reference:</span> @Model.RequestId
            </p>
        }

        @if (!string.IsNullOrEmpty(Model.ExceptionMessage))
        {
            <div class="mt-4 p-4 bg-bg-primary border border-border-primary rounded-lg">
                <p class="text-xs font-semibold text-error mb-2">Development only: exception details</p>
                <p class="text-xs text-text-primary font-mono whitespace-pre-wrap break-all">@Model.ExceptionMessage</p>
                @if (!string.IsNullOrEmpty(Model.ExceptionStackTrace))
                {
                    <details class="mt-4">
                        <summary class="text-xs font-semibold text-text-secondary cursor-pointer hover:text-text-primary">Stack trace</summary>
                        <pre class="text-xs text-text-secondary font-mono whitespace-pre-wrap break-all mt-2 max-h-64 overflow-y-auto">@Model.ExceptionStackTrace</pre>
                    </details>
                }
            </div>
        }

        <div class="flex flex-wrap gap-3 mt-6">
            @if (showSignIn)
            {
                <a asp-page="/Account/Login" asp-route-ReturnUrl="@Model.LocalOriginalUrl" class="btn btn-primary flex-1">Sign in</a>
            }
            else if (showReload && !string.IsNullOrEmpty(Model.OriginalPath))
            {
                @* A failed POST is not re-sent: reloading its address shows the form again *@
                <a href="@Model.LocalOriginalUrl" class="btn btn-primary flex-1">Reload the page</a>
            }
            else
            {
                <a asp-page="/Index" class="btn btn-primary flex-1">@(signedIn ? "Go to dashboard" : "Go to home page")</a>
            }
            <button type="button" class="btn btn-secondary flex-1" data-history-back>Go back</button>
        </div>
    </div>
</div>

@page
@model DiscordBot.Bot.Pages.Commands.IndexModel
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Pages
@{
    ViewData["Title"] = "Commands";

    var activeTab = Model.ActiveTab ?? "command-list";

    var tabPanel = new TabPanelViewModel
    {
        Id = "commandTabs",
        Tabs = new List<TabItemViewModel>
        {
            new TabItemViewModel { Id = "command-list", Label = "Command List" },
            new TabItemViewModel { Id = "execution-logs", Label = "Execution Logs" },
            new TabItemViewModel { Id = "analytics", Label = "Analytics" }
        },
        ActiveTabId = activeTab,
        NavigationMode = TabNavigationMode.InPage,
        // The tab lives in the query string (commands-page.js keeps it there), not the hash
        PersistenceMode = TabPersistenceMode.None,
        AriaLabel = "Commands sections"
    };

    var subtitle = activeTab switch
    {
        "execution-logs" => "Command execution history",
        "analytics" => "Usage statistics and performance",
        _ => "All registered slash commands"
    };

    var headerModel = new CommandHeaderViewModel { Title = "Commands", Subtitle = subtitle, ActiveTab = activeTab };
    var breadcrumbModel = new CommandBreadcrumbViewModel { ActiveTab = activeTab };

    // Filters present in the URL open the filter panels (the default date range is applied by the script)
    var logsHasFilters = Model.StartDate.HasValue || Model.EndDate.HasValue || Model.GuildId.HasValue
        || !string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.CommandName)
        || Model.StatusFilter.HasValue;
    var analyticsHasFilters = Model.StartDate.HasValue || Model.EndDate.HasValue || Model.GuildId.HasValue;

    var commandAutocomplete = new AutocompleteInputViewModel
    {
        Id = "CommandName",
        Name = "CommandName",
        Label = "Command",
        Placeholder = "Command name",
        Endpoint = "/api/autocomplete/commands",
        InitialValue = Model.CommandName,
        InitialDisplayText = Model.CommandDisplayText,
        NoResultsMessage = "No commands found"
    };
}

@functions {
    private static readonly string FunnelPath = "M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-commands-page data-active-tab="@activeTab">
    <partial name="Shared/Components/_CommandBreadcrumb" model="breadcrumbModel" />
    <partial name="Shared/Components/_CommandHeader" model="headerModel" />

    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <span class="text-sm text-text-secondary">
            @Model.ViewModel.ModuleCount @(Model.ViewModel.ModuleCount == 1 ? "module" : "modules") registered
        </span>
        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
        {
            <button type="button" data-open-confirm="clearCommandsModal" class="btn btn-warning">
                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Clear &amp; re-register globally
            </button>
        }
    </div>

    <partial name="Shared/Components/_TabPanel" model="tabPanel" />

    <!-- Tab 1: Command List (rendered here; the Retry-free partial is shared with /api/commands/list) -->
    <div id="commandTabs-panel-command-list" data-tab-panel-for="commandTabs" data-tab-id="command-list" role="tabpanel" aria-labelledby="commandTabs-tab-command-list" @(activeTab == "command-list" ? "" : "hidden")>
        <partial name="Tabs/_CommandListTab" model="Model.ViewModel" />
    </div>

    <!-- Tab 2: Execution Logs -->
    <div id="commandTabs-panel-execution-logs" data-tab-panel-for="commandTabs" data-tab-id="execution-logs" role="tabpanel" aria-labelledby="commandTabs-tab-execution-logs" @(activeTab == "execution-logs" ? "" : "hidden")>
        <details class="group bg-bg-secondary border border-border-primary rounded-lg mb-6" data-filter-panel="execution-logs" @(logsHasFilters ? "open" : "")>
            <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer list-none rounded-lg">
                <span class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@FunnelPath" /></svg>
                    <span class="text-lg font-semibold text-text-primary">Filters</span>
                    <span class="badge badge-orange hidden" data-filter-count></span>
                </span>
                <svg class="w-5 h-5 text-text-secondary transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>

            <div class="border-t border-border-primary p-4 sm:p-6">
                <form method="get" action="@Url.Page("/Commands/Index")" data-commands-filter-form="execution-logs" novalidate>
                    <input type="hidden" name="tab" value="execution-logs" />

                    <div class="mb-4">
                        <p class="block text-sm font-medium text-text-primary mb-2" id="logs-presets-label">Quick date range</p>
                        <div class="flex flex-wrap gap-2" role="group" aria-labelledby="logs-presets-label">
                            <button type="button" data-date-preset="today" aria-pressed="false" class="btn btn-secondary btn-sm">Today</button>
                            <button type="button" data-date-preset="7days" aria-pressed="false" class="btn btn-secondary btn-sm">Last 7 days</button>
                            <button type="button" data-date-preset="30days" aria-pressed="false" class="btn btn-secondary btn-sm">Last 30 days</button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 mb-4">
                        <div>
                            <label for="logs-StartDate" class="block text-sm font-medium text-text-primary mb-1">Start date</label>
                            <input type="date" id="logs-StartDate" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" autocomplete="off" data-range-input aria-describedby="logs-range-error" class="form-input w-full" />
                        </div>
                        <div>
                            <label for="logs-EndDate" class="block text-sm font-medium text-text-primary mb-1">End date</label>
                            <input type="date" id="logs-EndDate" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" autocomplete="off" data-range-input aria-describedby="logs-range-error" class="form-input w-full" />
                        </div>
                        <div>
                            <label for="logs-GuildId" class="block text-sm font-medium text-text-primary mb-1">Server</label>
                            <select id="logs-GuildId" name="GuildId" class="form-select w-full">
                                <option value="">All servers</option>
                                @foreach (var guild in Model.AvailableGuilds)
                                {
                                    <option value="@guild.Id" selected="@(Model.GuildId == guild.Id)">@guild.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <partial name="Shared/Components/_AutocompleteInput" model="commandAutocomplete" />
                        </div>
                        <div>
                            <label for="logs-StatusFilter" class="block text-sm font-medium text-text-primary mb-1">Status</label>
                            <select id="logs-StatusFilter" name="StatusFilter" class="form-select w-full">
                                <option value="">All statuses</option>
                                <option value="true" selected="@(Model.StatusFilter == true)">Success</option>
                                <option value="false" selected="@(Model.StatusFilter == false)">Failure</option>
                            </select>
                        </div>
                    </div>
                    <p id="logs-range-error" class="hidden text-sm text-error mb-4" role="alert" data-range-error></p>

                    <div class="mb-4">
                        <label for="logs-SearchTerm" class="block text-sm font-medium text-text-primary mb-1">Search</label>
                        <input type="search" id="logs-SearchTerm" name="SearchTerm" value="@Model.SearchTerm" autocomplete="off"
                               placeholder="User names, command names, servers"
                               class="form-input w-full" />
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        <button type="submit" class="btn btn-primary">Apply filters</button>
                        <button type="button" data-commands-action="clear-filters" class="btn btn-secondary">Clear filters</button>
                    </div>
                </form>
            </div>
        </details>

        <div data-tab-content tabindex="-1" class="outline-none"></div>
    </div>

    <!-- Tab 3: Analytics -->
    <div id="commandTabs-panel-analytics" data-tab-panel-for="commandTabs" data-tab-id="analytics" role="tabpanel" aria-labelledby="commandTabs-tab-analytics" @(activeTab == "analytics" ? "" : "hidden")>
        <details class="group bg-bg-secondary border border-border-primary rounded-lg mb-6" data-filter-panel="analytics" @(analyticsHasFilters ? "open" : "")>
            <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer list-none rounded-lg">
                <span class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@FunnelPath" /></svg>
                    <span class="text-lg font-semibold text-text-primary">Filters</span>
                    <span class="badge badge-orange hidden" data-filter-count></span>
                </span>
                <svg class="w-5 h-5 text-text-secondary transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>

            <div class="border-t border-border-primary p-4 sm:p-6">
                <form method="get" action="@Url.Page("/Commands/Index")" data-commands-filter-form="analytics" novalidate>
                    <input type="hidden" name="tab" value="analytics" />

                    <div class="mb-4">
                        <p class="block text-sm font-medium text-text-primary mb-2" id="analytics-presets-label">Quick date range</p>
                        <div class="flex flex-wrap gap-2" role="group" aria-labelledby="analytics-presets-label">
                            <button type="button" data-date-preset="today" aria-pressed="false" class="btn btn-secondary btn-sm">Today</button>
                            <button type="button" data-date-preset="7days" aria-pressed="false" class="btn btn-secondary btn-sm">Last 7 days</button>
                            <button type="button" data-date-preset="30days" aria-pressed="false" class="btn btn-secondary btn-sm">Last 30 days</button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
                        <div>
                            <label for="analytics-StartDate" class="block text-sm font-medium text-text-primary mb-1">Start date</label>
                            <input type="date" id="analytics-StartDate" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" autocomplete="off" data-range-input aria-describedby="analytics-range-error analytics-range-hint" class="form-input w-full" />
                        </div>
                        <div>
                            <label for="analytics-EndDate" class="block text-sm font-medium text-text-primary mb-1">End date</label>
                            <input type="date" id="analytics-EndDate" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" autocomplete="off" data-range-input aria-describedby="analytics-range-error analytics-range-hint" class="form-input w-full" />
                        </div>
                        <div>
                            <label for="analytics-GuildId" class="block text-sm font-medium text-text-primary mb-1">Server</label>
                            <select id="analytics-GuildId" name="GuildId" class="form-select w-full">
                                <option value="">All servers</option>
                                @foreach (var guild in Model.AvailableGuilds)
                                {
                                    <option value="@guild.Id" selected="@(Model.GuildId == guild.Id)">@guild.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p id="analytics-range-hint" class="text-xs text-text-secondary mb-4">Leave the dates empty for the last 30 days. The longest range is 90 days.</p>
                    <p id="analytics-range-error" class="hidden text-sm text-error mb-4" role="alert" data-range-error></p>

                    <div class="flex flex-wrap items-center gap-3">
                        <button type="submit" class="btn btn-primary">Apply filters</button>
                        <button type="button" data-commands-action="clear-filters" class="btn btn-secondary">Clear filters</button>
                    </div>
                </form>
            </div>
        </details>

        <div data-tab-content tabindex="-1" class="outline-none"></div>
    </div>
</div>

@if (Model.ClearCommandsModal != null)
{
    <partial name="Shared/Components/_ConfirmationModal" model="Model.ClearCommandsModal" />
}

<partial name="Shared/Components/_CommandLogDetailsModal" />

@section Styles {
    <link rel="stylesheet" href="~/css/tab-panel.css" asp-append-version="true" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/tab-panel.js" asp-append-version="true"></script>
    <script src="~/js/command-tabs.js" asp-append-version="true"></script>
    <script src="~/js/date-range-filter.js" asp-append-version="true"></script>
    <script src="~/js/autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/command-log-modal.js" asp-append-version="true"></script>
    <script src="~/js/commands-charts.js" asp-append-version="true"></script>
    <script src="~/js/commands-page.js" asp-append-version="true"></script>
}

@* AJAX-loaded partial view for the Execution Logs tab (GET /api/commands/logs). *@
@* Swapped into [data-tab-content] by wwwroot/js/commands-page.js, which also handles the *@
@* [data-log-id] buttons, [data-commands-action="clear-filters"] and the pagination links. *@
@model DiscordBot.Bot.ViewModels.Pages.CommandLogListViewModel
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@{
    var paginationBaseUrl = ViewData["PaginationBaseUrl"] as string ?? string.Empty;
    var hasFilters = Model.Filters.HasActiveFilters;

    var paginationModel = new PaginationViewModel
    {
        CurrentPage = Model.CurrentPage,
        TotalPages = Model.TotalPages,
        TotalItems = Model.TotalCount,
        PageSize = Model.PageSize,
        ShowItemCount = true,
        BaseUrl = paginationBaseUrl,
        PageParameterName = "pageNumber",
        AriaLabel = "Execution log pages"
    };
}

@if (!Model.Logs.Any())
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-12">
        <partial name="~/Pages/Shared/Components/_EmptyState.cshtml" model="@(hasFilters
            ? new EmptyStateViewModel
            {
                Type = EmptyStateType.NoResults,
                Title = "No command logs match these filters",
                Description = "Try a wider date range or remove a filter.",
                PrimaryActionText = "Clear filters",
                PrimaryActionIconPath = "",
                PrimaryActionAttributes = new Dictionary<string, string> { ["data-commands-action"] = "clear-filters" },
                Announce = true
            }
            : new EmptyStateViewModel
            {
                Type = EmptyStateType.NoData,
                Title = "No command logs yet",
                Description = "Logs appear here once commands are executed.",
                Announce = true
            })" />
    </div>
}
else
{
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <p class="text-sm text-text-secondary" role="status">
            @DisplayFormat.Plural(Model.TotalCount, "command log") found
        </p>
        @if (hasFilters)
        {
            <button type="button" data-commands-action="clear-filters" class="btn btn-secondary btn-sm">Clear filters</button>
        }
    </div>

    <!-- Desktop table -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden hidden md:block">
        <div class="overflow-x-auto">
            <table class="w-full">
                <caption class="sr-only">Command execution logs, newest first</caption>
                <thead class="bg-bg-tertiary">
                    <tr>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Time</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Command</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider hidden lg:table-cell">Server</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">User</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider hidden xl:table-cell">Duration</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @foreach (var log in Model.Logs)
                    {
                        <tr class="hover:bg-bg-hover/50 transition-colors">
                            <td class="px-6 py-4 text-text-secondary text-sm whitespace-nowrap">
                                @DisplayFormat.Time(log.ExecutedAt, "datetime-seconds")
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-mono text-sm text-accent-blue break-all">/@log.CommandName</span>
                            </td>
                            <td class="px-6 py-4 text-text-secondary text-sm hidden lg:table-cell">
                                @if (log.GuildId.HasValue)
                                {
                                    <span class="preview-trigger" data-preview-type="guild" data-guild-id="@log.GuildId">@log.GuildName</span>
                                }
                                else
                                {
                                    @log.GuildName
                                }
                            </td>
                            <td class="px-6 py-4 text-text-secondary text-sm">
                                <span class="preview-trigger" data-preview-type="user" data-user-id="@log.UserId" data-context-guild-id="@log.GuildId">@log.Username</span>
                            </td>
                            <td class="px-6 py-4 text-text-secondary text-sm hidden xl:table-cell whitespace-nowrap">
                                @(log.ResponseTimeMs) ms
                            </td>
                            <td class="px-6 py-4">
                                <partial name="~/Pages/Shared/Components/_Badge.cshtml" model="@(log.Success
                                    ? new BadgeViewModel { Text = "Success", Variant = BadgeVariant.Success, Size = BadgeSize.Small }
                                    : new BadgeViewModel { Text = "Failed", Variant = BadgeVariant.Error, Size = BadgeSize.Small })" />
                                @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                {
                                    <div class="mt-1 text-xs text-error truncate max-w-xs" title="@log.ErrorMessage">@log.ErrorMessage</div>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button type="button" data-log-id="@log.Id" aria-label="View details of /@log.CommandName"
                                        class="btn btn-secondary btn-sm">View</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile cards -->
    <div class="md:hidden space-y-4">
        @foreach (var log in Model.Logs)
        {
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 space-y-3">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex-1 min-w-0">
                        <span class="font-mono text-sm text-accent-blue break-all">/@log.CommandName</span>
                        <div class="text-xs text-text-secondary mt-1">
                            @DisplayFormat.Time(log.ExecutedAt, "datetime-seconds")
                        </div>
                    </div>
                    <partial name="~/Pages/Shared/Components/_Badge.cshtml" model="@(log.Success
                        ? new BadgeViewModel { Text = "Success", Variant = BadgeVariant.Success, Size = BadgeSize.Small }
                        : new BadgeViewModel { Text = "Failed", Variant = BadgeVariant.Error, Size = BadgeSize.Small })" />
                </div>

                <dl class="text-sm text-text-secondary space-y-1">
                    <div class="flex gap-1.5">
                        <dt class="font-medium text-text-primary">User:</dt>
                        <dd class="min-w-0 break-words"><span class="preview-trigger" data-preview-type="user" data-user-id="@log.UserId" data-context-guild-id="@log.GuildId">@log.Username</span></dd>
                    </div>
                    <div class="flex gap-1.5">
                        <dt class="font-medium text-text-primary">Server:</dt>
                        <dd class="min-w-0 break-words">
                            @if (log.GuildId.HasValue)
                            {
                                <span class="preview-trigger" data-preview-type="guild" data-guild-id="@log.GuildId">@log.GuildName</span>
                            }
                            else
                            {
                                @log.GuildName
                            }
                        </dd>
                    </div>
                    <div class="flex gap-1.5">
                        <dt class="font-medium text-text-primary">Duration:</dt>
                        <dd>@(log.ResponseTimeMs) ms</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrEmpty(log.ErrorMessage))
                {
                    <div class="text-xs text-error bg-error/10 border border-error/20 rounded px-2 py-1.5 break-words">@log.ErrorMessage</div>
                }

                <button type="button" data-log-id="@log.Id" aria-label="View details of /@log.CommandName"
                        class="btn btn-secondary btn-sm">View details</button>
            </div>
        }
    </div>

    <div class="mt-6" data-commands-pagination>
        <partial name="~/Pages/Shared/Components/_Pagination.cshtml" model="paginationModel" />
    </div>
}

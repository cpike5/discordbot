@* AJAX-loaded partial view for the Analytics tab (GET /api/commands/analytics). *@
@* The chart data rides in the JSON island below; wwwroot/js/commands-charts.js draws it. *@
@model DiscordBot.Bot.ViewModels.Pages.CommandAnalyticsViewModel
@using System.Text.Json
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@{
    var hasData = Model.TotalCommands > 0;
    var hasFilters = ViewData["HasActiveFilters"] as bool? ?? false;

    // Success rate: a colour is a hint, the number and the word carry the meaning
    var rateTone = Model.SuccessRate >= 95 ? "success" : Model.SuccessRate >= 80 ? "warning" : "error";
    var rateWord = Model.SuccessRate >= 95 ? "Healthy" : Model.SuccessRate >= 80 ? "Needs attention" : "Failing";

    var chartData = JsonSerializer.Serialize(new
    {
        usageOverTime = Model.UsageOverTime.Select(d => new { date = d.Date.ToString("yyyy-MM-dd"), count = d.Count }),
        topCommands = Model.TopCommands.Select(kv => new { name = kv.Key, count = kv.Value }),
        successCount = Model.SuccessRateData.SuccessCount,
        failureCount = Model.SuccessRateData.FailureCount,
        performance = Model.PerformanceData.Select(p => new { name = p.CommandName, avgMs = p.AvgResponseTimeMs })
    }, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<p class="text-sm text-text-secondary mb-4" data-analytics-range>
    @* Calendar dates the viewer picked, not instants: no time-zone conversion *@
    @Model.StartDate.ToString("MMM d, yyyy") to @Model.EndDate.ToString("MMM d, yyyy")@(Model.GuildId.HasValue ? ", one server" : ", all servers")
</p>

@if (!hasData)
{
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-12">
        <partial name="~/Pages/Shared/Components/_EmptyState.cshtml" model="@(hasFilters
            ? new EmptyStateViewModel
            {
                Type = EmptyStateType.NoResults,
                Title = "No commands ran in this range",
                Description = "Try a wider date range or a different server.",
                PrimaryActionText = "Clear filters",
                PrimaryActionIconPath = "",
                PrimaryActionAttributes = new Dictionary<string, string> { ["data-commands-action"] = "clear-filters" },
                Announce = true
            }
            : new EmptyStateViewModel
            {
                Type = EmptyStateType.NoData,
                Title = "No analytics yet",
                Description = "Usage statistics appear here once commands are executed.",
                Announce = true
            })" />
    </div>
}
else
{
    <!-- Summary stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 mb-8">
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <p class="text-sm font-medium text-text-secondary">Total commands</p>
            <p class="mt-2 text-3xl font-display font-semibold text-text-primary">@DisplayFormat.Number(Model.TotalCommands)</p>
        </div>

        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <p class="text-sm font-medium text-text-secondary">Success rate</p>
            <p class="mt-2 text-3xl font-display font-semibold text-@rateTone">@DisplayFormat.Number(Math.Round((double)Model.SuccessRate, 1), 1)%</p>
            <p class="mt-1 text-xs text-text-secondary">@rateWord</p>
        </div>

        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <p class="text-sm font-medium text-text-secondary">Average response time</p>
            <p class="mt-2 text-3xl font-display font-semibold text-text-primary">@DisplayFormat.Number(Math.Round(Model.AvgResponseTimeMs)) <span class="text-lg text-text-secondary">ms</span></p>
            <p class="mt-1 text-xs text-text-secondary">Across the 10 busiest commands</p>
        </div>

        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <p class="text-sm font-medium text-text-secondary">Distinct commands</p>
            <p class="mt-2 text-3xl font-display font-semibold text-text-primary">@Model.UniqueCommands@(Model.UniqueCommands >= 10 ? "+" : "")</p>
            <p class="mt-1 text-xs text-text-secondary">Counts up to the top 10</p>
        </div>
    </div>

    <!-- Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6" data-commands-charts>
        <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" aria-labelledby="chart-usage-title">
            <div class="px-5 py-4 border-b border-border-primary">
                <h2 id="chart-usage-title" class="text-lg font-semibold text-text-primary">Usage over time</h2>
            </div>
            <div class="p-5">
                @if (Model.UsageOverTime.Any())
                {
                    <div class="relative h-72">
                        <canvas data-chart="usage" role="img" aria-label="Line chart of commands executed per day"></canvas>
                    </div>
                }
                else
                {
                    <partial name="~/Pages/Shared/Components/_EmptyState.cshtml" model="@(new EmptyStateViewModel { Type = EmptyStateType.NoData, Title = "No usage data", Description = "Daily counts appear once commands run.", Size = EmptyStateSize.Compact })" />
                }
            </div>
        </section>

        <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" aria-labelledby="chart-top-title">
            <div class="px-5 py-4 border-b border-border-primary">
                <h2 id="chart-top-title" class="text-lg font-semibold text-text-primary">Top commands</h2>
            </div>
            <div class="p-5">
                @if (Model.TopCommands.Any())
                {
                    <div class="relative h-72">
                        <canvas data-chart="top" role="img" aria-label="Bar chart of the most used commands"></canvas>
                    </div>
                }
                else
                {
                    <partial name="~/Pages/Shared/Components/_EmptyState.cshtml" model="@(new EmptyStateViewModel { Type = EmptyStateType.NoData, Title = "No command data", Description = "The busiest commands appear here.", Size = EmptyStateSize.Compact })" />
                }
            </div>
        </section>

        <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" aria-labelledby="chart-success-title">
            <div class="px-5 py-4 border-b border-border-primary">
                <h2 id="chart-success-title" class="text-lg font-semibold text-text-primary">Success and failure</h2>
            </div>
            <div class="p-5">
                @if (Model.SuccessRateData.SuccessCount + Model.SuccessRateData.FailureCount > 0)
                {
                    <div class="relative h-72">
                        <canvas data-chart="success" role="img" aria-label="Doughnut chart of successful against failed commands"></canvas>
                    </div>
                }
                else
                {
                    <partial name="~/Pages/Shared/Components/_EmptyState.cshtml" model="@(new EmptyStateViewModel { Type = EmptyStateType.NoData, Title = "No data", Description = "The split appears once commands run.", Size = EmptyStateSize.Compact })" />
                }
            </div>
        </section>

        <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" aria-labelledby="chart-response-title">
            <div class="px-5 py-4 border-b border-border-primary">
                <h2 id="chart-response-title" class="text-lg font-semibold text-text-primary">Response time by command</h2>
            </div>
            <div class="p-5">
                @if (Model.PerformanceData.Any())
                {
                    <div class="relative h-72">
                        <canvas data-chart="response" role="img" aria-label="Bar chart of average response time per command"></canvas>
                    </div>
                }
                else
                {
                    <partial name="~/Pages/Shared/Components/_EmptyState.cshtml" model="@(new EmptyStateViewModel { Type = EmptyStateType.NoData, Title = "No timing data", Description = "Average times appear once commands run.", Size = EmptyStateSize.Compact })" />
                }
            </div>
        </section>
    </div>

    <script type="application/json" data-commands-chart-data>@Html.Raw(chartData)</script>
}

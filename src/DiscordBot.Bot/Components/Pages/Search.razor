@page "/Search"
@attribute [Authorize(Policy = "RequireViewer")]
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Pages
@using DiscordBot.Core.DTOs
@using DiscordBot.Core.Interfaces
@inject ISearchService SearchService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<Search> Logger

<PageTitle>Search Results - Discord Bot Admin</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="flex flex-col gap-6 mb-6">
        <!-- Header with Icon -->
        <div class="flex items-center gap-3">
            <div class="p-3 bg-bg-secondary border border-border-primary rounded-lg">
                <svg class="w-6 h-6 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl lg:text-3xl font-bold text-text-primary">Search Results</h1>
                @if (!string.IsNullOrWhiteSpace(_viewModel.SearchTerm) && _viewModel.HasResults)
                {
                    <p class="mt-1 text-text-secondary">
                        @{
                            var totalResults = _viewModel.GuildResults.Count +
                                             _viewModel.CommandLogResults.Count +
                                             _viewModel.UserResults.Count +
                                             _viewModel.Commands.Count +
                                             _viewModel.AuditLogs.Count +
                                             _viewModel.MessageLogs.Count +
                                             _viewModel.Pages.Count +
                                             _viewModel.Reminders.Count +
                                             _viewModel.ScheduledMessages.Count;
                        }
                        Found @totalResults result@(totalResults != 1 ? "s" : "") for <span class="font-semibold text-text-primary">"@_viewModel.SearchTerm"</span>
                    </p>
                }
            </div>
        </div>

        <!-- Search Input -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
            <form @onsubmit="ExecuteSearch" class="flex flex-col sm:flex-row gap-3">
                <div class="flex-1">
                    <label for="SearchTerm" class="sr-only">Search</label>
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="search"
                               id="SearchTerm"
                               @bind="_searchInput"
                               placeholder="Search servers, commands, logs, or users..."
                               class="w-full pl-10 pr-4 py-2.5 text-sm bg-bg-primary border border-border-primary rounded-lg text-text-primary placeholder-text-tertiary focus:border-border-focus focus:ring-1 focus:ring-border-focus transition-colors"
                               autofocus />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <svg class="animate-spin w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    }
                    else
                    {
                        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    }
                    Search
                </button>
            </form>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-12">
            <LoadingSpinner Message="Searching..." />
        </div>
    }
    else if (string.IsNullOrWhiteSpace(_viewModel.SearchTerm))
    {
        <!-- Empty State: No Search Term -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-12">
            <EmptyState Type="EmptyStateType.NoResults"
                        Title="Start searching"
                        Description="Enter a search term above to find servers, command logs, or users."
                        Size="EmptyStateSize.Default" />
        </div>
    }
    else if (!string.IsNullOrEmpty(_viewModel.ValidationMessage))
    {
        <!-- Validation Message -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-12">
            <EmptyState Type="EmptyStateType.NoResults"
                        Title="Search term too short"
                        Description="@_viewModel.ValidationMessage"
                        Size="EmptyStateSize.Default" />
        </div>
    }
    else if (!_viewModel.HasResults)
    {
        <!-- Empty State: No Results Found -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-12">
            <EmptyState Type="EmptyStateType.NoResults"
                        Title="No results found"
                        Description="@($"No servers, command logs, or users match \"{_viewModel.SearchTerm}\". Try a different search term.")"
                        Size="EmptyStateSize.Default" />
        </div>
    }
    else
    {
        <!-- Results Sections -->
        <div class="space-y-6">
            <!-- Servers Section -->
            @if (_viewModel.GuildResults.Any())
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                    <!-- Section Header -->
                    <div class="px-6 py-4 border-b border-border-primary bg-bg-tertiary">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                                <h2 class="text-lg font-semibold text-text-primary">Servers</h2>
                                <Badge Text="@_viewModel.GuildResults.Count.ToString()" Variant="BadgeVariant.Default" Size="BadgeSize.Small" />
                            </div>
                            @if (_viewModel.TotalGuildResults > _viewModel.GuildResults.Count)
                            {
                                <a href="/Guilds?SearchTerm=@Uri.EscapeDataString(_viewModel.SearchTerm)" class="text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors">
                                    View all @_viewModel.TotalGuildResults results &rarr;
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Server Results Grid -->
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var guild in _viewModel.GuildResults)
                            {
                                <a href="/Guilds/Details/@guild.Id" class="block bg-bg-primary border border-border-primary rounded-lg p-4 hover:border-accent-blue hover:bg-bg-hover transition-all">
                                    <div class="flex items-start gap-3">
                                        @if (!string.IsNullOrEmpty(guild.IconUrl))
                                        {
                                            <img src="@guild.IconUrl" alt="@guild.Name" class="w-12 h-12 rounded-full flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-accent-blue to-accent-orange flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                                                @(guild.Name.Length >= 2 ? guild.Name[..2].ToUpper() : guild.Name.ToUpper())
                                            </div>
                                        }
                                        <div class="flex-1 min-w-0">
                                            <h3 class="font-semibold text-text-primary truncate">@guild.Name</h3>
                                            <div class="flex items-center gap-3 mt-1 text-xs text-text-secondary">
                                                @if (guild.MemberCount.HasValue)
                                                {
                                                    <span class="flex items-center gap-1">
                                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                                        </svg>
                                                        @guild.MemberCount.Value.ToString("N0") members
                                                    </span>
                                                }
                                                <StatusIndicator Status="@(guild.IsActive ? StatusType.Online : StatusType.Offline)"
                                                                 Text="@(guild.IsActive ? "Active" : "Inactive")"
                                                                 DisplayStyle="StatusDisplayStyle.DotWithText"
                                                                 Size="StatusSize.Small" />
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Command Logs Section -->
            @if (_viewModel.CommandLogResults.Any())
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                    <!-- Section Header -->
                    <div class="px-6 py-4 border-b border-border-primary bg-bg-tertiary">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                <h2 class="text-lg font-semibold text-text-primary">Command Logs</h2>
                                <Badge Text="@_viewModel.CommandLogResults.Count.ToString()" Variant="BadgeVariant.Default" Size="BadgeSize.Small" />
                            </div>
                            @if (_viewModel.TotalCommandLogResults > _viewModel.CommandLogResults.Count)
                            {
                                <a href="/Commands?tab=logs&SearchTerm=@Uri.EscapeDataString(_viewModel.SearchTerm)" class="text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors">
                                    View all @_viewModel.TotalCommandLogResults results &rarr;
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Command Log Results List -->
                    <div class="divide-y divide-border-primary">
                        @foreach (var log in _viewModel.CommandLogResults)
                        {
                            <a href="/CommandLogs/Details/@log.Id" class="block px-6 py-4 hover:bg-bg-hover transition-colors">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-3 flex-wrap">
                                            <span class="font-mono text-sm font-semibold text-accent-blue">/@log.CommandName</span>
                                            <Badge Text="@(log.Success ? "Success" : "Failed")"
                                                   Variant="@(log.Success ? BadgeVariant.Success : BadgeVariant.Error)"
                                                   Size="BadgeSize.Small" />
                                        </div>
                                        <div class="flex items-center gap-4 mt-1 text-xs text-text-secondary flex-wrap">
                                            @if (!string.IsNullOrEmpty(log.GuildName))
                                            {
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                                    </svg>
                                                    @log.GuildName
                                                </span>
                                            }
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                                @log.UserIdentifier
                                            </span>
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                <span data-utc="@log.ExecutedAtUtcIso" data-format="datetime-short"></span>
                                            </span>
                                        </div>
                                    </div>
                                    <svg class="w-5 h-5 text-text-tertiary flex-shrink-0 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Users Section (Admin+ only) -->
            @if (_viewModel.CanViewUsers && _viewModel.UserResults.Any())
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                    <!-- Section Header -->
                    <div class="px-6 py-4 border-b border-border-primary bg-bg-tertiary">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <h2 class="text-lg font-semibold text-text-primary">Users</h2>
                                <Badge Text="@_viewModel.UserResults.Count.ToString()" Variant="BadgeVariant.Default" Size="BadgeSize.Small" />
                            </div>
                            @if (_viewModel.TotalUserResults > _viewModel.UserResults.Count)
                            {
                                <a href="/Admin/Users?SearchTerm=@Uri.EscapeDataString(_viewModel.SearchTerm)" class="text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors">
                                    View all @_viewModel.TotalUserResults results &rarr;
                                </a>
                            }
                        </div>
                    </div>

                    <!-- User Results Grid -->
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var user in _viewModel.UserResults)
                            {
                                <a href="/Admin/Users/Details/@user.Id" class="block bg-bg-primary border border-border-primary rounded-lg p-4 hover:border-accent-blue hover:bg-bg-hover transition-all">
                                    <div class="flex items-start gap-3">
                                        @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                        {
                                            <img src="@user.AvatarUrl" alt="@(user.DisplayName ?? user.Email)" class="w-12 h-12 rounded-full flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-accent-blue to-accent-orange flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                                                @{
                                                    var initials = !string.IsNullOrEmpty(user.DisplayName)
                                                        ? (user.DisplayName.Length >= 2 ? user.DisplayName[..2].ToUpper() : user.DisplayName.ToUpper())
                                                        : user.Email[0].ToString().ToUpper();
                                                }
                                                @initials
                                            </div>
                                        }
                                        <div class="flex-1 min-w-0">
                                            <h3 class="font-semibold text-text-primary truncate">@(user.DisplayName ?? user.Email)</h3>
                                            <p class="text-xs text-text-tertiary truncate mt-0.5">@user.Email</p>
                                            <div class="flex items-center gap-2 mt-2">
                                                @{
                                                    var roleBadgeVariant = user.Role switch
                                                    {
                                                        "SuperAdmin" => BadgeVariant.Orange,
                                                        "Admin" => BadgeVariant.Blue,
                                                        "Moderator" => BadgeVariant.Success,
                                                        _ => BadgeVariant.Default
                                                    };
                                                }
                                                <Badge Text="@user.Role" Variant="@roleBadgeVariant" Size="BadgeSize.Small" />
                                                @if (!user.IsActive)
                                                {
                                                    <Badge Text="Inactive" Variant="BadgeVariant.Default" Size="BadgeSize.Small" />
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Commands Section -->
            @if (_viewModel.Commands.Any())
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                    <!-- Section Header -->
                    <div class="px-6 py-4 border-b border-border-primary bg-bg-tertiary">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <h2 class="text-lg font-semibold text-text-primary">Commands</h2>
                                <Badge Text="@_viewModel.Commands.Count.ToString()" Variant="BadgeVariant.Default" Size="BadgeSize.Small" />
                            </div>
                            @if (_viewModel.TotalCommands > _viewModel.Commands.Count && !string.IsNullOrEmpty(_viewModel.CommandsViewAllUrl))
                            {
                                <a href="@_viewModel.CommandsViewAllUrl" class="text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors">
                                    View all @_viewModel.TotalCommands results &rarr;
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Command Results List -->
                    <div class="divide-y divide-border-primary">
                        @foreach (var cmd in _viewModel.Commands)
                        {
                            <a href="@cmd.Url" class="block px-6 py-4 hover:bg-bg-hover transition-colors">
                                <div class="flex flex-col gap-2">
                                    <div class="flex items-center gap-3 flex-wrap">
                                        <span class="font-mono text-sm font-semibold text-accent-blue">@cmd.Title</span>
                                        @if (!string.IsNullOrEmpty(cmd.BadgeText))
                                        {
                                            <Badge Text="@cmd.BadgeText" Variant="BadgeVariant.Blue" Size="BadgeSize.Small" />
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(cmd.Description))
                                    {
                                        <p class="text-sm text-text-secondary"><SearchHighlight Text="@cmd.Description" SearchTerm="@_viewModel.SearchTerm" MaxLength="100" /></p>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Pages Section -->
            @if (_viewModel.Pages.Any())
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                    <!-- Section Header -->
                    <div class="px-6 py-4 border-b border-border-primary bg-bg-tertiary">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                <h2 class="text-lg font-semibold text-text-primary">Pages</h2>
                                <Badge Text="@_viewModel.Pages.Count.ToString()" Variant="BadgeVariant.Default" Size="BadgeSize.Small" />
                            </div>
                            @if (_viewModel.TotalPages > _viewModel.Pages.Count && !string.IsNullOrEmpty(_viewModel.PagesViewAllUrl))
                            {
                                <a href="@_viewModel.PagesViewAllUrl" class="text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors">
                                    View all @_viewModel.TotalPages results &rarr;
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Page Results List -->
                    <div class="divide-y divide-border-primary">
                        @foreach (var pageItem in _viewModel.Pages)
                        {
                            <a href="@pageItem.Url" class="block px-6 py-4 hover:bg-bg-hover transition-colors">
                                <div class="flex items-center justify-between gap-4">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-3 flex-wrap">
                                            <h3 class="font-semibold text-text-primary"><SearchHighlight Text="@pageItem.Title" SearchTerm="@_viewModel.SearchTerm" /></h3>
                                            @if (!string.IsNullOrEmpty(pageItem.BadgeText))
                                            {
                                                <Badge Text="@pageItem.BadgeText" Variant="@ParseBadgeVariant(pageItem.BadgeVariant)" Size="BadgeSize.Small" />
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(pageItem.Description))
                                        {
                                            <p class="text-sm text-text-secondary mt-1"><SearchHighlight Text="@pageItem.Description" SearchTerm="@_viewModel.SearchTerm" MaxLength="100" /></p>
                                        }
                                    </div>
                                    <svg class="w-5 h-5 text-text-tertiary flex-shrink-0 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Audit Logs Section (Admin+ only) -->
            @if (_viewModel.CanViewUsers && _viewModel.AuditLogs.Any())
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                    <!-- Section Header -->
                    <div class="px-6 py-4 border-b border-border-primary bg-bg-tertiary">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                <h2 class="text-lg font-semibold text-text-primary">Audit Logs</h2>
                                <Badge Text="@_viewModel.AuditLogs.Count.ToString()" Variant="BadgeVariant.Default" Size="BadgeSize.Small" />
                            </div>
                            @if (_viewModel.TotalAuditLogs > _viewModel.AuditLogs.Count && !string.IsNullOrEmpty(_viewModel.AuditLogsViewAllUrl))
                            {
                                <a href="@_viewModel.AuditLogsViewAllUrl" class="text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors">
                                    View all @_viewModel.TotalAuditLogs results &rarr;
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Audit Log Results List -->
                    <div class="divide-y divide-border-primary">
                        @foreach (var log in _viewModel.AuditLogs)
                        {
                            <a href="@log.Url" class="block px-6 py-4 hover:bg-bg-hover transition-colors">
                                <div class="flex flex-col gap-2">
                                    <div class="flex items-center gap-3 flex-wrap">
                                        <span class="font-semibold text-text-primary"><SearchHighlight Text="@log.Title" SearchTerm="@_viewModel.SearchTerm" /></span>
                                        @if (!string.IsNullOrEmpty(log.BadgeText))
                                        {
                                            <Badge Text="@log.BadgeText" Variant="@ParseBadgeVariant(log.BadgeVariant)" Size="BadgeSize.Small" />
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.Subtitle))
                                    {

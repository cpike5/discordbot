@page "/blazor-test"
@attribute [Authorize(Policy = "RequireAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<DiscordBot.Infrastructure.Data.BotDbContext> DbFactory

<PageTitle>Blazor Test Page</PageTitle>

<div class="max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold text-content-primary mb-4">Blazor Test Page</h1>

    <div class="bg-surface-card rounded-lg border border-border-primary p-6 space-y-4">
        <div>
            <span class="text-content-secondary text-sm">Authenticated User:</span>
            <p class="text-content-primary font-medium">@_username</p>
        </div>

        <div>
            <span class="text-content-secondary text-sm">Guild Count:</span>
            <p class="text-content-primary font-medium">@_guildCount</p>
        </div>

        <div>
            <span class="text-content-secondary text-sm">Render Mode:</span>
            <p class="text-content-primary font-medium">Interactive Server</p>
        </div>

        <div class="pt-4 border-t border-border-primary">
            <p class="text-xs text-content-tertiary">
                This is a temporary verification page for Phase 1 Blazor Foundation.
                If you can see this with proper styling, Blazor Server is working correctly.
            </p>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private string _username = "Loading...";
    private int _guildCount;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateTask;
        _username = state.User.Identity?.Name ?? "Unknown";

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        _guildCount = await dbContext.Guilds.CountAsync();
    }
}

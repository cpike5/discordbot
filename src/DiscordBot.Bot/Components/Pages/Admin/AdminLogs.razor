    private async Task ExportAuditCsvAsync()
    {
        _isExporting = true;
        try
        {
            ulong? guildId = null;
            if (!string.IsNullOrWhiteSpace(_auditFilters.GuildIdInput) && ulong.TryParse(_auditFilters.GuildIdInput, out var parsedGuildId))
            {
                guildId = parsedGuildId;
            }

            AuditLogCategory? category = null;
            if (!string.IsNullOrEmpty(_auditFilters.Category) && Enum.TryParse<AuditLogCategory>(_auditFilters.Category, out var parsedCategory))
            {
                category = parsedCategory;
            }

            AuditLogAction? action = null;
            if (!string.IsNullOrEmpty(_auditFilters.Action) && Enum.TryParse<AuditLogAction>(_auditFilters.Action, out var parsedAction))
            {
                action = parsedAction;
            }

            var query = new AuditLogQueryDto
            {
                Category = category,
                Action = action,
                ActorId = _auditFilters.ActorId,
                TargetType = string.IsNullOrWhiteSpace(_auditFilters.TargetType) ? null : _auditFilters.TargetType,
                GuildId = guildId,
                StartDate = _auditFilters.StartDate,
                EndDate = _auditFilters.EndDate?.Date.AddDays(1).AddTicks(-1),
                SearchTerm = _auditFilters.SearchTerm,
                Page = 1,
                PageSize = int.MaxValue
            };

            Logger.LogInformation("Exporting audit logs with current filters");
            var (items, totalCount) = await AuditLogService.GetLogsAsync(query);

            Logger.LogInformation("Exporting {Count} audit log entries to CSV", totalCount);

            // Build CSV content
            var csv = new StringBuilder();
            csv.AppendLine("Timestamp,Category,Action,Actor,Target Type,Target ID,Guild,Details,IP Address,Correlation ID");

            foreach (var log in items)
            {
                csv.AppendLine($"\"{log.Timestamp:yyyy-MM-dd HH:mm:ss}\"," +
                    $"\"{EscapeCsv(log.CategoryName)}\"," +
                    $"\"{EscapeCsv(log.ActionName)}\"," +
                    $"\"{EscapeCsv(log.ActorDisplayName ?? log.ActorId ?? string.Empty)}\"," +
                    $"\"{EscapeCsv(log.TargetType ?? string.Empty)}\"," +
                    $"\"{EscapeCsv(log.TargetId ?? string.Empty)}\"," +
                    $"\"{EscapeCsv(log.GuildName ?? string.Empty)}\"," +
                    $"\"{EscapeCsv(log.Details ?? string.Empty)}\"," +
                    $"\"{EscapeCsv(log.IpAddress ?? string.Empty)}\"," +
                    $"\"{EscapeCsv(log.CorrelationId ?? string.Empty)}\"");
            }

            // Trigger download via JS interop
            var fileName = $"audit-logs-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
            var csvBytes = Encoding.UTF8.GetBytes(csv.ToString());
            var base64 = Convert.ToBase64String(csvBytes);
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var a = document.createElement('a');
                    a.href = 'data:text/csv;base64,{base64}';
                    a.download = '{fileName}';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }})();
            ");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting audit logs to CSV");
            _errorMessage = "An error occurred while exporting audit logs. Please try again.";
        }
        finally
        {
            _isExporting = false;
        }
    }


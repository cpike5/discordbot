@code {
    // Tab state
    private string _activeTab = "messages";
    private bool _isLoading = true;
    private string? _errorMessage;

    // Message logs state
    private MessageFilterModel _messageFilters = new();
    private PaginatedResponseDto<MessageLogDto>? _messageResult;

    // Audit logs state
    private AuditFilterModel _auditFilters = new();
    private IReadOnlyList<AuditLogDto> _auditLogs = Array.Empty<AuditLogDto>();
    private IReadOnlyList<AuditLogListItem> _auditListItems = Array.Empty<AuditLogListItem>();
    private int _auditCurrentPage = 1;
    private int _auditTotalCount;
    private int _auditTotalPages;
    private bool _showAuditFilters = true;
    private bool _isExporting;
    private IReadOnlyList<GuildDto> _availableGuilds = Array.Empty<GuildDto>();

    // Expandable row state
    private readonly HashSet<long> _expandedRows = new();
    private readonly HashSet<long> _expandedJson = new();

    protected override async Task OnInitializedAsync()
    {
        // Set default date ranges
        _messageFilters.StartDate = DateTime.UtcNow.Date.AddDays(-7);
        _messageFilters.EndDate = DateTime.UtcNow.Date.AddDays(1);

        _auditFilters.StartDate = DateTime.UtcNow.Date.AddDays(-30);
        _auditFilters.EndDate = DateTime.UtcNow.Date.AddDays(1);

        await LoadTabDataAsync();
    }

    private async Task SwitchTabAsync(string tab)
    {
        if (_activeTab == tab) return;
        _activeTab = tab;
        _isLoading = true;
        _errorMessage = null;
        await LoadTabDataAsync();
    }

    private async Task LoadTabDataAsync()
    {
        _isLoading = true;
        try
        {
            if (_activeTab == "messages")
            {
                await LoadMessageLogsAsync();
            }
            else if (_activeTab == "audit")
            {
                await LoadAuditLogsAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading {Tab} logs", _activeTab);
            _errorMessage = "An error occurred while loading logs. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMessageLogsAsync()
    {
        MessageSource? sourceFilter = null;
        if (!string.IsNullOrEmpty(_messageFilters.Source))
        {
            if (Enum.TryParse<MessageSource>(_messageFilters.Source, true, out var parsedSource))
            {
                sourceFilter = parsedSource;
            }
        }

        ulong? authorId = null;
        if (!string.IsNullOrWhiteSpace(_messageFilters.AuthorIdInput) && ulong.TryParse(_messageFilters.AuthorIdInput, out var parsedAuthorId))
        {
            authorId = parsedAuthorId;
        }

        ulong? guildId = null;
        if (!string.IsNullOrWhiteSpace(_messageFilters.GuildIdInput) && ulong.TryParse(_messageFilters.GuildIdInput, out var parsedGuildId))
        {
            guildId = parsedGuildId;
        }

        ulong? channelId = null;
        if (!string.IsNullOrWhiteSpace(_messageFilters.ChannelIdInput) && ulong.TryParse(_messageFilters.ChannelIdInput, out var parsedChannelId))
        {
            channelId = parsedChannelId;
        }

        var query = new MessageLogQueryDto
        {
            AuthorId = authorId,
            GuildId = guildId,
            ChannelId = channelId,
            Source = sourceFilter,
            StartDate = _messageFilters.StartDate,
            EndDate = _messageFilters.EndDate,
            SearchTerm = _messageFilters.SearchTerm,
            Page = _messageFilters.CurrentPage,
            PageSize = 25
        };

        Logger.LogDebug("Loading message logs with filters: AuthorId={AuthorId}, GuildId={GuildId}, ChannelId={ChannelId}, Source={Source}, Page={Page}",
            authorId, guildId, channelId, sourceFilter, _messageFilters.CurrentPage);

        _messageResult = await MessageLogService.GetLogsAsync(query);

        Logger.LogInformation("Retrieved {Count} message logs (page {Page} of {TotalPages})",
            _messageResult.Items.Count, _messageResult.Page, _messageResult.TotalPages);
    }


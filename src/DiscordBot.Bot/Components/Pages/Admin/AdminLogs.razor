@page "/Admin/Logs"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "RequireAdmin")]

@using System.Text
@using DiscordBot.Core.DTOs
@using DiscordBot.Core.Enums
@using DiscordBot.Core.Interfaces
@using DiscordBot.Bot.ViewModels.Pages
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@inject IMessageLogService MessageLogService
@inject IAuditLogService AuditLogService
@inject IGuildService GuildService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<AdminLogs> Logger

<PageTitle>Logs</PageTitle>

<!-- Page Header -->
<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl lg:text-3xl font-bold text-text-primary">Logs</h1>
        <p class="text-text-secondary mt-1">View message logs, audit logs, and application logs</p>
    </div>
</div>

<!-- Tab Navigation -->
<div class="mb-6">
    <div class="border-b border-border-primary" role="tablist" aria-label="Log types">
        <nav class="flex -mb-px space-x-6">
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeTab == "messages")"
                    aria-controls="panel-messages"
                    class="@GetTabClass("messages") whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm transition-colors flex items-center gap-2"
                    @onclick="@(() => SwitchTabAsync("messages"))">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
                Messages
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeTab == "audit")"
                    aria-controls="panel-audit"
                    class="@GetTabClass("audit") whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm transition-colors flex items-center gap-2"
                    @onclick="@(() => SwitchTabAsync("audit"))">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Audit
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="false"
                    aria-disabled="true"
                    disabled
                    class="whitespace-nowrap py-3 px-1 border-b-2 border-transparent font-medium text-sm text-text-tertiary cursor-not-allowed flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="hidden sm:inline">Application</span>
                <span class="sm:hidden">App</span>
            </button>
        </nav>
    </div>
</div>

<!-- Error Alert -->
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="mb-6 rounded-lg border border-error/30 bg-error/10 p-4 flex items-start gap-3" role="alert">
        <svg class="w-5 h-5 text-error flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="flex-1">
            <p class="text-sm text-error">@_errorMessage</p>
        </div>
        <button type="button" class="text-error/70 hover:text-error transition-colors" @onclick="() => _errorMessage = null">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>
}

<!-- Tab Panels -->
@if (_activeTab == "messages")
{
    <div id="panel-messages" role="tabpanel" aria-labelledby="tab-messages">
        @if (_isLoading)
        {
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent-blue"></div>
                <span class="ml-3 text-text-secondary">Loading message logs...</span>
            </div>
        }
        else
        {
            <div class="max-w-7xl mx-auto">
                <!-- Header -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-semibold text-text-primary">Message Logs</h2>
                        <p class="mt-1 text-sm text-text-secondary">View and search logged Discord messages</p>
                    </div>
                </div>

                <!-- Filters Section -->
                <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-semibold text-text-primary">Filters</h3>
                    </div>

                    <form @onsubmit="ApplyMessageFiltersAsync" @onsubmit:preventDefault>
                        <div class="space-y-4">
                            <!-- Row 1: User ID, Guild, Search -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label for="msgAuthorId" class="block text-sm font-medium text-text-primary mb-1">Author ID</label>
                                    <input type="text" id="msgAuthorId" @bind="_messageFilters.AuthorIdInput"
                                           placeholder="Discord user ID..."
                                           class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent" />
                                </div>
                                <div>
                                    <label for="msgGuildId" class="block text-sm font-medium text-text-primary mb-1">Guild ID</label>
                                    <input type="text" id="msgGuildId" @bind="_messageFilters.GuildIdInput"
                                           placeholder="Discord guild ID..."
                                           class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent" />
                                </div>
                                <div>
                                    <label for="msgChannelId" class="block text-sm font-medium text-text-primary mb-1">Channel ID</label>
                                    <input type="text" id="msgChannelId" @bind="_messageFilters.ChannelIdInput"
                                           placeholder="Discord channel ID..."
                                           class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent" />
                                </div>
                            </div>

                            <!-- Row 2: Date Range -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="msgStartDate" class="block text-sm font-medium text-text-primary mb-1">From Date</label>
                                    <input type="date" id="msgStartDate" @bind="_messageFilters.StartDate" @bind:format="yyyy-MM-dd"
                                           class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent" />
                                </div>
                                <div>
                                    <label for="msgEndDate" class="block text-sm font-medium text-text-primary mb-1">To Date</label>
                                    <input type="date" id="msgEndDate" @bind="_messageFilters.EndDate" @bind:format="yyyy-MM-dd"
                                           class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent" />
                                </div>
                            </div>

                            <!-- Row 3: Source Type -->
                            <div>
                                <label class="block text-sm font-medium text-text-primary mb-2">Source Type</label>
                                <div class="flex flex-wrap items-center gap-4">
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="radio" name="msgSource" checked="@(string.IsNullOrEmpty(_messageFilters.Source))"
                                               @onchange="@(() => _messageFilters.Source = "")" class="w-4 h-4" />
                                        <span class="text-sm text-text-primary">All</span>
                                    </label>
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="radio" name="msgSource" checked="@(_messageFilters.Source == "DirectMessage")"
                                               @onchange="@(() => _messageFilters.Source = "DirectMessage")" class="w-4 h-4" />
                                        <span class="text-sm text-text-primary">DMs Only</span>
                                    </label>
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="radio" name="msgSource" checked="@(_messageFilters.Source == "ServerChannel")"
                                               @onchange="@(() => _messageFilters.Source = "ServerChannel")" class="w-4 h-4" />
                                        <span class="text-sm text-text-primary">Server Only</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Row 4: Content Search -->
                            <div>
                                <label for="msgSearchTerm" class="block text-sm font-medium text-text-primary mb-1">Content Search</label>
                                <input type="text" id="msgSearchTerm" @bind="_messageFilters.SearchTerm"
                                       placeholder="Search message content..."
                                       class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md placeholder-text-tertiary transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent" />
                            </div>

                            <!-- Actions -->
                            <div class="flex flex-col sm:flex-row justify-end gap-2 pt-2">
                                <button type="button" @onclick="ClearMessageFilters"
                                        class="px-4 py-2 text-sm font-medium text-text-secondary bg-transparent border border-border-primary rounded-md hover:bg-bg-hover transition-colors text-center">
                                    Clear Filters
                                </button>
                                <button type="submit"
                                        class="px-4 py-2 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors">
                                    <span class="flex items-center justify-center gap-2">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                        </svg>
                                        Apply Filters
                                    </span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Results Summary -->
                @if (_messageResult != null && _messageResult.Items.Any())
                {
                    <div class="flex items-center justify-between mb-4">
                        <p class="text-sm text-text-secondary">
                            Showing <span class="font-medium text-text-primary">@((_messageResult.Page - 1) * _messageResult.PageSize + 1)-@Math.Min(_messageResult.Page * _messageResult.PageSize, _messageResult.TotalCount)</span> of <span class="font-medium text-text-primary">@_messageResult.TotalCount</span> messages
                        </p>
                    </div>
                }

                <!-- Table -->
                <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-border-primary">
                            <thead class="bg-bg-tertiary">
                                <tr>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Timestamp</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Author</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Guild</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Channel</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Source</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Content</th>
                                    <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border-primary">
                                @if (_messageResult != null && _messageResult.Items.Any())
                                {
                                    @foreach (var message in _messageResult.Items)
                                    {
                                        <tr class="hover:bg-bg-tertiary/50 transition-colors">
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                                                @message.Timestamp.ToString("yyyy-MM-dd HH:mm")
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="flex items-center">
                                                    <div class="h-8 w-8 rounded-full bg-accent-blue flex items-center justify-center">
                                                        <span class="text-white font-medium text-xs">
                                                            @GetUserInitials(message.AuthorUsername)
                                                        </span>
                                                    </div>
                                                    <div class="ml-3">
                                                        <div class="text-sm font-medium text-text-primary">@(message.AuthorUsername ?? "(Unknown)")</div>
                                                        <div class="text-xs text-text-tertiary font-mono">@message.AuthorId</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-text-primary">
                                                @if (message.GuildId.HasValue)
                                                {
                                                    @(message.GuildName ?? message.GuildId.ToString())
                                                }
                                                else
                                                {
                                                    <span class="text-text-tertiary">(DM)</span>
                                                }
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                                                @if (message.GuildId.HasValue)
                                                {
                                                    @(message.ChannelName ?? $"#{message.ChannelId}")
                                                }
                                                else
                                                {
                                                    <span class="text-text-tertiary">-</span>
                                                }
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                @if (message.Source == MessageSource.DirectMessage)
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-blue text-white">
                                                        DM
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-success text-white">
                                                        Server
                                                    </span>
                                                }
                                            </td>
                                            <td class="px-6 py-4 text-sm text-text-primary max-w-xs truncate">
                                                @TruncateContent(message.Content, 100)
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                                <a href="/Admin/MessageLogs/Details/@message.Id" class="text-accent-blue hover:text-accent-blue/80 transition-colors" title="View Details">
                                                    <svg class="w-5 h-5 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                    </svg>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="px-6 py-12 text-center">
                                            <div class="flex flex-col items-center gap-2">
                                                <svg class="w-12 h-12 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                                </svg>
                                                <h3 class="text-sm font-medium text-text-primary">
                                                    @(HasActiveMessageFilters() ? "No messages found" : "No messages logged yet")
                                                </h3>
                                                <p class="text-sm text-text-secondary">
                                                    @(HasActiveMessageFilters() ? "Try adjusting your search or filters" : "Messages will appear here as they are logged")
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (_messageResult != null && _messageResult.TotalPages > 1)
                    {
                        <div class="px-6 py-4 border-t border-border-primary">
                            <div class="flex items-center justify-between">
                                <p class="text-sm text-text-secondary">
                                    Page @_messageResult.Page of @_messageResult.TotalPages (@_messageResult.TotalCount total)
                                </p>
                                <div class="flex gap-2">
                                    <button type="button" disabled="@(!_messageResult.HasPreviousPage)"
                                            @onclick="() => ChangeMessagePageAsync(_messageResult.Page - 1)"
                                            class="px-3 py-1.5 text-sm font-medium rounded-md border border-border-primary transition-colors disabled:opacity-50 disabled:cursor-not-allowed hover:bg-bg-hover text-text-primary">
                                        Previous
                                    </button>
                                    @foreach (var pageNum in GetPageNumbers(_messageResult.Page, _messageResult.TotalPages))
                                    {
                                        var currentPageNum = pageNum;
                                        <button type="button"
                                                @onclick="@(() => ChangeMessagePageAsync(currentPageNum))"
                                                class="@(currentPageNum == _messageResult.Page ? "px-3 py-1.5 text-sm font-medium rounded-md bg-accent-blue text-white" : "px-3 py-1.5 text-sm font-medium rounded-md border border-border-primary hover:bg-bg-hover text-text-primary transition-colors")">
                                            @currentPageNum
                                        </button>
                                    }
                                    <button type="button" disabled="@(!_messageResult.HasNextPage)"
                                            @onclick="() => ChangeMessagePageAsync(_messageResult.Page + 1)"
                                            class="px-3 py-1.5 text-sm font-medium rounded-md border border-border-primary transition-colors disabled:opacity-50 disabled:cursor-not-allowed hover:bg-bg-hover text-text-primary">
                                        Next
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else if (_activeTab == "audit")
{
    <div id="panel-audit" role="tabpanel" aria-labelledby="tab-audit">
        @if (_isLoading)
        {
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent-blue"></div>
                <span class="ml-3 text-text-secondary">Loading audit logs...</span>
            </div>
        }
        else
        {
            <div class="max-w-7xl mx-auto">
                <!-- Header -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-semibold text-text-primary">Audit Logs</h2>
                        <p class="mt-1 text-sm text-text-secondary">Track administrative actions and changes across your bot</p>
                    </div>
                    <button type="button" @onclick="ExportAuditCsvAsync"
                            disabled="@_isExporting"
                            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-text-primary bg-bg-secondary border border-border-primary rounded-md hover:bg-bg-hover transition-colors disabled:opacity-50">
                        @if (_isExporting)
                        {
                            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-text-primary"></div>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                        }
                        Export CSV
                    </button>
                </div>

                <!-- Filters Section -->
                <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-semibold text-text-primary flex items-center gap-2">
                            <svg class="w-4 h-4 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                            </svg>
                            Filters
                        </h3>
                        <button type="button" class="text-sm text-accent-blue hover:text-accent-blue/80 transition-colors flex items-center gap-1"
                                @onclick="() => _showAuditFilters = !_showAuditFilters">
                            <span>@(_showAuditFilters ? "Hide Filters" : "Show Filters")</span>
                            <svg class="w-4 h-4 transition-transform @(_showAuditFilters ? "" : "rotate-180")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                            </svg>
                        </button>
                    </div>

                    @if (_showAuditFilters)
                    {
                        <form @onsubmit="ApplyAuditFiltersAsync" @onsubmit:preventDefault>
                            <div class="space-y-4">
                                <!-- Row 1: Date Range -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="auditStartDate" class="block text-sm font-medium text-text-primary mb-1">From Date</label>
                                        <input type="date" id="auditStartDate" @bind="_auditFilters.StartDate" @bind:format="yyyy-MM-dd"
                                               class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent" />
                                    </div>
                                    <div>
                                        <label for="auditEndDate" class="block text-sm font-medium text-text-primary mb-1">To Date</label>
                                        <input type="date" id="auditEndDate" @bind="_auditFilters.EndDate" @bind:format="yyyy-MM-dd"
                                               class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent" />
                                    </div>
                                </div>

                                <!-- Row 2: Category and Action -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="auditCategory" class="block text-sm font-medium text-text-primary mb-1">Category</label>
                                        <select id="auditCategory" @bind="_auditFilters.Category"
                                                class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent">
                                            <option value="">All Categories</option>
                                            @foreach (var category in Enum.GetValues<AuditLogCategory>())
                                            {
                                                <option value="@category">@category</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label for="auditAction" class="block text-sm font-medium text-text-primary mb-1">Action</label>
                                        <select id="auditAction" @bind="_auditFilters.Action"
                                                class="w-full py-2 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-border-focus focus:border-transparent">
                                            <option value="">All Actions</option>
                                            @foreach (var action in Enum.GetValues<AuditLogAction>())
                                            {

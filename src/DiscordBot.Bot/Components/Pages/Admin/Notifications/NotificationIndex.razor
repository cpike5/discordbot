    private void SetDatePreset(string preset)
    {
        var today = DateTime.UtcNow.Date;
        _endDate = today;
        _endDateValue = today.ToString("yyyy-MM-dd");

        _startDate = preset switch
        {
            "today" => today,
            "7days" => today.AddDays(-7),
            "30days" => today.AddDays(-30),
            _ => today.AddDays(-7)
        };
        _startDateValue = _startDate.Value.ToString("yyyy-MM-dd");

        ApplyFilters();
    }

    private bool IsPresetToday()
    {
        var today = DateTime.UtcNow.Date;
        return _startDate.HasValue && _endDate.HasValue &&
               _startDate.Value.Date == today && _endDate.Value.Date == today;
    }

    private bool IsPreset7Days()
    {
        var today = DateTime.UtcNow.Date;
        return _startDate.HasValue && _endDate.HasValue &&
               _startDate.Value.Date == today.AddDays(-7) && _endDate.Value.Date == today;
    }

    private bool IsPreset30Days()
    {
        var today = DateTime.UtcNow.Date;
        return _startDate.HasValue && _endDate.HasValue &&
               _startDate.Value.Date == today.AddDays(-30) && _endDate.Value.Date == today;
    }

    private static string GetPresetClass(bool isActive) => isActive
        ? "px-3 py-1.5 text-xs font-medium bg-accent-blue text-white border border-accent-blue rounded-md hover:bg-accent-blue/90 transition-colors"
        : "px-3 py-1.5 text-xs font-medium bg-bg-tertiary text-text-secondary border border-border-primary rounded-md hover:bg-bg-hover transition-colors";

    private void ApplyFilters()
    {
        // Parse date inputs back to DateTime
        if (DateTime.TryParse(_startDateValue, out var startDt))
            _startDate = startDt;
        else
            _startDate = null;

        if (DateTime.TryParse(_endDateValue, out var endDt))
            _endDate = endDt;
        else
            _endDate = null;

        var queryParams = new Dictionary<string, object?>();
        if (_typeFilter.HasValue) queryParams["Type"] = ((int)_typeFilter.Value).ToString();
        if (_readFilter.HasValue) queryParams["IsRead"] = _readFilter.Value.ToString();
        if (_severityFilter.HasValue) queryParams["Severity"] = ((int)_severityFilter.Value).ToString();
        if (_startDate.HasValue) queryParams["StartDate"] = _startDate.Value.ToString("yyyy-MM-dd");
        if (_endDate.HasValue) queryParams["EndDate"] = _endDate.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrWhiteSpace(_searchTerm)) queryParams["SearchTerm"] = _searchTerm;
        if (_guildFilter.HasValue) queryParams["GuildId"] = _guildFilter.Value.ToString();
        queryParams["pageNumber"] = 1;
        if (_pageSize != 25) queryParams["PageSize"] = _pageSize;

        var url = NavigationManager.GetUriWithQueryParameters("/Admin/Notifications", queryParams);
        NavigationManager.NavigateTo(url);
    }

    private void ClearFilters()
    {
        _searchTerm = null;
        _typeFilter = null;
        _readFilter = null;
        _severityFilter = null;
        _startDate = null;
        _endDate = null;
        _guildFilter = null;
        _typeFilterValue = "";
        _readFilterValue = "";
        _severityFilterValue = "";
        _guildFilterValue = "";
        _startDateValue = null;
        _endDateValue = null;
        NavigationManager.NavigateTo("/Admin/Notifications");
    }

    private string BuildPaginationBaseUrl()
    {
        var queryParams = new Dictionary<string, object?>();
        if (_typeFilter.HasValue) queryParams["Type"] = ((int)_typeFilter.Value).ToString();
        if (_readFilter.HasValue) queryParams["IsRead"] = _readFilter.Value.ToString();
        if (_severityFilter.HasValue) queryParams["Severity"] = ((int)_severityFilter.Value).ToString();
        if (_startDate.HasValue) queryParams["StartDate"] = _startDate.Value.ToString("yyyy-MM-dd");
        if (_endDate.HasValue) queryParams["EndDate"] = _endDate.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrWhiteSpace(_searchTerm)) queryParams["SearchTerm"] = _searchTerm;
        if (_guildFilter.HasValue) queryParams["GuildId"] = _guildFilter.Value.ToString();
        if (_pageSize != 25) queryParams["PageSize"] = _pageSize;

        return NavigationManager.GetUriWithQueryParameters("/Admin/Notifications", queryParams);
    }

    // Selection handlers
    private void HandleSelectAllChanged(ChangeEventArgs e)
    {
        _selectAll = (bool)(e.Value ?? false);
        if (_selectAll)
        {
            foreach (var n in _notifications)
                _selectedIds.Add(n.Id);
        }
        else
        {
            _selectedIds.Clear();
        }
    }

    private void HandleCheckboxChanged(Guid id, ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        if (isChecked)
            _selectedIds.Add(id);
        else
            _selectedIds.Remove(id);

        _selectAll = _notifications.Count > 0 && _selectedIds.Count == _notifications.Count;
    }

    // Individual actions
    private async Task ToggleReadAsync(NotificationListItem notification)
    {
        if (string.IsNullOrEmpty(_currentUserId)) return;

        try
        {
            if (notification.IsRead)
            {
                await NotificationService.MarkAsUnreadAsync(_currentUserId, notification.Id);
                await Toast.ShowAsync("success", "Notification marked as unread");
            }
            else
            {
                await NotificationService.MarkAsReadAsync(_currentUserId, notification.Id);
                await Toast.ShowAsync("success", "Notification marked as read");
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling read status for notification {NotificationId}", notification.Id);
            await Toast.ShowAsync("error", "Failed to update notification status");
        }
    }

    private async Task DeleteNotificationAsync(Guid notificationId)
    {
        if (string.IsNullOrEmpty(_currentUserId)) return;

        try
        {
            await NotificationService.DeleteAsync(_currentUserId, notificationId);
            await Toast.ShowAsync("success", "Notification deleted");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting notification {NotificationId}", notificationId);
            await Toast.ShowAsync("error", "Failed to delete notification");
        }
    }

    // Bulk actions
    private async Task MarkSelectedReadAsync()
    {
        if (string.IsNullOrEmpty(_currentUserId) || _selectedIds.Count == 0) return;

        _isBulkProcessing = true;
        try
        {
            await NotificationService.MarkMultipleAsReadAsync(_currentUserId, _selectedIds);
            await Toast.ShowAsync("success", $"{_selectedIds.Count} notification(s) marked as read");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error marking {Count} notifications as read", _selectedIds.Count);
            await Toast.ShowAsync("error", "Failed to mark notifications as read");
        }
        finally
        {
            _isBulkProcessing = false;
        }
    }


    private void HandleTypeFilterChanged(string? value)
    {
        _typeFilterValue = value;
        if (int.TryParse(value, out var v) && Enum.IsDefined(typeof(NotificationType), v))
            _typeFilter = (NotificationType)v;
        else
            _typeFilter = null;
    }

    private void HandleReadFilterChanged(string? value)
    {
        _readFilterValue = value;
        _readFilter = value switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private void HandleSeverityFilterChanged(string? value)
    {
        _severityFilterValue = value;
        if (int.TryParse(value, out var v) && Enum.IsDefined(typeof(AlertSeverity), v))
            _severityFilter = (AlertSeverity)v;

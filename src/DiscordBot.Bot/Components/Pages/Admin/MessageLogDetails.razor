@page "/Admin/MessageLogs/Details/{Id:long}"
@attribute [Authorize(Policy = "RequireAdmin")]
@using DiscordBot.Bot.ViewModels.Pages
@using DiscordBot.Core.Interfaces
@using DiscordBot.Core.Enums
@inject IMessageLogService MessageLogService
@inject ILogger<MessageLogDetails> Logger

<PageTitle>@(_viewModel?.Message != null ? $"Message #{_viewModel.Message.Id}" : "Message Details") - Discord Bot Admin</PageTitle>

@if (_viewModel?.Message is null)
{
    <div class="flex items-center justify-center py-12">
        <div class="text-text-secondary">Loading...</div>
    </div>
}
else
{
    var msg = _viewModel.Message;
    var isDM = msg.Source == MessageSource.DirectMessage;

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Back Button -->
        <div class="mb-6">
            <a href="/Admin/MessageLogs" class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-text-primary transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to Message Logs
            </a>
        </div>

        <!-- Main Card -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
            <!-- Card Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-border-primary">
                <div class="flex items-center gap-3">
                    <h1 class="text-xl font-bold text-text-primary">Message Details</h1>
                    @if (isDM)
                    {
                        <Badge Text="DM" Variant="BadgeVariant.Blue" />
                    }
                    else
                    {
                        <Badge Text="Server" Variant="BadgeVariant.Success" />
                    }
                </div>
            </div>

            <!-- Card Body -->
            <div class="p-6 space-y-6">

                <!-- Message Info Section -->
                <section>
                    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Message Info</h2>
                    <div class="bg-bg-primary border border-border-secondary rounded-lg p-4 space-y-4">
                        <!-- Discord Message ID -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <span class="text-sm text-text-secondary">Discord Message ID</span>
                            <div class="flex items-center gap-2">
                                <code class="text-sm font-mono text-text-primary bg-bg-tertiary px-2 py-1 rounded">@msg.DiscordMessageId</code>
                            </div>
                        </div>
                        <!-- Timestamp -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <span class="text-sm text-text-secondary">Timestamp</span>
                            <span class="text-sm text-text-primary" data-utc="@msg.TimestampUtcIso" data-format="datetime-seconds"></span>
                        </div>
                        <!-- Logged At -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <span class="text-sm text-text-secondary">Logged At</span>
                            <span class="text-sm text-text-primary" data-utc="@msg.LoggedAtUtcIso" data-format="datetime-seconds"></span>
                        </div>
                    </div>
                </section>

                <!-- Author Section -->
                <section>
                    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Author</h2>
                    <div class="bg-bg-primary border border-border-secondary rounded-lg p-4 space-y-4">
                        <!-- Author Info with Avatar -->
                        <div class="flex items-center gap-4">
                            <div class="h-12 w-12 rounded-full bg-accent-blue flex items-center justify-center">
                                <span class="text-white font-medium text-lg">
                                    @if (!string.IsNullOrEmpty(msg.AuthorUsername))
                                    {
                                        @msg.AuthorUsername.Substring(0, Math.Min(2, msg.AuthorUsername.Length)).ToUpper()
                                    }
                                    else
                                    {
                                        @("?")
                                    }
                                </span>
                            </div>
                            <div>
                                <div class="text-base font-medium text-text-primary">
                                    <span class="preview-trigger" data-preview-type="user" data-user-id="@msg.AuthorId" @(msg.GuildId.HasValue ? $"data-context-guild-id=\"{msg.GuildId}\"" : "")>@(msg.AuthorUsername ?? "(Unknown)")</span>
                                </div>
                                <div class="text-sm text-text-secondary">Discord User</div>
                            </div>
                        </div>
                        <!-- Author ID -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <span class="text-sm text-text-secondary">Author ID</span>
                            <div class="flex items-center gap-2">
                                <code class="text-sm font-mono text-text-primary bg-bg-tertiary px-2 py-1 rounded">@msg.AuthorId</code>
                            </div>
                        </div>
                        <!-- Username -->
                        @if (!string.IsNullOrEmpty(msg.AuthorUsername))
                        {
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <span class="text-sm text-text-secondary">Username</span>
                                <span class="text-sm text-text-primary">@msg.AuthorUsername</span>
                            </div>
                        }
                    </div>
                </section>

                <!-- Location Section -->
                <section>
                    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Location</h2>
                    @if (isDM)
                    {
                        <div class="bg-bg-primary border border-border-secondary rounded-lg p-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-accent-blue/20 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                    </svg>
                                </div>
                                <div>
                                    <div class="text-base font-medium text-text-primary">Direct Message</div>
                                    <div class="text-sm text-text-secondary">This message was sent via DM to the bot</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bg-bg-primary border border-border-secondary rounded-lg p-4 space-y-4">
                            @if (msg.GuildId.HasValue)
                            {
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                    <span class="text-sm text-text-secondary">Guild ID</span>
                                    <div class="flex items-center gap-2">
                                        <code class="text-sm font-mono text-text-primary bg-bg-tertiary px-2 py-1 rounded">@msg.GuildId.Value</code>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(msg.GuildName))
                            {
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                    <span class="text-sm text-text-secondary">Guild Name</span>
                                    <span class="text-sm text-text-primary preview-trigger" data-preview-type="guild" data-guild-id="@msg.GuildId">@msg.GuildName</span>
                                </div>
                            }
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <span class="text-sm text-text-secondary">Channel ID</span>
                                <div class="flex items-center gap-2">
                                    <code class="text-sm font-mono text-text-primary bg-bg-tertiary px-2 py-1 rounded">@msg.ChannelId</code>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(msg.ChannelName))
                            {
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                    <span class="text-sm text-text-secondary">Channel Name</span>
                                    <span class="text-sm text-text-primary">@msg.ChannelName</span>
                                </div>
                            }
                        </div>
                    }
                </section>

                <!-- Content Section -->
                <section>
                    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Content</h2>
                    <div class="bg-bg-primary border border-border-secondary rounded-lg p-4">
                        <p class="text-sm text-text-primary whitespace-pre-wrap leading-relaxed">@msg.Content</p>
                    </div>
                </section>

                <!-- Metadata Section -->
                <section>
                    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Metadata</h2>
                    <div class="bg-bg-primary border border-border-secondary rounded-lg p-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            <!-- Has Attachments -->
                            <div class="flex items-center justify-between sm:flex-col sm:items-start gap-2">
                                <span class="text-sm text-text-secondary">Has Attachments</span>
                                @if (msg.HasAttachments)
                                {
                                    <Badge Text="Yes" Variant="BadgeVariant.Success" Style="BadgeStyle.Subtle" Size="BadgeSize.Small" />
                                }
                                else
                                {
                                    <Badge Text="No" Variant="BadgeVariant.Error" Style="BadgeStyle.Subtle" Size="BadgeSize.Small" />
                                }
                            </div>
                            <!-- Has Embeds -->
                            <div class="flex items-center justify-between sm:flex-col sm:items-start gap-2">
                                <span class="text-sm text-text-secondary">Has Embeds</span>
                                @if (msg.HasEmbeds)
                                {
                                    <Badge Text="Yes" Variant="BadgeVariant.Success" Style="BadgeStyle.Subtle" Size="BadgeSize.Small" />
                                }
                                else
                                {
                                    <Badge Text="No" Variant="BadgeVariant.Error" Style="BadgeStyle.Subtle" Size="BadgeSize.Small" />
                                }
                            </div>
                            <!-- Is Reply -->
                            <div class="flex items-center justify-between sm:flex-col sm:items-start gap-2">
                                <span class="text-sm text-text-secondary">Is Reply</span>
                                @if (msg.ReplyToMessageId.HasValue)
                                {
                                    <Badge Text="Yes" Variant="BadgeVariant.Success" Style="BadgeStyle.Subtle" Size="BadgeSize.Small" />
                                }
                                else
                                {
                                    <Badge Text="No" Variant="BadgeVariant.Error" Style="BadgeStyle.Subtle" Size="BadgeSize.Small" />
                                }
                            </div>
                            <!-- Reply To -->
                            <div class="flex items-center justify-between sm:flex-col sm:items-start gap-2">
                                <span class="text-sm text-text-secondary">Reply To Message ID</span>
                                @if (msg.ReplyToMessageId.HasValue)
                                {
                                    <code class="text-xs font-mono text-text-primary bg-bg-tertiary px-2 py-1 rounded">@msg.ReplyToMessageId.Value</code>
                                }
                                else
                                {
                                    <span class="text-sm text-text-tertiary">-</span>
                                }
                            </div>
                        </div>
                    </div>
                </section>

            </div>

            <!-- Card Footer -->
            <div class="flex items-center justify-between px-6 py-4 border-t border-border-primary bg-bg-primary/50">
                <a href="/Admin/MessageLogs" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-text-secondary bg-transparent border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to List
                </a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private MessageLogDetailViewModel? _viewModel;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("Loading message log details for ID: {MessageLogId}", Id);

        var message = await MessageLogService.GetByIdAsync(Id);

        if (message == null)
        {
            Logger.LogWarning("Message log not found: {MessageLogId}", Id);
            return;
        }

        Logger.LogInformation("Retrieved message log {MessageLogId} (Discord message {DiscordMessageId} from author {AuthorId})",
            Id, message.DiscordMessageId, message.AuthorId);

        _viewModel = new MessageLogDetailViewModel
        {
            Message = message
        };
    }
}

@page "/Guilds/FlaggedEvents/Details/{GuildId:long}/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "RequireAdmin")]
@attribute [Authorize(Policy = "GuildAccess")]
@layout GuildLayout
@using DiscordBot.Bot.Configuration
@using DiscordBot.Core.DTOs
@using DiscordBot.Core.Enums
@using DiscordBot.Core.Interfaces
@using System.Security.Claims
@inject IFlaggedEventService FlaggedEventService
@inject IGuildService GuildService
@inject ILogger<FlaggedEventDetails> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Flagged Event Details - Discord Bot Admin</PageTitle>

@if (_event is null)
{
    <div class="flex items-center justify-center py-12">
        <div class="text-text-secondary">Loading...</div>
    </div>
}
else
{
    <!-- Breadcrumb -->
    <GuildBreadcrumb Items="@_breadcrumbItems" />

    <!-- Guild Header -->
    <GuildHeader GuildId="(ulong)GuildId"
                 GuildName="@_guildName"
                 PageTitle="Flagged Event Details"
                 PageDescription="@($"Event details for {_guildName}")" />

    <!-- Success/Error Messages -->
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="mb-6">
            <Alert Variant="AlertVariant.Success" Message="@_successMessage" IsDismissible="true" />
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="mb-6">
            <Alert Variant="AlertVariant.Error" Message="@_errorMessage" IsDismissible="true" />
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content Column -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Event Summary Card -->
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <SeverityBadge Severity="@_event.Severity" />
                        <StatusBadge Status="@_event.Status" />
                    </div>
                    <div class="text-sm text-text-tertiary">
                        <span data-utc="@_event.CreatedAt.ToString("o")" data-format="datetime"></span>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Description</h3>
                        <p class="text-text-primary">@_event.Description</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Rule Type</h3>
                            <div class="flex items-center gap-2">
                                <RuleTypeIcon RuleType="@_event.RuleType" />
                                <span class="text-text-primary">@_event.RuleType</span>
                            </div>
                        </div>

                        @if (_event.ChannelId > 0)
                        {
                            <div>
                                <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-1">Channel</h3>
                                <p class="text-text-primary">#@_event.ChannelName</p>
                            </div>
                        }
                    </div>

                    @if (_event.ReviewedAt.HasValue)
                    {
                        <div class="border-t border-border-primary pt-4">
                            <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-2">Review Information</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <span class="text-sm text-text-secondary">Reviewed by:</span>
                                    <p class="text-text-primary">@(_event.ReviewedByUsername ?? "Unknown")</p>
                                </div>
                                <div>
                                    <span class="text-sm text-text-secondary">Reviewed at:</span>
                                    <p class="text-text-primary"><span data-utc="@_event.ReviewedAt.Value.ToString("o")" data-format="datetime"></span></p>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_event.ActionTaken))
                            {
                                <div class="mt-4">
                                    <span class="text-sm text-text-secondary">Action taken:</span>
                                    <p class="text-text-primary">@_event.ActionTaken</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- User Info Card -->
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                <h2 class="text-lg font-semibold text-text-primary mb-4">User Information</h2>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-accent-blue flex items-center justify-center text-white font-bold text-lg">
                        @(_event.Username.Length > 0 ? _event.Username[0].ToString().ToUpper() : "?")
                    </div>
                    <div>
                        <div class="text-text-primary font-medium">
                            <span class="preview-trigger" data-preview-type="user" data-user-id="@_event.UserId" data-context-guild-id="@GuildId">@_event.Username</span>
                        </div>
                        <div class="text-sm text-text-tertiary">User ID: @_event.UserId</div>
                    </div>
                </div>
            </div>

            <!-- Evidence Card -->
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                <button type="button" @onclick="ToggleEvidence" class="w-full flex items-center justify-between text-left">
                    <h2 class="text-lg font-semibold text-text-primary">Evidence</h2>
                    <svg class="w-5 h-5 text-text-secondary transition-transform @(_evidenceVisible ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                @if (_evidenceVisible)
                {
                    <div class="mt-4">
                        <pre class="bg-bg-primary border border-border-primary rounded-md p-4 text-sm text-text-primary overflow-x-auto">@_event.Evidence</pre>
                    </div>
                }
            </div>

            <!-- User History Card -->
            @if (_userHistory.Any())
            {
                <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                    <h2 class="text-lg font-semibold text-text-primary mb-4">User History (@_userHistory.Count() previous events)</h2>
                    <div class="space-y-3">
                        @foreach (var evt in _userHistory)
                        {
                            <div class="flex items-center justify-between p-3 bg-bg-primary border border-border-primary rounded-md">
                                <div class="flex items-center gap-3">
                                    <SeverityBadge Severity="@evt.Severity" />
                                    <span class="text-sm text-text-primary">@evt.RuleType</span>
                                    <span class="text-xs text-text-tertiary"><span data-utc="@evt.CreatedAt.ToString("o")" data-format="date"></span></span>
                                </div>
                                <StatusBadge Status="@evt.Status" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Action Panel Column -->
        <div class="lg:col-span-1">
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 sticky top-6">
                <h2 class="text-lg font-semibold text-text-primary mb-4">Actions</h2>

                @if (_event.Status == FlaggedEventStatus.Pending)
                {
                    <div class="space-y-3">
                        <button type="button" @onclick="DismissEvent" disabled="@_isProcessing"
                                class="w-full px-4 py-2 bg-text-tertiary/20 text-text-primary font-medium rounded-md hover:bg-text-tertiary/30 transition-colors disabled:opacity-50">
                            @if (_isProcessing && _processingAction == "dismiss")
                            {
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Dismiss</span>
                            }
                        </button>
                        <button type="button" @onclick="AcknowledgeEvent" disabled="@_isProcessing"
                                class="w-full px-4 py-2 bg-accent-blue text-white font-medium rounded-md hover:bg-accent-blue/90 transition-colors disabled:opacity-50">
                            @if (_isProcessing && _processingAction == "acknowledge")
                            {
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Acknowledge</span>
                            }
                        </button>

                        <div class="relative">
                            <button type="button" @onclick="ToggleActionDropdown"
                                    class="w-full px-4 py-2 bg-warning text-white font-medium rounded-md hover:bg-warning/90 transition-colors flex items-center justify-between"
                                    disabled="@_isProcessing">
                                <span>Take Action</span>
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            @if (_actionDropdownVisible)
                            {
                                <div class="absolute z-10 mt-2 w-full bg-bg-secondary border border-border-primary rounded-md shadow-lg">
                                    <div class="py-1">
                                        <button type="button" @onclick='() => TakeAction("Warned user")' class="block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-bg-hover transition-colors">
                                            Warn User
                                        </button>
                                        <button type="button" @onclick='() => TakeAction("Muted user for 24 hours")' class="block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-bg-hover transition-colors">
                                            Mute User
                                        </button>
                                        <button type="button" @onclick='() => TakeAction("Kicked user from server")' class="block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-bg-hover transition-colors">
                                            Kick User
                                        </button>
                                        <button type="button" @onclick='() => TakeAction("Banned user from server")' class="block w-full text-left px-4 py-2 text-sm text-error hover:bg-bg-hover transition-colors">
                                            Ban User
                                        </button>
                                        <button type="button" @onclick="ShowCustomActionInput" class="block w-full text-left px-4 py-2 text-sm text-text-primary hover:bg-bg-hover transition-colors border-t border-border-primary">
                                            Custom Action...
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (_showCustomAction)
                        {
                            <div class="mt-3 space-y-2">
                                <textarea @bind="_customActionText" rows="3"
                                          class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:ring-2 focus:ring-accent-blue focus:border-accent-blue"
                                          placeholder="Describe the action you took..."></textarea>
                                <div class="flex items-center justify-end gap-2">
                                    <button type="button" @onclick="HideCustomActionInput"
                                            class="px-3 py-1.5 text-sm text-text-secondary hover:text-text-primary transition-colors">
                                        Cancel
                                    </button>
                                    <button type="button" @onclick="SubmitCustomAction" disabled="@_isProcessing"
                                            class="px-3 py-1.5 bg-accent-blue text-white text-sm font-medium rounded-md hover:bg-accent-blue/90 transition-colors disabled:opacity-50">
                                        Submit
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-text-secondary">
                        This event has been @_event.Status.ToString().ToLower()
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long GuildId { get; set; }
    [Parameter] public Guid Id { get; set; }

    private FlaggedEventDto? _event;
    private IEnumerable<FlaggedEventDto> _userHistory = Array.Empty<FlaggedEventDto>();
    private string _guildName = string.Empty;
    private List<BreadcrumbItem>? _breadcrumbItems;

    private bool _evidenceVisible = true;
    private bool _actionDropdownVisible;
    private bool _showCustomAction;
    private string _customActionText = string.Empty;
    private bool _isProcessing;
    private string? _processingAction;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var guildId = (ulong)GuildId;
        Logger.LogInformation("User accessing Flagged Event details for event {EventId} in guild {GuildId}", Id, guildId);

        var guild = await GuildService.GetGuildByIdAsync(guildId);
        if (guild == null)
        {
            Logger.LogWarning("Guild {GuildId} not found", guildId);
            return;
        }

        _guildName = guild.Name;

        var eventDto = await FlaggedEventService.GetEventAsync(Id);
        if (eventDto == null || eventDto.GuildId != guildId)
        {
            Logger.LogWarning("Flagged event {EventId} not found for guild {GuildId}", Id, guildId);
            return;
        }

        _event = eventDto;

        var userEvents = await FlaggedEventService.GetUserEventsAsync(guildId, _event.UserId);
        _userHistory = userEvents
            .Where(e => e.Id != Id)
            .OrderByDescending(e => e.CreatedAt)
            .Take(10);

        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new() { Label = "Home", Url = "/" },
            new() { Label = "Servers", Url = "/Guilds" },
            new() { Label = guild.Name, Url = $"/Guilds/Details/{GuildId}" },
            new() { Label = "Moderation", Url = $"/Guilds/ModerationSettings/{GuildId}" },
            new() { Label = "Flagged Events", Url = $"/Guilds/{GuildId}/FlaggedEvents" },
            new() { Label = "Details", IsCurrent = true }
        };
    }

    private void ToggleEvidence() => _evidenceVisible = !_evidenceVisible;

    private void ToggleActionDropdown()
    {
        _actionDropdownVisible = !_actionDropdownVisible;
        _showCustomAction = false;
    }

    private void ShowCustomActionInput()
    {
        _actionDropdownVisible = false;
        _showCustomAction = true;
    }

    private void HideCustomActionInput()
    {
        _showCustomAction = false;
        _customActionText = string.Empty;
    }

    private async Task<ulong> GetReviewerIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var discordIdClaim = authState.User.FindFirst("DiscordId")?.Value;
        return ulong.TryParse(discordIdClaim, out var id) ? id : 0;
    }

    private async Task DismissEvent()
    {
        _isProcessing = true;
        _processingAction = "dismiss";
        _errorMessage = null;

        try
        {
            var reviewerId = await GetReviewerIdAsync();
            var result = await FlaggedEventService.DismissEventAsync(Id, reviewerId);
            if (result != null)
            {
                NavigationManager.NavigateTo($"/Guilds/{GuildId}/FlaggedEvents?successMessage=Event+dismissed+successfully");
            }
            else
            {
                _errorMessage = "Failed to dismiss event.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error dismissing flagged event {EventId}", Id);
            _errorMessage = "An error occurred while dismissing the event.";
        }
        finally
        {
            _isProcessing = false;
            _processingAction = null;
        }
    }

    private async Task AcknowledgeEvent()
    {
        _isProcessing = true;
        _processingAction = "acknowledge";
        _errorMessage = null;

        try
        {
            var reviewerId = await GetReviewerIdAsync();
            var result = await FlaggedEventService.AcknowledgeEventAsync(Id, reviewerId);
            if (result != null)
            {
                _event = result;
                _successMessage = "Event acknowledged successfully.";
            }
            else
            {
                _errorMessage = "Failed to acknowledge event.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error acknowledging flagged event {EventId}", Id);
            _errorMessage = "An error occurred while acknowledging the event.";
        }
        finally
        {
            _isProcessing = false;
            _processingAction = null;
        }
    }

    private async Task TakeAction(string action)
    {
        _actionDropdownVisible = false;
        _isProcessing = true;
        _processingAction = "action";
        _errorMessage = null;

        try
        {
            var reviewerId = await GetReviewerIdAsync();
            var result = await FlaggedEventService.TakeActionAsync(Id, action, reviewerId);
            if (result != null)
            {
                _event = result;
                _successMessage = $"Action taken: {action}";
            }
            else
            {
                _errorMessage = "Failed to take action on event.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error taking action on flagged event {EventId}", Id);
            _errorMessage = "An error occurred while taking action.";
        }
        finally
        {
            _isProcessing = false;
            _processingAction = null;
        }
    }

    private async Task SubmitCustomAction()
    {
        var actionText = _customActionText.Trim();
        if (string.IsNullOrEmpty(actionText))
        {
            _errorMessage = "Please enter an action description.";
            return;
        }

        _showCustomAction = false;
        _customActionText = string.Empty;
        await TakeAction(actionText);
    }
}

@page "/Guilds/Details/{GuildId:long}"
@attribute [Authorize(Policy = "RequireModerator")]
@attribute [Authorize(Policy = "GuildAccess")]
@layout GuildLayout
@using DiscordBot.Bot.Configuration
@using DiscordBot.Bot.ViewModels.Pages
@using DiscordBot.Core.Configuration
@using DiscordBot.Core.DTOs
@using DiscordBot.Core.Enums
@using DiscordBot.Core.Interfaces
@using Microsoft.Extensions.Options
@inject IGuildService GuildService
@inject ICommandLogService CommandLogService
@inject IWelcomeService WelcomeService
@inject IScheduledMessageService ScheduledMessageService
@inject IRatWatchService RatWatchService
@inject IReminderRepository ReminderRepository
@inject IGuildMemberService GuildMemberService
@inject IGuildAudioSettingsService GuildAudioSettingsService
@inject ISoundRepository SoundRepository
@inject ITtsMessageRepository TtsMessageRepository
@inject IAssistantGuildSettingsService AssistantGuildSettingsService
@inject IOptions<AssistantOptions> AssistantOptionsAccessor
@inject ILogger<GuildDetails> Logger

<PageTitle>@(_guild?.Name ?? "Guild Details") - Discord Bot Admin</PageTitle>

@if (_guild is null)
{
    <div class="flex items-center justify-center py-12">
        <div class="text-text-secondary">Loading...</div>
    </div>
}
else
{
    <!-- Breadcrumb -->
    <GuildBreadcrumb Items="@_breadcrumbItems" />

    <!-- Guild Header -->
    <GuildHeader GuildId="(ulong)GuildId"
                 GuildName="@_guild.Name"
                 GuildIconUrl="@_guild.IconUrl"
                 PageTitle="@_guild.Name"
                 PageDescription="@($"ID: {_guild.Id}")"
                 StatusBadge="@(new BadgeViewModel { Text = _guild.IsActive ? "Active" : "Inactive", Variant = _guild.IsActive ? BadgeVariant.Success : BadgeVariant.Error, Style = BadgeStyle.Subtle, IconLeft = "M10 18a8 8 0 100-16 8 8 0 000 16z" })"
                 Actions="@_headerActions" />

    <!-- Guild Navigation Tabs -->
    <GuildTabNavigation GuildId="(ulong)GuildId" ActiveTab="overview" />

    <!-- Guild Information Card -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 sm:p-6 mb-6">
        <h2 class="text-lg font-semibold text-text-primary mb-4">Guild Information</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
            <!-- Members -->
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <span class="text-sm text-text-tertiary font-medium">Members</span>
                </div>
                <p class="text-xl font-bold text-text-primary">@_guild.MemberCount.ToString("N0")</p>
            </div>
            <!-- Bot Joined -->
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="text-sm text-text-tertiary font-medium">Bot Joined</span>
                </div>
                <p class="text-xl font-bold text-text-primary" data-utc="@_guild.JoinedAtUtcIso" data-format="date"></p>
            </div>
            <!-- Prefix -->
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                    </svg>
                    <span class="text-sm text-text-tertiary font-medium">Prefix</span>
                </div>
                <p class="text-xl font-bold text-text-primary font-mono">
                    @if (!string.IsNullOrEmpty(_guild.Prefix))
                    {
                        @_guild.Prefix
                    }
                    else
                    {
                        <span class="text-text-secondary text-base">Default (/)</span>
                    }
                </p>
            </div>
            <!-- Status -->
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    <span class="text-sm text-text-tertiary font-medium">Status</span>
                </div>
                <p class="text-xl font-bold text-text-primary">
                    @if (_guild.IsActive)
                    {
                        <span class="text-success">Active</span>
                    }
                    else
                    {
                        <span class="text-error">Inactive</span>
                    }
                </p>
            </div>
            <!-- Welcome -->
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                    </svg>
                    <span class="text-sm text-text-tertiary font-medium">Welcome</span>
                </div>
                <p class="text-xl font-bold">
                    @if (_welcomeEnabled)
                    {
                        <span class="text-success">Enabled</span>
                    }
                    else
                    {
                        <span class="text-text-secondary">Disabled</span>
                    }
                </p>
            </div>
        </div>
    </div>

    <!-- Dashboard Widgets Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-6">
        <!-- Scheduled Messages Widget -->
        <DashboardWidget Title="Scheduled Messages"
                         DetailUrl="@($"/Guilds/ScheduledMessages/{GuildId}")">
            <BodyContent>
                @if (_scheduledMessagesTotal > 0)
                {
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Total</span>
                            </div>
                            <p class="text-2xl font-bold text-text-primary">@_scheduledMessagesTotal</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Active</span>
                            </div>
                            <p class="text-2xl font-bold text-success">@_scheduledMessagesActive</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Paused</span>
                            </div>
                            <p class="text-2xl font-bold text-warning">@_scheduledMessagesPaused</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Next Run</span>
                            </div>
                            @if (_nextScheduledExecution.HasValue)
                            {
                                <span class="text-sm font-bold text-text-primary" data-utc="@_nextScheduledExecutionUtcIso" data-format="datetime-short">Loading...</span>
                                <p class="text-xs text-text-tertiary line-clamp-2 sm:truncate mt-1" title="@_nextScheduledMessageTitle">@_nextScheduledMessageTitle</p>
                            }
                            else
                            {
                                <p class="text-sm text-text-tertiary">--</p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <EmptyState Type="EmptyStateType.NoData"
                                Title="No scheduled messages yet"
                                IconSvgPath="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                PrimaryActionText="Create Scheduled Message"
                                PrimaryActionUrl="@($"/Guilds/ScheduledMessages/Create/{GuildId}")" />
                }
            </BodyContent>
        </DashboardWidget>

        <!-- Rat Watch Widget -->
        <DashboardWidget Title="Rat Watch"
                         IsEnabled="@_ratWatchEnabled"
                         DetailUrl="@($"/Guilds/RatWatch/Incidents/{GuildId}")"
                         DetailLinkText="Incidents &rarr;"
                         HeaderActions="@(new List<WidgetHeaderAction> { new() { Text = "Settings", Url = $"/Guilds/RatWatch/{GuildId}" }, new() { Text = "Analytics", Url = $"/Guilds/RatWatch/Analytics/{GuildId}" } })">
            <BodyContent>
                @if (_ratWatchTotal > 0)
                {
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Total Watches</span>
                            </div>
                            <p class="text-2xl font-bold text-text-primary">@_ratWatchTotal</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Pending/Voting</span>
                            </div>
                            <p class="text-2xl font-bold text-warning">@_ratWatchPending</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Completed</span>
                            </div>
                            <p class="text-2xl font-bold text-success">@_ratWatchCompleted</p>
                        </div>
                    </div>
                }
                else
                {
                    <EmptyState Type="EmptyStateType.NoData"
                                Title="@(_ratWatchEnabled ? "No watches yet" : "Ratwatch is disabled")"
                                Description="@(_ratWatchEnabled ? "Use the \"Rat Watch\" context menu on messages in Discord to start accountability tracking." : "Enable Ratwatch in settings to start tracking.")"
                                IconSvgPath="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                }
            </BodyContent>
        </DashboardWidget>

        <!-- Reminders Widget -->
        <DashboardWidget Title="Reminders"
                         DetailUrl="@($"/Guilds/{GuildId}/Reminders")">
            <BodyContent>
                @if (_remindersTotal > 0)
                {
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Total</span>
                            </div>
                            <p class="text-2xl font-bold text-text-primary">@_remindersTotal</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Pending</span>
                            </div>
                            <p class="text-2xl font-bold text-accent-blue">@_remindersPending</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Delivered Today</span>
                            </div>
                            <p class="text-2xl font-bold text-success">@_remindersDeliveredToday</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 @(_remindersFailed > 0 ? "text-error" : "text-text-tertiary")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Failed</span>
                            </div>
                            <p class="text-2xl font-bold @(_remindersFailed > 0 ? "text-error" : "text-text-primary")">@_remindersFailed</p>
                        </div>
                    </div>
                }
                else
                {
                    <EmptyState Type="EmptyStateType.NoData"
                                Title="No reminders yet"
                                Description="Users can create reminders using the /remind command in Discord."
                                IconSvgPath="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                }
            </BodyContent>
        </DashboardWidget>

        <!-- Audio Widget -->
        <DashboardWidget Title="Audio"
                         IsEnabled="@_audioEnabled"
                         DetailUrl="@($"/Guilds/AudioSettings/{GuildId}")">
            <BodyContent>
                @if (_audioEnabled && (_totalSoundCount > 0 || !string.IsNullOrEmpty(_mostUsedTtsVoice)))
                {
                    <div class="grid grid-cols-2 gap-3 sm:gap-4 mb-4">
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Total Sounds</span>
                            </div>
                            <p class="text-2xl font-bold text-text-primary">@_totalSoundCount</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Top TTS Voice</span>
                            </div>
                            @if (!string.IsNullOrEmpty(_mostUsedTtsVoice))
                            {
                                <p class="text-sm font-bold text-text-primary truncate" title="@_mostUsedTtsVoice">@_mostUsedTtsVoice</p>
                            }
                            else
                            {
                                <p class="text-sm text-text-tertiary">No TTS usage</p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <EmptyState Type="EmptyStateType.NoData"
                                Title="@(_audioEnabled ? "No audio activity yet" : "Audio is disabled")"
                                Description="@(_audioEnabled ? "Upload sounds and use TTS to see stats here." : "Enable audio features in Audio settings.")"
                                IconSvgPath="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
                                PrimaryActionText="@(!_audioEnabled ? "Configure Audio" : null)"
                                PrimaryActionUrl="@(!_audioEnabled ? $"/Guilds/AudioSettings/{GuildId}" : null)" />
                }
            </BodyContent>
        </DashboardWidget>

        <!-- Assistant Widget -->
        <DashboardWidget Title="Assistant"
                         IsEnabled="@_assistantLocallyEnabled"
                         DetailUrl="@($"/Guilds/AssistantSettings/{GuildId}")">
            <BodyContent>
                @if (_assistantGloballyEnabled && _assistantLocallyEnabled)
                {
                    var channelCoverage = _assistantChannelCount == 0 ? "All" : _assistantChannelCount.ToString();
                    var rateLimitDisplay = _assistantIsRateLimitOverride
                        ? $"{_assistantRateLimit} req/{_assistantRateLimitWindowMinutes}min"
                        : "Default";

                    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Global Status</span>
                            </div>
                            <p class="text-sm font-bold text-success">Enabled</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Channel Coverage</span>
                            </div>
                            <p class="text-sm font-bold text-text-primary">@channelCoverage</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Rate Limit</span>
                            </div>
                            <p class="text-sm font-bold text-text-primary">@rateLimitDisplay</p>
                        </div>
                    </div>
                }
                else if (!_assistantGloballyEnabled)
                {
                    <EmptyState Type="EmptyStateType.Error"
                                Title="Service unavailable"
                                Description="The Assistant feature is globally disabled. Contact your administrator to enable it."
                                IconSvgPath="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                }
                else
                {
                    <EmptyState Type="EmptyStateType.NoData"
                                Title="Assistant is disabled"
                                Description="Enable the Assistant to allow users to ask questions about bot features."
                                IconSvgPath="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                PrimaryActionText="Configure Assistant"
                                PrimaryActionUrl="@($"/Guilds/AssistantSettings/{GuildId}")" />
                }
            </BodyContent>
        </DashboardWidget>

        <!-- Members Widget -->
        <DashboardWidget Title="Members"
                         DetailUrl="@($"/Guilds/{GuildId}/Members")">
            <BodyContent>
                @if (_membersTotalCount > 0)
                {
                    <div class="grid grid-cols-2 gap-3 sm:gap-4 mb-4">
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Total Members</span>
                            </div>
                            <p class="text-2xl font-bold text-text-primary">@_membersTotalCount.ToString("N0")</p>
                        </div>
                        <div class="bg-bg-primary rounded-lg p-3 sm:p-4">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span class="text-xs text-text-tertiary font-medium">Active Today</span>
                            </div>
                            <p class="text-2xl font-bold text-success">@_membersActiveToday.ToString("N0")</p>
                        </div>
                    </div>
                }
                else
                {
                    <EmptyState Type="EmptyStateType.NoData"
                                Title="No members found"
                                Description="Member data will appear here after synchronization."
                                IconSvgPath="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                }
            </BodyContent>
        </DashboardWidget>
    </div>

    <!-- Full-width Activity Section -->
    <div class="w-full">
        <DashboardWidget Title="Activity"
                         Subtitle="Recent command activity"
                         IconSvgPath="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                         DetailUrl="@($"/Commands?tab=logs&GuildId={GuildId}")"
                         ColSpan="2">
            <BodyContent>
                @if (_guild.RecentCommandLogs.Any())
                {
                    <!-- Desktop Table -->
                    <div class="overflow-x-auto hidden md:block">
                        <table class="min-w-full divide-y divide-border-primary">
                            <thead class="bg-bg-tertiary">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Command</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">User</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Time</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Response</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border-primary">
                                @foreach (var cmd in _guild.RecentCommandLogs)
                                {
                                    <tr class="hover:bg-bg-tertiary/50 transition-colors">
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="text-sm font-medium text-text-primary font-mono">/@cmd.CommandName</span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                                            <span class="preview-trigger" data-preview-type="user" data-user-id="@cmd.UserId" data-context-guild-id="@GuildId">@cmd.Username</span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                                            <span data-utc="@cmd.ExecutedAtUtcIso" data-format="datetime-short"></span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                                            @cmd.ResponseTimeMs ms
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            @if (cmd.Success)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-success/20 text-success">Success</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-error/20 text-error">Failed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Card Layout -->
                    <div class="md:hidden divide-y divide-border-primary">
                        @foreach (var cmd in _guild.RecentCommandLogs)
                        {
                            <div class="p-3 sm:p-4 hover:bg-bg-tertiary/50 transition-colors">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-medium text-text-primary font-mono">/@cmd.CommandName</span>
                                    @if (cmd.Success)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-success/20 text-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-error/20 text-error">Failed</span>
                                    }
                                </div>
                                <div class="space-y-1 text-sm">
                                    <div class="flex justify-between">
                                        <span class="text-text-tertiary">User:</span>
                                        <span class="text-text-secondary preview-trigger" data-preview-type="user" data-user-id="@cmd.UserId" data-context-guild-id="@GuildId">@cmd.Username</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-text-tertiary">Time:</span>
                                        <span class="text-text-secondary" data-utc="@cmd.ExecutedAtUtcIso" data-format="datetime-short"></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-text-tertiary">Response:</span>
                                        <span class="text-text-secondary">@cmd.ResponseTimeMs ms</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <EmptyState Type="EmptyStateType.NoData"
                                Title="No command activity yet"
                                Description="No commands have been executed in this server" />
                }
            </BodyContent>
        </DashboardWidget>
    </div>

}

@code {
    [Parameter] public long GuildId { get; set; }

    private GuildDetailViewModel? _guild;
    private List<BreadcrumbItem>? _breadcrumbItems;
    private List<HeaderAction>? _headerActions;

    // Widget data
    private bool _welcomeEnabled;
    private int _scheduledMessagesTotal;
    private int _scheduledMessagesActive;
    private int _scheduledMessagesPaused;
    private DateTime? _nextScheduledExecution;
    private string? _nextScheduledExecutionUtcIso;
    private string? _nextScheduledMessageTitle;
    private bool _ratWatchEnabled;
    private int _ratWatchTotal;
    private int _ratWatchPending;
    private int _ratWatchCompleted;
    private int _remindersTotal;
    private int _remindersPending;
    private int _remindersDeliveredToday;
    private int _remindersFailed;
    private int _membersTotalCount;
    private int _membersActiveToday;
    private bool _audioEnabled;
    private int _totalSoundCount;
    private string? _mostUsedTtsVoice;
    private bool _assistantGloballyEnabled;
    private bool _assistantLocallyEnabled;
    private int _assistantChannelCount;
    private int _assistantRateLimit;
    private bool _assistantIsRateLimitOverride;
    private int _assistantRateLimitWindowMinutes;

    private const int RecentCommandsLimit = 10;

    protected override async Task OnInitializedAsync()
    {
        var guildId = (ulong)GuildId;
        var ct = CancellationToken.None;
        var assistantOptions = AssistantOptionsAccessor.Value;

        Logger.LogInformation("User accessing guild details page for guild {GuildId}", guildId);

        var guildDto = await GuildService.GetGuildByIdAsync(guildId, ct);
        if (guildDto == null)
        {
            Logger.LogWarning("Guild {GuildId} not found", guildId);
            return;
        }

        // Fetch recent command activity
        var commandQuery = new CommandLogQueryDto { GuildId = guildId, Page = 1, PageSize = RecentCommandsLimit };
        var recentCommandsResponse = await CommandLogService.GetLogsAsync(commandQuery, ct);

        // Welcome configuration
        var welcomeConfig = await WelcomeService.GetConfigurationAsync(guildId, ct);
        _welcomeEnabled = welcomeConfig?.IsEnabled ?? false;

        // Scheduled messages summary
        var (scheduledMessages, totalCount) = await ScheduledMessageService.GetByGuildIdAsync(guildId, 1, 100, ct);
        var messagesList = scheduledMessages.ToList();
        _scheduledMessagesTotal = totalCount;
        _scheduledMessagesActive = messagesList.Count(m => m.IsEnabled);
        _scheduledMessagesPaused = messagesList.Count(m => !m.IsEnabled);

        var nextMessage = messagesList
            .Where(m => m.IsEnabled && m.NextExecutionAt.HasValue && m.NextExecutionAt.Value > DateTime.UtcNow)
            .OrderBy(m => m.NextExecutionAt)
            .FirstOrDefault();

        if (nextMessage != null)
        {
            _nextScheduledExecution = nextMessage.NextExecutionAt;
            _nextScheduledExecutionUtcIso = _nextScheduledExecution.HasValue
                ? DateTime.SpecifyKind(_nextScheduledExecution.Value, DateTimeKind.Utc).ToString("o")
                : null;
            _nextScheduledMessageTitle = nextMessage.Title;
        }

        // Rat Watch summary
        var ratWatchSettings = await RatWatchService.GetGuildSettingsAsync(guildId, ct);
        _ratWatchEnabled = ratWatchSettings.IsEnabled;
        var (ratWatches, ratWatchTotalCount) = await RatWatchService.GetByGuildAsync(guildId, 1, 100, ct);
        var ratWatchList = ratWatches.ToList();
        _ratWatchTotal = ratWatchTotalCount;
        _ratWatchPending = ratWatchList.Count(w => w.Status == RatWatchStatus.Pending || w.Status == RatWatchStatus.Voting);
        _ratWatchCompleted = ratWatchList.Count(w => w.Status == RatWatchStatus.Guilty || w.Status == RatWatchStatus.NotGuilty);

        // Reminder stats
        var (remindersTotal, remindersPending, remindersDeliveredToday, remindersFailed) =
            await ReminderRepository.GetGuildStatsAsync(guildId, ct);
        _remindersTotal = remindersTotal;
        _remindersPending = remindersPending;
        _remindersDeliveredToday = remindersDeliveredToday;
        _remindersFailed = remindersFailed;

        // Member stats
        var memberCountQuery = new GuildMemberQueryDto { IsActive = true };
        _membersTotalCount = await GuildMemberService.GetMemberCountAsync(guildId, memberCountQuery, ct);
        var activeTodayQuery = new GuildMemberQueryDto { IsActive = true, LastActiveAtStart = DateTime.UtcNow.Date };
        _membersActiveToday = await GuildMemberService.GetMemberCountAsync(guildId, activeTodayQuery, ct);

        // Audio widget data
        var audioSettings = await GuildAudioSettingsService.GetSettingsAsync(guildId, ct);
        _audioEnabled = audioSettings?.AudioEnabled ?? false;
        _totalSoundCount = await SoundRepository.GetSoundCountAsync(guildId, ct);
        var oneWeekAgo = DateTime.UtcNow.AddDays(-7);
        _mostUsedTtsVoice = await TtsMessageRepository.GetMostUsedVoiceAsync(guildId, oneWeekAgo, ct);

        // Assistant widget data
        _assistantGloballyEnabled = assistantOptions.GloballyEnabled;
        var assistantSettings = await AssistantGuildSettingsService.GetOrCreateSettingsAsync(guildId, ct);
        _assistantLocallyEnabled = assistantSettings.IsEnabled;
        _assistantChannelCount = assistantSettings.GetAllowedChannelIdsList().Count;
        _assistantIsRateLimitOverride = assistantSettings.RateLimitOverride.HasValue;
        _assistantRateLimit = assistantSettings.RateLimitOverride ?? assistantOptions.DefaultRateLimit;
        _assistantRateLimitWindowMinutes = assistantOptions.RateLimitWindowMinutes;

        // Build view model
        _guild = GuildDetailViewModel.FromDto(guildDto, recentCommandsResponse.Items);

        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new() { Label = "Home", Url = "/" },
            new() { Label = "Servers", Url = "/Guilds" },
            new() { Label = guildDto.Name, IsCurrent = true }
        };

        _headerActions = _guild.CanEdit ? new List<HeaderAction>
        {
            new()
            {
                Label = "Sync",
                Url = "#",
                Icon = "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
                Style = HeaderActionStyle.Secondary
            },
            new()
            {
                Label = "Edit Settings",
                Url = $"/Guilds/Edit?id={guildDto.Id}",
                Icon = "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
                Style = HeaderActionStyle.Primary
            }
        } : null;

        Logger.LogDebug("Retrieved guild {GuildId} with {CommandCount} recent commands",
            guildId, recentCommandsResponse.Items.Count);
    }
}

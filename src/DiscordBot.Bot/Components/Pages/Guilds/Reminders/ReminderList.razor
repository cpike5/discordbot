@page "/guilds/{GuildId:long}/reminders"
@attribute [Authorize(Policy = "GuildAccess")]
@layout GuildLayout
@rendermode InteractiveServer

@using Discord.WebSocket
@using DiscordBot.Bot.ViewModels.Pages
@using DiscordBot.Core.Enums
@using DiscordBot.Core.Interfaces

@inject IReminderRepository ReminderRepository
@inject IGuildService GuildService
@inject DiscordSocketClient DiscordClient
@inject ILogger<ReminderList> Logger

<PageTitle>Reminders - @(_guildName ?? "Loading") - Discord Bot Admin</PageTitle>

@if (_isLoading)
{
    <div class="flex items-center justify-center py-12">
        <LoadingSpinner Message="Loading reminders..." />
    </div>
}
else if (_guildName is null)
{
    <EmptyState Type="EmptyStateType.Error"
                Title="Guild Not Found"
                Description="The requested guild could not be found." />
}
else
{
    <!-- Breadcrumb -->
    <GuildBreadcrumb Items="@_breadcrumbItems" />

    <!-- Guild Header -->
    <GuildHeader GuildId="(ulong)GuildId"
                 GuildName="@_guildName"
                 GuildIconUrl="@_guildIconUrl"
                 PageTitle="Reminders"
                 PageDescription="View and manage scheduled reminders for this server" />

    <!-- Guild Navigation Tabs -->
    <GuildTabNavigation GuildId="(ulong)GuildId" ActiveTab="reminders" />

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="mb-6">
            <Alert Variant="AlertVariant.Success" Message="@_successMessage" IsDismissible="true" OnDismiss="() => _successMessage = null" />
        </div>
    }
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="mb-6">
            <Alert Variant="AlertVariant.Error" Message="@_errorMessage" IsDismissible="true" OnDismiss="() => _errorMessage = null" />
        </div>
    }

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6 mb-6">
        <!-- Total Reminders -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Total Reminders</p>
                    <p class="mt-2 text-3xl font-bold text-text-primary">@_stats.TotalCount.ToString("N0")</p>
                    <p class="mt-1 text-xs text-text-tertiary">All-time</p>
                </div>
                <div class="p-3 bg-accent-blue/10 rounded-lg">
                    <svg class="w-6 h-6 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Pending -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Pending</p>
                    <p class="mt-2 text-3xl font-bold text-accent-blue">@_stats.PendingCount.ToString("N0")</p>
                    <p class="mt-1 text-xs text-text-tertiary">Awaiting delivery</p>
                </div>
                <div class="p-3 bg-accent-blue/10 rounded-lg">
                    <svg class="w-6 h-6 text-accent-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Delivered Today -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Delivered Today</p>
                    <p class="mt-2 text-3xl font-bold text-success">@_stats.DeliveredTodayCount.ToString("N0")</p>
                    <p class="mt-1 text-xs text-text-tertiary">Successfully sent</p>
                </div>
                <div class="p-3 bg-success/10 rounded-lg">
                    <svg class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Failed -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-text-secondary">Failed</p>
                    <p class="mt-2 text-3xl font-bold @(_stats.FailedCount > 0 ? "text-error" : "text-text-primary")">@_stats.FailedCount.ToString("N0")</p>
                    <p class="mt-1 text-xs text-text-tertiary">Needs attention</p>
                </div>
                <div class="p-3 @(_stats.FailedCount > 0 ? "bg-error/10" : "bg-bg-tertiary") rounded-lg">
                    <svg class="w-6 h-6 @(_stats.FailedCount > 0 ? "text-error" : "text-text-tertiary")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
        <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-1">
                <FormSelect Id="statusFilter"
                            Label="Status"
                            Placeholder="All Statuses"
                            SelectedValue="@_statusFilterValue"
                            SelectedValueChanged="OnStatusFilterChanged"
                            Options="@_statusOptions" />
            </div>
            @if (_statusFilter.HasValue)
            {
                <div class="flex items-end">
                    <Button Text="Clear Filters" Variant="ButtonVariant.Ghost" OnClick="ClearFilters" />
                </div>
            }
        </div>
    </div>

    <!-- Reminders Table -->
    @if (_viewModel is not null && _viewModel.TotalCount > 0)
    {
        <!-- Desktop Table -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden hidden md:block">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px]">
                    <thead class="bg-bg-tertiary border-b border-border-primary">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">User</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Message</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Trigger Time</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Created</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var reminder in _viewModel.Reminders)
                        {
                            <tr class="hover:bg-bg-hover transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(reminder.AvatarUrl))
                                        {
                                            <img src="@reminder.AvatarUrl" alt="" class="w-8 h-8 rounded-full" />
                                        }
                                        else
                                        {
                                            <div class="w-8 h-8 rounded-full bg-bg-tertiary flex items-center justify-center">
                                                <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                            </div>
                                        }
                                        <span class="preview-trigger text-sm text-text-primary" data-preview-type="user" data-user-id="@reminder.UserId" data-context-guild-id="@_guildId">@reminder.Username</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-text-secondary max-w-[250px] truncate block" title="@reminder.Message">
                                        @reminder.MessagePreview
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-text-primary" data-utc="@reminder.TriggerAtUtcIso" data-format="datetime-short"></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-text-secondary" data-utc="@reminder.CreatedAtUtcIso" data-format="datetime-short"></span>
                                </td>
                                <td class="px-6 py-4">
                                    @{
                                        var reminderBadgeVariant = reminder.Status switch
                                        {
                                            ReminderStatus.Pending => BadgeVariant.Blue,
                                            ReminderStatus.Delivered => BadgeVariant.Success,
                                            ReminderStatus.Failed => BadgeVariant.Error,
                                            ReminderStatus.Cancelled => BadgeVariant.Default,
                                            _ => BadgeVariant.Default
                                        };
                                    }
                                    <Badge Text="@reminder.StatusText" Variant="reminderBadgeVariant" Size="BadgeSize.Small" Style="BadgeStyle.Subtle" />
                                    @if (reminder.Status == ReminderStatus.Failed && !string.IsNullOrEmpty(reminder.LastError))
                                    {
                                        <span class="ml-2 cursor-help" title="@reminder.LastError">
                                            <svg class="w-4 h-4 text-error inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-end gap-1">
                                        @if (reminder.CanCancel)
                                        {
                                            <Button IsIconOnly="true"
                                                    Variant="ButtonVariant.Ghost"
                                                    IconLeft="M6 18L18 6M6 6l12 12"
                                                    AriaLabel="Cancel Reminder"
                                                    OnClick="() => ShowCancelConfirmation(reminder.Id, reminder.Username)" />
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (_viewModel.TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-border-primary">
                    @{
                        var baseUrl = _statusFilter.HasValue
                            ? $"/guilds/{GuildId}/reminders?status={(int)_statusFilter.Value}"
                            : $"/guilds/{GuildId}/reminders";
                    }
                    <Pagination CurrentPage="_viewModel.CurrentPage"
                                TotalPages="_viewModel.TotalPages"
                                TotalItems="_viewModel.TotalCount"
                                PageSize="_viewModel.PageSize"
                                BaseUrl="@baseUrl"
                                Style="PaginationStyle.Full"
                                ShowItemCount="true" />
                </div>
            }
        </div>

        <!-- Mobile Card Layout -->
        <div class="md:hidden space-y-4">
            @foreach (var reminder in _viewModel.Reminders)
            {
                var mobileBadgeVariant = reminder.Status switch
                {
                    ReminderStatus.Pending => BadgeVariant.Blue,
                    ReminderStatus.Delivered => BadgeVariant.Success,
                    ReminderStatus.Failed => BadgeVariant.Error,
                    ReminderStatus.Cancelled => BadgeVariant.Default,
                    _ => BadgeVariant.Default
                };
                <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrEmpty(reminder.AvatarUrl))
                            {
                                <img src="@reminder.AvatarUrl" alt="" class="w-8 h-8 rounded-full" />
                            }
                            else
                            {
                                <div class="w-8 h-8 rounded-full bg-bg-tertiary flex items-center justify-center">
                                    <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </div>
                            }
                            <span class="preview-trigger text-sm font-medium text-text-primary" data-preview-type="user" data-user-id="@reminder.UserId" data-context-guild-id="@_guildId">@reminder.Username</span>
                        </div>
                        <Badge Text="@reminder.StatusText" Variant="mobileBadgeVariant" Size="BadgeSize.Small" Style="BadgeStyle.Subtle" />
                    </div>
                    <div class="space-y-2 text-sm">
                        <p class="text-text-secondary truncate" title="@reminder.Message">@reminder.MessagePreview</p>
                        <div class="grid grid-cols-2 gap-2 text-xs text-text-tertiary">
                            <div>
                                <span class="text-text-secondary">Trigger:</span>
                                <span data-utc="@reminder.TriggerAtUtcIso" data-format="datetime-short"></span>
                            </div>
                            <div>
                                <span class="text-text-secondary">Created:</span>
                                <span data-utc="@reminder.CreatedAtUtcIso" data-format="datetime-short"></span>
                            </div>
                        </div>
                    </div>
                    @if (reminder.CanCancel)
                    {
                        <div class="flex items-center gap-2 pt-3 mt-3 border-t border-border-secondary">
                            <Button Text="Cancel Reminder"
                                    Variant="ButtonVariant.Danger"
                                    Size="ButtonSize.Small"
                                    OnClick="() => ShowCancelConfirmation(reminder.Id, reminder.Username)" />
                        </div>
                    }
                </div>
            }

            <!-- Mobile Pagination -->
            @if (_viewModel.TotalPages > 1)
            {
                <div class="mt-4">
                    @{
                        var mobileBaseUrl = _statusFilter.HasValue
                            ? $"/guilds/{GuildId}/reminders?status={(int)_statusFilter.Value}"
                            : $"/guilds/{GuildId}/reminders";
                    }
                    <Pagination CurrentPage="_viewModel.CurrentPage"
                                TotalPages="_viewModel.TotalPages"
                                TotalItems="_viewModel.TotalCount"
                                PageSize="_viewModel.PageSize"
                                BaseUrl="@mobileBaseUrl"
                                Style="PaginationStyle.Full"
                                ShowItemCount="true" />
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
            @{
                var emptyTitle = _statusFilter.HasValue ? "No Reminders Match Filter" : "No Reminders Yet";
                var emptyDescription = _statusFilter.HasValue
                    ? "No reminders match the selected status filter. Try adjusting your filters."
                    : "No reminders have been created in this server. Users can create reminders using the /remind command in Discord.";
            }
            <EmptyState Type="@(_statusFilter.HasValue ? EmptyStateType.NoResults : EmptyStateType.FirstTime)"
                        Title="@emptyTitle"
                        Description="@emptyDescription"
                        IconSvgPath="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </div>
    }

    <!-- Cancel Confirmation Modal -->
    <ConfirmationModal Id="cancelReminder"
                       Title="Cancel Reminder"
                       Message="@($"Are you sure you want to cancel the reminder for {_cancelUsername}? This action cannot be undone.")"
                       ConfirmText="Cancel Reminder"
                       CancelText="Keep Reminder"
                       Variant="ConfirmationVariant.Warning"
                       IsVisible="_showCancelModal"
                       IsVisibleChanged="(bool v) => _showCancelModal = v"
                       OnConfirm="ConfirmCancel" />
}

@code {
    [Parameter] public long GuildId { get; set; }

    private ulong _guildId => (ulong)GuildId;
    private string? _guildName;
    private string? _guildIconUrl;
    private bool _isLoading = true;
    private RemindersIndexViewModel? _viewModel;
    private ReminderStatsViewModel _stats = new();
    private List<BreadcrumbItem>? _breadcrumbItems;
    private string? _successMessage;
    private string? _errorMessage;

    // Filter state
    private ReminderStatus? _statusFilter;
    private string? _statusFilterValue;

    // Cancel modal state
    private bool _showCancelModal;
    private Guid _cancelReminderId;
    private string _cancelUsername = string.Empty;

    // Pagination
    private int _currentPage = 1;

    [SupplyParameterFromQuery(Name = "page")]
    public int? QueryPage { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public int? QueryStatus { get; set; }

    private static readonly List<SelectOption> _statusOptions = new()
    {
        new() { Value = ((int)ReminderStatus.Pending).ToString(), Text = "Pending" },
        new() { Value = ((int)ReminderStatus.Delivered).ToString(), Text = "Delivered" },
        new() { Value = ((int)ReminderStatus.Failed).ToString(), Text = "Failed" },
        new() { Value = ((int)ReminderStatus.Cancelled).ToString(), Text = "Cancelled" }
    };

    protected override async Task OnInitializedAsync()
    {
        _currentPage = QueryPage ?? 1;

        if (QueryStatus.HasValue && Enum.IsDefined(typeof(ReminderStatus), QueryStatus.Value))
        {
            _statusFilter = (ReminderStatus)QueryStatus.Value;
            _statusFilterValue = QueryStatus.Value.ToString();
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;

        try
        {
            var page = _currentPage;
            var pageSize = 20;
            if (page < 1) page = 1;

            Logger.LogInformation("User accessing Reminders admin page for guild {GuildId}, page {Page}", _guildId, page);

            var guild = await GuildService.GetGuildByIdAsync(_guildId);
            if (guild == null)
            {
                Logger.LogWarning("Guild {GuildId} not found", _guildId);
                return;
            }

            _guildName = guild.Name;
            _guildIconUrl = guild.IconUrl;

            // Get reminders with pagination and filtering
            var (reminders, totalCount) = await ReminderRepository.GetByGuildAsync(_guildId, page, pageSize, _statusFilter);

            // Get statistics
            var (totalStats, pendingStats, deliveredTodayStats, failedStats) = await ReminderRepository.GetGuildStatsAsync(_guildId);
            _stats = new ReminderStatsViewModel
            {
                TotalCount = totalStats,
                PendingCount = pendingStats,
                DeliveredTodayCount = deliveredTodayStats,
                FailedCount = failedStats
            };

            // Populate user information - deduplicate user IDs to avoid N+1 API calls
            var reminderItems = new List<ReminderItemViewModel>();
            var socketGuild = DiscordClient.GetGuild(_guildId);
            var uniqueUserIds = reminders.Select(r => r.UserId).Distinct().ToList();
            var userInfoCache = new Dictionary<ulong, (string Username, string? AvatarUrl)>();

            foreach (var userId in uniqueUserIds)
            {
                string username = $"Unknown ({userId})";
                string? avatarUrl = null;

                if (socketGuild != null)
                {
                    var socketUser = socketGuild.GetUser(userId);
                    if (socketUser != null)
                    {
                        username = socketUser.GlobalName ?? socketUser.Username;
                        avatarUrl = socketUser.GetAvatarUrl() ?? socketUser.GetDefaultAvatarUrl();
                    }
                    else
                    {
                        try
                        {
                            var restUser = await DiscordClient.Rest.GetUserAsync(userId);
                            if (restUser != null)
                            {
                                username = restUser.GlobalName ?? restUser.Username;
                                avatarUrl = restUser.GetAvatarUrl() ?? restUser.GetDefaultAvatarUrl();
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogDebug(ex, "Could not fetch Discord user {UserId}", userId);
                        }
                    }
                }

                userInfoCache[userId] = (username, avatarUrl);
            }

            foreach (var reminder in reminders)
            {
                var item = ReminderItemViewModel.FromEntity(reminder);
                var (username, avatarUrl) = userInfoCache.GetValueOrDefault(reminder.UserId, ($"Unknown ({reminder.UserId})", null));
                item = item.WithUserInfo(username, avatarUrl);
                reminderItems.Add(item);
            }

            _viewModel = new RemindersIndexViewModel
            {
                GuildId = _guildId,
                GuildName = guild.Name,
                GuildIconUrl = guild.IconUrl,
                Reminders = reminderItems,
                TotalCount = totalCount,
                Stats = _stats,
                CurrentPage = page,
                PageSize = pageSize,
                StatusFilter = _statusFilter
            };

            _breadcrumbItems = new List<BreadcrumbItem>
            {
                new() { Label = "Home", Url = "/" },
                new() { Label = "Servers", Url = "/guilds" },
                new() { Label = guild.Name, Url = $"/Guilds/Details/{guild.Id}" },
                new() { Label = "Reminders", IsCurrent = true }
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading reminders for guild {GuildId}", _guildId);
            _errorMessage = "An error occurred while loading reminders.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilterValue = value;
        if (string.IsNullOrEmpty(value))
        {
            _statusFilter = null;
        }
        else if (int.TryParse(value, out var intValue) && Enum.IsDefined(typeof(ReminderStatus), intValue))
        {
            _statusFilter = (ReminderStatus)intValue;
        }

        _currentPage = 1;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        _statusFilter = null;
        _statusFilterValue = null;
        _currentPage = 1;
        await LoadData();
    }

    private void ShowCancelConfirmation(Guid reminderId, string username)
    {
        _cancelReminderId = reminderId;
        _cancelUsername = username;
        _showCancelModal = true;
    }

    private async Task ConfirmCancel()
    {
        try
        {
            Logger.LogInformation("User attempting to cancel reminder {ReminderId} for guild {GuildId}", _cancelReminderId, _guildId);

            var reminder = await ReminderRepository.GetByIdAsync(_cancelReminderId);
            if (reminder == null || reminder.GuildId != _guildId)
            {
                _errorMessage = "Reminder not found.";
                return;
            }

            if (reminder.Status != ReminderStatus.Pending)
            {
                _errorMessage = "Only pending reminders can be cancelled.";
                return;
            }

            reminder.Status = ReminderStatus.Cancelled;
            await ReminderRepository.UpdateAsync(reminder);

            Logger.LogInformation("Successfully cancelled reminder {ReminderId}", _cancelReminderId);
            _successMessage = "Reminder cancelled successfully.";
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cancelling reminder {ReminderId}", _cancelReminderId);
            _errorMessage = "An error occurred while cancelling the reminder.";
        }
    }
}

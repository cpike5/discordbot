@page "/Admin/Users/Details"
@attribute [Authorize(Policy = "RequireAdmin")]
@rendermode InteractiveServer
@layout MainLayout
@using DiscordBot.Bot.ViewModels.Components

@*
    Routable replacement for Pages/Admin/Users/Details.cshtml + DetailsModel
    (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4a). See Details.razor.cs for the load
    logic this markup renders. Timestamps follow the interim <time data-utc data-format> contract
    (see this cluster's task notes) until the concurrent LocalTime component lands.
*@

<PageTitle>User Details</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb Items="@(new List<BreadcrumbItem> { new() { Label = "Users", Url = "/Admin/Users" }, new() { Label = "Details", IsCurrent = true } })" />

    @if (IsLoading)
    {
        <SkeletonCard />
    }
    else if (UserNotFound)
    {
        <EmptyState Type="EmptyStateType.NoData" Size="EmptyStateSize.Large"
                    Title="User Not Found"
                    Description="This user doesn't exist or has been removed."
                    PrimaryActionText="Back to Users" PrimaryActionHref="/Admin/Users" />
    }
    else
    {
        var user = User!;
        <div class="mb-6">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-text-primary">User Details</h1>
                    <p class="mt-1 text-sm text-text-secondary">View user information and activity history</p>
                </div>
                @if (CanEdit)
                {
                    <a href="@UserEditUrl(user.Id)" class="btn btn-primary">
                        <Icon Path="@IconPaths.PencilSquare" Class="w-5 h-5 mr-2" />
                        Edit User
                    </a>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-1">
                <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
                    <div class="flex justify-center mb-4">
                        @if (!string.IsNullOrEmpty(user.DiscordAvatarUrl))
                        {
                            <img class="h-24 w-24 rounded-full" src="@user.DiscordAvatarUrl" alt="@user.Email" />
                        }
                        else
                        {
                            <div class="h-24 w-24 rounded-full bg-accent-blue flex items-center justify-center">
                                <span class="text-white font-bold text-3xl">@user.Email.Substring(0, 1).ToUpper()</span>
                            </div>
                        }
                    </div>

                    <div class="text-center mb-6">
                        <h2 class="text-xl font-bold text-text-primary">@(user.DisplayName ?? user.Email)</h2>
                        @if (!string.IsNullOrEmpty(user.DisplayName))
                        {
                            <p class="text-sm text-text-secondary mt-1">@user.Email</p>
                        }
                    </div>

                    <div class="flex justify-center mb-6">
                        <Badge Text="@user.HighestRole" Variant="RoleBadgeVariant(user.HighestRole)" />
                    </div>

                    <div class="mb-6">
                        <StatusIndicator Status="@(user.IsActive ? StatusType.Online : StatusType.Offline)"
                                         Text="@(user.IsActive ? "Active Account" : "Inactive Account")" />
                    </div>

                    <div class="space-y-3 border-t border-border-primary pt-4">
                        <div class="flex justify-between text-sm">
                            <span class="text-text-secondary">Member Since</span>
                            <time datetime="@user.CreatedAtUtcIso" data-utc="@user.CreatedAtUtcIso" data-format="date"
                                  class="text-text-primary font-medium">@user.CreatedAt.ToString("MMM d, yyyy")</time>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-text-secondary">Last Login</span>
                            <span class="text-text-primary font-medium">
                                @if (user.LastLoginAt.HasValue)
                                {
                                    <time datetime="@user.LastLoginAtUtcIso" data-utc="@user.LastLoginAtUtcIso" data-format="date">@user.LastLoginAt.Value.ToString("MMM d, yyyy")</time>
                                }
                                else
                                {
                                    <span class="text-text-tertiary">Never</span>
                                }
                            </span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-text-secondary">Email Confirmed</span>
                            <span class="text-text-primary font-medium">
                                @if (user.EmailConfirmed)
                                {
                                    <span class="text-success">Yes</span>
                                }
                                else
                                {
                                    <span class="text-warning">No</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>

                @if (user.IsDiscordLinked)
                {
                    <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 mt-6">
                        <h3 class="text-lg font-semibold text-text-primary mb-4">Discord Account</h3>
                        <div class="space-y-3">
                            <div class="flex items-center gap-2">
                                <Icon Path="@IconPaths.User" Class="w-5 h-5 text-accent-blue" />
                                <span class="text-sm font-medium text-text-primary">@user.DiscordUsername</span>
                            </div>
                            <div class="text-xs text-text-tertiary">ID: @user.DiscordUserId</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 mt-6">
                        <div class="text-center py-4">
                            <Icon Path="@IconPaths.User" Class="w-12 h-12 mx-auto text-text-tertiary mb-2" />
                            <p class="text-sm text-text-secondary">No Discord account linked</p>
                        </div>
                    </div>
                }
            </div>

            <div class="lg:col-span-2">
                <div class="bg-bg-secondary border border-border-primary rounded-lg">
                    <div class="px-6 py-4 border-b border-border-primary">
                        <h2 class="text-lg font-semibold text-text-primary">Recent Activity</h2>
                    </div>
                    <div class="overflow-x-auto">
                        @if (RecentActivity.Count > 0)
                        {
                            <table class="min-w-full divide-y divide-border-primary">
                                <thead class="bg-bg-tertiary">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Action</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Actor</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Details</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Date</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-border-primary">
                                    @foreach (var activity in RecentActivity)
                                    {
                                        var badge = ActivityBadge(activity.Action);
                                        <tr class="hover:bg-bg-tertiary/50">
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <Badge Text="@badge.Text" Variant="badge.Variant" Size="BadgeSize.Small" />
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-text-primary">@activity.ActorEmail</td>
                                            <td class="px-6 py-4 text-sm text-text-secondary">
                                                @if (!string.IsNullOrEmpty(activity.Details))
                                                {
                                                    <span class="truncate max-w-md block">@activity.Details</span>
                                                }
                                                else
                                                {
                                                    <span class="text-text-tertiary">-</span>
                                                }
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                                                <time datetime="@activity.TimestampUtcIso" data-utc="@activity.TimestampUtcIso" data-format="datetime-short">@activity.Timestamp.ToString("MMM d, h:mm tt")</time>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="p-12 text-center">
                                <EmptyState Type="EmptyStateType.NoData" Title="No activity yet" Description="This user has no recorded activity" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

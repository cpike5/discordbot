@page "/Admin/Users"
@attribute [Authorize(Policy = "RequireAdmin")]
@rendermode InteractiveServer
@layout MainLayout
@using DiscordBot.Bot.ViewModels.Components

@*
    Routable replacement for Pages/Admin/Users/Index.cshtml + IndexModel
    (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4a "Simple admin"). See Index.razor.cs for
    the query/persistence/toggle logic this markup renders. Timestamps follow the interim
    <time data-utc data-format> contract (see this cluster's task notes) until the concurrent
    LocalTime component lands and every such element in this file switches to it.
*@

<PageTitle>User Management</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PageHeader Title="Users" Subtitle="Manage application users and their roles">
        <Actions>
            @if (CanCreateUsers)
            {
                <a href="/Admin/Users/Create" class="btn btn-primary">
                    <Icon Path="@IconPaths.Plus" Class="w-5 h-5 mr-2" />
                    Create User
                </a>
            }
        </Actions>
    </PageHeader>

    <!-- Search and Filters -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
        <form @onsubmit="HandleFilterSubmit" @onsubmit:preventDefault="true" class="grid grid-cols-1 md:grid-cols-4 gap-4" data-testid="users-filter-form">
            <TextInput Id="SearchTerm" Label="Search" @bind-Value="SearchTermInput" Placeholder="Email, name, or Discord username..." />

            <Select TValue="string" Id="RoleFilter" Label="Role" @bind-Value="RoleFilterInput" Placeholder="" Options="RoleFilterOptions" />

            <Select TValue="string" Id="ActiveFilter" Label="Status" @bind-Value="ActiveFilterInput" Placeholder="" Options="ActiveFilterOptions" />

            <Select TValue="string" Id="DiscordLinkedFilter" Label="Discord" @bind-Value="DiscordLinkedFilterInput" Placeholder="" Options="DiscordLinkedFilterOptions" />

            <div class="md:col-span-4 flex justify-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="HandleClearFilters">Clear</button>
                <button type="submit" class="btn btn-primary">
                    <Icon Path="@IconPaths.MagnifyingGlass" Class="w-4 h-4 mr-2" />
                    Search
                </button>
            </div>
        </form>
    </div>

    <!-- Users Table -->
    <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-border-primary">
                <thead class="bg-bg-tertiary">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">User</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Role</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Discord</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Last Login</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-primary">
                    @if (Users.Count > 0)
                    {
                        @foreach (var user in Users)
                        {
                            <tr class="hover:bg-bg-tertiary/50 transition-colors" data-testid="users-row">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        @if (!string.IsNullOrEmpty(user.DiscordAvatarUrl))
                                        {
                                            <img class="h-10 w-10 rounded-full" src="@user.DiscordAvatarUrl" alt="@user.Email" />
                                        }
                                        else
                                        {
                                            <div class="h-10 w-10 rounded-full bg-accent-blue flex items-center justify-center">
                                                <span class="text-white font-medium text-sm">@user.Email.Substring(0, 1).ToUpper()</span>
                                            </div>
                                        }
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-text-primary">@user.Email</div>
                                            @if (!string.IsNullOrEmpty(user.DisplayName))
                                            {
                                                <div class="text-sm text-text-secondary">@user.DisplayName</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <Badge Text="@user.HighestRole" Variant="RoleBadgeVariant(user.HighestRole)" Size="BadgeSize.Small" />
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <StatusIndicator Status="@(user.IsActive ? StatusType.Online : StatusType.Offline)" Text="@(user.IsActive ? "Active" : "Inactive")" />
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (user.IsDiscordLinked)
                                    {
                                        <div class="flex items-center text-sm text-text-primary">
                                            <Icon Path="@IconPaths.User" Class="w-4 h-4 mr-1.5 text-accent-blue" />
                                            @user.DiscordUsername
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-sm text-text-tertiary">-</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                                    @if (user.LastLoginAt.HasValue)
                                    {
                                        <time datetime="@user.LastLoginAtUtcIso" data-utc="@user.LastLoginAtUtcIso" data-format="date">@user.LastLoginAt.Value.ToString("MMM d, yyyy")</time>
                                    }
                                    else
                                    {
                                        <span class="text-text-tertiary">Never</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <div class="flex justify-end gap-2">
                                        <a href="@UserDetailsUrl(user.Id)" class="text-accent-blue hover:text-accent-blue/80">View</a>
                                        <a href="@UserEditUrl(user.Id)" class="text-accent-blue hover:text-accent-blue/80">Edit</a>
                                        <button type="button" class="text-accent-blue hover:text-accent-blue/80" @onclick="() => RequestToggleActive(user)">
                                            @(user.IsActive ? "Disable" : "Enable")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center">
                                <EmptyState Type="EmptyStateType.NoResults"
                                            Title="@(SearchTerm != null ? "No users found" : "No users yet")"
                                            Description="@(SearchTerm != null ? "Try adjusting your search or filters" : "Create your first user to get started")" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-border-primary">
                <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" TotalItems="TotalCount" PageSize="PageSize"
                            OnPageChanged="HandlePageChanged" />
            </div>
        }
    </div>

    <div class="mt-4 text-sm text-text-secondary">
        Showing @((CurrentPage - 1) * PageSize + 1) to @Math.Min(CurrentPage * PageSize, TotalCount) of @TotalCount users
    </div>
</div>

<ConfirmModal @ref="_toggleModal" Id="toggle-active-modal" Title="@(_pendingToggleUser?.IsActive == true ? "Disable User" : "Enable User")"
              Message="@ToggleModalMessage" ConfirmText="@(_pendingToggleUser?.IsActive == true ? "Disable" : "Enable")"
              Variant="@(_pendingToggleUser?.IsActive == true ? ConfirmationVariant.Danger : ConfirmationVariant.Info)" />

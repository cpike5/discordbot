@page "/Admin/LlmUsage"
@attribute [Authorize(Policy = "RequireAdmin")]
@rendermode InteractiveServer
@layout MainLayout
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums

@*
    Routable replacement for Pages/Admin/LlmUsage.cshtml + LlmUsageModel
    (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4d). LlmUsageController retires with this
    page - the per-user drill-down (llm-usage.js's api/admin/llm-usage/records call) becomes a
    paged component method over ILlmUsageRepository.GetRecordsAsync directly. See Index.razor.cs.
*@

<PageTitle>LLM Usage</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PageHeader Title="LLM Usage" Subtitle="Token and cost usage across the assistant" />

    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
        <form @onsubmit="HandleFilterSubmit" @onsubmit:preventDefault="true" class="space-y-4" data-testid="llm-usage-filter-form">
            <div class="flex flex-wrap gap-2">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ApplyPreset(7)">Last 7 Days</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ApplyPreset(30)">Last 30 Days</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ApplyPreset(90)">Last 90 Days</button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label for="startDate" class="block text-sm font-medium text-text-secondary mb-1">Start Date</label>
                    <input type="date" id="startDate" class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary" @bind="StartInput" />
                </div>
                <div>
                    <label for="endDate" class="block text-sm font-medium text-text-secondary mb-1">End Date</label>
                    <input type="date" id="endDate" class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary" @bind="EndInput" />
                </div>
                <Select TValue="string" Id="guildFilter" Label="Guild" @bind-Value="GuildIdInput" Placeholder="All guilds" Options="GuildOptions" />
                <Select TValue="string" Id="modeFilter" Label="Mode" @bind-Value="ModeInput" Placeholder="All modes" Options="ModeOptions" />
            </div>

            <div class="flex justify-end gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </form>
    </div>

    @if (LoadFailed)
    {
        <Alert Variant="AlertVariant.Error" Title="Couldn't load usage data" Message="Something went wrong loading this data. Try reloading." />
    }
    else if (IsLoading)
    {
        <div class="p-8 text-center text-text-secondary">Loading...</div>
    }
    else
    {
        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">
            <HeroMetricCard Title="Messages" Value="@Totals.MessageCount.ToString("N0")" IconPath="@IconPaths.ChatBubbleLeftEllipsis" AccentColor="CardAccent.Blue" />
            <HeroMetricCard Title="Input Tokens" Value="@FormatTokens(Totals.InputTokens)" IconPath="@IconPaths.ArrowDown" AccentColor="CardAccent.Info" />
            <HeroMetricCard Title="Output Tokens" Value="@FormatTokens(Totals.OutputTokens)" IconPath="@IconPaths.ArrowUp" AccentColor="CardAccent.Info" />
            <HeroMetricCard Title="Cached Tokens" Value="@FormatTokens(Totals.CachedTokens)" IconPath="@IconPaths.ServerStack" AccentColor="CardAccent.Success" />
            <HeroMetricCard Title="Cost" Value="@($"${Totals.CostUsd:N2}")" IconPath="@IconPaths.CurrencyDollar" AccentColor="CardAccent.Orange" />
            <HeroMetricCard Title="Avg Latency" Value="@($"{Totals.AverageLatencyMs:N0} ms")" IconPath="@IconPaths.Clock" AccentColor="CardAccent.Blue" />
        </div>

        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-6">
            <div class="px-6 py-4 border-b border-border-primary">
                <h2 class="text-lg font-semibold text-text-primary">Cost by User</h2>
            </div>
            @if (ByUser.Count == 0)
            {
                <div class="p-8"><EmptyState Type="EmptyStateType.NoData" Title="No usage" Description="No LLM usage recorded for this range." /></div>
            }
            else
            {
                <table class="min-w-full divide-y divide-border-primary">
                    <thead class="bg-bg-tertiary">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">User</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Messages</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Share</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var u in ByUser)
                        {
                            <tr class="hover:bg-bg-tertiary/50 transition-colors cursor-pointer @(SelectedUserId == u.UserId ? "bg-bg-tertiary" : "")"
                                data-testid="llm-usage-user-row" @onclick="() => SelectUserAsync(u.UserId)">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-primary">@u.DisplayName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary text-right">@u.MessageCount.ToString("N0")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary text-right">$@u.CostUsd.ToString("N2")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary text-right">@((u.CostShare * 100).ToString("N0"))%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (SelectedUserId is not null)
            {
                <div class="border-t border-border-primary p-4" data-testid="llm-usage-drilldown">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-sm font-semibold text-text-primary">Records for @(ByUser.FirstOrDefault(u => u.UserId == SelectedUserId)?.DisplayName ?? SelectedUserId)</h3>
                        <button type="button" class="text-sm text-text-secondary hover:text-text-primary" @onclick="() => SelectedUserId = null">Close</button>
                    </div>
                    @if (DrilldownRecords.Count == 0)
                    {
                        <p class="text-sm text-text-tertiary">No records found.</p>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-border-primary text-sm">
                                <thead>
                                    <tr>
                                        <th class="px-3 py-2 text-left text-xs text-text-tertiary uppercase">Time</th>
                                        <th class="px-3 py-2 text-left text-xs text-text-tertiary uppercase">Model</th>
                                        <th class="px-3 py-2 text-right text-xs text-text-tertiary uppercase">Tokens</th>
                                        <th class="px-3 py-2 text-right text-xs text-text-tertiary uppercase">Cost</th>
                                        <th class="px-3 py-2 text-center text-xs text-text-tertiary uppercase">Success</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-border-primary">
                                    @foreach (var r in DrilldownRecords)
                                    {
                                        <tr data-testid="llm-usage-drilldown-row">
                                            <td class="px-3 py-2"><LocalTime Utc="r.Timestamp" Format="datetime-short" /></td>
                                            <td class="px-3 py-2">@r.Model</td>
                                            <td class="px-3 py-2 text-right">@((r.InputTokens + r.OutputTokens).ToString("N0"))</td>
                                            <td class="px-3 py-2 text-right">$@r.CostUsd.ToString("N4")</td>
                                            <td class="px-3 py-2 text-center">@(r.Success ? "✓" : "✗")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (DrilldownTotalPages > 1)
                        {
                            <div class="mt-3">
                                <Pagination CurrentPage="DrilldownPage" TotalPages="DrilldownTotalPages" TotalItems="DrilldownTotalCount" PageSize="DrilldownPageSize"
                                            Style="PaginationStyle.Compact" OnPageChanged="LoadDrilldownPageAsync" />
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <div class="px-6 py-4 border-b border-border-primary"><h2 class="text-lg font-semibold text-text-primary">By Model</h2></div>
                <table class="min-w-full divide-y divide-border-primary">
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var m in ByModel)
                        {
                            <tr>
                                <td class="px-6 py-3 text-sm text-text-primary">@m.Model</td>
                                <td class="px-6 py-3 text-sm text-text-secondary text-right">@m.MessageCount.ToString("N0")</td>
                                <td class="px-6 py-3 text-sm text-text-secondary text-right">$@m.CostUsd.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <div class="px-6 py-4 border-b border-border-primary"><h2 class="text-lg font-semibold text-text-primary">By Mode</h2></div>
                <table class="min-w-full divide-y divide-border-primary">
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var m in ByMode)
                        {
                            <tr>
                                <td class="px-6 py-3 text-sm text-text-primary">@m.Mode</td>
                                <td class="px-6 py-3 text-sm text-text-secondary text-right">@m.MessageCount.ToString("N0")</td>
                                <td class="px-6 py-3 text-sm text-text-secondary text-right">$@m.CostUsd.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-border-primary"><h2 class="text-lg font-semibold text-text-primary">By Day</h2></div>
            <div class="overflow-x-auto hidden sm:block">
                <table class="min-w-full divide-y divide-border-primary">
                    <thead class="bg-bg-tertiary">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Day</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Messages</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Tokens</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var d in ByDay)
                        {
                            <tr>
                                <td class="px-6 py-3 text-sm text-text-primary"><LocalTime Utc="d.Day" Format="date" /></td>
                                <td class="px-6 py-3 text-sm text-text-secondary text-right">@d.MessageCount.ToString("N0")</td>
                                <td class="px-6 py-3 text-sm text-text-secondary text-right">@FormatTokens(d.InputTokens + d.OutputTokens)</td>
                                <td class="px-6 py-3 text-sm text-text-secondary text-right">$@d.CostUsd.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="sm:hidden divide-y divide-border-primary">
                @foreach (var d in ByDay)
                {
                    <div class="p-4 flex justify-between items-center">
                        <LocalTime Utc="d.Day" Format="date" Class="text-sm text-text-primary" />
                        <span class="text-sm text-text-secondary">$@d.CostUsd.ToString("N2")</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@page "/Admin/MessageLogs"
@namespace DiscordBot.Bot.Blazor.Pages.Admin
@attribute [Authorize(Policy = "RequireAdmin")]
@inject NavigationManager Navigation

@*
    Routed-Blazor replacement for Pages/Admin/MessageLogs/Index.cshtml(.cs) — Phase F.
    The Razor page had already been reduced to a redirect to the unified Logs page
    (?tab=messages); this preserves that behavior. Global-search links pass ?search=,
    which is forwarded as the message search term.
*@

<p class="text-text-secondary">Redirecting to the unified Logs page…</p>

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    protected override void OnInitialized()
    {
        var target = "/Admin/Logs?tab=messages";
        if (!string.IsNullOrWhiteSpace(Search))
        {
            target += $"&MessageSearchTerm={Uri.EscapeDataString(Search)}";
        }

        Navigation.NavigateTo(target, forceLoad: true);
    }
}

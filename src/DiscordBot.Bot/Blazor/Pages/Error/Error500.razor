@page "/Error/500"
@namespace DiscordBot.Bot.Blazor.Pages.Error
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout DiscordBot.Bot.Blazor.Layout.EmptyLayout
@inject ILogger<Error500> Logger
@inject IWebHostEnvironment Environment

<PageTitle>Server Error - Discord Bot Admin</PageTitle>

<StandaloneErrorShell IconPath="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                      Title="Something Went Wrong"
                      Subtitle="We encountered an unexpected error. Our team has been notified."
                      BannerTitle="500 Internal Server Error"
                      BannerMessage="An unexpected error occurred.">
    <p class="text-sm text-text-primary mb-4">
        We're sorry, but something went wrong on our end. The error has been logged and our team will investigate.
    </p>

    @if (!string.IsNullOrEmpty(_requestId))
    {
        <p class="text-xs text-text-tertiary mb-6 font-mono break-all">
            Request ID: @_requestId
        </p>
    }

    <p class="text-sm text-text-secondary mb-6">
        Please try again in a few moments. If the problem persists, contact support with the request ID above.
    </p>

    @if (_isDevelopment && !string.IsNullOrEmpty(_exceptionMessage))
    {
        <div class="mb-6 p-4 bg-bg-primary border border-border-primary rounded-lg">
            <p class="text-xs font-semibold text-error mb-2">Development Mode - Exception Details:</p>
            <p class="text-xs text-text-primary font-mono whitespace-pre-wrap break-all">@_exceptionMessage</p>

            @if (!string.IsNullOrEmpty(_stackTrace))
            {
                <details class="mt-4">
                    <summary class="text-xs font-semibold text-text-secondary cursor-pointer hover:text-text-primary">Stack Trace</summary>
                    <pre class="text-xs text-text-tertiary font-mono whitespace-pre-wrap break-all mt-2 max-h-64 overflow-y-auto">@_stackTrace</pre>
                </details>
            }
        </div>
    }

    <div class="flex gap-3">
        <a href="/" class="flex-1 text-center py-2.5 px-4 text-sm font-semibold text-white bg-accent-orange border border-accent-orange rounded-md transition-colors hover:bg-accent-orange-hover hover:border-accent-orange-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 focus-visible:ring-offset-bg-secondary">
            Go to Dashboard
        </a>
        <button onclick="location.reload()" class="flex-1 text-center py-2.5 px-4 text-sm font-semibold text-text-primary bg-transparent border border-border-primary rounded-md transition-colors hover:bg-bg-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 focus-visible:ring-offset-bg-secondary">
            Try Again
        </button>
    </div>
</StandaloneErrorShell>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    private string? RequestIdFromQuery { get; set; }

    private string? _requestId;
    private bool _isDevelopment;
    private string? _exceptionMessage;
    private string? _stackTrace;

    protected override void OnInitialized()
    {
        _requestId = RequestIdFromQuery ?? HttpContext?.TraceIdentifier;
        _isDevelopment = Environment.IsDevelopment();

        if (_isDevelopment)
        {
            var exceptionFeature = HttpContext?.Features.Get<Microsoft.AspNetCore.Diagnostics.IExceptionHandlerPathFeature>();
            if (exceptionFeature?.Error is { } exception)
            {
                _exceptionMessage = exception.Message;
                _stackTrace = exception.StackTrace;

                Logger.LogError(exception, "Unhandled exception occurred. Request ID: {RequestId}, Path: {Path}",
                    _requestId, exceptionFeature.Path);
            }
        }
        else
        {
            Logger.LogError("Server error page displayed. Request ID: {RequestId}", _requestId);
        }
    }
}

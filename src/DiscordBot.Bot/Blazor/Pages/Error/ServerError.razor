@page "/Error/500"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Diagnostics
@inject ILogger<ServerError> Logger
@inject IWebHostEnvironment Environment

@*
    Static SSR port of Pages/Error/500.cshtml + ServerErrorModel (docs/plans/blazor-port-plan.md
    §5 Phase 3). [AllowAnonymous] is required here because Routes.razor's AuthorizeRouteView
    carries a FallbackPolicy that requires authentication globally (docs/architecture/patterns.md
    "Blazor Components"). No @@rendermode - this never needs interactivity, and Program.cs's
    UseExceptionHandler("/Error/500") re-executes into it exactly as it did the cshtml.

    RequestId is [SupplyParameterFromQuery] instead of the PageModel's OnGet(string? requestId)
    parameter - Program.cs's UseExceptionHandler re-execute preserves no query string of its own,
    so in practice this is almost always the HttpContext.TraceIdentifier fallback, same as before;
    the query parameter exists for a caller that links to this page directly with a known id.

    Exception details (message/stack trace) are read from IExceptionHandlerPathFeature only when
    IWebHostEnvironment.IsDevelopment() - identical gating and logging to ServerErrorModel.OnGet.

    App.razor already supplies <!DOCTYPE html>/<head>/<body> (body classes: bg-bg-primary
    text-text-primary font-sans antialiased) for the whole app, so the centering wrapper below is
    a plain <div> rather than the cshtml's own <body> element.

    "Try Again" is a <button data-error-action="reload"> wired by wwwroot/js/blazor/error-pages.js
    (a classic script with a document-level delegated click listener) instead of an inline
    onclick="location.reload()" - see Forbidden.razor for why.
*@

<PageTitle>Server Error - Discord Bot Admin</PageTitle>

<HeadContent>
    <script src="/js/blazor/error-pages.js"></script>
</HeadContent>

<div class="min-h-screen flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md">
        <!-- Error Icon -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-error rounded-xl mb-4">
                <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-text-primary">Something Went Wrong</h1>
            <p class="text-text-secondary mt-2">We encountered an unexpected error. Our team has been notified.</p>
        </div>

        <!-- Message Card -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 shadow-lg">
            <div class="mb-6 p-4 bg-error-bg border border-error-border rounded-lg">
                <p class="text-sm text-error">
                    <strong>500 Internal Server Error:</strong> An unexpected error occurred.
                </p>
            </div>

            <p class="text-sm text-text-primary mb-4">
                We're sorry, but something went wrong on our end. The error has been logged and our team will investigate.
            </p>

            @if (!string.IsNullOrEmpty(_requestId))
            {
                <p class="text-xs text-text-tertiary mb-6 font-mono break-all">
                    Request ID: @_requestId
                </p>
            }

            <p class="text-sm text-text-secondary mb-6">
                Please try again in a few moments. If the problem persists, contact support with the request ID above.
            </p>

            @if (_isDevelopment && !string.IsNullOrEmpty(_exceptionMessage))
            {
                <div class="mb-6 p-4 bg-bg-primary border border-border-primary rounded-lg">
                    <p class="text-xs font-semibold text-error mb-2">Development Mode - Exception Details:</p>
                    <p class="text-xs text-text-primary font-mono whitespace-pre-wrap break-all">@_exceptionMessage</p>

                    @if (!string.IsNullOrEmpty(_stackTrace))
                    {
                        <details class="mt-4">
                            <summary class="text-xs font-semibold text-text-secondary cursor-pointer hover:text-text-primary">Stack Trace</summary>
                            <pre class="text-xs text-text-tertiary font-mono whitespace-pre-wrap break-all mt-2 max-h-64 overflow-y-auto">@_stackTrace</pre>
                        </details>
                    }
                </div>
            }

            <div class="flex gap-3">
                <a href="/" class="flex-1 text-center py-2.5 px-4 text-sm font-semibold text-white bg-accent-orange border border-accent-orange rounded-md transition-colors hover:bg-accent-orange-hover hover:border-accent-orange-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 focus-visible:ring-offset-bg-secondary">
                    Go to Dashboard
                </a>
                <button type="button" data-error-action="reload" class="flex-1 text-center py-2.5 px-4 text-sm font-semibold text-text-primary bg-transparent border border-border-primary rounded-md transition-colors hover:bg-bg-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 focus-visible:ring-offset-bg-secondary">
                    Try Again
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _exceptionMessage;
    private string? _stackTrace;
    private string? _requestId;
    private bool _isDevelopment;

    [SupplyParameterFromQuery]
    [Parameter]
    public string? RequestId { get; set; }

    // Prerender-only, per "Auth in components" in patterns.md - this page is always static SSR
    // (no @@rendermode), so it is never null while the component actually renders, but the
    // pattern is to null-guard it regardless.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        _requestId = RequestId ?? HttpContext?.TraceIdentifier;
        _isDevelopment = Environment.IsDevelopment();

        if (!_isDevelopment)
        {
            Logger.LogError("Server error page displayed. Request ID: {RequestId}", _requestId);
            return;
        }

        var exceptionFeature = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
        if (exceptionFeature?.Error is not { } exception)
        {
            return;
        }

        _exceptionMessage = exception.Message;
        _stackTrace = exception.StackTrace;

        Logger.LogError(exception, "Unhandled exception occurred. Request ID: {RequestId}, Path: {Path}",
            _requestId, exceptionFeature.Path);
    }
}

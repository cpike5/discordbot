@page "/Guilds/{guildId:long}/Members/{userId:long}/Moderation"
@attribute [Authorize(Policy = "RequireAdmin")]
@layout GuildLayout
@inherits GuildPageBase
@rendermode InteractiveServer
@using DiscordBot.Bot.Blazor.Guilds
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.DTOs
@using DiscordBot.Core.Enums

@*
    Routable replacement for Pages/Guilds/Members/Moderation.cshtml + ModerationModel
    (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4d). moderation.css stays loaded here -
    it's still needed by the not-yet-ported ModerationSettings/FlaggedEvents pages, and this page's
    tag chips/note items/severity-flags badges reuse its classes rather than duplicating them as
    component-scoped CSS.
*@

<HeadContent>
    <link rel="stylesheet" href="/css/moderation.css" asp-append-version="true" />
</HeadContent>

<PageTitle>Moderation Profile</PageTitle>

<GuildContextGate Result="Result">
    <ChildContent Context="guild">
        @if (NotFoundState)
        {
            <EmptyState Type="EmptyStateType.NoData" Title="Member not found"
                        Description="This user is not a member of this server." />
        }
        else if (Member is null)
        {
            <div class="flex items-center justify-center py-12">
                <Icon Path="@IconPaths.ArrowPath" Class="w-8 h-8 animate-spin text-accent-blue" />
            </div>
        }
        else
        {
            var member = Member;
            var avatarUrl = BuildAvatarUrl(member.UserId, member.AvatarHash);

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 mb-6">
                <div class="flex flex-col md:flex-row md:items-start gap-6">
                    <div class="flex items-start gap-4 flex-1">
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <img src="@avatarUrl" alt="@member.DisplayName" class="w-20 h-20 rounded-full flex-shrink-0" />
                        }
                        else
                        {
                            <div class="w-20 h-20 rounded-full bg-gradient-to-br from-accent-blue to-accent-orange flex items-center justify-center text-white font-bold text-xl flex-shrink-0">
                                @Initials(member.DisplayName)
                            </div>
                        }
                        <div class="flex-1 min-w-0">
                            <div class="flex flex-wrap items-center gap-2 mb-2">
                                <h1 class="text-2xl font-bold text-text-primary">@member.DisplayName</h1>
                                <span class="text-sm text-text-tertiary font-mono">@@@member.Username</span>
                            </div>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                                <div>
                                    <span class="text-text-tertiary block">Account Created</span>
                                    <LocalTime Utc="AccountCreatedAt" Format="date" Class="text-text-secondary" />
                                </div>
                                <div>
                                    <span class="text-text-tertiary block">Joined Server</span>
                                    <LocalTime Utc="member.JoinedAt" Format="date" Class="text-text-secondary" />
                                </div>
                                <div>
                                    <span class="text-text-tertiary block">User ID</span>
                                    <p class="text-text-secondary font-mono">@UserId</p>
                                </div>
                                <div>
                                    <span class="text-text-tertiary block">Server Roles</span>
                                    <p class="text-text-secondary">@(member.Roles.Count > 0 ? string.Join(", ", member.Roles.Select(r => r.Name)) : "None")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-6 mb-6">
                <h2 class="text-lg font-semibold text-text-primary mb-4">User Tags</h2>
                <div class="flex flex-wrap items-center gap-2">
                    @foreach (var tag in Tags)
                    {
                        <span class="user-tag user-tag-removable user-tag-@tag.TagCategory.ToString().ToLowerInvariant()"
                              @onclick="() => RequestRemoveTagAsync(tag.TagName)">
                            @tag.TagName
                            <span class="user-tag-remove" title="Remove tag">
                                <Icon Path="@IconPaths.XMark" Class="w-3 h-3" />
                            </span>
                        </span>
                    }
                    @if (AddableTags.Any())
                    {
                        <div class="relative">
                            <Select TValue="string" Id="addTagSelect" Placeholder="Add Tag"
                                    Options="@(AddableTags.Select(t => new SelectOption { Value = t.Name, Text = t.Name }).ToList())"
                                    Value="@((string?)null)" ValueChanged="async v => { if (!string.IsNullOrEmpty(v)) await AddTagAsync(v); }" />
                        </div>
                    }
                </div>
            </div>

            <TabGroup Mode="TabGroupMode.InPage" @bind-ActiveTabId="ActiveTabId"
                      AriaLabel="User moderation sections"
                      Tabs="@(new List<TabItem>
                          {
                              new() { Id = "cases", Label = "Cases", BadgeCount = Cases.Count, BadgeVariant = TabBadgeVariant.Error },
                              new() { Id = "notes", Label = "Notes", BadgeCount = Notes.Count, BadgeVariant = TabBadgeVariant.Info },
                              new() { Id = "flags", Label = "Flags", BadgeCount = FlaggedEvents.Count, BadgeVariant = TabBadgeVariant.Warning }
                          })">
                <div class="bg-bg-secondary border border-border-primary rounded-lg mt-4">
                    <TabPanel Id="cases">
                        <div class="overflow-x-auto">
                            <table class="w-full" role="table" aria-label="Moderation cases">
                                <thead class="bg-bg-tertiary">
                                    <tr>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Case</th>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Action</th>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Reason</th>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Moderator</th>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Date</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-border-primary">
                                    @if (Cases.Count > 0)
                                    {
                                        @foreach (var c in Cases)
                                        {
                                            <tr class="hover:bg-bg-hover/50 transition-colors">
                                                <td class="px-6 py-4 text-sm font-medium text-text-primary">#@c.CaseNumber</td>
                                                <td class="px-6 py-4">
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium @CaseBadgeClass(c.Type)">
                                                        @c.Type.ToString()
                                                        @if (c.Duration.HasValue)
                                                        {
                                                            <text> (@FormatDuration(c.Duration.Value))</text>
                                                        }
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 text-sm text-text-secondary">@(c.Reason ?? "No reason provided")</td>
                                                <td class="px-6 py-4 text-sm text-text-secondary">
                                                    <UserPreview UserId="c.ModeratorUserId" GuildId="GuildId">@c.ModeratorUsername</UserPreview>
                                                </td>
                                                <td class="px-6 py-4 text-sm text-text-tertiary"><LocalTime Utc="c.CreatedAt" Format="date" /></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="px-6 py-12">
                                                <div class="text-center">
                                                    <h3 class="text-sm font-medium text-text-primary mb-1">No moderation cases found</h3>
                                                    <p class="text-sm text-text-tertiary">This user has no moderation cases.</p>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="p-4 border-t border-border-primary text-sm text-text-tertiary">
                            Showing @Cases.Count moderation case@(Cases.Count == 1 ? "" : "s")
                        </div>
                    </TabPanel>

                    <TabPanel Id="notes" Class="p-6">
                        <div class="mb-6">
                            <h3 class="text-sm font-semibold text-text-primary mb-2">Add New Note</h3>
                            <div class="flex gap-3">
                                <textarea rows="2" placeholder="Add a note about this user..." @bind="NewNoteText" @bind:event="oninput"
                                          class="flex-1 px-3 py-2 text-sm bg-bg-primary border border-border-primary rounded-lg text-text-primary placeholder-text-tertiary focus:border-border-focus focus:ring-1 focus:ring-border-focus transition-colors resize-none"></textarea>
                                <button type="button" disabled="@(!RendererInfo.IsInteractive || IsAddingNote || string.IsNullOrWhiteSpace(NewNoteText))"
                                        class="self-end px-4 py-2 text-sm font-medium text-white bg-accent-orange rounded-lg hover:bg-accent-orange-hover transition-colors disabled:opacity-50"
                                        @onclick="AddNoteAsync">
                                    Add Note
                                </button>
                            </div>
                        </div>

                        <div class="space-y-4">
                            @if (Notes.Count > 0)
                            {
                                @foreach (var note in Notes)
                                {
                                    <div class="note-item">
                                        <div class="note-meta">
                                            <span class="font-medium text-text-secondary">
                                                <UserPreview UserId="note.AuthorUserId" GuildId="GuildId">@note.AuthorUsername</UserPreview>
                                            </span>
                                            <span>-</span>
                                            <LocalTime Utc="note.CreatedAt" Format="datetime" />
                                            @if (note.AuthorUserId == CurrentUserId)
                                            {
                                                <button type="button" class="ml-auto text-error hover:text-error-hover text-xs"
                                                        disabled="@(!RendererInfo.IsInteractive)" @onclick="() => DeleteNoteAsync(note.Id)">
                                                    Delete
                                                </button>
                                            }
                                        </div>
                                        <p class="note-content">@note.Content</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-8">
                                    <h3 class="text-sm font-medium text-text-primary mb-1">No notes yet</h3>
                                    <p class="text-sm text-text-tertiary">Add a note about this user above.</p>
                                </div>
                            }
                        </div>
                    </TabPanel>

                    <TabPanel Id="flags">
                        <div class="overflow-x-auto">
                            <table class="w-full" role="table" aria-label="Flagged events">
                                <thead class="bg-bg-tertiary">
                                    <tr>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Severity</th>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Rule</th>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Channel</th>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Status</th>
                                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-text-primary uppercase tracking-wider">Date</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-border-primary">
                                    @if (FlaggedEvents.Count > 0)
                                    {
                                        @foreach (var flag in FlaggedEvents)
                                        {
                                            <tr class="hover:bg-bg-hover/50 transition-colors">
                                                <td class="px-6 py-4"><SeverityBadge Severity="flag.Severity" /></td>
                                                <td class="px-6 py-4">
                                                    <div class="flex items-center gap-2">
                                                        <RuleTypeIcon RuleType="flag.RuleType" />
                                                        <span class="text-sm text-text-secondary">@flag.RuleType.ToString()</span>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 text-sm text-text-secondary">@(string.IsNullOrEmpty(flag.ChannelName) ? "N/A" : flag.ChannelName)</td>
                                                <td class="px-6 py-4"><StatusBadge Status="flag.Status" /></td>
                                                <td class="px-6 py-4 text-sm text-text-tertiary"><LocalTime Utc="flag.CreatedAt" Format="datetime-short" /></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="px-6 py-12">
                                                <div class="text-center">
                                                    <h3 class="text-sm font-medium text-text-primary mb-1">No flagged events found</h3>
                                                    <p class="text-sm text-text-tertiary">This user has no flagged events.</p>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="p-4 border-t border-border-primary text-sm text-text-tertiary">
                            Showing @FlaggedEvents.Count flagged event@(FlaggedEvents.Count == 1 ? "" : "s")
                        </div>
                    </TabPanel>
                </div>
            </TabGroup>

            <ConfirmModal @ref="_confirmRemoveTagModal" Id="confirmRemoveTagModal"
                          Title="Remove tag?" Message="@($"Remove the '{PendingRemoveTagName}' tag from this user?")"
                          ConfirmText="Remove" Variant="ConfirmationVariant.Danger" />
        }
    </ChildContent>
</GuildContextGate>

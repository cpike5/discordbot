@page "/Guilds/FeatureRequests/{guildId:long}"
@attribute [Authorize(Policy = "RequireAdmin")]
@layout GuildLayout
@inherits GuildPageBase
@rendermode InteractiveServer
@using DiscordBot.Bot.Blazor.Common
@using DiscordBot.Bot.Blazor.Guilds
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@inject NavigationManager Nav

@*
    Routable replacement for Pages/Guilds/FeatureRequests/Index.cshtml + IndexModel
    (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4b). See Index.razor.cs for the
    filter/pagination logic this markup renders.
*@

<PageTitle>Feature Requests</PageTitle>

<GuildContextGate Result="Result">
    <ChildContent Context="guild">
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <Select TValue="string" Id="statusFilter" Label="Status" Placeholder="" Options="StatusOptions"
                        Value="@(StatusFilter.HasValue ? ((int)StatusFilter.Value).ToString() : "")"
                        ValueChanged="HandleStatusChanged" />
            </div>
        </div>

        @if (Items.Count == 0)
        {
            <EmptyState Type="EmptyStateType.NoResults" Title="No feature requests found"
                        Description="@(StatusFilter.HasValue ? "Try adjusting your filters." : "No feature requests have been submitted yet.")" />
        }
        else
        {
            <div class="hidden md:block bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mb-6">
                <table class="min-w-full divide-y divide-border-primary">
                    <thead class="bg-bg-tertiary">
                        <tr>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Ref</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Submitter</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Description</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Date</th>
                            <th scope="col" class="px-4 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var item in Items)
                        {
                            <tr class="hover:bg-bg-hover transition-colors" data-testid="feature-request-row">
                                <td class="px-4 py-4 whitespace-nowrap"><span class="text-xs font-mono text-text-secondary">#@ShortId(item.Id)</span></td>
                                <td class="px-4 py-4 whitespace-nowrap"><span class="text-sm text-text-secondary">@item.SubmittedByUserId</span></td>
                                <td class="px-4 py-4"><span class="text-sm text-text-primary">@Truncate(item.Description, 80)</span></td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <Badge Text="@FeatureRequestStatusDisplay.Label(item.Status)" Variant="FeatureRequestStatusDisplay.Variant(item.Status)" Size="BadgeSize.Small" />
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap"><LocalTime Utc="item.CreatedAt" Format="date" Class="text-sm text-text-secondary" /></td>
                                <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a href="@DetailsUrl(item.Id)" class="text-accent-blue hover:text-accent-blue/80 transition-colors" title="View Details">
                                        <Icon Path="@IconPaths.MagnifyingGlass" Class="w-5 h-5 inline" />
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="md:hidden space-y-4 mb-6">
                @foreach (var item in Items)
                {
                    <div class="bg-bg-secondary border border-border-primary rounded-lg p-4" data-testid="feature-request-card">
                        <div class="flex items-start justify-between mb-3">
                            <span class="text-xs font-mono text-text-secondary">#@ShortId(item.Id)</span>
                            <Badge Text="@FeatureRequestStatusDisplay.Label(item.Status)" Variant="FeatureRequestStatusDisplay.Variant(item.Status)" Size="BadgeSize.Small" />
                        </div>
                        <p class="text-sm text-text-primary mb-2">@Truncate(item.Description, 80)</p>
                        <div class="flex items-center justify-between text-xs text-text-tertiary mt-3 pt-3 border-t border-border-primary">
                            <span>User: @item.SubmittedByUserId</span>
                            <LocalTime Utc="item.CreatedAt" Format="date" />
                        </div>
                        <div class="mt-3">
                            <a href="@DetailsUrl(item.Id)" class="w-full px-3 py-1.5 bg-accent-blue text-white text-sm font-medium rounded-md hover:bg-accent-blue/90 transition-colors text-center block">
                                View Details
                            </a>
                        </div>
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <Pagination CurrentPage="Query.PageNumber" TotalPages="TotalPages" TotalItems="Total" PageSize="Query.PageSize"
                            BaseUrl="@PageUrl" PageParameterName="pageNumber" />
            }
        }
    </ChildContent>
</GuildContextGate>

@code {
    private List<SelectOption> StatusOptions =>
    [
        new() { Value = "", Text = "All Statuses" },
        new() { Value = ((int)FeatureRequestStatus.Submitted).ToString(), Text = "Submitted" },
        new() { Value = ((int)FeatureRequestStatus.GeneratingDocs).ToString(), Text = "Generating Docs" },
        new() { Value = ((int)FeatureRequestStatus.DocsGenerated).ToString(), Text = "Docs Generated" },
        new() { Value = ((int)FeatureRequestStatus.DocGenFailed).ToString(), Text = "Doc Gen Failed" },
        new() { Value = ((int)FeatureRequestStatus.Approved).ToString(), Text = "Approved" },
        new() { Value = ((int)FeatureRequestStatus.Rejected).ToString(), Text = "Rejected" }
    ];

    private void HandleStatusChanged(string? value)
    {
        var query = string.IsNullOrEmpty(value) ? string.Empty : $"?StatusFilter={value}";
        Nav.NavigateTo($"/Guilds/FeatureRequests/{GuildId}{query}");
    }
}

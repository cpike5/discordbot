@page "/Guilds/Reminders/{guildId:long}"
@attribute [Authorize]
@layout GuildLayout
@inherits GuildPageBase
@rendermode InteractiveServer
@using DiscordBot.Bot.Blazor.Common
@using DiscordBot.Bot.Blazor.Guilds
@using DiscordBot.Core.Enums
@using DiscordBot.Bot.ViewModels.Components

@*
    Routable replacement for Pages/Guilds/Reminders/Index.cshtml + IndexModel
    (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4b). Only the "GuildAccess" policy applies
    (enforced by GuildContextProvider via GuildPageBase) - no app role is required, matching the
    legacy page's bare [Authorize(Policy = "GuildAccess")]. See Index.razor.cs for the stats/filter/
    cancel logic this markup renders.
*@

<PageTitle>Reminders</PageTitle>

<GuildContextGate Result="Result">
    <ChildContent Context="guild">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6 mb-6">
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
                <p class="text-sm font-medium text-text-secondary">Total Reminders</p>
                <p class="mt-2 text-3xl font-bold text-text-primary">@StatTotal.ToString("N0")</p>
                <p class="mt-1 text-xs text-text-tertiary">All-time</p>
            </div>
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
                <p class="text-sm font-medium text-text-secondary">Pending</p>
                <p class="mt-2 text-3xl font-bold text-accent-blue">@StatPending.ToString("N0")</p>
                <p class="mt-1 text-xs text-text-tertiary">Awaiting delivery</p>
            </div>
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
                <p class="text-sm font-medium text-text-secondary">Delivered Today</p>
                <p class="mt-2 text-3xl font-bold text-success">@StatDeliveredToday.ToString("N0")</p>
                <p class="mt-1 text-xs text-text-tertiary">Successfully sent</p>
            </div>
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-5">
                <p class="text-sm font-medium text-text-secondary">Failed</p>
                <p class="mt-2 text-3xl font-bold @(StatFailed > 0 ? "text-error" : "text-text-primary")">@StatFailed.ToString("N0")</p>
                <p class="mt-1 text-xs text-text-tertiary">Needs attention</p>
            </div>
        </div>

        <div class="bg-bg-secondary border border-border-primary rounded-lg p-4 mb-6">
            <div class="flex flex-col sm:flex-row gap-4">
                <div class="flex-1">
                    <label for="status" class="block text-sm font-medium text-text-secondary mb-1">Status</label>
                    <select id="status" class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-blue"
                            value="@(Status.HasValue ? ((int)Status.Value).ToString() : "")" @onchange="HandleStatusChanged">
                        <option value="">All Statuses</option>
                        <option value="@((int)ReminderStatus.Pending)">Pending</option>
                        <option value="@((int)ReminderStatus.Delivered)">Delivered</option>
                        <option value="@((int)ReminderStatus.Failed)">Failed</option>
                        <option value="@((int)ReminderStatus.Cancelled)">Cancelled</option>
                    </select>
                </div>
                @if (Status.HasValue)
                {
                    <div class="flex items-end">
                        <a href="/Guilds/Reminders/@GuildId" class="px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors">
                            Clear Filters
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (TotalCount > 0)
        {
            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[900px]">
                        <thead class="bg-bg-tertiary border-b border-border-primary">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">User</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Message</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Trigger Time</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Created</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-primary">
                            @foreach (var row in Rows)
                            {
                                <tr class="hover:bg-bg-hover transition-colors" data-testid="reminder-row">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            @if (!string.IsNullOrEmpty(row.AvatarUrl))
                                            {
                                                <img src="@row.AvatarUrl" alt="" class="w-8 h-8 rounded-full" />
                                            }
                                            else
                                            {
                                                <div class="w-8 h-8 rounded-full bg-bg-tertiary flex items-center justify-center">
                                                    <Icon Path="@IconPaths.User" Class="w-4 h-4 text-text-tertiary" />
                                                </div>
                                            }
                                            <span class="preview-trigger text-sm text-text-primary" data-preview-type="user" data-user-id="@row.UserId" data-context-guild-id="@GuildId">@row.Username</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4"><span class="text-sm text-text-secondary max-w-[250px] truncate block" title="@row.Message">@row.MessagePreview</span></td>
                                    <td class="px-6 py-4"><LocalTime Utc="row.TriggerAt" Format="datetime-short" Class="text-sm text-text-primary" /></td>
                                    <td class="px-6 py-4"><LocalTime Utc="row.CreatedAt" Format="datetime-short" Class="text-sm text-text-secondary" /></td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @StatusBadgeClass(row.Status)">
                                            <span class="w-1.5 h-1.5 rounded-full @StatusDotClass(row.Status) mr-1.5"></span>
                                            @row.StatusText
                                        </span>
                                        @if (row.Status == ReminderStatus.Failed && !string.IsNullOrEmpty(row.LastError))
                                        {
                                            <span class="ml-2 cursor-help" title="@row.LastError">
                                                <Icon Path="@IconPaths.ExclamationCircle" Class="w-4 h-4 text-error inline" />
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center justify-end gap-1">
                                            @if (row.CanCancel)
                                            {
                                                <button type="button" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => RequestCancel(row)"
                                                        class="p-2 text-text-secondary hover:text-error hover:bg-error/10 rounded-md transition-colors disabled:opacity-50"
                                                        title="Cancel Reminder">
                                                    <Icon Path="@IconPaths.XMark" Class="w-4 h-4" />
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
                {
                    <div class="px-6 py-4 border-t border-border-primary">
                        <Pagination CurrentPage="Query.PageNumber" TotalPages="TotalPages" TotalItems="TotalCount" PageSize="Query.PageSize"
                                    BaseUrl="@PageUrl" PageParameterName="pageNumber" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-8">
                <EmptyState Type="@(Status.HasValue ? EmptyStateType.NoResults : EmptyStateType.FirstTime)"
                            Title="@(Status.HasValue ? "No Reminders Match Filter" : "No Reminders Yet")"
                            Description="@(Status.HasValue ? "No reminders match the selected status filter. Try adjusting your filters." : "No reminders have been created in this server. Users can create reminders using the /remind command in Discord.")" />
            </div>
        }
    </ChildContent>
</GuildContextGate>

<ConfirmModal @ref="_cancelModal" Id="cancel-reminder-modal" Title="Cancel Reminder" Message="@ToggleModalMessage"
              ConfirmText="Cancel Reminder" CancelText="Keep Reminder" Variant="ConfirmationVariant.Danger" />

@code {
    private static string StatusBadgeClass(ReminderStatus status) => status switch
    {
        ReminderStatus.Pending => "bg-accent-blue/20 text-accent-blue",
        ReminderStatus.Delivered => "bg-success/20 text-success",
        ReminderStatus.Failed => "bg-error/20 text-error",
        ReminderStatus.Cancelled => "bg-bg-tertiary text-text-secondary",
        _ => "bg-bg-tertiary text-text-tertiary"
    };

    private static string StatusDotClass(ReminderStatus status) => status switch
    {
        ReminderStatus.Pending => "bg-accent-blue",
        ReminderStatus.Delivered => "bg-success",
        ReminderStatus.Failed => "bg-error",
        ReminderStatus.Cancelled => "bg-text-secondary",
        _ => "bg-text-tertiary"
    };
}

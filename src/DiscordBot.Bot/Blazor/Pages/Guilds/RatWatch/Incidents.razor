@page "/Guilds/RatWatch/Incidents/{guildId:long}"
@attribute [Authorize(Policy = "RequireModerator")]
@attribute [Authorize(Policy = "GuildAccess")]
@layout GuildLayout
@inherits GuildPageBase
@rendermode InteractiveServer
@using DiscordBot.Bot.Blazor.Guilds
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Enums
@inject NavigationManager Nav

@*
    Routable replacement for Pages/Guilds/RatWatch/Incidents.cshtml + IncidentsModel
    (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4d). See Incidents.razor.cs for the
    filter/modal/CSV-export logic this markup renders.
*@

<PageTitle>Rat Watch Incidents</PageTitle>

<GuildContextGate Result="Result">
    <ChildContent Context="guild">
        <TabGroup Id="ratWatchTabs" Mode="TabGroupMode.Navigation" StyleVariant="TabStyleVariant.Underline" AriaLabel="Rat Watch navigation" ActiveTabId="incidents" Class="mb-6"
                  Tabs="@(new List<TabItem>
                  {
                      new() { Id = "settings", Label = "Settings", Href = $"/Guilds/RatWatch/{guild.GuildIdString}" },
                      new() { Id = "analytics", Label = "Analytics", Href = $"/Guilds/RatWatch/Analytics/{guild.GuildIdString}" },
                      new() { Id = "incidents", Label = "Incidents", Href = $"/Guilds/RatWatch/Incidents/{guild.GuildIdString}" }
                  })" />

        @if (LoadFailed)
        {
            <Alert Variant="AlertVariant.Error" Title="Couldn't load incidents" Message="Something went wrong loading this list. Try reloading." Class="mb-6" />
        }

        <FilterPanel Title="Filters" ActiveFilterCount="@ActiveFilterCount" DefaultExpanded="@(ActiveFilterCount > 0)">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
                <Select TValue="string" Id="statusFilter" Label="Status" AllowMultiple="true" Options="StatusFilterOptions"
                        SelectedValues="_pendingStatusValues" SelectedValuesChanged="v => _pendingStatusValues = v" />
                <TextInput Id="accusedUser" Label="Accused User" @bind-Value="AccusedUserInput" Placeholder="Discord ID or username" />
                <TextInput Id="initiatorUser" Label="Initiator User" @bind-Value="InitiatorUserInput" Placeholder="Discord ID or username" />
                <div>
                    <label for="startDate" class="block text-sm font-medium text-text-secondary mb-1">Start Date</label>
                    <input type="date" id="startDate" class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary" value="@StartDateInput" @onchange="e => StartDateInput = e.Value?.ToString()" />
                </div>
                <div>
                    <label for="endDate" class="block text-sm font-medium text-text-secondary mb-1">End Date</label>
                    <input type="date" id="endDate" class="w-full px-3 py-2 bg-bg-primary border border-border-primary rounded-md text-text-primary" value="@EndDateInput" @onchange="e => EndDateInput = e.Value?.ToString()" />
                </div>
                <TextInput Id="minVoteCount" Label="Min Vote Count" Type="number" @bind-Value="MinVoteCountInput" />
                <TextInput Id="keyword" Label="Keyword" @bind-Value="KeywordInput" Placeholder="Search custom message" />
            </div>
            <div class="flex items-center justify-end gap-2">
                <a href="@($"/Guilds/RatWatch/Incidents/{GuildId}")" class="btn btn-secondary">Clear</a>
                <button type="button" class="btn btn-primary" @onclick="ApplyFilters">Apply Filters</button>
            </div>
        </FilterPanel>

        <div class="flex items-center justify-end gap-2 mb-4">
            <button type="button" class="btn btn-secondary" disabled="@(!RendererInfo.IsInteractive || Items.Count == 0)" @onclick="ExportCsvAsync">
                <Icon Path="@IconPaths.ArrowDownTray" Class="w-4 h-4 mr-2" />
                Export CSV
            </button>
        </div>

        @if (Items.Count == 0)
        {
            <EmptyState Type="EmptyStateType.NoResults" Title="No incidents found" Description="Try adjusting your filters." />
        }
        else
        {
            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[900px]">
                        <thead class="bg-bg-tertiary border-b border-border-primary">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Status</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Accused</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Initiator</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Scheduled</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Votes</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">Details</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-primary">
                            @foreach (var item in Items)
                            {
                                <tr class="hover:bg-bg-hover transition-colors" data-testid="ratwatch-incident-row">
                                    <td class="px-4 py-3"><Badge Text="@item.StatusText" Variant="StatusVariant(item.Status)" Size="BadgeSize.Small" /></td>
                                    <td class="px-4 py-3 text-sm text-text-primary">@item.AccusedUsername</td>
                                    <td class="px-4 py-3 text-sm text-text-secondary">@item.InitiatorUsername</td>
                                    <td class="px-4 py-3"><LocalTime Utc="item.ScheduledAt" Format="datetime-short" Class="text-sm text-text-primary" /></td>
                                    <td class="px-4 py-3 text-sm">
                                        @if (item.TotalVotes > 0)
                                        {
                                            <span class="text-error font-medium">@item.GuiltyVotes</span> <span class="text-text-tertiary">/</span> <span class="text-success font-medium">@item.NotGuiltyVotes</span>
                                        }
                                        else
                                        {
                                            <span class="text-text-tertiary">--</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <button type="button" class="text-accent-blue hover:text-accent-blue/80" @onclick="() => OpenModalAsync(item.Id)">View</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
                {
                    <div class="px-4 py-4 border-t border-border-primary">
                        <Pagination CurrentPage="Query.PageNumber" TotalPages="TotalPages" TotalItems="TotalCount" PageSize="Query.PageSize"
                                    Style="PaginationStyle.Compact" BaseUrl="@PageUrl" PageParameterName="pageNumber" />
                    </div>
                }
            </div>
        }
    </ChildContent>
</GuildContextGate>

<Modal @bind-IsOpen="ModalOpen" Id="incidentDetailModal" Title="Incident Detail" OnClosed="CloseModal">
    <ChildContent>
        @if (ModalLoading)
        {
            <p class="text-sm text-text-secondary">Loading...</p>
        }
        else if (ModalDetail is null)
        {
            <p class="text-sm text-text-secondary">Incident not found.</p>
        }
        else
        {
            var detail = ModalDetail;
            <div class="space-y-3 text-sm">
                <div class="flex justify-between"><span class="text-text-tertiary">Accused</span><span class="text-text-primary">@detail.AccusedUsername</span></div>
                <div class="flex justify-between"><span class="text-text-tertiary">Initiator</span><span class="text-text-primary">@detail.InitiatorUsername</span></div>
                <div class="flex justify-between"><span class="text-text-tertiary">Status</span><span class="text-text-primary">@detail.Status</span></div>
                <div class="flex justify-between"><span class="text-text-tertiary">Scheduled</span><LocalTime Utc="detail.ScheduledAt" Format="datetime" /></div>
                @if (detail.VotingStartedAt.HasValue)
                {
                    <div class="flex justify-between"><span class="text-text-tertiary">Voting Started</span><LocalTime Utc="detail.VotingStartedAt.Value" Format="datetime" /></div>
                }
                <div class="flex justify-between"><span class="text-text-tertiary">Votes</span><span class="text-text-primary">@detail.GuiltyVotes guilty / @detail.NotGuiltyVotes not guilty</span></div>
                @if (!string.IsNullOrEmpty(detail.CustomMessage))
                {
                    <div>
                        <p class="text-text-tertiary mb-1">Custom Message</p>
                        <p class="text-text-primary">@detail.CustomMessage</p>
                    </div>
                }
                <div class="flex justify-between"><span class="text-text-tertiary">Channel</span><span class="text-text-primary font-mono">@detail.ChannelId</span></div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors" @onclick="CloseModal">Close</button>
    </FooterContent>
</Modal>

@code {
    private string? AccusedUserInput { get; set; }
    private string? InitiatorUserInput { get; set; }
    private string? KeywordInput { get; set; }
    private string? MinVoteCountInput { get; set; }
    private string? StartDateInput { get; set; }
    private string? EndDateInput { get; set; }
    private IReadOnlyList<string> _pendingStatusValues = [];

    private static List<SelectOption> StatusFilterOptions
        => AllStatuses.Select(s => new SelectOption { Value = ((int)s.Status).ToString(), Text = s.Label }).ToList();

    /// <summary>
    /// Seeds the editable filter inputs from the resolved query - called from
    /// Incidents.razor.cs's own <c>LoadAsync</c>, which already runs exactly once per distinct
    /// query (first load, and every query-string change) via that file's <c>OnParametersSet</c>
    /// override. Kept as a second method here (not merged into that override) only because
    /// <c>OnParametersSet</c> itself can't be declared twice in one partial class.
    /// </summary>
    private void SeedFilterInputs()
    {
        AccusedUserInput = AccusedUser;
        InitiatorUserInput = InitiatorUser;
        KeywordInput = Keyword;
        MinVoteCountInput = MinVoteCount?.ToString();
        StartDateInput = EffectiveStartDate?.ToString("yyyy-MM-dd");
        EndDateInput = EffectiveEndDate?.ToString("yyyy-MM-dd");
        _pendingStatusValues = (StatusValues ?? []).Select(v => v.ToString()).ToList();
    }

    private int ActiveFilterCount
    {
        get
        {
            var count = 0;
            if (SelectedStatuses.Count is > 0 and < 7) count++;
            if (StartDate.HasValue) count++;
            if (EndDate.HasValue) count++;
            if (!string.IsNullOrWhiteSpace(AccusedUser)) count++;
            if (!string.IsNullOrWhiteSpace(InitiatorUser)) count++;
            if (MinVoteCount is > 0) count++;
            if (!string.IsNullOrWhiteSpace(Keyword)) count++;
            return count;
        }
    }

    private static BadgeVariant StatusVariant(RatWatchStatus status) => status switch
    {
        RatWatchStatus.Pending => BadgeVariant.Warning,
        RatWatchStatus.Voting => BadgeVariant.Blue,
        RatWatchStatus.Guilty => BadgeVariant.Error,
        RatWatchStatus.NotGuilty => BadgeVariant.Success,
        RatWatchStatus.Cancelled => BadgeVariant.Error,
        _ => BadgeVariant.Default
    };

    private void ApplyFilters()
    {
        var parts = new List<string>();
        foreach (var status in _pendingStatusValues)
        {
            parts.Add($"Statuses={status}");
        }

        if (!string.IsNullOrWhiteSpace(AccusedUserInput)) parts.Add($"AccusedUser={Uri.EscapeDataString(AccusedUserInput)}");
        if (!string.IsNullOrWhiteSpace(InitiatorUserInput)) parts.Add($"InitiatorUser={Uri.EscapeDataString(InitiatorUserInput)}");
        if (!string.IsNullOrWhiteSpace(KeywordInput)) parts.Add($"Keyword={Uri.EscapeDataString(KeywordInput)}");
        if (int.TryParse(MinVoteCountInput, out var minVotes) && minVotes > 0) parts.Add($"MinVoteCount={minVotes}");
        if (!string.IsNullOrEmpty(StartDateInput)) parts.Add($"StartDate={StartDateInput}");
        if (!string.IsNullOrEmpty(EndDateInput)) parts.Add($"EndDate={EndDateInput}");

        Nav.NavigateTo(parts.Count == 0 ? $"/Guilds/RatWatch/Incidents/{GuildId}" : $"/Guilds/RatWatch/Incidents/{GuildId}?{string.Join('&', parts)}");
    }
}

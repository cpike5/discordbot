@namespace DiscordBot.Bot.Blazor.Pages.Guilds.ScheduledMessages
@using System.Net
@using DiscordBot.Bot.Helpers
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Bot.ViewModels.Pages
@using DiscordBot.Core.Enums

@*
    Shared Create/Edit form fields (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4b - "share
    one model class"; this goes one step further and shares the markup too, since Create.cshtml and
    Edit.cshtml were near-identical). Embedded by both Blazor/Pages/Guilds/ScheduledMessages/
    {Create,Edit}.razor inside their own EditForm - this component renders only the fields, not the
    <EditForm> wrapper itself, so each page still owns its own OnValidSubmit/DataAnnotationsValidator
    and (on Edit) an extra Delete action via ExtraActions.
*@

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-6">
        <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
            <h2 class="text-lg font-semibold text-text-primary mb-4">Message Content</h2>

            <TextInput Id="Input_Title" Label="Title" Placeholder="Enter a descriptive title..." IsRequired="true"
                       HelpText="A short title to identify this scheduled message" @bind-Value="Input.Title" />

            <div class="mt-4">
                <TextArea Id="Input_Content" Label="Message" Rows="4" Placeholder="Enter your message..." IsRequired="true"
                          HelpText="Supports Discord markdown formatting" @bind-Value="Input.Content" />
                <p class="text-xs text-text-secondary text-right mt-1">@Input.Content.Length/2000</p>
            </div>

            <div class="mt-4">
                <Select TValue="ulong?" Id="Input_ChannelId" Label="Target Channel" Placeholder="Select a channel..." IsRequired="true"
                        HelpText="Select the channel where this message will be sent" Options="ChannelOptions" @bind-Value="Input.ChannelId" />
            </div>
        </div>

        <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
            <h2 class="text-lg font-semibold text-text-primary mb-4">Schedule</h2>

            <div class="mb-6">
                <label class="block text-sm font-medium text-text-primary mb-3">Schedule Type</label>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
                    @foreach (var freq in Enum.GetValues<ScheduleFrequency>())
                    {
                        var isSelected = Input.Frequency == freq;
                        <label class="border rounded-lg p-3 text-center cursor-pointer transition-colors @(isSelected ? "border-accent-orange bg-accent-orange/10" : "border-border-secondary hover:border-border-primary hover:bg-bg-tertiary")"
                               @onclick="() => SelectFrequency(freq)">
                            <span class="text-xs font-medium text-text-primary">@ScheduledMessageStatusDisplay.ScheduleDescription(freq)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="mb-4">
                <label for="Input_NextExecutionAt" class="block text-sm font-medium text-text-primary mb-2">Next Execution Time</label>
                <InputDate @bind-Value="Input.NextExecutionAt" Type="InputDateType.DateTimeLocal" id="Input_NextExecutionAt"
                           class="form-input w-full py-2.5 px-3 text-sm text-text-primary bg-bg-primary border border-border-primary rounded-md transition-colors focus:outline-none focus:border-border-focus focus:ring-2 focus:ring-border-focus/20" />
                <p class="text-xs text-text-tertiary mt-1 timezone-indicator">
                    Your timezone: <span class="font-medium">@(DetectedTimeZone ?? "Detecting…")</span>
                </p>
                <ValidationMessage For="@(() => Input.NextExecutionAt)" class="text-error text-xs" />
            </div>

            @if (Input.Frequency == ScheduleFrequency.Custom)
            {
                <div>
                    <TextInput Id="Input_CronExpression" Label="Cron Expression" Placeholder="0 9 * * 1"
                               HelpText="Standard cron format: minute hour day month weekday" @bind-Value="Input.CronExpression" />
                </div>
            }
        </div>

        <div class="bg-bg-secondary border border-border-primary rounded-lg p-6">
            <Toggle Id="Input_IsEnabled" Label="Active" HelpText="Enable or disable this scheduled message" @bind-Value="Input.IsEnabled" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <Alert Variant="AlertVariant.Error" Message="@ErrorMessage" />
        }

        <div class="flex flex-col sm:flex-row gap-3">
            @if (!RendererInfo.IsInteractive)
            {
                <span class="text-sm text-text-tertiary self-center">Connecting…</span>
            }
            <button type="submit" disabled="@(!RendererInfo.IsInteractive)"
                    class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-accent-orange border border-accent-orange rounded-md hover:bg-accent-orange-hover transition-colors disabled:opacity-50">
                <Icon Path="@IconPaths.Check" Class="w-4 h-4" />
                @SubmitLabel
            </button>
            <a href="@CancelUrl" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-sm font-medium text-text-primary bg-transparent border border-border-primary rounded-md hover:bg-bg-hover transition-colors">
                Cancel
            </a>
            @ExtraActions
        </div>
    </div>

    <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-8 space-y-6">
            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <div class="px-6 py-4 border-b border-border-primary">
                    <h3 class="text-sm font-semibold text-text-primary">Message Preview</h3>
                </div>
                <div class="p-4">
                    <div class="bg-[#36393f] rounded-md p-3">
                        <div class="flex gap-3">
                            <div class="flex-shrink-0">
                                <div class="w-10 h-10 rounded-full bg-discord flex items-center justify-center">
                                    <Icon Path="@IconPaths.User" Class="w-6 h-6 text-white" />
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-1 mb-1">
                                    <span class="font-medium text-white text-sm">Bot</span>
                                    <span class="bg-discord text-white text-[10px] px-1 py-0.5 rounded uppercase font-semibold">BOT</span>
                                </div>
                                <div class="text-[#dcddde] text-sm leading-relaxed break-words">
                                    @if (!string.IsNullOrWhiteSpace(Input.Content))
                                    {
                                        @((MarkupString)WebUtility.HtmlEncode(Input.Content).Replace("\n", "<br />"))
                                    }
                                    else
                                    {
                                        <span class="text-[#72767d] italic">Enter a message to see preview...</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
                <div class="px-6 py-4 border-b border-border-primary">
                    <h3 class="text-sm font-semibold text-text-primary">Schedule Information</h3>
                </div>
                <div class="p-4 space-y-3">
                    <div class="flex items-start gap-2">
                        <Icon Path="@IconPaths.Clock" Class="w-4 h-4 text-text-tertiary mt-0.5 flex-shrink-0" />
                        <div class="flex-1">
                            <p class="text-xs text-text-tertiary">Frequency</p>
                            <p class="text-sm text-text-primary font-medium">@ScheduledMessageStatusDisplay.ScheduleDescription(Input.Frequency)</p>
                        </div>
                    </div>
                    @if (Input.NextExecutionAt.HasValue)
                    {
                        <div class="flex items-start gap-2">
                            <Icon Path="@IconPaths.Calendar" Class="w-4 h-4 text-success mt-0.5 flex-shrink-0" />
                            <div class="flex-1">
                                <p class="text-xs text-text-tertiary">Next Run (your local time)</p>
                                <p class="text-sm text-text-primary font-medium">@Input.NextExecutionAt.Value.ToString("MMM d, yyyy h:mm tt")</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ScheduledMessageInputModel Input { get; set; } = default!;
    [Parameter] public IReadOnlyList<ChannelSelectItem> Channels { get; set; } = [];
    [Parameter] public string? DetectedTimeZone { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Create Message";
    [Parameter] public string CancelUrl { get; set; } = "#";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public RenderFragment? ExtraActions { get; set; }

    /// <summary>
    /// Channel options plus, when <see cref="Input"/> already points at a channel
    /// <see cref="Channels"/> doesn't contain (unresolvable - no live Discord gateway, or the
    /// channel was since deleted), a synthetic option for it. Without this the rendered
    /// <c>&lt;select required&gt;</c>'s value attribute matches no real <c>&lt;option&gt;</c>, so the
    /// browser's own native "required" constraint validation blocks the form's submit event from
    /// ever reaching Blazor - even though <c>Input.ChannelId</c> itself is still set correctly in
    /// C# memory and the user never touched this field (e.g. editing an existing message's title in
    /// a web-only host with no channels resolved at all).
    /// </summary>
    private List<SelectOption> ChannelOptions
    {
        get
        {
            var options = Channels.Select(c => new SelectOption
            {
                Value = c.Id.ToString(),
                Text = $"{ChannelPrefix(c.Type)} {c.Name}"
            }).ToList();

            if (Input.ChannelId.HasValue && options.All(o => o.Value != Input.ChannelId.Value.ToString()))
            {
                options.Insert(0, new SelectOption
                {
                    Value = Input.ChannelId.Value.ToString(),
                    Text = $"# Channel {Input.ChannelId.Value} (unavailable)"
                });
            }

            return options;
        }
    }

    private static string ChannelPrefix(ChannelDisplayType type) => type switch
    {
        ChannelDisplayType.Text => "#",
        ChannelDisplayType.Voice => "🔊",
        ChannelDisplayType.Announcement => "📢",
        ChannelDisplayType.Stage => "🎭",
        ChannelDisplayType.Forum => "💬",
        _ => "#"
    };

    private void SelectFrequency(ScheduleFrequency frequency) => Input.Frequency = frequency;
}

@page "/Guilds/AssistantMetrics/{guildId:long}"
@attribute [Authorize(Policy = "RequireAdmin")]
@layout GuildLayout
@inherits GuildPageBase
@rendermode InteractiveServer
@using DiscordBot.Bot.Blazor.Guilds

@*
    Routable replacement for Pages/Guilds/AssistantMetrics.cshtml + AssistantMetricsModel
    (docs/plans/blazor-port-plan.md §5 Phase 4, cluster 4b). Read-only - see AssistantMetrics.razor.cs
    for the 30-day window this markup renders.
*@

<PageTitle>Assistant Metrics</PageTitle>

<GuildContextGate Result="Result">
    <ChildContent Context="guild">
        <!-- Summary Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-center gap-2 mb-1">
                    <Icon Path="@IconPaths.QuestionMarkCircle" Class="w-5 h-5 text-accent-blue" />
                    <span class="text-xs text-text-tertiary font-medium">Total Questions</span>
                </div>
                <p class="text-2xl font-bold text-text-primary">@TotalQuestions.ToString("N0")</p>
            </div>

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-center gap-2 mb-1">
                    <Icon Path="@IconPaths.CurrencyDollar" Class="w-5 h-5 text-accent-orange" />
                    <span class="text-xs text-text-tertiary font-medium">Est. Cost (USD)</span>
                </div>
                <p class="text-2xl font-bold text-text-primary">$@TotalCost.ToString("F2")</p>
            </div>

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-center gap-2 mb-1">
                    <Icon Path="@IconPaths.Bolt" Class="w-5 h-5 text-success" />
                    <span class="text-xs text-text-tertiary font-medium">Avg Latency</span>
                </div>
                <p class="text-2xl font-bold text-text-primary">
                    @if (AverageLatencyMs >= 1000)
                    {
                        <span>@((AverageLatencyMs / 1000.0).ToString("F1"))s</span>
                    }
                    else
                    {
                        <span>@AverageLatencyMs<span class="text-sm font-normal text-text-tertiary">ms</span></span>
                    }
                </p>
            </div>

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-center gap-2 mb-1">
                    <Icon Path="@IconPaths.FolderOpen" Class="w-5 h-5 text-info" />
                    <span class="text-xs text-text-tertiary font-medium">Cache Hit Rate</span>
                </div>
                <p class="text-2xl font-bold text-text-primary">@CacheHitRate.ToString("F1")<span class="text-sm font-normal text-text-tertiary">%</span></p>
            </div>
        </div>

        <!-- Additional Stats Row -->
        <div class="grid grid-cols-3 gap-4 mb-8">
            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-center gap-2 mb-1">
                    <Icon Path="@IconPaths.CheckCircle" Class="@("w-5 h-5 " + (SuccessRate >= 95 ? "text-success" : SuccessRate >= 80 ? "text-warning" : "text-error"))" />
                    <span class="text-xs text-text-tertiary font-medium">Success Rate</span>
                </div>
                <p class="text-xl font-bold text-text-primary">@SuccessRate.ToString("F1")<span class="text-sm font-normal text-text-tertiary">%</span></p>
                <p class="text-xs text-text-tertiary mt-1">@TotalFailedRequests failed requests</p>
            </div>

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-center gap-2 mb-1">
                    <Icon Path="@IconPaths.Cog" Class="w-5 h-5 text-text-tertiary" />
                    <span class="text-xs text-text-tertiary font-medium">Tool Calls</span>
                </div>
                <p class="text-xl font-bold text-text-primary">@TotalToolCalls.ToString("N0")</p>
                <p class="text-xs text-text-tertiary mt-1">Documentation lookups</p>
            </div>

            <div class="bg-bg-secondary border border-border-primary rounded-lg p-4">
                <div class="flex items-center gap-2 mb-1">
                    <Icon Path="@IconPaths.Server" Class="w-5 h-5 text-text-tertiary" />
                    <span class="text-xs text-text-tertiary font-medium">Cache Stats</span>
                </div>
                <p class="text-xl font-bold text-text-primary">@TotalCacheHits.ToString("N0") <span class="text-sm font-normal text-success">hits</span></p>
                <p class="text-xs text-text-tertiary mt-1">@TotalCacheMisses.ToString("N0") misses</p>
            </div>
        </div>

        <!-- Daily Metrics Table -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-border-primary">
                <h3 class="text-lg font-semibold text-text-primary">Daily Breakdown</h3>
                <p class="text-sm text-text-secondary mt-1">Detailed metrics for each day</p>
            </div>

            @if (Metrics.Count > 0)
            {
                <div class="overflow-x-auto hidden md:block">
                    <table class="min-w-full divide-y divide-border-primary">
                        <thead class="bg-bg-tertiary">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Date</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Questions</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Avg Latency</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cache Hit</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Tool Calls</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Failed</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-primary">
                            @foreach (var metric in Metrics.OrderByDescending(m => m.Date))
                            {
                                var cacheTotal = metric.TotalCacheHits + metric.TotalCacheMisses;
                                var cacheRate = cacheTotal > 0 ? (double)metric.TotalCacheHits / cacheTotal * 100 : 0;
                                <tr class="hover:bg-bg-tertiary/50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap"><LocalTime Utc="metric.Date" Format="date" Class="text-sm text-text-primary" /></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right"><span class="text-sm font-medium text-text-primary">@metric.TotalQuestions</span></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right"><span class="text-sm text-text-primary">$@metric.EstimatedCostUsd.ToString("F4")</span></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right"><span class="text-sm text-text-secondary">@metric.AverageLatencyMs<span class="text-text-tertiary">ms</span></span></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right"><span class="@("text-sm " + (cacheRate >= 50 ? "text-success" : "text-text-secondary"))">@cacheRate.ToString("F0")%</span></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right"><span class="text-sm text-text-secondary">@metric.TotalToolCalls</span></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right">
                                        @if (metric.FailedRequests > 0)
                                        {
                                            <span class="text-sm text-error">@metric.FailedRequests</span>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-text-tertiary">0</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="md:hidden divide-y divide-border-primary">
                    @foreach (var metric in Metrics.OrderByDescending(m => m.Date).Take(10))
                    {
                        var cacheTotal = metric.TotalCacheHits + metric.TotalCacheMisses;
                        var cacheRate = cacheTotal > 0 ? (double)metric.TotalCacheHits / cacheTotal * 100 : 0;
                        <div class="p-4 hover:bg-bg-tertiary/50 transition-colors">
                            <div class="flex items-center justify-between mb-3">
                                <LocalTime Utc="metric.Date" Format="date" Class="text-sm font-medium text-text-primary" />
                                <span class="text-sm font-semibold text-accent-orange">$@metric.EstimatedCostUsd.ToString("F4")</span>
                            </div>
                            <div class="grid grid-cols-3 gap-2 text-xs">
                                <div><span class="text-text-tertiary block">Questions</span><span class="text-text-primary font-medium">@metric.TotalQuestions</span></div>
                                <div><span class="text-text-tertiary block">Latency</span><span class="text-text-primary">@metric.AverageLatencyMs ms</span></div>
                                <div><span class="text-text-tertiary block">Cache</span><span class="@(cacheRate >= 50 ? "text-success" : "text-text-primary")">@cacheRate.ToString("F0")%</span></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center">
                    <Icon Path="@IconPaths.ChartBarSquare" Class="w-12 h-12 text-text-tertiary mx-auto mb-3" />
                    <p class="text-text-secondary mb-2">No usage data yet</p>
                    <p class="text-sm text-text-tertiary">Metrics will appear here once users start using the AI assistant.</p>
                </div>
            }
        </div>

        <!-- Tool Usage -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mt-6">
            <div class="px-6 py-4 border-b border-border-primary">
                <h3 class="text-lg font-semibold text-text-primary">Tool Usage</h3>
                <p class="text-sm text-text-secondary mt-1">
                    Which tools the assistant actually reached for over the last 30 days. Every tool this
                    server allows is listed, including the ones that were never called.
                </p>
            </div>

            @if (!HasToolUsageData)
            {
                <div class="px-6 py-4 border-b border-border-primary text-sm text-text-secondary">
                    No tool names recorded yet in this window. Interactions logged before tool names were
                    stored carry none, so this fills in as new questions come through.
                </div>
            }

            <div class="overflow-x-auto hidden md:block">
                <table class="min-w-full divide-y divide-border-primary">
                    <thead class="bg-bg-tertiary">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Tool</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Category</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Calls</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Questions</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Failure Rate</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Last Used</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-primary">
                        @foreach (var tool in ToolUsage)
                        {
                            <tr class="@("hover:bg-bg-tertiary/50 transition-colors " + (tool.Calls == 0 ? "opacity-60" : ""))">
                                <td class="px-6 py-3 whitespace-nowrap">
                                    <span class="text-sm font-medium text-text-primary">@tool.DisplayName</span>
                                    <span class="block text-xs text-text-tertiary font-mono">@tool.ToolName</span>
                                </td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-text-secondary">@tool.Category</td>
                                <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-primary">@tool.Calls.ToString("N0")</td>
                                <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-secondary">@tool.Interactions.ToString("N0")</td>
                                <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-secondary">@(tool.Calls == 0 ? "—" : tool.FailureRate.ToString("F1") + "%")</td>
                                <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-tertiary">
                                    @if (tool.LastUsed.HasValue)
                                    {
                                        <LocalTime Utc="tool.LastUsed.Value" Format="datetime" />
                                    }
                                    else
                                    {
                                        <span>Never</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="md:hidden divide-y divide-border-primary">
                @foreach (var tool in ToolUsage)
                {
                    <div class="@("p-4 " + (tool.Calls == 0 ? "opacity-60" : ""))">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium text-text-primary">@tool.DisplayName</span>
                            <span class="text-sm font-semibold text-accent-orange">@tool.Calls.ToString("N0")</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-xs">
                            <div><span class="text-text-tertiary block">Category</span><span class="text-text-primary font-medium">@tool.Category</span></div>
                            <div><span class="text-text-tertiary block">Questions</span><span class="text-text-primary font-medium">@tool.Interactions</span></div>
                            <div><span class="text-text-tertiary block">Failure rate</span><span class="text-text-primary font-medium">@(tool.Calls == 0 ? "—" : tool.FailureRate.ToString("F1") + "%")</span></div>
                            <div><span class="text-text-tertiary block">Last used</span><span class="text-text-primary font-medium">@(tool.LastUsed.HasValue ? tool.LastUsed.Value.ToString("yyyy-MM-dd") : "Never")</span></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Prompt Surface -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mt-6">
            <div class="px-6 py-4 border-b border-border-primary">
                <h3 class="text-lg font-semibold text-text-primary">Prompt Surface</h3>
                <p class="text-sm text-text-secondary mt-1">
                    What every question pays for before it is even read. The tool array is sent at the top
                    of each request, so a tool costs its schema whether or not the question needs it.
                </p>
            </div>

            @if (PromptSurface is null)
            {
                <div class="px-6 py-4 text-sm text-text-secondary">
                    The assistant is not configured on this deployment, so there is no tool array to measure.
                </div>
            }
            else
            {
                var surface = PromptSurface;

                <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-y lg:divide-y-0 divide-border-primary border-b border-border-primary">
                    <div class="px-6 py-4">
                        <div class="text-xs text-text-tertiary uppercase tracking-wider">Tools sent</div>
                        <div class="text-2xl font-semibold text-text-primary mt-1">@surface.AdvertisedCount</div>
                        <div class="text-xs text-text-tertiary mt-1">of @surface.RegisteredCount available</div>
                    </div>
                    <div class="px-6 py-4">
                        <div class="text-xs text-text-tertiary uppercase tracking-wider">Schema size</div>
                        <div class="text-2xl font-semibold text-text-primary mt-1">@surface.Advertised.TotalChars.ToString("N0")</div>
                        <div class="text-xs text-text-tertiary mt-1">characters per request</div>
                    </div>
                    <div class="px-6 py-4">
                        <div class="text-xs text-text-tertiary uppercase tracking-wider">Estimated tokens</div>
                        <div class="text-2xl font-semibold text-accent-orange mt-1">~@surface.Advertised.EstimatedTokens.ToString("N0")</div>
                        <div class="text-xs text-text-tertiary mt-1">characters &#247; 4</div>
                    </div>
                    <div class="px-6 py-4">
                        <div class="text-xs text-text-tertiary uppercase tracking-wider">Held back</div>
                        <div class="text-2xl font-semibold text-text-primary mt-1">@surface.WithheldChars.ToString("N0")</div>
                        <div class="text-xs text-text-tertiary mt-1">characters not sent</div>
                    </div>
                </div>

                <div class="overflow-x-auto hidden md:block">
                    <table class="min-w-full divide-y divide-border-primary">
                        <thead class="bg-bg-tertiary">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Tool</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Category</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Schema</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Share of prefix</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">In every request</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-primary">
                            @foreach (var tool in surface.Tools)
                            {
                                <tr class="@("hover:bg-bg-tertiary/50 transition-colors " + (tool.Advertised ? "" : "opacity-60"))">
                                    <td class="px-6 py-3 whitespace-nowrap">
                                        <span class="text-sm font-medium text-text-primary">@tool.DisplayName</span>
                                        <span class="block text-xs text-text-tertiary font-mono">@tool.Name</span>
                                    </td>
                                    <td class="px-6 py-3 whitespace-nowrap text-sm text-text-secondary">@tool.Category</td>
                                    <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-primary">@tool.SchemaChars.ToString("N0")</td>
                                    <td class="px-6 py-3 whitespace-nowrap">
                                        @if (tool.Advertised)
                                        {
                                            <div class="flex items-center gap-2">
                                                <div class="w-24 h-2 bg-bg-tertiary rounded-full overflow-hidden">
                                                    <div class="h-full bg-accent-orange" style="width: @((tool.Share * 100).ToString("F1"))%"></div>
                                                </div>
                                                <span class="text-xs text-text-secondary">@((tool.Share * 100).ToString("F1"))%</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-text-tertiary">&#8212;</span>
                                        }
                                    </td>
                                    <td class="px-6 py-3 whitespace-nowrap text-xs">
                                        @if (tool.Advertised)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-accent-orange/10 text-accent-orange">Yes</span>
                                        }
                                        else if (tool.BehindSkill)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-bg-tertiary text-text-secondary"
                                                  title="@($"Loaded on demand by the {string.Join(", ", tool.SkillKeys)} skill")">
                                                Behind a skill
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-bg-tertiary text-text-secondary">Not allowed here</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="md:hidden divide-y divide-border-primary">
                    @foreach (var tool in surface.Tools)
                    {
                        <div class="@("p-4 " + (tool.Advertised ? "" : "opacity-60"))">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm font-medium text-text-primary">@tool.DisplayName</span>
                                <span class="text-sm font-semibold text-accent-orange">@tool.SchemaChars.ToString("N0")</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div><span class="text-text-tertiary block">Category</span><span class="text-text-primary font-medium">@tool.Category</span></div>
                                <div>
                                    <span class="text-text-tertiary block">Share of prefix</span>
                                    <span class="text-text-primary font-medium">@(tool.Advertised ? (tool.Share * 100).ToString("F1") + "%" : "—")</span>
                                </div>
                                <div class="col-span-2">
                                    <span class="text-text-tertiary block">In every request</span>
                                    <span class="text-text-primary font-medium">@(tool.Advertised ? "Yes" : tool.BehindSkill ? "Behind a skill" : "Not allowed here")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="px-6 py-3 border-t border-border-primary text-xs text-text-tertiary">
                    Measured as the request is actually sent. A tool this server has turned off, or one a
                    skill is holding back, is not in the prefix and is not billed for &#8212; it still appears
                    above so the cost of turning it on is visible before you do.
                </div>
            }
        </div>

        <!-- Cost by User -->
        <div class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden mt-6">
            <div class="px-6 py-4 border-b border-border-primary">
                <h3 class="text-lg font-semibold text-text-primary">Cost by User</h3>
                <p class="text-sm text-text-secondary mt-1">Top @CostByUser.Count spenders in this guild over the last 30 days</p>
            </div>
            @if (CostByUser.Count > 0)
            {
                <div class="overflow-x-auto hidden md:block">
                    <table class="min-w-full divide-y divide-border-primary">
                        <thead class="bg-bg-tertiary">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">User</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Messages</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Tokens</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Cost</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Share</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-primary">
                            @foreach (var user in CostByUser)
                            {
                                <tr class="hover:bg-bg-tertiary/50 transition-colors">
                                    <td class="px-6 py-3 whitespace-nowrap">
                                        <span class="text-sm font-medium text-text-primary">@user.DisplayName</span>
                                        <span class="block text-xs text-text-tertiary font-mono">@user.UserId</span>
                                    </td>
                                    <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-primary">@user.MessageCount.ToString("N0")</td>
                                    <td class="px-6 py-3 whitespace-nowrap text-right text-sm text-text-secondary">@((user.InputTokens + user.OutputTokens).ToString("N0"))</td>
                                    <td class="px-6 py-3 whitespace-nowrap text-right text-sm font-medium text-text-primary">$@user.CostUsd.ToString("F4")</td>
                                    <td class="px-6 py-3 whitespace-nowrap">
                                        <div class="flex items-center gap-2 w-32">
                                            <div class="flex-1 h-2 bg-bg-tertiary rounded-full overflow-hidden">
                                                <div class="h-full bg-accent-orange" style="width: @((user.CostShare * 100).ToString("F1"))%"></div>
                                            </div>
                                            <span class="text-xs text-text-tertiary w-10 text-right">@((user.CostShare * 100).ToString("F0"))%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="md:hidden divide-y divide-border-primary">
                    @foreach (var user in CostByUser)
                    {
                        <div class="p-4">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm font-medium text-text-primary">@user.DisplayName</span>
                                <span class="text-sm font-semibold text-accent-orange">$@user.CostUsd.ToString("F4")</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div><span class="text-text-tertiary block">Messages</span><span class="text-text-primary font-medium">@user.MessageCount</span></div>
                                <div><span class="text-text-tertiary block">Share</span><span class="text-text-primary font-medium">@((user.CostShare * 100).ToString("F0"))%</span></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center">
                    <p class="text-text-secondary">No per-user usage recorded for this range.</p>
                </div>
            }
        </div>

        <div class="mt-6 p-4 bg-info-bg border border-info-border rounded-md">
            <div class="flex items-start gap-3">
                <Icon Path="@IconPaths.InformationCircle" Class="w-5 h-5 text-info flex-shrink-0 mt-0.5" />
                <div class="text-sm text-info">
                    <p class="font-semibold mb-1">About Cost Estimates</p>
                    <p class="text-info/90">
                        Costs are estimated based on Claude API token usage. Actual costs may vary slightly. Cache hits reduce costs significantly by reusing previously computed context.
                    </p>
                </div>
            </div>
        </div>
    </ChildContent>
</GuildContextGate>

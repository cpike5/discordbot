@namespace DiscordBot.Bot.Blazor.Pages.Components.Sections
@using System.Net
@using System.Text
@using DiscordBot.Bot.Blazor.Shared
@using DiscordBot.Bot.ViewModels.Components
@using DiscordBot.Core.Models

@* Non-routable showcase section for Tier 5 (TTS authoring), mirroring how Pages/Portal/TTS/Index.cshtml
   and Pages/Guilds/TextToSpeech/Index.cshtml wire these components together
   (docs/articles/blazor-components.md "Component contract", point 10; see PrimitivesShowcase.razor
   for the sibling Tier 1a section this composes alongside). Sample data only - a later agent
   composes the routable /components page from every tier's *Showcase.razor. *@

<div class="space-y-8" data-testid="tts-showcase">

    <!-- Mode Switcher -->
    <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" data-testid="showcase-mode-switcher">
        <div class="px-6 py-4 border-b border-border-primary">
            <h3 class="text-lg font-semibold text-text-primary">Mode Switcher</h3>
            <p class="text-sm text-text-secondary mt-1">Simple / Standard / Pro segmented control, persisted to localStorage</p>
        </div>
        <div class="p-6">
            <ModeSwitcher @bind-Value="_mode" />
            <p class="text-xs text-text-tertiary mt-3" data-testid="mode-value">Current mode: @_mode</p>
        </div>
    </section>

    <!-- Voice + Style -->
    <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" data-testid="showcase-voice-style">
        <div class="px-6 py-4 border-b border-border-primary">
            <h3 class="text-lg font-semibold text-text-primary">Voice &amp; Style Selectors</h3>
            <p class="text-sm text-text-secondary mt-1">Grouped voice combobox and style/intensity picker (fake capabilities loader)</p>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-text-secondary mb-3">Voice</label>
                <VoiceSelector Voices="_voices" @bind-Value="_voice" />
            </div>
            <div>
                <StyleSelector SelectedVoice="@_voice" @bind-Value="_style" @bind-Intensity="_intensity"
                                AvailableStyles="_styles" CapabilitiesLoader="LoadCapabilitiesAsync"
                                OnEmphasisSupportChanged="@(supported => _emphasisSupported = supported)" />
            </div>
        </div>
    </section>

    <!-- Preset Bar -->
    <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" data-testid="showcase-preset-bar">
        <div class="px-6 py-4 border-b border-border-primary">
            <h3 class="text-lg font-semibold text-text-primary">Preset Bar</h3>
            <p class="text-sm text-text-secondary mt-1">Built-in presets plus user-saved custom presets (persistence is the page's job)</p>
        </div>
        <div class="p-6">
            <PresetBar Presets="_presets" ActivePresetId="@_activePresetId" OnApply="ApplyPresetAsync"
                       CustomPresets="_customPresets" OnSaveCustom="SaveCustomPresetAsync" OnDeleteCustom="DeleteCustomPresetAsync" />
            <p class="text-xs text-text-tertiary mt-3" data-testid="active-preset">Active preset: @(_activePresetId ?? "(none)")</p>
        </div>
    </section>

    <!-- Message + Emphasis Toolbar -->
    <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" data-testid="showcase-emphasis-toolbar">
        <div class="px-6 py-4 border-b border-border-primary">
            <h3 class="text-lg font-semibold text-text-primary">Message &amp; Emphasis Toolbar</h3>
            <p class="text-sm text-text-secondary mt-1">Select text in the box, then apply strong/moderate emphasis, a pause, or say-as formatting</p>
        </div>
        <div class="p-6">
            <div class="relative">
                <textarea class="w-full min-h-[6rem] rounded-lg border border-border-primary bg-bg-primary text-text-primary p-3 text-sm"
                          @ref="_textareaRef"
                          value="@_text"
                          @oninput="@(e => _text = e.Value?.ToString() ?? string.Empty)"></textarea>
                <EmphasisToolbar TextareaRef="_textareaRef" Value="@_text" ValueChanged="@(v => _text = v)"
                                  EmphasisSupported="_emphasisSupported" ShowKeyboardShortcuts="true" />
            </div>
            <div class="mt-3">
                <Button Text="Insert Pause..." Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="OpenPauseModalAsync" />
            </div>
        </div>
    </section>

    <!-- SSML Preview -->
    <section class="bg-bg-secondary border border-border-primary rounded-lg overflow-hidden" data-testid="showcase-ssml-preview">
        <div class="px-6 py-4 border-b border-border-primary">
            <h3 class="text-lg font-semibold text-text-primary">SSML Preview</h3>
            <p class="text-sm text-text-secondary mt-1">Syntax-highlighted, read-only preview of the message built as SSML</p>
        </div>
        <div class="p-6">
            <SsmlPreview Ssml="@BuildSsml()" PlainLength="_text.Length" StartCollapsed="false" ShowCharacterCount="true"
                          OnCopy="@(() => _copyCount++)" />
            <p class="text-xs text-text-tertiary mt-3" data-testid="copy-count">Copied: @_copyCount</p>
        </div>
    </section>
</div>

<PauseModal @ref="_pauseModal" Title="Insert Pause" OnInsert="HandlePauseInsertAsync" />

@code {
    private TtsMode _mode = TtsMode.Standard;
    private string _voice = "en-US-JennyNeural";
    private string _style = string.Empty;
    private decimal _intensity = 1.0m;
    private bool _emphasisSupported = true;
    private string _text = "Welcome to the text to speech preview. Select some words to try emphasis.";
    private ElementReference _textareaRef;
    private string? _activePresetId;
    private readonly List<CustomTtsPreset> _customPresets = new();
    private int _nextCustomId = 1;
    private int _copyCount;
    private PauseModal? _pauseModal;

    private readonly IReadOnlyList<VoiceSelectorVoiceOption> _voices = new[]
    {
        new VoiceSelectorVoiceOption { Value = "en-US-JennyNeural", DisplayName = "Jenny", Gender = "Female", Locale = "en-US", LocaleDisplayName = "English (US)" },
        new VoiceSelectorVoiceOption { Value = "en-US-GuyNeural", DisplayName = "Guy", Gender = "Male", Locale = "en-US", LocaleDisplayName = "English (US)" },
        new VoiceSelectorVoiceOption { Value = "en-GB-LibbyNeural", DisplayName = "Libby", Gender = "Female", Locale = "en-GB", LocaleDisplayName = "English (UK)" },
        new VoiceSelectorVoiceOption { Value = "fr-FR-DeniseNeural", DisplayName = "Denise", Gender = "Female", Locale = "fr-FR", LocaleDisplayName = "French (France)" },
    };

    private readonly IReadOnlyList<StyleOption> _styles = new[]
    {
        new StyleOption { Value = "", Label = "(None)", Description = "Natural speech" },
        new StyleOption { Value = "cheerful", Label = "Cheerful", Icon = "face-smile", Description = "Happy, energetic", Example = "I'm so excited to share this news!" },
        new StyleOption { Value = "excited", Label = "Excited", Icon = "sparkles", Description = "Very enthusiastic", Example = "This is amazing!" },
        new StyleOption { Value = "friendly", Label = "Friendly", Icon = "hand-raised", Description = "Warm, approachable", Example = "Hey there, welcome!" },
        new StyleOption { Value = "sad", Label = "Sad", Icon = "face-frown", Description = "Sorrowful", Example = "I'm sorry to hear that." },
        new StyleOption { Value = "angry", Label = "Angry", Icon = "fire", Description = "Frustrated", Example = "This is unacceptable!" },
        new StyleOption { Value = "whispering", Label = "Whispering", Icon = "speaker-x-mark", Description = "Quiet, intimate", Example = "Don't tell anyone..." },
        new StyleOption { Value = "shouting", Label = "Shouting", Icon = "speaker-wave", Description = "Loud, urgent", Example = "Watch out!" },
        new StyleOption { Value = "newscast", Label = "Newscast", Icon = "newspaper", Description = "Professional", Example = "In today's news..." },
    };

    private readonly IReadOnlyList<PresetButtonViewModel> _presets = new[]
    {
        new PresetButtonViewModel { Id = "excited", Name = "Excited", Icon = "sparkles", Description = "High energy, cheerful tone", VoiceName = "en-US-JennyNeural", Style = "cheerful", Speed = 1.2m, Pitch = 1.1m },
        new PresetButtonViewModel { Id = "announcer", Name = "Announcer", Icon = "megaphone", Description = "Deep voice for announcements", VoiceName = "en-US-GuyNeural", Style = "newscast", Speed = 1.0m, Pitch = 0.9m },
        new PresetButtonViewModel { Id = "robot", Name = "Robot", Icon = "computer-desktop", Description = "Robotic, monotone delivery", VoiceName = "en-US-GuyNeural", Style = null, Speed = 0.9m, Pitch = 0.7m },
        new PresetButtonViewModel { Id = "friendly", Name = "Friendly", Icon = "face-smile", Description = "Warm, natural", VoiceName = "en-US-JennyNeural", Style = "friendly", Speed = 1.0m, Pitch = 1.0m },
        new PresetButtonViewModel { Id = "narrator", Name = "Narrator", Icon = "microphone", Description = "Professional, measured", VoiceName = "en-GB-LibbyNeural", Style = null, Speed = 0.9m, Pitch = 1.0m },
        new PresetButtonViewModel { Id = "whisper", Name = "Whisper", Icon = "speaker-x-mark", Description = "Quiet, intimate", VoiceName = "en-US-JennyNeural", Style = "whispering", Speed = 0.9m, Pitch = 0.9m },
    };

    /// <summary>Fake stand-in for <c>GET /api/portal/tts/voices/{voice}/capabilities</c> - a real
    /// page passes its own <c>ITtsVoiceCapabilityProvider</c>-backed delegate instead.</summary>
    private Task<VoiceCapabilities?> LoadCapabilitiesAsync(string voiceName)
    {
        var supportsEmphasis = voiceName == "en-US-GuyNeural";
        var supportedStyles = voiceName switch
        {
            "en-US-JennyNeural" => new[] { "cheerful", "excited", "friendly", "sad", "whispering" },
            "en-US-GuyNeural" => new[] { "angry", "newscast", "shouting" },
            _ => Array.Empty<string>()
        };

        return Task.FromResult<VoiceCapabilities?>(new VoiceCapabilities
        {
            VoiceName = voiceName,
            DisplayName = voiceName,
            Locale = "en-US",
            Gender = "Female",
            SupportedStyles = supportedStyles,
            SupportsEmphasis = supportsEmphasis
        });
    }

    private Task ApplyPresetAsync(PresetButtonViewModel preset)
    {
        _activePresetId = preset.Id;
        _voice = preset.VoiceName;
        _style = preset.Style ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task SaveCustomPresetAsync(string name)
    {
        var preset = new CustomTtsPreset(_nextCustomId++, name, _voice, _style, 1.0m, 1.0m);
        _customPresets.Add(preset);
        _activePresetId = $"custom-{preset.Id}";
        return Task.CompletedTask;
    }

    private Task DeleteCustomPresetAsync(CustomTtsPreset preset)
    {
        _customPresets.RemoveAll(p => p.Id == preset.Id);
        if (_activePresetId == $"custom-{preset.Id}")
        {
            _activePresetId = null;
        }

        return Task.CompletedTask;
    }

    private async Task OpenPauseModalAsync()
    {
        if (_pauseModal is null)
        {
            return;
        }

        var duration = await _pauseModal.ShowAsync();
        if (duration is { } ms)
        {
            _text += SsmlMarkers.PauseMarker(ms);
        }
    }

    private Task HandlePauseInsertAsync(int duration) => Task.CompletedTask;

    /// <summary>Small stand-in SSML builder for the showcase - a real page uses
    /// <c>ISsmlBuilder</c> against <see cref="SsmlMarkers.ParseMarkers"/>'s element list.</summary>
    private string BuildSsml()
    {
        var sb = new StringBuilder();
        sb.Append("<speak version=\"1.0\" xmlns=\"http://www.w3.org/2001/10/synthesis\" xml:lang=\"en-US\"><voice name=\"")
          .Append(WebUtility.HtmlEncode(_voice))
          .Append("\">");

        if (!string.IsNullOrEmpty(_style))
        {
            sb.Append("<mstts:express-as style=\"").Append(WebUtility.HtmlEncode(_style)).Append("\" styledegree=\"")
              .Append(_intensity.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)).Append("\">");
        }

        foreach (var element in SsmlMarkers.ParseMarkers(_text))
        {
            switch (element.Type)
            {
                case "text":
                    sb.Append(WebUtility.HtmlEncode(element.Text));
                    break;
                case "emphasis":
                    sb.Append("<emphasis level=\"").Append(element.Attributes["level"]).Append("\">")
                      .Append(WebUtility.HtmlEncode(element.Text)).Append("</emphasis>");
                    break;
                case "say-as":
                    sb.Append("<say-as interpret-as=\"").Append(element.Attributes["interpret-as"]).Append("\">")
                      .Append(WebUtility.HtmlEncode(element.Text)).Append("</say-as>");
                    break;
                case "break":
                    sb.Append("<break time=\"").Append(element.Attributes["duration"]).Append("\"/>");
                    break;
            }
        }

        if (!string.IsNullOrEmpty(_style))
        {
            sb.Append("</mstts:express-as>");
        }

        sb.Append("</voice></speak>");
        return sb.ToString();
    }
}

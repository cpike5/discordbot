@namespace DiscordBot.Bot.Blazor.Shared
@using DiscordBot.Bot.ViewModels.Components

@*
    Blazor twin of Pages/Shared/Components/_ActivityFeedTimeline.cshtml.
    Render-only: items come in via the Model parameter (Model.Items) and are
    rendered natively — the partial's JS insertion template is dropped; real-time
    updates are the consuming page's responsibility. The pause toggle is native
    component state (drives the indicator/icon/text like activity-feed JS did).
*@

<div class="bg-bg-secondary border border-border-primary rounded-xl overflow-hidden h-full flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-border-primary">
        <div class="flex items-center gap-3">
            <h2 class="text-lg font-semibold text-text-primary">@Model.Title</h2>
            <span class="@(_paused ? "" : "hidden") text-xs text-warning font-medium">Paused</span>
        </div>
        <div class="flex items-center gap-2">
            @if (Model.ShowRefreshButton)
            {
                <button
                    type="button"
                    class="flex items-center gap-1.5 px-3 py-1.5 text-sm text-text-secondary hover:text-text-primary hover:bg-bg-hover rounded-md transition-all duration-150"
                    aria-pressed="@(_paused ? "true" : "false")"
                    aria-label="@(_paused ? "Resume activity feed" : "Pause activity feed")"
                    @onclick="TogglePauseAsync"
                >
                    <svg class="w-4 h-4 @(_paused ? "hidden" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <svg class="w-4 h-4 @(_paused ? "" : "hidden")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>@(_paused ? "Resume" : "Pause")</span>
                </button>
            }
        </div>
    </div>

    <!-- Timeline Container -->
    <div class="p-4 overflow-y-auto flex-grow" style="@MaxHeightStyle">
        <div class="activity-timeline">
            @if (Model.HasItems)
            {
                @foreach (var item in Model.Items)
                {
                    <div class="activity-item @item.TypeClassName">
                        <div class="bg-bg-primary/50 rounded-lg p-3">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="activity-timestamp text-xs text-text-tertiary font-mono">@item.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                            </div>
                            <p class="text-sm text-text-primary activity-description">
                                @if (!string.IsNullOrEmpty(item.CommandText))
                                {
                                    var index = item.Message.IndexOf(item.CommandText, StringComparison.Ordinal);
                                    if (index >= 0)
                                    {
                                        @item.Message[..index]<span class="font-mono text-accent-orange">@item.CommandText</span>@item.Message[(index + item.CommandText.Length)..]
                                    }
                                    else
                                    {
                                        @item.Message
                                    }
                                }
                                else
                                {
                                    @item.Message
                                }
                            </p>
                            <p class="text-xs text-text-tertiary mt-1 activity-guild">@item.Source - @item.RelativeTime</p>
                        </div>
                    </div>
                }
            }
            <!-- Empty state (hidden when items exist) -->
            <div class="@(Model.HasItems ? "hidden" : "") flex flex-col items-center justify-center py-12 text-center">
                <svg class="w-12 h-12 text-text-tertiary mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <p class="text-sm text-text-secondary">No recent activity</p>
                <p class="text-xs text-text-tertiary mt-1">Activity will appear here as it occurs</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    @if (!string.IsNullOrEmpty(Model.ViewAllUrl))
    {
        <div class="px-6 py-3 border-t border-border-primary bg-bg-primary/30">
            <a
                href="@Model.ViewAllUrl"
                class="text-sm text-accent-blue hover:text-accent-blue-hover font-medium transition-colors duration-150"
            >
                View all activity
                <svg class="inline-block w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Timeline configuration + the item list to render (Model.Items).
    /// Complex ViewModel, so it is accepted whole rather than as flat parameters.
    /// </summary>
    [Parameter] public ActivityFeedTimelineViewModel Model { get; set; } = new();

    /// <summary>Raised when the pause toggle changes so the consuming page can stop pushing items.</summary>
    [Parameter] public EventCallback<bool> OnPauseToggle { get; set; }

    private bool _paused;

    private string MaxHeightStyle =>
        !string.IsNullOrEmpty(Model.MaxHeight) ? $"max-height: {Model.MaxHeight};" : "";

    private async Task TogglePauseAsync()
    {
        _paused = !_paused;
        if (OnPauseToggle.HasDelegate)
        {
            await OnPauseToggle.InvokeAsync(_paused);
        }
    }
}

@namespace DiscordBot.Bot.Blazor.Shared
@using DiscordBot.Bot.Blazor.Interop
@using DiscordBot.Bot.ViewModels.Components
@implements IAsyncDisposable
@inject BrowserInterop BrowserInterop

@* Ported from _GuildContextSelector.cshtml / GuildContextSelectorViewModel. The inline
   click-outside-to-close script becomes BrowserInterop.OnClickOutsideAsync; Escape-to-close is new
   (the partial had none) since it's now a stateful Blazor dropdown rather than a plain
   document.addEventListener. *@

@if (Guilds.Count == 0)
{
    <span class="text-sm text-text-tertiary italic @Class" @attributes="AdditionalAttributes">No guilds available</span>
}
else if (Guilds.Count == 1)
{
    var guild = Guilds[0];
    <a href="@Url(guild)" class="inline-flex items-center gap-2 text-sm font-medium text-accent-blue hover:text-accent-blue-hover transition-colors @Class" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrEmpty(guild.GuildIconUrl))
        {
            <img src="@guild.GuildIconUrl" alt="" class="w-4 h-4 rounded-full" />
        }
        <span>Open in @guild.GuildName</span>
        <Icon Path="IconPaths.ArrowRight" Class="w-4 h-4" />
    </a>
}
else
{
    <div @ref="_containerRef" class="relative inline-block @Class" @attributes="AdditionalAttributes">
        <button type="button"
                class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium text-accent-blue bg-accent-blue/10 border border-accent-blue/20 rounded-lg hover:bg-accent-blue/20 transition-colors"
                @onclick="Toggle">
            <Icon Path="IconPaths.Home" Class="w-4 h-4" />
            <span>Select guild</span>
            <Icon Path="IconPaths.ChevronDown" Class="w-3 h-3" />
        </button>
        <div class="@DropdownClass" @onkeydown="HandleKeyDown">
            @foreach (var guild in Guilds)
            {
                <a href="@Url(guild)"
                   class="flex items-center gap-3 px-4 py-2.5 text-sm text-text-primary hover:bg-bg-hover transition-colors">
                    @if (!string.IsNullOrEmpty(guild.GuildIconUrl))
                    {
                        <img src="@guild.GuildIconUrl" alt="" class="w-5 h-5 rounded-full flex-shrink-0" />
                    }
                    else
                    {
                        <div class="w-5 h-5 rounded-full bg-bg-tertiary flex items-center justify-center flex-shrink-0">
                            <span class="text-xs font-medium text-text-secondary">@guild.GuildName.FirstOrDefault()</span>
                        </div>
                    }
                    <span class="truncate">@guild.GuildName</span>
                </a>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string RouteTemplate { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<GuildSelectorItem> Guilds { get; set; } = [];
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _containerRef;
    private DotNetObjectReference<GuildContextSelector>? _selfRef;
    private int? _clickOutsideHandle;
    private bool _open;

    private string DropdownClass => _open
        ? "absolute left-0 z-50 mt-1 w-56 bg-bg-secondary border border-border-primary rounded-lg shadow-lg overflow-hidden"
        : "hidden absolute left-0 z-50 mt-1 w-56 bg-bg-secondary border border-border-primary rounded-lg shadow-lg overflow-hidden";

    private string Url(GuildSelectorItem guild) => RouteTemplate.Replace("{guildId}", guild.GuildId);

    protected override void OnInitialized() => _selfRef = DotNetObjectReference.Create(this);

    private async Task Toggle()
    {
        _open = !_open;
        if (_open && _clickOutsideHandle is null)
        {
            _clickOutsideHandle = await BrowserInterop.OnClickOutsideAsync(_containerRef, _selfRef!);
        }
        else if (!_open)
        {
            await ReleaseClickOutsideAsync();
        }
    }

    [JSInvokable]
    public void OnClickOutside()
    {
        _open = false;
        StateHasChanged();
        _ = ReleaseClickOutsideAsync();
    }

    private Task HandleKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Toggle() : Task.CompletedTask;

    private async Task ReleaseClickOutsideAsync()
    {
        if (_clickOutsideHandle is { } handle)
        {
            _clickOutsideHandle = null;
            await BrowserInterop.OffClickOutsideAsync(handle);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await ReleaseClickOutsideAsync();
        _selfRef?.Dispose();
    }
}

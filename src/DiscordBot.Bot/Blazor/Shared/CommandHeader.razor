@namespace DiscordBot.Bot.Blazor.Shared

@*
    Blazor twin of Pages/Shared/Components/_CommandHeader.cshtml.
*@

<div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-bold text-text-primary">@Title</h1>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <p class="text-sm text-text-secondary mt-1" data-command-subtitle>@Subtitle</p>
    }
</div>

@code {
    /// <summary>Main page title. Defaults to "Commands".</summary>
    [Parameter] public string Title { get; set; } = "Commands";

    /// <summary>Optional subtitle text displayed below the title.</summary>
    [Parameter] public string Subtitle { get; set; } = string.Empty;

    /// <summary>Currently active tab identifier (kept for parity with CommandHeaderViewModel; not rendered).</summary>
    [Parameter] public string ActiveTab { get; set; } = "command-list";
}

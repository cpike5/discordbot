@namespace DiscordBot.Bot.Blazor.Shared
@using DiscordBot.Bot.ViewModels.Components

@*
    Blazor twin of Pages/Shared/Components/_PageLoadingOverlay.cshtml.
    Same Tailwind classes so it is visually identical to the partial.
    The partial rendered the _LoadingSpinner partial with SpinnerColor.White;
    that spinner markup (non-overlay branch) is inlined here verbatim because
    no LoadingSpinner Blazor component exists yet.
    The cancel button raises the OnCancel EventCallback (the partial exposed
    it to JS via an id instead).
*@

<!-- Page Loading Overlay -->
<div id="@Model.Id"
     class="loading-overlay hidden"
     role="alert"
     aria-live="polite"
     aria-busy="true">

    <!-- Spinner and Messages -->
    <div class="@(string.IsNullOrEmpty(Model.Message) ? "inline-flex" : "flex flex-col items-center justify-center gap-3")">
        @if (Model.Variant == SpinnerVariant.Dots)
        {
            <div class="flex items-center justify-center gap-1.5">
                <div class="@DotSize @BgColorClass rounded-full animate-bounce" style="animation-delay: -0.32s"></div>
                <div class="@DotSize @BgColorClass rounded-full animate-bounce" style="animation-delay: -0.16s"></div>
                <div class="@DotSize @BgColorClass rounded-full animate-bounce"></div>
            </div>
        }
        else if (Model.Variant == SpinnerVariant.Pulse)
        {
            <div class="relative flex items-center justify-center">
                <div class="absolute @OuterSize @BorderWidth @BorderColorClass rounded-full animate-ping opacity-75"></div>
                <div class="@InnerSize @BgColorClass rounded-full animate-pulse"></div>
            </div>
        }
        else
        {
            <div class="@OuterSize @BorderWidth border-white/20 @ColorClass rounded-full animate-spin"></div>
        }
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p class="text-sm text-text-primary">@Model.Message</p>
        }
        @if (!string.IsNullOrEmpty(Model.SubMessage))
        {
            <p class="text-xs text-text-tertiary">@Model.SubMessage</p>
        }
    </div>

    <!-- Optional Cancel Button -->
    @if (Model.ShowCancelButton)
    {
        <button type="button"
                class="btn btn-secondary btn-sm mt-4"
                id="@(Model.Id)CancelBtn"
                aria-label="@Model.CancelText"
                @onclick="HandleCancelAsync">
            @Model.CancelText
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public PageLoadingOverlayViewModel Model { get; set; } = new();

    /// <summary>Raised when the cancel button is clicked.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    // Spinner sizing/colors copied from _LoadingSpinner.cshtml with SpinnerColor.White,
    // matching the LoadingSpinnerViewModel the partial constructed.
    private (string OuterSize, string InnerSize, string BorderWidth) SpinnerSizes => Model.Size switch
    {
        SpinnerSize.Small => ("w-6 h-6", "w-3 h-3", "border-2"),
        SpinnerSize.Large => ("w-16 h-16", "w-8 h-8", "border-4"),
        _ => ("w-10 h-10", "w-5 h-5", "border-[3px]")
    };

    private string OuterSize => SpinnerSizes.OuterSize;
    private string InnerSize => SpinnerSizes.InnerSize;
    private string BorderWidth => SpinnerSizes.BorderWidth;

    private string ColorClass => "border-white/20 border-t-white";
    private string BgColorClass => "bg-white";
    private string BorderColorClass => "border-white";

    private string DotSize => Model.Size switch
    {
        SpinnerSize.Small => "w-1.5 h-1.5",
        SpinnerSize.Large => "w-4 h-4",
        _ => "w-2.5 h-2.5"
    };

    private async Task HandleCancelAsync()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}

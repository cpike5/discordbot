@namespace DiscordBot.Bot.Blazor.Shared
@using DiscordBot.Bot.ViewModels.Components

@* Ported from _StatusIndicator.cshtml / StatusIndicatorViewModel. Pure markup, no interop. The
   three DisplayStyle branches don't share a common wrapper element in the source partial (DotOnly
   has none at all) so Class/AdditionalAttributes land on whichever element is the actual root of
   each branch, matching the partial's structure exactly rather than forcing a uniform wrapper. *@

@if (DisplayStyle == StatusDisplayStyle.DotOnly)
{
    @if (IsPulsing)
    {
        <span class="@Merge("relative inline-flex")" @attributes="AdditionalAttributes">
            <span class="@SizeClass @ColorClass rounded-full"></span>
            <span class="absolute inset-0 @SizeClass @ColorClass rounded-full animate-ping opacity-75"></span>
        </span>
    }
    else
    {
        <span class="@Merge($"{SizeClass} {ColorClass} rounded-full")" @attributes="AdditionalAttributes"></span>
    }
}
else if (DisplayStyle == StatusDisplayStyle.BadgeStyle)
{
    <span class="@Merge($"inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-full {BadgeBgClass}")" @attributes="AdditionalAttributes">
        @Dot(BadgeDotSize)
        @DisplayText
    </span>
}
else
{
    <span class="@Merge($"inline-flex items-center gap-2 text-sm font-medium {TextColorClass}")" @attributes="AdditionalAttributes">
        @Dot(SizeClass)
        @DisplayText
    </span>
}

@code {
    [Parameter] public StatusType Status { get; set; } = StatusType.Offline;
    [Parameter] public string? Text { get; set; }
    [Parameter] public StatusDisplayStyle DisplayStyle { get; set; } = StatusDisplayStyle.DotWithText;
    [Parameter] public bool IsPulsing { get; set; }
    [Parameter] public StatusSize Size { get; set; } = StatusSize.Medium;
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private const string BadgeDotSize = "w-1.5 h-1.5";

    private string SizeClass => Size switch
    {
        StatusSize.Small => "w-1.5 h-1.5",
        StatusSize.Large => "w-3 h-3",
        _ => "w-2 h-2"
    };

    private string ColorClass => Status switch
    {
        StatusType.Online => "bg-success",
        StatusType.Idle => "bg-warning",
        StatusType.Busy => "bg-error",
        _ => "bg-text-tertiary"
    };

    private string TextColorClass => Status switch
    {
        StatusType.Online => "text-success",
        StatusType.Idle => "text-warning",
        StatusType.Busy => "text-error",
        _ => "text-text-tertiary"
    };

    private string BadgeBgClass => Status switch
    {
        StatusType.Online => "bg-success/20 text-success",
        StatusType.Idle => "bg-warning/20 text-warning",
        StatusType.Busy => "bg-error/20 text-error",
        _ => "bg-border-primary text-text-tertiary"
    };

    private string DisplayText => Text ?? Status switch
    {
        StatusType.Online => "Online",
        StatusType.Idle => "Idle",
        StatusType.Busy => "Do Not Disturb",
        _ => "Offline"
    };

    private string Merge(string baseClasses) => string.Join(" ", new[] { baseClasses, Class }
        .Where(c => !string.IsNullOrEmpty(c)));

    private RenderFragment Dot(string sizeClass) => @<text>
        @if (IsPulsing)
        {
            <span class="relative inline-flex">
                <span class="@sizeClass @ColorClass rounded-full"></span>
                <span class="absolute inset-0 @sizeClass @ColorClass rounded-full animate-ping opacity-75"></span>
            </span>
        }
        else
        {
            <span class="@sizeClass @ColorClass rounded-full"></span>
        }
    </text>;
}

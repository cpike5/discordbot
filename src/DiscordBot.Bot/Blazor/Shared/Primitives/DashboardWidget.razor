@namespace DiscordBot.Bot.Blazor.Shared
@using DiscordBot.Bot.ViewModels.Components

@* Ported from _DashboardWidget.cshtml / DashboardWidgetViewModel. BodyContent (a raw-HTML string)
   becomes ChildContent; the EmptyState fallback keeps both shapes the ViewModel supported - a
   data object (EmptyState, reusing EmptyStateViewModel as a plain parameter holder mapped onto
   the Tier 1a <EmptyState> component below) or a fully custom EmptyContent fragment - so a caller
   picks whichever is more convenient. Precedence: ChildContent, then EmptyContent, then EmptyState. *@

<div class="@RootClass" @attributes="AdditionalAttributes">
    <div class="px-4 sm:px-6 py-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                @if (!string.IsNullOrEmpty(IconPath))
                {
                    <Icon Path="@IconPath" Class="text-text-tertiary" Size="IconSize.MD" />
                }
                <h3 class="text-lg font-semibold text-text-primary">@Title</h3>
                @if (IsEnabled.HasValue)
                {
                    @if (IsEnabled.Value)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-success/20 text-success">
                            <span class="w-1.5 h-1.5 rounded-full bg-success mr-1"></span>
                            @EnabledLabel
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-error/20 text-error">
                            <span class="w-1.5 h-1.5 rounded-full bg-error mr-1"></span>
                            @DisabledLabel
                        </span>
                    }
                }
            </div>
            <div class="flex items-center gap-3">
                @if (HeaderActions is not null)
                {
                    @foreach (var action in HeaderActions)
                    {
                        <a href="@action.Url" class="text-sm text-text-secondary hover:text-text-primary transition-colors">
                            @action.Text
                        </a>
                    }
                }
                @if (!string.IsNullOrEmpty(DetailUrl))
                {
                    <a href="@DetailUrl" class="text-sm text-accent-blue hover:text-accent-blue/80 transition-colors">
                        @DetailLinkText
                    </a>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="text-sm text-text-secondary mt-1">@Subtitle</p>
        }
    </div>

    <div class="px-4 sm:px-6 pb-4 sm:pb-6">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (EmptyContent is not null)
        {
            @EmptyContent
        }
        else if (EmptyState is not null)
        {
            <EmptyState Type="EmptyState.Type" Title="@EmptyState.Title" Description="@EmptyState.Description"
                        IconPath="@EmptyState.IconSvgPath" PrimaryActionText="@EmptyState.PrimaryActionText"
                        PrimaryActionHref="@EmptyState.PrimaryActionUrl" SecondaryActionText="@EmptyState.SecondaryActionText"
                        SecondaryActionHref="@EmptyState.SecondaryActionUrl" Size="EmptyState.Size" />
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? DetailUrl { get; set; }
    [Parameter] public string DetailLinkText { get; set; } = "View All →";
    [Parameter] public string? IconPath { get; set; }
    [Parameter] public bool? IsEnabled { get; set; }
    [Parameter] public string EnabledLabel { get; set; } = "Enabled";
    [Parameter] public string DisabledLabel { get; set; } = "Disabled";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    [Parameter] public EmptyStateViewModel? EmptyState { get; set; }
    [Parameter] public int ColSpan { get; set; } = 1;
    [Parameter] public List<WidgetHeaderAction>? HeaderActions { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ColSpanClass => ColSpan == 2 ? "md:col-span-2" : "md:col-span-1";

    private string RootClass => string.Join(" ", new[]
    {
        ColSpanClass, "bg-bg-secondary border border-border-primary rounded-lg overflow-hidden", Class
    }.Where(c => !string.IsNullOrEmpty(c)));
}

@namespace DiscordBot.Bot.Blazor.Shared
@using DiscordBot.Bot.ViewModels.Components

@*
    Blazor twin of Pages/Shared/Components/_HeroMetricCard.cshtml.
    Same Tailwind classes / accent + trend variants so it is visually identical
    to the partial. Model.IconSvg and the trend arrow are raw SVG fragments and
    are rendered via MarkupString, exactly as the partial used Html.Raw.
*@

<div class="@CardClasses" id="@(string.IsNullOrEmpty(Model.Id) ? null : Model.Id)">
    <div class="flex items-start justify-between">
        <div>
            <p class="text-sm font-medium text-text-secondary">@Model.Title</p>
            <p class="mt-2 text-3xl font-bold text-text-primary" @attributes="ValueAttributes">@Model.Value</p>

            @if (!string.IsNullOrEmpty(Model.TrendValue) || !string.IsNullOrEmpty(Model.TrendLabel))
            {
                <div class="mt-2 flex items-center gap-1.5">
                    @if (!string.IsNullOrEmpty(Model.TrendValue))
                    {
                        <span class="@TrendClass flex items-center gap-1 text-xs font-medium">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                @((MarkupString)TrendIconSvg)
                            </svg>
                            @Model.TrendValue
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.TrendLabel))
                    {
                        <span class="text-xs text-text-tertiary">@Model.TrendLabel</span>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.IconSvg))
        {
            <div class="p-3 @IconBgClass rounded-xl">
                <svg class="w-6 h-6 @IconTextClass" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    @((MarkupString)Model.IconSvg)
                </svg>
            </div>
        }
    </div>

    @if (Model.ShowSparkline && Model.SparklineData.Any())
    {
        <div class="sparkline mt-4" aria-hidden="true">
            @foreach (var height in Model.SparklineData)
            {
                <div class="sparkline-bar" style="height: @(height)%; background-color: @SparklineColorVar"></div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public HeroMetricCardViewModel Model { get; set; } = new();

    private string AccentClass => Model.AccentColor switch
    {
        CardAccent.Blue => "accent-blue",
        CardAccent.Orange => "accent-orange",
        CardAccent.Success => "accent-success",
        CardAccent.Info => "accent-info",
        _ => "accent-blue"
    };

    private string TrendClass => Model.TrendDirection switch
    {
        TrendDirection.Up => "trend-up",
        TrendDirection.Down => "trend-down",
        TrendDirection.Neutral => "trend-neutral",
        _ => "trend-neutral"
    };

    private string TrendIconSvg => Model.TrendDirection switch
    {
        TrendDirection.Up =>
            "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 10l7-7m0 0l7 7m-7-7v18\" />",
        TrendDirection.Down =>
            "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 14l-7 7m0 0l-7-7m7 7V3\" />",
        TrendDirection.Neutral =>
            "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20 12H4\" />",
        _ => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20 12H4\" />"
    };

    private string IconBgClass => Model.AccentColor switch
    {
        CardAccent.Blue => "bg-accent-blue/10",
        CardAccent.Orange => "bg-accent-orange/10",
        CardAccent.Success => "bg-success/10",
        CardAccent.Info => "bg-info/10",
        _ => "bg-accent-blue/10"
    };

    private string IconTextClass => Model.AccentColor switch
    {
        CardAccent.Blue => "text-accent-blue",
        CardAccent.Orange => "text-accent-orange",
        CardAccent.Success => "text-success",
        CardAccent.Info => "text-info",
        _ => "text-accent-blue"
    };

    private string SparklineColorVar => Model.AccentColor switch
    {
        CardAccent.Blue => "var(--color-accent-blue)",
        CardAccent.Orange => "var(--color-accent-orange)",
        CardAccent.Success => "var(--color-success)",
        CardAccent.Info => "var(--color-info)",
        _ => "var(--color-accent-blue)"
    };

    private string CardClasses => $"hero-metric-card {AccentClass} {Model.CssClass ?? ""}".Trim();

    // The partial injected Model.DataAttribute as a raw attribute name (e.g. "data-total-commands")
    // to enable SignalR real-time updates; splatting reproduces that.
    private IReadOnlyDictionary<string, object>? ValueAttributes =>
        string.IsNullOrEmpty(Model.DataAttribute)
            ? null
            : new Dictionary<string, object> { [Model.DataAttribute] = string.Empty };
}

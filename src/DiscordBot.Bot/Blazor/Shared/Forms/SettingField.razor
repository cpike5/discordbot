@namespace DiscordBot.Bot.Blazor.Shared
@using DiscordBot.Core.DTOs
@using DiscordBot.Core.Enums
@using DiscordBot.Bot.ViewModels.Components

@* Ported from Pages/Shared/_SettingField.cshtml (model = Core.DTOs.SettingDto, not a
   ViewModels.Components type - the partial lives in Pages/Shared/, not Pages/Shared/Components/).
   Dispatches on SettingDataType to Toggle/Select/TextInput exactly as the partial does; the
   "Restart Required" indicator goes through <Badge> instead of the partial's hand-written
   bg-warning/10 <span> (the tier brief asks for this explicitly) - its refresh-arrow icon isn't a
   20x20 filled Heroicon (what Badge.IconLeft expects, see Component contract point 8), so it's
   composed into Badge's ChildContent via <Icon> instead of IconLeft. *@

@{
    var inputId = $"setting_{Setting.Key.Replace(":", "_").Replace(".", "_")}";
    var inputName = $"FormSettings[{Setting.Key}]";
}

@if (Setting.DataType == SettingDataType.Boolean)
{
    <div class="lg:col-span-2 @Class" @attributes="AdditionalAttributes">
        <div class="flex items-start gap-4 p-4 bg-bg-primary rounded-lg border border-border-primary">
            <Toggle Id="@inputId" Name="@inputName" Label="@Setting.DisplayName" Description="@Setting.Description"
                    Value="_boolValue" ValueChanged="HandleBoolChanged" />
            @if (Setting.RequiresRestart)
            {
                <div class="ml-auto flex-shrink-0">
                    @RestartBadge
                </div>
            }
        </div>
    </div>
}
else if (Setting.AllowedValues is { Count: > 0 })
{
    <div class="@Class" @attributes="AdditionalAttributes">
        <Select TValue="string" Id="@inputId" Name="@inputName" Label="@Setting.DisplayName"
                Options="@AllowedOptions" HelpText="@Setting.Description"
                Value="_stringValue" ValueChanged="HandleStringChanged" />
        @if (Setting.RequiresRestart)
        {
            <div class="mt-2">
                @RestartBadge
            </div>
        }
    </div>
}
else if (Setting.DataType is SettingDataType.Integer or SettingDataType.Decimal)
{
    <div class="@Class" @attributes="AdditionalAttributes">
        <TextInput Id="@inputId" Name="@inputName" Label="@Setting.DisplayName" Type="number"
                   HelpText="@Setting.Description" Value="_stringValue" ValueChanged="HandleStringChanged"
                   AdditionalAttributes="@NumberStepAttribute" />
        @if (Setting.RequiresRestart)
        {
            <div class="mt-2">
                @RestartBadge
            </div>
        }
    </div>
}
else
{
    <div class="@Class" @attributes="AdditionalAttributes">
        <TextInput Id="@inputId" Name="@inputName" Label="@Setting.DisplayName" Type="text"
                   HelpText="@Setting.Description" Value="_stringValue" ValueChanged="HandleStringChanged" />
        @if (Setting.RequiresRestart)
        {
            <div class="mt-2">
                @RestartBadge
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public SettingDto Setting { get; set; } = null!;

    /// <summary>Fires with (Key, Value) whenever the rendered control's value changes - Value is
    /// always the same string representation SettingDto.Value already uses ("true"/"false" for a
    /// Boolean setting, the raw text otherwise).</summary>
    [Parameter] public EventCallback<(string Key, string Value)> OnValueChanged { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? _stringValueOverride;
    private string _stringValue => _stringValueOverride ?? Setting.Value;
    private bool _boolValue => string.Equals(_stringValue, "true", StringComparison.OrdinalIgnoreCase);

    private List<SelectOption> AllowedOptions => (Setting.AllowedValues ?? new List<string>())
        .Select(v => new SelectOption { Value = v, Text = v })
        .ToList();

    private Dictionary<string, object>? NumberStepAttribute => new()
    {
        ["step"] = Setting.DataType == SettingDataType.Decimal ? "0.01" : "1"
    };

    private async Task HandleStringChanged(string? value)
    {
        _stringValueOverride = value ?? string.Empty;
        await OnValueChanged.InvokeAsync((Setting.Key, _stringValueOverride));
    }

    private async Task HandleBoolChanged(bool value)
    {
        _stringValueOverride = value ? "true" : "false";
        await OnValueChanged.InvokeAsync((Setting.Key, _stringValueOverride));
    }

    private RenderFragment RestartBadge => @<Badge Variant="BadgeVariant.Warning">
        <Icon Path="@IconPaths.ArrowPath" Size="IconSize.XS" Class="mr-1" />Restart Required
    </Badge>;
}

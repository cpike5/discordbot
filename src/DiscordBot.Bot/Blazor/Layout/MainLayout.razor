@*
    Blazor bootstrap for routed pages. blazor.web.js (razor-components hosting)
    starts the server circuit for any component with an interactive render mode
    (the bell island above). Loaded after toast.js/theme.js so blazor-interop.js
    can bridge them (gotcha §6.1). Relative fetches resolve against App.razor's
    <base href="/">, so nested routes are safe without a manual Blazor.start.
*@
<script src="js/blazor-interop.js"></script>
<script src="_framework/blazor.web.js"></script>

@code {
    /// <summary>
    /// Overrides the notification bell area. Defaults to the real
    /// NotificationBellIsland (interactive server); bUnit tests supply a stub
    /// fragment so the island's DI surface doesn't need faking.
    /// </summary>
    [Parameter] public RenderFragment? BellContent { get; set; }

    private string _displayName = "User";
    private string? _email;
    private string? _avatarUrl;
    private string _initials = "U";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        if (principal.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _displayName = principal.Identity.Name ?? "User";
        try
        {
            // Same lookup _Navbar.cshtml did via the injected UserManager; a DI
            // scope per operation (standing rule). Failure degrades to the
            // claims-derived name — the chrome must never take a page down.
            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userManager.GetUserAsync(principal);
            _displayName = user?.DisplayName ?? user?.Email ?? _displayName;
            _email = user?.Email;
            _avatarUrl = user?.DiscordAvatarUrl;
        }
        catch
        {
            // Claims-only fallback (also keeps bUnit setup light).
        }

        _initials = string.Join(
            string.Empty,
            _displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
    }

    // ── Active-link computation (twin of _Sidebar.cshtml's route-data checks) ──

    private string CurrentPath
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var path = "/" + relative.Split('?', '#')[0].TrimEnd('/');
            return path == "/" ? "/" : path;
        }
    }

    private bool DashboardActive => CurrentPath is "/" or "/Index";

    private bool IsActiveExact(string path) =>
        string.Equals(CurrentPath, path, StringComparison.OrdinalIgnoreCase);

    private bool IsActivePrefix(string prefix) =>
        CurrentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    private bool LogsActive =>
        IsActivePrefix("/Admin/Logs") || IsActivePrefix("/Admin/MessageLogs") || IsActivePrefix("/Admin/AuditLogs");
}

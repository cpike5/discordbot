@namespace DiscordBot.Bot.Blazor.Layout
@inherits LayoutComponentBase
@using System.Security.Claims
@using DiscordBot.Bot.Blazor.Pages
@using DiscordBot.Core.Configuration
@using DiscordBot.Core.Entities
@using DiscordBot.Core.Interfaces
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject IServiceScopeFactory ScopeFactory
@inject IVersionService VersionService
@inject IOptions<ObservabilityOptions> ObservabilityOptions

@*
    Routed-Blazor twin of Pages/Shared/_Layout.cshtml (+ _Navbar/_Sidebar/
    _MobileSearchOverlay/_ToastContainer partials) — Phase E of
    docs/architecture/blazor-completion-plan.md.

    Tailwind markup, element ids and data attributes are copied verbatim so the
    existing global JS (navigation.js sidebar toggles, theme.js, search.js,
    toast.js) keeps operating on the same DOM. The scripts are loaded at the
    bottom of this layout (not App.razor) so standalone EmptyLayout pages keep
    the Phase C "no script for anonymous error pages" guardrail; ordering
    mirrors _Layout.cshtml (toast.js/theme.js before blazor-interop.js —
    gotcha §6.1). Routed pages use _framework/blazor.web.js (razor-components
    hosting) instead of the classic blazor.server.js island bootstrap; the
    <base href="/"> in App.razor makes its relative fetches safe on nested routes.

    The notification bell is the existing NotificationBellIsland rendered as a
    direct child (interactive server render mode). Tests can replace it via the
    BellContent parameter to avoid faking its DI surface.

    Differences from _Layout.cshtml, by design:
    - No ViewData breadcrumb block — routed pages render their own breadcrumb
      components inside @Body (GuildLayout renders the guild one).
    - No TempData toast script — routed pages raise toasts via ToastInterop.
*@

<!-- Skip Link for Accessibility -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- Mobile Sidebar Overlay -->
<div id="mobileOverlay" class="mobile-overlay lg:hidden" onclick="toggleMobileSidebar()"></div>

<!-- Mobile Search Overlay -->
<div id="mobileSearchOverlay" class="mobile-search-overlay" role="dialog" aria-modal="true" aria-label="Search">
  <!-- Overlay Header with Search Input -->
  <div class="mobile-search-header">
    <div class="relative flex-1">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-text-tertiary pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="search"
        id="mobile-search-input"
        placeholder="Search servers, commands, logs..."
        class="mobile-search-input"
        aria-label="Search"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      />
    </div>
    <button onclick="closeMobileSearch()" class="mobile-search-close" aria-label="Close search">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Search Content Area -->
  <div class="mobile-search-content">
    <!-- Recent Searches Section -->
    <div id="mobile-recent-searches" class="mobile-recent-searches">
      <!-- Populated by JavaScript -->
    </div>

    <!-- Search Results Section -->
    <div id="mobile-search-results" class="mobile-search-results hidden">
      <!-- Populated by search functionality -->
    </div>

    <!-- Empty State -->
    <div id="mobile-search-empty" class="mobile-search-empty">
      <svg class="w-16 h-16 text-text-tertiary opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <p class="text-text-secondary">Start typing to search</p>
    </div>
  </div>
</div>

<!-- Top Navigation Bar (64px) -->
<nav class="navbar-redesign fixed top-0 left-0 right-0 flex items-center justify-between px-4 lg:px-6 z-fixed">
  <!-- Left Section: Menu Toggle & Logo -->
  <div class="flex items-center gap-4">
    <!-- Mobile Menu Toggle -->
    <button
      id="sidebarToggle"
      onclick="toggleMobileSidebar()"
      class="lg:hidden p-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors"
      aria-label="Toggle sidebar menu"
      aria-expanded="false"
      aria-controls="sidebar"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Desktop Sidebar Collapse Toggle -->
    <button
      id="sidebarCollapseToggle"
      onclick="toggleSidebarCollapse()"
      class="hidden lg:flex p-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors"
      aria-label="Toggle sidebar"
    >
      <svg class="w-5 h-5 transition-transform" id="sidebarCollapseIcon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
      </svg>
    </button>

    <!-- Logo & App Name -->
    <a href="/" class="flex items-center gap-3">
      <img src="images/logo.svg" alt="Bot Admin" class="w-9 h-9" />
      <span class="text-lg font-bold text-text-primary hidden sm:block">Bot Admin</span>
    </a>
  </div>

  <!-- Center Section: Search -->
  <form class="hidden md:flex flex-1 max-w-md mx-8" role="search" action="/Search" method="get">
    <div class="search-container relative w-full">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <label for="navbar-search" class="sr-only">Search servers, commands, logs</label>
      <input
        type="search"
        id="navbar-search"
        name="q"
        placeholder="Search servers, commands, logs..."
        class="w-full pl-10 pr-24 py-2 text-sm bg-bg-tertiary border border-transparent rounded-lg text-text-primary placeholder-text-tertiary focus:border-border-focus focus:ring-1 focus:ring-border-focus transition-colors"
      />
      <!-- Keyboard Shortcut Hint (desktop only) -->
      <div class="absolute right-3 top-1/2 -translate-y-1/2 hidden lg:flex items-center gap-0.5 pointer-events-none">
        <kbd class="search-kbd">
          <span id="kbd-mac" class="hidden">⌘</span>
          <span id="kbd-other">Ctrl</span>
        </kbd>
        <kbd class="search-kbd">K</kbd>
      </div>
    </div>
  </form>

  <!-- Right Section: Actions & User Menu -->
  <div class="flex items-center gap-2">
    <!-- Mobile Search Toggle -->
    <button onclick="toggleMobileSearch()" class="md:hidden p-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors" aria-label="Search">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </button>

    <!-- Connection status is now shown via toast notifications (see dashboard-realtime.js) -->

    <!-- Notification Bell (Blazor island rendered directly; BellContent overridable in tests) -->
    @if (BellContent is not null)
    {
      @BellContent
    }
    else
    {
      <NotificationBellIsland @rendermode="RenderMode.InteractiveServer" />
    }

    <!-- Authentication Section -->
    <AuthorizeView Context="navbarAuth">
      <Authorized>
        <!-- User Menu Dropdown -->
        <div class="relative">
          <button
            id="userMenuButton"
            onclick="toggleUserMenu()"
            class="group flex items-center gap-2 p-1.5 rounded-lg hover:bg-bg-hover transition-colors"
            aria-label="User menu"
            aria-expanded="false"
            aria-haspopup="menu"
            aria-controls="userMenu"
          >
            @if (!string.IsNullOrEmpty(_avatarUrl))
            {
              <img src="@_avatarUrl" alt="@_displayName" class="w-8 h-8 rounded-full object-cover" />
            }
            else
            {
              <div class="w-8 h-8 rounded-full bg-accent-blue flex items-center justify-center text-white font-semibold text-sm">
                @_initials
              </div>
            }
            <svg class="hidden sm:block w-4 h-4 text-text-secondary group-hover:text-text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div id="userMenu" class="user-menu-dropdown" role="menu" aria-label="User menu options">
            <div class="px-4 py-2 border-b border-border-primary">
              <p class="text-sm font-medium text-text-primary">@_displayName</p>
              <p class="text-xs text-text-secondary">@_email</p>
            </div>
            <div class="pt-1">
              <a href="/Account/Profile" role="menuitem" class="flex items-center gap-2 px-4 py-2 text-sm text-text-primary hover:bg-bg-hover transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                Profile
              </a>
              <a href="/Account/Privacy" role="menuitem" class="flex items-center gap-2 px-4 py-2 text-sm text-text-primary hover:bg-bg-hover transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                Privacy & Consent
              </a>
              <form action="/Account/Logout?handler=Post" method="post" class="block">
                <AntiforgeryToken />
                <button type="submit" role="menuitem" class="w-full text-left flex items-center gap-2 px-4 py-2 text-sm text-error hover:bg-bg-hover transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  Sign out
                </button>
              </form>
            </div>
          </div>
        </div>
      </Authorized>
      <NotAuthorized>
        <!-- Login Button -->
        <a href="/Account/Login" class="py-2 px-4 text-sm font-semibold text-white bg-accent-orange border border-accent-orange rounded-md transition-colors hover:bg-accent-orange-hover hover:border-accent-orange-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2">
          Sign In
        </a>
      </NotAuthorized>
    </AuthorizeView>
  </div>
</nav>

<!-- Sidebar Navigation (256px) -->
<aside
  id="sidebar"
  class="sidebar-redesign fixed left-0 h-[calc(100vh-64px)] transform -translate-x-full lg:translate-x-0 overflow-y-auto overflow-x-hidden z-fixed"
  style="top: var(--navbar-height);"
  aria-label="Main navigation"
>
  <nav class="flex flex-col h-full p-3" aria-label="Primary">
    <!-- Main Navigation -->
    <div class="space-y-1" role="group" aria-labelledby="main-nav-heading">
      <h2 id="main-nav-heading" class="sr-only">Main Navigation</h2>
      <!-- Dashboard - visible to all authenticated users -->
      <a href="/" class="sidebar-link-redesign @(DashboardActive ? "active" : "")" aria-current="@(DashboardActive ? "page" : null)">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span class="sidebar-link-text">Dashboard</span>
      </a>

      <!-- Servers - visible to Moderator+ -->
      <AuthorizeView Policy="RequireModerator" Context="modAuth">
        <a href="/Guilds" class="sidebar-link-redesign @(IsActivePrefix("/Guilds") ? "active" : "")" aria-current="@(IsActivePrefix("/Guilds") ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
          <span class="sidebar-link-text">Servers</span>
        </a>
      </AuthorizeView>

      <!-- Commands - visible to Viewer+ -->
      <AuthorizeView Policy="RequireViewer" Context="viewerAuth">
        <a href="/Commands" class="sidebar-link-redesign @(IsActivePrefix("/Commands") ? "active" : "")" aria-current="@(IsActivePrefix("/Commands") ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="sidebar-link-text">Commands</span>
        </a>
      </AuthorizeView>

      <!-- Rat Watch Analytics - visible to Admin+ -->
      <AuthorizeView Policy="RequireAdmin" Context="adminAuth1">
        <a href="/Admin/RatWatchAnalytics" class="sidebar-link-redesign @(IsActiveExact("/Admin/RatWatchAnalytics") ? "active" : "")" aria-current="@(IsActiveExact("/Admin/RatWatchAnalytics") ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span class="sidebar-link-text">Rat Watch Analytics</span>
        </a>
      </AuthorizeView>

      <!-- Bot Performance - visible to Viewer+ -->
      <AuthorizeView Policy="RequireViewer" Context="viewerAuth2">
        <a href="/Admin/Performance" class="sidebar-link-redesign @(IsActivePrefix("/Admin/Performance") ? "active" : "")" aria-current="@(IsActivePrefix("/Admin/Performance") ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <span class="sidebar-link-text">Bot Performance</span>
        </a>
      </AuthorizeView>

      <!-- Settings - visible to Admin+ -->
      <AuthorizeView Policy="RequireAdmin" Context="adminAuth2">
        <a href="/Admin/Settings" class="sidebar-link-redesign @(IsActiveExact("/Admin/Settings") ? "active" : "")" aria-current="@(IsActiveExact("/Admin/Settings") ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="sidebar-link-text">Settings</span>
        </a>
      </AuthorizeView>
    </div>

    <!-- Divider -->
    <div class="my-4 border-t border-border-secondary" role="separator"></div>

    <!-- Admin Section - visible to Admin+ -->
    <AuthorizeView Policy="RequireAdmin" Context="adminAuth3">
      <div class="space-y-1" role="group" aria-labelledby="admin-nav-heading">
        <h2 id="admin-nav-heading" class="sidebar-section-header">Administration</h2>
        <a href="/Admin/Users" class="sidebar-link-redesign @(IsActivePrefix("/Admin/Users") ? "active" : "")" aria-current="@(IsActivePrefix("/Admin/Users") ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span class="sidebar-link-text">Users</span>
        </a>
        <a href="/Admin/Logs" class="sidebar-link-redesign @(LogsActive ? "active" : "")" aria-current="@(LogsActive ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="sidebar-link-text">Logs</span>
        </a>
        <a href="/Admin/Notifications" class="sidebar-link-redesign @(IsActivePrefix("/Admin/Notifications") ? "active" : "")" aria-current="@(IsActivePrefix("/Admin/Notifications") ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span class="sidebar-link-text">Notifications</span>
        </a>
        <AuthorizeView Policy="RequireSuperAdmin" Context="superAdminAuth">
          <a href="/Admin/BulkPurge" class="sidebar-link-redesign @(IsActiveExact("/Admin/BulkPurge") ? "active" : "")" aria-current="@(IsActiveExact("/Admin/BulkPurge") ? "page" : null)">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span class="sidebar-link-text">Bulk Purge</span>
          </a>
          <a href="/Admin/UserPurge" class="sidebar-link-redesign @(IsActiveExact("/Admin/UserPurge") ? "active" : "")" aria-current="@(IsActiveExact("/Admin/UserPurge") ? "page" : null)">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="sidebar-link-text">User Purge</span>
          </a>
        </AuthorizeView>
      </div>
      <div class="my-4 border-t border-border-secondary" role="separator"></div>
    </AuthorizeView>

    <!-- Developer Tools - visible to Admin+ -->
    <AuthorizeView Policy="RequireAdmin" Context="adminAuth4">
      <div class="space-y-1" role="group" aria-labelledby="dev-nav-heading">
        <h2 id="dev-nav-heading" class="sidebar-section-header">Developer</h2>
        <a href="/Components" class="sidebar-link-redesign @(IsActiveExact("/Components") ? "active" : "")" aria-current="@(IsActiveExact("/Components") ? "page" : null)">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span class="sidebar-link-text">Components</span>
        </a>
        @if (!string.IsNullOrEmpty(ObservabilityOptions.Value.KibanaUrl))
        {
          <a href="@ObservabilityOptions.Value.KibanaUrl" target="_blank" rel="noopener noreferrer" class="sidebar-link-redesign">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>

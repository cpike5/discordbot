@* Rendered by Routes.razor's <NotAuthorized> when the user isn't signed in at all (an
   authenticated-but-forbidden user gets the plain "access denied" message next to this
   instead - see Routes.razor). Forces a full page load rather than a client-side
   navigation: the SPA-style NavigateTo can't complete the round trip through the cookie
   auth middleware that Login needs. *@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // A path relative to the app base, always starting with "/", so it matches what
        // Blazor/Pages/Account/Login.razor.cs's own LocalUrl.IsLocal check (Phase 4 cluster 4c)
        // accepts as a returnUrl (an absolute URL here would otherwise be rejected there anyway).
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = "/" + relativePath;

        // Reject anything that could carry the browser off-site: "//host/..." is a
        // protocol-relative URL, and "scheme://" anywhere in the path would otherwise be handed
        // straight to the browser as the post-login destination. Login.razor.cs's own
        // LocalUrl.IsLocal check re-validates this too (belt and suspenders across the redirect),
        // but fall back to the app root here as well instead of relying solely on that.
        if (returnUrl.StartsWith("//", StringComparison.Ordinal) || returnUrl.Contains("://", StringComparison.Ordinal))
        {
            returnUrl = "/";
        }

        Navigation.NavigateTo(
            $"/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}",
            forceLoad: true);
    }
}
